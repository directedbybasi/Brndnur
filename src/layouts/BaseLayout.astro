---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  currentPath?: string;
  robots?: string;
  hasCustomSchema?: boolean;
  heroImage?: string;
  heroImageMobile?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = '/assets/brndnur-og-banner.jpg',
  ogType = 'website',
  currentPath = '/',
  robots = 'index, follow, max-image-preview:large',
  hasCustomSchema = false,
  heroImage,
  heroImageMobile,
} = Astro.props;

const siteName = 'BRNDNUR Advisory LLP';
const isHome = currentPath === '/' || currentPath === '' || currentPath === '/index.html';
const fullOgImage = ogImage.startsWith('http') ? ogImage : `https://brndnur.com${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

const isIndexable = !robots.includes('noindex');

// Responsive hero image preloading computation
const desktopHero = heroImage ? (heroImage.endsWith('.webp') ? heroImage : heroImage.replace(/\.(png|jpe?g)$/i, '.webp')) : '';
const candidateMobileHero = heroImageMobile || (desktopHero ? desktopHero.replace(/\.webp$/i, '-mobile.webp') : '');
let hasMobileHero = false;
let mobileHero = desktopHero;
if (candidateMobileHero) {
  try {
    const localMobile = path.join(process.cwd(), 'public', candidateMobileHero.replace(/^\//, ''));
    if (fs.existsSync(localMobile)) {
      hasMobileHero = true;
      mobileHero = candidateMobileHero;
    }
  } catch(e) {}
}

// High-fidelity structured data incorporating WebPage, WebSite, Breadcrumbs, and ProfessionalService/LegalService entity
const defaultSchema = isIndexable && !hasCustomSchema ? {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LegalService",
      "additionalType": [
        "https://schema.org/ProfessionalService",
        "https://schema.org/LocalBusiness"
      ],
      "@id": "https://brndnur.com/#organization",
      "name": "BRNDNUR Advisory LLP",
      "legalName": "BRNDNUR Advisory LLP",
      "url": "https://brndnur.com/",
      "sameAs": [
        "https://www.linkedin.com/company/brndnur",
        "https://x.com/brndnur"
      ],
      "logo": {
        "@type": "ImageObject",
        "@id": "https://brndnur.com/#logo",
        "url": "https://brndnur.com/assets/brndnur-logo-transparent.png",
        "caption": "BRNDNUR Advisory LLP"
      },
      "image": "https://brndnur.com/assets/brndnur-og-banner.jpg",
      "telephone": "+91 90481 88899",
      "email": "brndnuradvisoryllp@gmail.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skatt Business Park",
        "addressLocality": "Manjeri, Malappuram",
        "addressRegion": "Kerala",
        "postalCode": "676121",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 11.117737,
        "longitude": 76.1179931
      },
      "hasMap": "https://www.google.com/maps/place/Skatt+Business+Park+Manjeri/@11.117737,76.1154182,17z/data=!4m7!3m6!1s0x3ba637bf4f77ff6f:0xbda0700b92d1cffc!4b1!8m2!3d11.117737!4d76.1179931!16s%2Fg%2F11xh27nsrc?entry=ttu&g_ep=EgoyMDI2MTAyMC4wIKXMDSoASAFQAw%3D%3D",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:30",
        "closes": "18:00"
      },
      "areaServed": [
        "Manjeri",
        "Malappuram",
        "Kozhikode",
        "Wayanad",
        "Kannur",
        "Kasaragod",
        "Palakkad",
        "Thrissur",
        "Ernakulam",
        "Kerala",
        "India"
      ],
      "knowsAbout": [
        "Trademark Registration in India",
        "Brand Name Search",
        "Nice Classification",
        "Trademark Renewal",
        "Trademark Journal Monitoring",
        "GST Registration",
        "Udyam MSME Registration",
        "FSSAI Registration",
        "Business Setup Advisory"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-90481-88899",
        "contactType": "customer service",
        "availableLanguage": ["en", "ml"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://brndnur.com/#website",
      "url": "https://brndnur.com/",
      "name": "BRNDNUR Advisory LLP",
      "publisher": {
        "@id": "https://brndnur.com/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": "https://brndnur.com/#website"
      },
      "about": {
        "@id": "https://brndnur.com/#organization"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://brndnur.com/"
        },
        ...(currentPath !== '/' ? [{
          "@type": "ListItem",
          "position": 2,
          "name": title.split('|')[0].trim(),
          "item": canonical
        }] : [])
      ]
    }
  ]
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <link rel="canonical" href={canonical}>

  <!-- Geographic & Local Entity Metadata -->
  <meta name="geo.region" content="IN-KL">
  <meta name="geo.placename" content="Skatt Business Park, Manjeri, Malappuram, Kerala - 676121">
  <meta name="geo.position" content="11.117737;76.1179931">
  <meta name="ICBM" content="11.117737, 76.1179931">
  <meta name="author" content="BRNDNUR Advisory LLP">
  <meta name="theme-color" content="#13233A">

  <!-- Favicon & Brand Icons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Open Graph / Facebook -->
  <meta property="og:site_name" content={siteName}>
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={fullOgImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_IN">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={fullOgImage}>

  <!-- Typography & Preconnect (Optimized Non-Render-Blocking Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap">
  </noscript>

  <!-- Above-the-Fold LCP Hero Image Preload -->
  {desktopHero && (
    hasMobileHero ? (
      <>
        <link rel="preload" as="image" href={mobileHero} media="(max-width: 768px)" type="image/webp" fetchpriority="high" />
        <link rel="preload" as="image" href={desktopHero} media="(min-width: 769px)" type="image/webp" fetchpriority="high" />
      </>
    ) : (
      <link rel="preload" as="image" href={desktopHero} type="image/webp" fetchpriority="high" />
    )
  )}

  {defaultSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(defaultSchema)} />
  )}

  <!-- First-Visit Intro Detection Script: Homepage-only desktop progressive enhancement -->
  {isHome && (
    <script is:inline>
      (function() {
        try {
          var pathname = window.location.pathname;
          var isHomeUrl = pathname === '/' || pathname === '' || pathname === '/index.html';
          if (!isHomeUrl) return;

          var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var isMobile = window.matchMedia('(max-width: 768px)').matches;
          var isReplay = window.location.search.indexOf('replay=') !== -1;
          var introPlayed = false;
          try {
            introPlayed = sessionStorage.getItem('brndnur_intro_played') === 'true';
          } catch(e) {}

          // Run intro overlay only on desktop screens when motion is enabled, or on explicit replay
          if ((!isMobile && !introPlayed && !prefersReduced) || (isReplay && !prefersReduced)) {
            document.documentElement.classList.add('bn-show-intro');
            document.addEventListener('DOMContentLoaded', function() {
              if (document.documentElement.classList.contains('bn-show-intro')) {
                document.body.classList.add('bn-intro-active');
              }
            });
          }
        } catch(e) {}
      })();
    </script>
  )}

  <slot name="head" />
</head>
<body>
  <!-- Accessible Skip Link for Keyboard & Screen Reader Users (WCAG 2.4.1 Bypass Blocks) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {isHome && <IntroAnimation />}

  <Header currentPath={currentPath} />
  <slot />
  <Footer />
  <FloatingWhatsApp currentPath={currentPath} pageTitle={title} />

  <script is:inline>
    document.addEventListener('click', (e) => {
      const button = e.target.closest('.faq-question, .bn-faq-q');
      if (button) {
        const item = button.closest('.faq-item, .bn-faq-item');
        if (item) {
          const isOpen = item.classList.toggle('is-open');
          item.classList.toggle('open', isOpen);
          button.setAttribute('aria-expanded', String(isOpen));
        }
      }
    });
  </script>
  {['/', '/packages/', '/how-it-works/', '/trademark-registration/'].some(p => currentPath === p || currentPath === p.slice(0, -1)) && (
    <script is:inline src="/scripts/carousel.js" defer></script>
  )}
  <script is:inline src="/scripts/motion.js" defer></script>
</body>
</html>
