---
import Logo from './Logo.astro';
import { getFooterWhatsAppUrl } from '../utils/whatsapp';

const footerWhatsAppUrl = getFooterWhatsAppUrl();
---

<footer class="bn-footer" id="contact">
  <div class="container bn-footer-main">
    <div class="bn-footer-brand">
      <a class="bn-brand footer-logo" href="/" aria-label="BRNDNUR Advisory LLP">
        <Logo variant="transparent" loading="lazy" fetchpriority="auto" alt="BRNDNUR Advisory LLP" />
      </a>
      <p>Trademark registration guidance and business advisory services for entrepreneurs and growing businesses.</p>
    </div>
    <div class="bn-footer-col">
      <p class="bn-foot-title">Quick Links</p>
      <a href="/">Home</a>
      <a href="/services/">Services</a>
      <a href="/packages/">Packages</a>
      <a href="/about/">About</a>
      <a href="/resources/">Resources</a>
      <a href="/contact/">Contact</a>
    </div>
    <div class="bn-footer-col">
      <p class="bn-foot-title">Trademark Services</p>
      <a href="/trademark-registration/">Trademark Registration</a>
      <a href="/brand-name-search/">Brand Name Search</a>
      <a href="/trademark-renewal-monitoring/">Renewal &amp; Monitoring</a>
      <a href="/business-registration/">Business Registration</a>
    </div>
    <div class="bn-footer-col">
      <p class="bn-foot-title">Contact</p>
