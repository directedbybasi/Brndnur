          <path d="M12 22s7-7.4 7-13a7 7 0 1 0-14 0c0 5.6 7 13 7 13Z"/>
          <circle cx="12" cy="9" r="2.4"/>
        </svg>
        <span>Skatt Business Park,<br>Manjeri, Malappuram - 676121</span>
