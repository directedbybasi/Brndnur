---
import { getFloatingWhatsAppUrl } from '../utils/whatsapp';

interface Props {
  currentPath?: string;
  pageTitle?: string;
}

const { currentPath = '/', pageTitle } = Astro.props;
const whatsappUrl = getFloatingWhatsAppUrl(currentPath, pageTitle);
---

<aside class="bn-floating-whatsapp" aria-label="Direct WhatsApp Contact">
  <a
    href={whatsappUrl}
    class="bn-floating-wa-btn"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat directly with BRNDNUR Advisory on WhatsApp"
  >
    <picture>
      <source srcset="/assets/whatsapp-icon.webp" type="image/webp" />
      <img
        src="/assets/whatsapp-icon.png"
        alt="WhatsApp"
        width="60"
        height="60"
        loading="lazy"
        decoding="async"
        class="bn-floating-wa-img"
      />
    </picture>
    <span class="bn-floating-wa-tooltip" role="tooltip">Chat on WhatsApp</span>
  </a>
</aside>

<style>
  .bn-floating-whatsapp {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 998;
    display: block;
  }

  .bn-floating-wa-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.16), 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    outline: none;
  }

  .bn-floating-wa-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35), 0 4px 12px rgba(19, 35, 58, 0.18);
  }

  .bn-floating-wa-btn:focus-visible {
    outline: 3px solid #25D366;
    outline-offset: 4px;
  }

  .bn-floating-wa-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
    display: block;
  }

  /* Tooltip on desktop hover */
  .bn-floating-wa-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #13233A;
    color: #F4EFE4;
    padding: 6px 14px;
    border-radius: 6px;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(19, 35, 58, 0.25);
    border: 1px solid rgba(168, 120, 26, 0.35);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  .bn-floating-wa-tooltip::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -5px;
    transform: translateY(-50%);
    border-width: 5px 0 5px 5px;
    border-style: solid;
    border-color: transparent transparent transparent #13233A;
  }

  .bn-floating-wa-btn:hover .bn-floating-wa-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 767px) {
    .bn-floating-whatsapp {
      bottom: 18px;
      right: 18px;
    }

    .bn-floating-wa-btn {
      width: 52px;
      height: 52px;
    }

    .bn-floating-wa-tooltip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bn-floating-wa-btn {
      transition: none;
    }
    .bn-floating-wa-btn:hover {
      transform: none;
    }
  }
</style>
