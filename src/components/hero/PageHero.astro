    font-family: var(--sans, 'DM Sans', sans-serif);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-size: clamp(2.35rem, 3.8vw, 3.65rem);
    color: var(--navy, #13233A);
    max-width: 100%;
    min-width: 0;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
  }

  .shared-page-hero :global(.hero-amp-desktop) {
    display: inline;
  }

  .shared-page-hero :global(.hero-amp-mobile) {
    display: none;
  }

  .shared-page-hero :global(.hero-br-desktop) {
    display: inline;
  }

  .shared-page-hero :global(.hero-br-mobile) {
    display: none;
  }

  .shared-page-hero h1 :global(span) {
