---
import HeroBenefitStrip, { type BenefitBadge } from './HeroBenefitStrip.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCta?: {
    text: string;
    href: string;
    icon?: string;
    target?: string;
    rel?: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
    icon?: string;
    target?: string;
    rel?: string;
  };
  trustBadges?: BenefitBadge[];
  image: string;
  imageMobile?: string;
  imageAlt: string;
  imagePosition?: string;
  imagePositionMobile?: string;
  imageTransform?: string;
  hasGoldRule?: boolean;
  variant?: 'standard' | 'service' | 'package' | 'homepage';
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  trustBadges,
  image,
  imageMobile,
  imageAlt,
  imagePosition,
  imagePositionMobile,
  imageTransform,
  hasGoldRule = false,
  variant = 'standard',
  className = ''
} = Astro.props;

import fs from 'node:fs';
import path from 'node:path';

const desktopWebp = image ? (image.endsWith('.webp') ? image : image.replace(/\.(png|jpe?g)$/i, '.webp')) : '';
const candidateMobile = imageMobile || (desktopWebp ? desktopWebp.replace(/\.webp$/i, '-mobile.webp') : '');
let hasMobile = false;
let mobileWebp = desktopWebp;
if (candidateMobile) {
  try {
    const localMobilePath = path.join(process.cwd(), 'public', candidateMobile.replace(/^\//, ''));
    if (fs.existsSync(localMobilePath)) {
      hasMobile = true;
      mobileWebp = candidateMobile;
    }
  } catch(e) {}
}
---

<section class={`hero page-hero shared-page-hero variant-${variant} ${className}`.trim()} aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      {eyebrow && <p class="eyebrow hero-stagger-1" set:html={eyebrow} />}
      <h1 id="hero-title" class="hero-stagger-2" set:html={title} />
      {hasGoldRule && <div class="gold-rule hero-stagger-3" aria-hidden="true"></div>}
      <p class="hero-lead hero-stagger-3">{description}</p>

      {(primaryCta || secondaryCta) && (
        <div class="actions hero-actions hero-stagger-4">
          {primaryCta && (
            <a
              class="btn btn-primary"
              href={primaryCta.href}
              target={primaryCta.target}
              rel={primaryCta.rel}
            >
              <span>{primaryCta.text}</span>
              <span class="arrow" aria-hidden="true">{primaryCta.icon || '→'}</span>
            </a>
          )}
          {secondaryCta && (
            <a
              class="btn btn-secondary"
              href={secondaryCta.href}
              target={secondaryCta.target}
              rel={secondaryCta.rel}
            >
              <span>{secondaryCta.text}</span>
              <span class="arrow" aria-hidden="true">{secondaryCta.icon || '→'}</span>
            </a>
          )}
        </div>
      )}

      <div class="hero-stagger-5">
        <HeroBenefitStrip items={trustBadges} />
      </div>
    </div>
  </div>

  <div class="hero-photo-wrap hero-photo-animate" aria-hidden="true">
    <picture class="hero-photo-picture">
      {hasMobile && (
        <source media="(max-width: 768px)" srcset={mobileWebp} type="image/webp" />
      )}
      <source media="(min-width: 769px)" srcset={desktopWebp} type="image/webp" />
      <img
        class="hero-photo"
        src={desktopWebp}
        alt={imageAlt}
        width="1448"
        height="1086"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        style={[
        imagePosition ? `--hero-img-pos: ${imagePosition}; object-position: ${imagePosition};` : undefined,
        imagePositionMobile ? `--hero-img-pos-mobile: ${imagePositionMobile};` : undefined,
        imageTransform ? `--hero-img-transform: ${imageTransform};` : undefined
      ].filter(Boolean).join(' ') || undefined}
      />
    </picture>
  </div>
</section>

<style>
  /* ==========================================================================
     SHARED PAGE HERO STYLES — AUTHORITATIVE HOMEPAGE COMPOSITION & FIXED HEIGHT
     ========================================================================== */
  .shared-page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ivory, #F4EFE4);
    box-sizing: border-box;
