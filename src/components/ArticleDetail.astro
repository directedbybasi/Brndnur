---
import FaqItem from './FaqItem.astro';
import { buildWhatsAppUrl } from '../utils/whatsapp';
import type { ArticleData } from '../utils/blog';

interface Props {
  article: ArticleData;
  isPreview?: boolean;
}

const { article, isPreview = false } = Astro.props;

const readingTime = Math.ceil((article.wordCount || 1000) / 200);

const articleWhatsAppUrl = buildWhatsAppUrl({
  pageName: article.title,
  sectionName: 'Resource Guide Sidebar',
  enquiryType: 'Resource Advisory Guidance',
  message: `Hi BRNDNUR, I was reading your guide on "${article.title}" and would like guidance for my business. Could you please explain the applicable requirements, process, documents, and next steps?`
});

// Format category / location eyebrow
const locationText = article.town ? `${article.town}, ${article.district}` : (article.district || 'Kerala');
const categoryText = article.category || 'Brand & Business Guidance';
---

{/* Administrative Draft Notice Bar — Restricted strictly to Preview Route */}
{isPreview && (
  <div class="draft-notice-bar" role="status" aria-label="Editorial draft notice">
    <div class="container draft-notice-inner">
      <div class="draft-badge-group">
        <span class="draft-badge">DRAFT PREVIEW</span>
        <span class="draft-status-pill">Unpublished Editorial Build</span>
      </div>
      <div class="draft-meta">
        <span>ID: <strong>{article.id}</strong></span>
        <span class="meta-separator" aria-hidden="true">&bull;</span>
        <span>Location: <strong>{locationText}</strong></span>
        <span class="meta-separator" aria-hidden="true">&bull;</span>
        <span>Word Count: ~{article.wordCount || 1100}</span>
        <span class="meta-separator" aria-hidden="true">&bull;</span>
        <span>Est. Reading: {readingTime} min</span>
      </div>
      {article.reviewFlags && article.reviewFlags.length > 0 && (
        <a href="#editorial-review-panel" class="draft-flags-indicator">
          ⚠️ {article.reviewFlags.length} Review Note{article.reviewFlags.length > 1 ? 's' : ''} &darr;
        </a>
      )}
    </div>
  </div>
)}

<main id="main-content" class="article-page">
  {/* Breadcrumb Navigation */}
  <nav class="article-breadcrumb-nav" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li class="breadcrumb-sep" aria-hidden="true">&rsaquo;</li>
        <li><a href="/resources/">Resources</a></li>
        {article.district && (
          <>
            <li class="breadcrumb-sep" aria-hidden="true">&rsaquo;</li>
            <li><span>{article.district}</span></li>
          </>
        )}
        {article.town && (
          <>
            <li class="breadcrumb-sep" aria-hidden="true">&rsaquo;</li>
            <li><span>{article.town}</span></li>
          </>
        )}
        <li class="breadcrumb-sep" aria-hidden="true">&rsaquo;</li>
        <li class="breadcrumb-current" aria-current="page">{article.title}</li>
      </ol>
    </div>
  </nav>

  {/* Editorial Article Header */}
  <header class="article-hero">
    <div class="container">
      <div class="article-hero-content">
        <p class="eyebrow hero-stagger-1">{locationText.toUpperCase()} &bull; {categoryText.toUpperCase()}</p>

        <h1 class="article-title hero-stagger-2">{article.title}</h1>
        <div class="gold-rule hero-stagger-3" aria-hidden="true"></div>

        {article.metaDescription && (
          <p class="article-lead hero-stagger-3">{article.metaDescription}</p>
        )}

        <div class="article-meta-row hero-stagger-4" aria-label="Article publication metadata">
          <div class="meta-item">
            <span class="meta-icon" aria-hidden="true">⏱</span>
            <span>~{readingTime} min read</span>
          </div>
          <span class="meta-sep" aria-hidden="true">&bull;</span>
          <div class="meta-item">
            <span class="meta-icon" aria-hidden="true">🏛️</span>
            <span>Chennai Jurisdiction</span>
          </div>
          <span class="meta-sep" aria-hidden="true">&bull;</span>
          <div class="meta-item">
            <span class="meta-icon" aria-hidden="true">⚖</span>
            <span>Trade Marks Act, 1999</span>
          </div>
          <span class="meta-sep" aria-hidden="true">&bull;</span>
          <div class="meta-item meta-verified">
            <span class="meta-icon" aria-hidden="true">✓</span>
            <span>Advisory Clearance Guide</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  {/* Main 2-Column Responsive Layout */}
  <div class="container article-layout-container">
    <div class="article-layout">
      {/* Primary Article Content Column */}
      <article class="article-main legal-prose">
        {/* Quick Answer / Executive Takeaway Panel */}
        {article.quickAnswer && (
          <section class="quick-answer-card reveal-on-scroll" id="quick-answer" aria-label="Quick Answer Summary for Founders">
            <div class="quick-answer-header">
              <div class="quick-answer-title-group">
                <span class="quick-answer-icon" aria-hidden="true">💡</span>
                <h3>Quick Answer for Founders</h3>
              </div>
              <span class="quick-answer-tag">Key Takeaway</span>
            </div>
            <p class="quick-answer-text">{article.quickAnswer}</p>
          </section>
        )}

        {/* Mobile Quick Consultation Callout (Stacked on small screens) */}
        <div class="mobile-consultation-strip">
          <div class="strip-text">
            <strong>Need direct guidance for {locationText}?</strong>
            <span>Discuss your filing with BRNDNUR Advisory advisors.</span>
          </div>
          <a class="btn-strip-wa" href={articleWhatsAppUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp Advisory &rarr;
          </a>
        </div>

        {/* Body Sections */}
        {article.h2Sections && article.h2Sections.map((sec, idx) => (
          <section class="article-section" id={`section-${idx + 1}`}>
            <h2 class="section-h2">{sec.h2}</h2>
            {sec.h3 && <h3 class="section-h3">{sec.h3}</h3>}

            {sec.content && sec.content.map((p) => {
              if (typeof p === 'string' && p.includes('\n')) {
                const parts = p.split('\n').filter(Boolean);
                return (
                  <div class="qa-block">
                    {parts.map((part) => {
                      if (part.startsWith('Q:') || part.startsWith('Question:')) {
                        return <p class="qa-q"><strong>{part}</strong></p>;
                      }
                      return <p class="qa-a" set:html={part} />;
                    })}
                  </div>
                );
              }
              return <p set:html={p} />;
            })}

            {/* Checklist items */}
            {sec.checklist && sec.checklist.length > 0 && (
              <div class="checklist-panel">
                <h4 class="checklist-heading">Action Items &amp; Filing Checkpoints</h4>
                <ul class="check-list">
                  {sec.checklist.map((item) => (
                    <li>
                      <span class="check" aria-hidden="true">✓</span>
                      <span class="check-text" set:html={item} />
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {/* Tables */}
            {sec.table && sec.table.headers && sec.table.rows && (
              <div class="table-container">
                <div class="table-scroll-hint" aria-hidden="true">
                  <span>&larr; Scroll horizontally to view full table &rarr;</span>
                </div>
                <div class="table-wrap">
                  <table class="bn-table">
                    <thead>
                      <tr>
                        {sec.table.headers.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {sec.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, cIdx) => (
                            <td class={cIdx === 0 ? 'td-primary' : ''} set:html={cell} />
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* Callouts */}
            {sec.callout && (
              <aside class={`callout-card callout-${sec.callout.type || 'note'}`} aria-label={sec.callout.title}>
                <div class="callout-header">
                  <span class="callout-icon" aria-hidden="true">
                    {sec.callout.type === 'warning' ? '⚠️' : sec.callout.type === 'tip' ? '💡' : 'ℹ️'}
                  </span>
                  <strong class="callout-title">{sec.callout.title}</strong>
                </div>
                <p class="callout-text">{sec.callout.text}</p>
              </aside>
            )}
          </section>
        ))}

        {/* Frequently Asked Questions */}
        {article.faqs && article.faqs.length > 0 && (
          <section class="article-faqs reveal-on-scroll" id="faqs" aria-labelledby="faq-heading">
            <div class="faqs-header">
              <span class="section-eyebrow">Clarity &amp; Compliance</span>
              <h2 id="faq-heading" class="section-h2">Frequently Asked Questions</h2>
              <div class="article-gold-accent" aria-hidden="true"></div>
            </div>
            <div class="faq-editorial-list faq-list">
              {article.faqs.map((faq, idx) => (
                <FaqItem
                  num={idx + 1}
                  question={faq.question}
                  answer={faq.answer}
                />
              ))}
            </div>
          </section>
        )}

        {/* Relevant Statutory Services & Guides */}
        {article.internalLinks && article.internalLinks.length > 0 && (
          <section class="related-services-card reveal-on-scroll" id="related-services" aria-labelledby="related-heading">
            <div class="related-header">
              <span class="section-eyebrow">Statutory Assistance</span>
              <h3 id="related-heading">Relevant Advisory &amp; Registration Services</h3>
              <p>Explore related filings, classification tools, and government incentive schemes:</p>
            </div>
            <div class="related-links-grid reveal-group">
              {article.internalLinks.map((link) => (
                <a class="related-link-item reveal-item" href={link.url}>
                  <div class="related-link-title-row">
                    <strong>{link.title}</strong>
                    <span class="related-arrow" aria-hidden="true">&rarr;</span>
                  </div>
                  <span>{link.description}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* Official Statutory Authorities & Sources */}
        {article.officialSources && article.officialSources.length > 0 && (
          <section class="sources-card reveal-on-scroll" id="official-sources" aria-labelledby="sources-heading">
            <div class="sources-header">
              <span class="sources-icon" aria-hidden="true">🏛️</span>
              <h3 id="sources-heading">Official Authorities &amp; Statutory References</h3>
            </div>
            <ul class="sources-list">
              {article.officialSources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    <span class="source-title">{source.title}</span>
                    <span class="source-authority">&mdash; {source.authority}</span>
                    <span class="external-icon" aria-hidden="true">&#x2197;</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Educational Disclaimer */}
        <footer class="educational-disclaimer">
          <p>
            <strong>Disclaimer:</strong> This article is published for general educational and informational purposes only. It does not constitute individualized legal, tax, or professional advisory. Statutory rules, official filing fees, and procedural requirements under the Trade Marks Act 1999, CGST Act, and related notifications are subject to periodic governmental amendment. Consult qualified professionals or official authorities before acting on this information.
          </p>
        </footer>
      </article>

      {/* Balanced Sidebar Column (Sticky Companion) */}
      <aside class="article-sidebar" aria-label="Advisory consultation">
        <div class="sidebar-sticky-wrapper">
          {/* Consultation / Advisory Conversion Card */}
          <div class="sidebar-card sidebar-cta-card">
            <div class="sidebar-card-header">
              <span class="eyebrow">BRNDNUR Advisory</span>
              <h3 class="cta-heading">{article.cta.heading}</h3>
            </div>
            <p class="cta-desc">{article.cta.description}</p>

            <div class="sidebar-contact-info">
              <div class="contact-pill">
                <span class="pill-icon" aria-hidden="true">📍</span>
                <span>Registered at Skatt Business Park, Manjeri</span>
              </div>
              <div class="contact-pill">
                <span class="pill-icon" aria-hidden="true">⏱</span>
                <span>Mon &ndash; Sat: 9:30 AM &ndash; 6:00 PM</span>
              </div>
              <div class="contact-pill">
                <span class="pill-icon" aria-hidden="true">📞</span>
                <span>+91 90481 88899</span>
              </div>
            </div>

            <div class="sidebar-actions">
              <a class="btn btn-primary sidebar-btn-wa" href={articleWhatsAppUrl} target="_blank" rel="noopener noreferrer">
                <span>{article.cta.buttonText}</span>
                <span class="arrow" aria-hidden="true">&rarr;</span>
              </a>
              <a class="btn btn-outline sidebar-btn-call" href="tel:+919048188899">
                <span>Call Advisory Desk</span>
              </a>
            </div>

            <div class="sidebar-trust-guarantee">
              <span class="trust-icon" aria-hidden="true">🔒</span>
              <span>Confidential &bull; Direct Partner Review &bull; No Obligation</span>
            </div>
          </div>

          {/* Topical Pillar / Core Advisory Solutions Navigation (Hub & Spoke Silo) */}
          <div class="sidebar-card sidebar-pillar-card">
            <span class="eyebrow">Direct Solutions</span>
            <h4 class="pillar-heading">Core Advisory Services</h4>
            <ul class="pillar-links-list">
              <li>
                <a href="/trademark-registration/">
                  <span>Trademark Registration</span>
                  <span class="pillar-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
              <li>
                <a href="/packages/">
                  <span>Fixed-Fee Advisory Packages</span>
                  <span class="pillar-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
              <li>
                <a href="/trademark-classes/">
                  <span>Nice Classification Guide</span>
                  <span class="pillar-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
              <li>
                <a href="/business-setup/">
                  <span>Kerala Business Setup Advisory</span>
                  <span class="pillar-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  {/* Administrative Internal Review Notes — Restricted strictly to Preview Route and clearly separated from customer-facing content */}
  {isPreview && article.reviewFlags && article.reviewFlags.length > 0 && (
    <section class="container editorial-admin-section" id="editorial-review-panel" aria-label="Editorial Staff Review Notes">
      <div class="editorial-admin-card">
        <div class="editorial-admin-header">
          <div class="editorial-title-group">
            <span class="editorial-lock-icon" aria-hidden="true">🔒</span>
            <h3>Internal Editorial Review Notes</h3>
          </div>
          <span class="editorial-tag">Staff Only &bull; Excluded from Live Site</span>
        </div>
        <p class="editorial-subtext">
          These internal review flags are visible only in this preview route for editorial audit compliance. They are not displayed on public published articles.
        </p>
        <ul class="editorial-flags-list">
          {article.reviewFlags.map((flag) => (
            <li>
              <span class="flag-bullet" aria-hidden="true">⚠️</span>
              <span class="flag-text">{flag}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</main>

<style>
  /* Base Article Page Styles */
  .article-page {
    background: var(--ivory);
    padding-bottom: 80px;
    width: 100%;
    color: var(--body);
    font-family: var(--sans);
    overflow-wrap: break-word;
    box-sizing: border-box;
  }

  /* Preview Administrative Notice Bar */
  .draft-notice-bar {
    background: #1B1305;
    color: #F8E6B8;
    border-bottom: 2px solid #C28A25;
    padding: 10px 0;
    font-size: 13px;
    width: 100%;
    box-sizing: border-box;
  }
  .draft-notice-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  .draft-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .draft-badge {
    background: #C28A25;
    color: #13233A;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 3px;
    text-transform: uppercase;
  }
  .draft-status-pill {
    color: #E6D2A8;
    font-size: 12px;
  }
  .draft-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    color: #D6C298;
    font-size: 12px;
  }
  .draft-meta strong {
    color: #FFF2D1;
  }
  .meta-separator {
    opacity: 0.5;
  }
  .draft-flags-indicator {
    background: rgba(194, 138, 37, 0.2);
    color: #FEE8A2;
    border: 1px solid rgba(194, 138, 37, 0.6);
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .draft-flags-indicator:hover {
    background: rgba(194, 138, 37, 0.35);
  }

  /* Breadcrumb Navigation */
  .article-breadcrumb-nav {
    padding: 24px 0 12px;
    font-size: 13px;
    color: var(--muted);
    border-bottom: 1px solid rgba(220, 206, 182, 0.4);
    background: rgba(244, 239, 228, 0.6);
  }
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    line-height: 1.4;
  }
  .breadcrumb-list a {
    color: var(--navy);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb-list a:hover {
    color: var(--gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .breadcrumb-sep {
    color: var(--gold);
    opacity: 0.7;
    font-size: 14px;
  }
  .breadcrumb-current {
    color: var(--muted);
    font-weight: 500;
    max-width: 480px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Editorial Article Hero */
  .article-hero {
    padding: 38px 0 44px;
    border-bottom: 1px solid var(--line);
    background: var(--ivory);
    width: 100%;
    box-sizing: border-box;
  }
  .article-hero-content {
    max-width: 920px;
    width: 100%;
    box-sizing: border-box;
  }
  .article-hero .eyebrow {
    margin: 0 0 14px;
    color: var(--gold);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .article-title {
    font-size: clamp(2.35rem, 3.8vw, 3.35rem);
    font-weight: 600;
    line-height: 1.16;
    color: var(--navy);
    margin: 0 0 18px;
    letter-spacing: -0.025em;
  }
  .article-hero .gold-rule {
    width: 50px;
    height: 2.5px;
    background: var(--gold);
    margin: 0 0 22px;
  }
  .article-lead {
    font-size: 18px;
    line-height: 1.68;
    color: #384659;
    margin: 0 0 24px;
    max-width: 820px;
  }
  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-size: 13.5px;
    color: var(--muted);
    padding-top: 4px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    color: #475569;
  }
  .meta-icon {
    font-size: 13px;
    line-height: 1;
    color: var(--gold);
  }
  .meta-sep {
    color: var(--line);
    font-size: 14px;
    user-select: none;
  }
  .meta-verified {
    color: #1B4D2B;
    font-weight: 600;
  }
  .meta-verified .meta-icon {
    color: #1B4D2B;
  }

  /* Main Responsive Two-Column Layout */
  .article-layout-container {
    padding-top: 48px;
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 40px;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
  }
  .article-main {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .article-section,
  .quick-answer-card,
  .article-faqs,
  .related-services-card,
  .sources-card,
  .editorial-admin-section {
    scroll-margin-top: 100px;
  }

  /* Quick Answer / Takeaway Card */
  .quick-answer-card {
    background: #FFFDF9;
    border: 1.5px solid var(--gold);
    border-left: 5px solid var(--gold);
    border-radius: 8px;
    padding: 24px 28px;
    margin-bottom: 44px;
    box-shadow: 0 4px 18px rgba(168, 120, 26, 0.08);
    box-sizing: border-box;
  }
  .quick-answer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .quick-answer-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .quick-answer-icon {
    font-size: 1.35rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .quick-answer-header h3 {
    margin: 0;
    font-size: 18px;
    color: var(--navy);
    font-weight: 700;
    line-height: 1.3;
  }
  .quick-answer-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: #F0E2C8;
    color: #8F6214;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .quick-answer-text {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.72;
    color: #1F2D3D;
    font-weight: 500;
  }

  /* Mobile Quick Consultation Strip (Hidden on Desktop) */
  .mobile-consultation-strip {
    display: none;
    background: #EAE1D1;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 14px 16px;
    margin-bottom: 32px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .mobile-consultation-strip .strip-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13.5px;
  }
  .mobile-consultation-strip .strip-text strong {
    color: var(--navy);
  }
  .mobile-consultation-strip .strip-text span {
    color: var(--muted);
    font-size: 12px;
  }
  .btn-strip-wa {
    display: inline-block;
    background: #1B4D2B;
    color: #fff !important;
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 4px;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Article Sections */
  .article-section {
    margin-bottom: 48px;
    width: 100%;
    box-sizing: border-box;
  }
  .section-h2 {
    font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    color: var(--navy);
    margin: 0 0 18px;
