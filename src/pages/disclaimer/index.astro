---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Disclaimer | BRNDNUR Advisory LLP";
const description = "Legal and operational disclaimer for BRNDNUR Advisory LLP. Important notices regarding statutory authorities, independent decisions, and advisory scope.";
const canonical = "https://brndnur.com/disclaimer/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/disclaimer/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Disclaimer</span>
        </nav>
        <p class="eyebrow">Legal & Compliance</p>
        <h1>Website & Service Disclaimer</h1>
        <p class="lead">Important operational disclosures regarding our advisory role, government registries, and legal information.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Independent Advisory Entity</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Statutory Decision Disclosure</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Manjeri, Malappuram, Kerala</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer Content -->
    <section class="section">
      <div class="container">
        <article class="legal-prose" style="max-width: 860px; margin: 0 auto;">
          <div class="advisory-notice" style="margin-top: 0; margin-bottom: 32px;">
            <div class="advisory-notice-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div class="advisory-notice-content">
              <h4>Notice to Visitors</h4>
              <p>Please read this disclaimer before using our website or acting upon any educational content published herein.</p>
            </div>
          </div>

          <h2>1. General Informational Purpose Only</h2>
          <p>The materials, articles, class directories, and FAQs available on this website are prepared solely for general educational and informational purposes. They do not constitute formal legal counsel, tax advice, or certified statutory determinations. Users should obtain tailored professional advice before making commercial or intellectual property commitments.</p>

          <h2>2. Non-Government Entity Notice</h2>
          <p>BRNDNUR Advisory LLP is an independent business advisory and consultancy firm. We are <strong>not</strong> an official department, affiliate, or agency of the Government of India, the Trade Marks Registry (CGPDTM), the Ministry of Corporate Affairs (MCA), the Goods and Services Tax Network (GSTN), or the Food Safety and Standards Authority of India (FSSAI). Official portals for these departments can be accessed directly at their respective government domains (.gov.in / .nic.in).</p>

          <h2>3. No Guarantee of Registration or Outcomes</h2>
          <p>While our advisory team exercises professional diligence in clearance searching, class categorization, and documentation drafting, the final decision to accept, register, reject, or issue examination queries rests entirely with the competent statutory officers. BRNDNUR cannot and does not guarantee that a trademark application, GST registration, MSME filing, or FSSAI application will be approved without objection, opposition, or delay.</p>

          <h2>4. Preliminary Searches Are Not Exhaustive</h2>
          <p>Preliminary brand name and trademark clearance searches conducted via public registry tools are advisory screens. They cannot account for pending unregistered common-law rights, recent filings pending registry database indexing, or subjective adjudications made during examination and opposition proceedings.</p>

          <h2>5. Third-Party Links</h2>
          <p>This website may contain links to third-party or government websites for user convenience. BRNDNUR Advisory LLP does not control, endorse, or accept responsibility for the content, privacy policies, or practices of external websites.</p>

          <h2>6. Contact Details</h2>
          <div class="legal-box" style="margin-top: 24px;">
            <strong>BRNDNUR Advisory LLP</strong><br />
            Manjeri, Malappuram District, Kerala, India &ndash; PIN 676121<br />
            Email: <a href="mailto:brndnuradvisoryllp@gmail.com">brndnuradvisoryllp@gmail.com</a><br />
            Phone / WhatsApp: <a href="tel:+919048188899">+91 90481 88899</a>
          </div>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
