---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "How It Works | BRNDNUR Advisory LLP";
const description = "Understand the BRNDNUR client journey: from initial inquiry and preliminary search to scope confirmation and application tracking.";
const canonical = "https://brndnur.com/how-it-works/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/how-it-works/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">How It Works</span>
        </nav>
        <p class="eyebrow">Our Advisory Process</p>
        <h1>A Clearer Way to Protect and Build.</h1>
        <p class="lead">We believe working with a business advisory should be straightforward, transparent, and completely free of confusing jargon. Here is how we collaborate with you from first contact to execution.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Structured 4-Step Journey</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Trade Marks Registry Guidelines</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Milestone-Driven Tracking</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20the%20process." target="_blank" rel="noopener noreferrer">Start an Inquiry &rarr;</a>
          <a class="btn btn-outline" href="/packages/">View Service Packages</a>
        </div>
      </div>
    </section>

    <!-- 4-Step Journey Section -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">The 4-Step Journey</p>
          <h2>From Consultation to Filing and Protection</h2>
          <p>Every business engagement follows an established sequence designed to safeguard your brand interests and confirm mutual expectations.</p>
        </div>

        <div class="journey-grid">
          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">01</div>
              <span class="journey-step-tag">Discovery</span>
            </div>
            <h3>Share Your Vision</h3>
            <p>Tell us your brand name, proposed business constitution (Sole Proprietor, LLP, or Private Limited), and your specific commercial products or services.</p>
          </div>

          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">02</div>
              <span class="journey-step-tag">Feasibility</span>
            </div>
            <h3>Search & Analysis</h3>
            <p>We perform an indicative preliminary search on the official Trade Marks Registry database, examine conflicting phonetics, and map appropriate NICE classes.</p>
          </div>

          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">03</div>
              <span class="journey-step-tag">Confirmation</span>
            </div>
            <h3>Scope & Authorization</h3>
            <p>We provide a formal written breakdown itemizing applicable government statutory fees versus professional fees. You review and authorize before filing.</p>
          </div>

          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">04</div>
              <span class="journey-step-tag">Filing</span>
            </div>
            <h3>Execution & Tracking</h3>
            <p>We assemble documentation, file the application, provide your official government filing receipt, and keep you updated at each milestone.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Photographic Split Feature: Behind the Scenes -->
    <section class="section section-alt">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/services/assets/process-search.webp" alt="BRNDNUR Trademark research and database verification in progress" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Behind the Scenes</p>
            <h2>How We Research and Prepare Your Application</h2>
            <p>Filing a trademark without deep preliminary due diligence can lead to costly objections under Section 9 (absolute grounds of refusal) or Section 11 (relative grounds based on earlier identical or similar marks).</p>
            <p>Our advisory team conducts multi-layered checks:</p>
            <ul class="check-list">
              <li>
                <div class="check">✓</div>
                <div><strong>Phonetic & Visual Matching:</strong> We check spelling variations, similar pronunciations, and visual similarities across active and pending marks.</div>
              </li>
              <li>
                <div class="check">✓</div>
                <div><strong>Class Specification:</strong> We precisely formulate your description of goods and services to avoid vague classifications that invite registry queries.</div>
              </li>
              <li>
                <div class="check">✓</div>
                <div><strong>User Date Evidence:</strong> If you claim prior commercial usage, we guide you on compiling valid documentary affidavits and invoices.</div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Preparation Checklist with Clean SVGs -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Information to Prepare</p>
          <h2>What You Should Have Ready</h2>
          <p>To ensure our introductory consultation is efficient and tailored, having these basic details at hand is helpful:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
            </div>
            <h3>Brand Representation</h3>
            <p>The exact wordmark spelling, tagline, or high-resolution logo artwork (JPEG/PNG) you wish to protect under trademark law.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3>Applicant & MSME Details</h3>
            <p>Identity and address proof of the applicant, along with an active Udyam MSME certificate if eligible for 50% statutory fee concessions.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3>Commercial Description</h3>
            <p>A concise summary of the goods manufactured, sold, or services provided, including your current date of first commercial use in India if applicable.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Regulatory Timeline Expectations Table -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Realistic Timelines</p>
          <h2>Trademark Processing Stages in India</h2>
          <p>Indian trademark registration follows a multi-stage statutory procedure governed by the Trade Marks Act, 1999.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Stage</th>
                <th>Estimated Duration</th>
                <th>Key Milestone & Deliverable</th>
                <th>Applicant Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>1. Preliminary Search & Class Advice</strong></td>
                <td>24 – 48 Hours</td>
                <td>Conflict report & recommended NICE class list</td>
                <td>Review & approve proposed marks</td>
              </tr>
              <tr>
                <td><strong>2. Application Filing (Form TM-A)</strong></td>
                <td>1 – 2 Working Days</td>
                <td>Official filing receipt & TM application number issued; right to use &trade; symbol</td>
                <td>Sign Form TM-48 (Authorization)</td>
              </tr>
              <tr>
                <td><strong>3. Registry Examination</strong></td>
                <td>1 – 6 Months</td>
                <td>Registry issues Examination Report (Acceptance or Examination Query)</td>
                <td>Review report with advisor</td>
              </tr>
              <tr>
                <td><strong>4. Journal Publication</strong></td>
                <td>4 Months</td>
                <td>Published in the weekly Trade Marks Journal for public review</td>
                <td>Opposition monitoring window</td>
              </tr>
              <tr>
                <td><strong>5. Registration Certificate</strong></td>
                <td>~7 – 12 Months</td>
                <td>Official Certificate of Registration issued; lawful right to use &reg; symbol</td>
                <td>Valid for 10 years; renewable</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="advisory-notice">
          <div class="advisory-notice-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div class="advisory-notice-content">
            <h4>Statutory Timeline Clarification</h4>
            <p>Processing timelines at the Trade Marks Registry (Chennai jurisdiction for Kerala applicants) are managed by the Controller General of Patents, Designs and Trade Marks (CGPDTM). BRNDNUR guarantees prompt filing within 1–2 business days of authorization, while subsequent examination intervals depend entirely on official registry workload.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Ready to Begin?</p>
          <h2>Let’s Discuss the Right Route for Your Brand.</h2>
          <p>Reach out to our advisory team today for an honest, confidential discussion regarding your requirements.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20my%20application." target="_blank" rel="noopener noreferrer">Discuss on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/faqs/">Browse FAQs</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
