---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "How It Works | BRNDNUR Advisory LLP";
const description = "Understand the BRNDNUR client journey: from initial inquiry and preliminary search to scope confirmation and application tracking.";
const canonical = "https://brndnur.in/how-it-works/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/how-it-works/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Our Process</p>
        <h1>A Clearer Way to Move Forward.</h1>
        <p class="lead">We believe working with a business advisory should be straightforward, transparent, and completely free of confusing jargon. Here is how we collaborate with you from first contact to execution.</p>
        <div class="actions">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20the%20process." target="_blank" rel="noopener noreferrer">Start an Inquiry &rarr;</a>
          <a class="btn btn-outline" href="/packages/">View Service Packages</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">The 4-Step Journey</p>
          <h2>From Initial Consultation to Filing Support.</h2>
          <p>Every business engagement follows an established sequence designed to safeguard your brand interests and confirm mutual expectations.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">01</div>
            <h3>Share Your Requirements</h3>
            <p>Tell us your brand name, intended products or services, business constitution (individual, LLP, or private limited), and current operational stage.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">02</div>
            <h3>Review Search & Options</h3>
            <p>For trademarks, we perform an indicative preliminary search on the official database, evaluate potential conflicts, and identify relevant NICE classification classes.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">03</div>
            <h3>Confirm Scope & Fees</h3>
            <p>We provide a formal written breakdown itemizing applicable government statutory fees and professional charges. You review and authorize before proceeding.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">04</div>
            <h3>Filing & Status Updates</h3>
            <p>We assemble documentation, prepare the submission with precision, provide official filing receipts, and track status milestones as your application progresses.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Information to Prepare</p>
          <h2>What You Should Have Ready.</h2>
          <p>To ensure our introductory consultation is efficient and tailored, having these basic details at hand is helpful:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">♙</div>
            <h3>Brand Representation</h3>
            <p>The exact wordmark spelling, tagline, or high-resolution logo artwork you wish to protect under trademark law.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">▤</div>
            <h3>Applicant Details</h3>
            <p>Identity and address proof of the applicant, along with MSME/Udyam certificate if eligible for 50% government fee concessions.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">▥</div>
            <h3>Commercial Description</h3>
            <p>A concise summary of the exact goods sold or services provided, including your current date of first commercial use if applicable.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Ready to Begin?</p>
          <h2>Let’s Discuss the Right Route for Your Brand.</h2>
          <p>Reach out to our advisory team today for an honest, confidential discussion regarding your requirements.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20my%20application." target="_blank" rel="noopener noreferrer">Discuss on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/faqs/">Browse FAQs</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
