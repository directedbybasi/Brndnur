---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "FSSAI Registration & Licensing Support | BRNDNUR Advisory LLP";
const description = "Understand FSSAI food business registration and licensing in India. Guidance on basic registration, state licensing, and compliance with BRNDNUR.";
const canonical = "https://brndnur.com/fssai-registration/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/fssai-registration/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Food Safety Compliance</p>
        <h1>FSSAI Food Business Registration & Licensing.</h1>
        <p class="lead">Under the Food Safety and Standards Act, 2006, every food business operator (FBO)—from home bakers and cloud kitchens to manufacturers, packaged food brands, and distributors—must obtain an FSSAI license or registration prior to commercial operations.</p>
        <div class="actions">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20need%20FSSAI%20registration%20guidance." target="_blank" rel="noopener noreferrer">Request FSSAI Assistance &rarr;</a>
          <a class="btn btn-outline" href="/packages/food-brand/">View Food Brand Package</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">The 3 FSSAI Categories</p>
          <h2>Basic Registration vs. State vs. Central License</h2>
          <p>The appropriate regulatory tier depends directly on your annual turnover and production capacity:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">🏪</div>
            <h3>FSSAI Basic Registration</h3>
            <p>For small-scale food business operators, cloud kitchens, home caterers, and petty retailers with an annual turnover up to ₹12 lakhs.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">🏭</div>
            <h3>FSSAI State License</h3>
            <p>For medium-scale manufacturers, storage units, transporters, and restaurants with an annual turnover between ₹12 lakhs and ₹20 crores.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">🌐</div>
            <h3>FSSAI Central License</h3>
            <p>For large-scale food processors, multi-state chain operators, importers, and businesses with an annual turnover exceeding ₹20 crores.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Launch Compliantly</p>
          <h2>Operating a Food or Beverage Enterprise?</h2>
          <p>We review your premise documents, kitchen declarations, and product categories to file on the official FoSCoS portal.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20help%20with%20FSSAI%20licensing." target="_blank" rel="noopener noreferrer">Consult on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/packages/food-brand/">Explore Food Brand Package</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
