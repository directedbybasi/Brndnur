          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20help%20me%20file%20a%20trademark%20application." target="_blank" rel="noopener noreferrer">Inquire on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/packages/">View Advisory Packages</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
