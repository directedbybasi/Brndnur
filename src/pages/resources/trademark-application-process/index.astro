---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/hero/PageHero.astro';

const title = "Trademark Application Process in India | Guide | BRNDNUR";
const description = "Comprehensive breakdown of the Indian trademark application process: from Form TM-A filing and Vienna codification to examination reports, journal publication, and certificate issuance.";
const canonical = "https://brndnur.com/resources/trademark-application-process/";
import { buildWhatsAppUrl } from '../../../utils/whatsapp';

const closingWhatsAppUrl = buildWhatsAppUrl({
  pageName: "Trademark Application Process Guide",
  sectionName: "Guide Closing CTA",
  enquiryType: "Application Filing Guidance",
  message: "Hi BRNDNUR, I have read your Trademark Application Process Guide and would like assistance preparing and filing Form TM-A with IP India. Could you please explain the application steps, official fees, and timeline?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/resources/trademark-application-process/"
  heroImage="/assets/guide-process-hero.webp"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Procedural Guide"
      title="Trademark Application Process<br>in India: <span>Step-by-Step.</span>"
      hasGoldRule={true}
      description="From initial Form TM-A drafting and Vienna codification to examination reports, Trade Marks Journal publication, and certificate issuance."
      primaryCta={{
        text: "View Our Process",
        href: "/how-it-works/",
        icon: "→"
      }}
      secondaryCta={{
        text: "Back to Resources",
        href: "/resources/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Form TM-A E-Filing", subtitle: "Procedure" },
        { icon: "▱", title: "Vienna Codification", subtitle: "& Formalities" },
        { icon: "⌖", title: "4-Month Journal", subtitle: "Opposition Window" }
      ]}
      image="/assets/guide-process-hero.webp"
      imageAlt="Trademark registration application documents, legal scales, and statutory process workflow"
      imagePosition="right 30%"
      imagePositionMobile="50% 28%"
    />

    <!-- Guide Content -->
    <section class="section">
      <div class="container" style="max-width: 900px;">
        <article class="legal-prose">
          <div class="values" style="margin-bottom: 32px;">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Immediate Right to Use &trade;</strong>
                <p>The moment Form TM-A is submitted on the official IP India portal and the government filing receipt is issued, you gain the lawful right to append the &trade; symbol to your brand name and marketing assets.</p>
              </div>
            </div>
          </div>

          <p class="eyebrow">Procedural Milestones</p>
          <h2>1. Overview of the Statutory Sequence</h2>
          <div class="gold-rule"></div>
          <p>Indian trademark registration is managed by the Controller General of Patents, Designs and Trade Marks (CGPDTM). For applicants based in Kerala, the appropriate jurisdictional branch is the Trade Marks Registry in Chennai.</p>

          <div class="table-wrap">
            <table class="bn-table">
              <thead>
                <tr>
                  <th>Phase</th>
                  <th>Statutory Stage</th>
                  <th>Key Milestone / Document</th>
                  <th>Estimated Interval</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Step 1</strong></td>
                  <td>E-Filing on IP India</td>
                  <td>Form TM-A filed; Application Number issued</td>
                  <td>Day 1</td>
                </tr>
                <tr>
                  <td><strong>Step 2</strong></td>
                  <td>Formalities Check</td>
                  <td>Verification of applicant details, power of attorney, and Vienna code</td>
                  <td>1 to 2 Weeks</td>
                </tr>
                <tr>
                  <td><strong>Step 3</strong></td>
                  <td>Substantive Examination</td>
                  <td>Section 9 &amp; 11 review; Examination Report generated</td>
                  <td>1 to 6 Months</td>
                </tr>
                <tr>
                  <td><strong>Step 4</strong></td>
                  <td>Examination Response</td>
                  <td>Formal legal reply submitted if objections are cited</td>
                  <td>Within 30 Days</td>
                </tr>
                <tr>
                  <td><strong>Step 5</strong></td>
                  <td>Trade Marks Journal</td>
                  <td>Mark published in weekly journal for public opposition</td>
                  <td>4 Months Window</td>
                </tr>
                <tr>
                  <td><strong>Step 6</strong></td>
                  <td>Registration Certificate</td>
                  <td>Official Certificate of Registration issued (&reg; symbol)</td>
                  <td>~7 to 12 Months</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="eyebrow">Statutory Documentation</p>
          <h2>2. Primary Statutory Forms Under Trade Marks Rules</h2>
          <div class="gold-rule"></div>
          <ul>
            <li><strong>Form TM-A:</strong> The foundational application form used to register any wordmark, logo, or collective mark.</li>
            <li><strong>Form TM-48:</strong> The statutory Power of Attorney authorizing an advocate or trademark agent to act on behalf of the applicant.</li>
            <li><strong>Form TM-M:</strong> Used for procedural corrections, extension requests, or filing responses to examination reports.</li>
            <li><strong>Form TM-O:</strong> Formal notice of opposition filed by a third party during the 4-month Journal window.</li>
            <li><strong>Form TM-R:</strong> Application for renewal of a registered trademark (filed every 10 years).</li>
          </ul>

          <p class="eyebrow">Examination &amp; Responses</p>
          <h2>3. What Happens During Registry Examination?</h2>
          <div class="gold-rule"></div>
          <p>The Registry Examiner analyzes whether the application complies with the Trade Marks Act, 1999:</p>
          <ul>
            <li><strong>Accepted:</strong> If the mark is distinctive and lacks conflicting prior marks, it is accepted and directly forwarded for Journal publication.</li>
            <li><strong>Objected:</strong> The Examiner issues an Examination Report citing objections under Section 9 (lack of distinctiveness/descriptiveness) or Section 11 (conflict with existing marks). The applicant must file a formal written response within 30 days.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Ready to Protect Your Brand?</p>
          <h2>Let BRNDNUR Manage<br>Your Trademark Filing.</h2>
          <p>We assemble documentation, draft Form TM-A, and track your application milestones with complete transparency.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">File via WhatsApp <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Form TM-A Drafting</strong>
              <p>Precise goods specifications avoiding unnecessary registry objections.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Examination Tracking</strong>
              <p>Continuous surveillance of office actions and examiner reports.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Direct E-Receipt</strong>
              <p>Official government receipt delivered immediately upon submission.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
