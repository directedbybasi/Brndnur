---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Intellectual Property & Brand Protection Guides | BRNDNUR Resources";
const description = "Educational guides on trademark registration, Nice classification, brand name clearance searches, and official application lifecycles from BRNDNUR Advisory LLP.";
const canonical = "https://brndnur.in/resources/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/resources/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Knowledge Center</p>
        <h1>Intellectual Property & Compliance Guides for Founders.</h1>
        <p class="lead">Clear, verified explanations on trademark protection, classification principles, brand clearance searches, and statutory registration procedures under Indian law.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/trademark-registration/">Trademark Services &rarr;</a>
          <a class="btn btn-outline" href="/contact/">Consult an Advisor</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Featured Educational Guides</p>
          <h2>Essential Brand Protection Knowledge</h2>
          <p>Explore practical, plain-English overviews written to help entrepreneurs make informed decisions about their intangible assets.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">📖</div>
            <h3>Trademark Registration Guide</h3>
            <p>A comprehensive overview of what trademark protection entails in India, document prerequisites, search basics, examination processes, and post-registration maintenance.</p>
            <a class="card-link" href="/resources/trademark-registration-guide/">Read the Guide &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon">🏷️</div>
            <h3>Trademark Class Guide</h3>
            <p>Understand the Nice Classification system (Classes 1 to 45). Learn the difference between goods and services, how to select your core class, and how to avoid costly misclassification.</p>
            <a class="card-link" href="/resources/trademark-class-guide/">Read the Guide &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon">🔍</div>
            <h3>Brand Name Search Guide</h3>
            <p>Why a preliminary search matters before you invest in branding. Understand phonetic similarity, visual conflicts, well-known mark conflicts, and the limits of public portal queries.</p>
            <a class="card-link" href="/resources/brand-name-search-guide/">Read the Guide &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon">📋</div>
            <h3>Trademark Application Process</h3>
            <p>Step-by-step breakdown of the official journey: Form TM-A drafting, Vienna codification, formalities checks, examination reports, journal publication, and certificate issuance.</p>
            <a class="card-link" href="/resources/trademark-application-process/">Read the Guide &rarr;</a>
          </div>
        </div>

        <div class="legal-box" style="margin-top: 48px;">
          <strong>Educational Notice:</strong> The articles in this knowledge center provide general procedural information regarding trademark and commercial registration in India. They do not constitute formal legal opinions or binding guarantees of registration. For specific matters, consult our advisory team or qualified legal counsel.
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Ready to Protect Your Brand?</p>
          <h2>Turn Knowledge into Brand Protection.</h2>
          <p>Get professional assistance with comprehensive brand clearance searches, class selection, and filing support across India.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20have%20a%20question%20about%20trademark%20registration." target="_blank" rel="noopener noreferrer">Inquire on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/services/">Explore All Services</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
