---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import { getAllArticles, type ArticleData } from '../../utils/blog';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const articles = getAllArticles();
const districts = ['All', ...new Set(articles.map(a => a.district).filter(Boolean))];

const isDevOrPreview = !import.meta.env.PROD || !!process.env.ENABLE_EDITORIAL_PREVIEWS;
const getArticleUrl = (art: ArticleData) => {
  if (art.published) return `/resources/${art.slug}/`;
  return isDevOrPreview ? `/resources/preview/${art.slug}/` : `/resources/${art.slug}/`;
};

function getArticleImage(art: ArticleData): string {
  const text = (art.title + ' ' + (art.category || '') + ' ' + art.metaDescription).toLowerCase();
  if (text.includes('fssai') || text.includes('food') || text.includes('bakery') || text.includes('spice') || text.includes('coffee') || text.includes('seafood') || text.includes('restaurant') || text.includes('tea') || text.includes('produce') || text.includes('honey')) {
    return '/assets/fssai-packaging-standards.webp';
  }
  if (text.includes('gst') || text.includes('tax') || text.includes('trader') || text.includes('retail')) {
    return '/assets/gst-tax-credibility.webp';
  }
  if (text.includes('udyam') || text.includes('msme') || text.includes('manufactur') || text.includes('small business') || text.includes('workshop')) {
    return '/assets/udyam-growth-catalyst.webp';
  }
  if (text.includes('class') || text.includes('nice classification')) {
    return '/assets/resources-card-classes-169.webp';
  }
  if (text.includes('search') || text.includes('clearance') || text.includes('availability') || text.includes('preliminary')) {
    return '/assets/resources-card-search-169.webp';
  }
  if (text.includes('renewal') || text.includes('monitor') || text.includes('watch') || text.includes('maintenance')) {
    return '/assets/renewal-ownership-maintenance.webp';
  }
  if (text.includes('logo') || text.includes('packaging') || text.includes('device mark')) {
    return '/assets/logo-packaging-protection.webp';
  }
  if (text.includes('startup') || text.includes('setup') || text.includes('checklist') || text.includes('founder') || text.includes('gulf')) {
    return '/assets/setup-startup-readiness.webp';
  }
  return '/assets/resources-card-tm-169.webp';
}

function getArticleCategory(art: ArticleData): string {
  if (art.category) return art.category;
  const t = (art.title + ' ' + art.metaDescription).toLowerCase();
  if (t.includes('food') || t.includes('fssai') || t.includes('bakery') || t.includes('spice') || t.includes('coffee') || t.includes('seafood') || t.includes('restaurant') || t.includes('kitchen') || t.includes('tea') || t.includes('honey')) return 'FSSAI & Food Trademarks';
  if (t.includes('gst') || t.includes('tax') || t.includes('trader')) return 'GST & Tax Registration';
  if (t.includes('udyam') || t.includes('msme') || t.includes('manufactur') || t.includes('small business')) return 'Udyam & MSME';
  if (t.includes('search') || t.includes('availability') || t.includes('clearance')) return 'Brand Clearance Search';
  if (t.includes('renewal') || t.includes('monitor') || t.includes('watch') || t.includes('maintenance')) return 'Trademark Maintenance';
  if (t.includes('logo') || t.includes('device mark') || t.includes('packaging')) return 'Logo & Packaging';
  if (t.includes('startup') || t.includes('setup') || t.includes('checklist') || t.includes('founder') || t.includes('gulf')) return 'Business Setup';
  if (t.includes('class') || t.includes('classification')) return 'Trademark Classes';
  return 'Statutory IP Guidance';
}

const title = "Intellectual Property & Brand Protection Guides | BRNDNUR Resources";
const description = "Educational guides on trademark registration, Nice classification, brand name clearance searches, and official application lifecycles from BRNDNUR Advisory LLP.";
const canonical = "https://brndnur.com/resources/";

const resourcesClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Resources Hub',
  sectionName: 'Closing CTA Band',
  enquiryType: 'Knowledge Center Advisory',
  topic: 'I have been browsing your intellectual property and compliance guides and would like advice on my specific business requirement.',
  details: 'Topic of interest: [e.g. Trademark Search, Class Mapping, TM-A Filing]',
  callToAction: 'Could you please guide me on how to proceed?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/resources/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Knowledge Center"
      title='Intellectual Property<br class="hero-br">&amp;&nbsp;Compliance <span>Guides.</span>'
      hasGoldRule={true}
      description="Clear, verified explanations on trademark protection, classification principles, brand clearance searches, and statutory registration procedures under Indian law."
      primaryCta={{
        text: "Trademark Services",
        href: "/trademark-registration/",
        icon: "→"
      }}
      secondaryCta={{
        text: "Consult an Advisor",
        href: "/contact/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Trade Marks Act", subtitle: "1999 Knowledge" },
        { icon: "▱", title: "NICE Classification", subtitle: "Guides" },
        { icon: "⌖", title: "Statutory Verification", subtitle: "& Walkthroughs" }
      ]}
      image="/assets/resources-hero-knowledge.webp"
      imageAlt="Indian intellectual property law library and statutory resources"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/assets/resources-support-clarity.webp" alt="Trademark registration folio and statutory guidance reference" width="1000" height="1500" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Statutory Literacy</p>
          <h2>Empowering Indian Founders with Legal Clarity.</h2>
          <div class="gold-rule"></div>
          <p class="statutory-lead">Your registered trademark is often the single most valuable capital asset on your enterprise balance sheet. Our practical guides demystify Indian trademark law, classification, and statutory timelines—giving founders clear, actionable insight before launching or expanding.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Authoritative Indian Law Commentary</strong>
                <p>Every guide is anchored in the Trade Marks Act, 1999, Trade Marks Rules, 2017, and manual guidelines.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Founder-Centric Practicality</strong>
                <p>No unnecessary legalese—just direct, actionable knowledge on costs, classifications, and risks.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Strategic IP Asset Creation</strong>
                <p>Helping you build durable brand monopolies that support commercial growth and investor confidence.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Featured Guides (Authentic Service Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Featured Guides</p>
          <h2>Essential Brand Protection Knowledge.</h2>
          <div class="gold-rule"></div>
          <p>Explore practical, plain-English overviews written to help entrepreneurs make informed decisions about their intangible assets.</p>
        </div>

        <CardCarousel id="resources-featured-carousel" ariaLabel="Essential Brand Protection Knowledge">
          <article class="service-card">
            <img src="/assets/resources-card-tm.webp" alt="Trademark Registration Guide" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Trademark Registration Guide</h3>
              <p>A comprehensive overview of what trademark protection entails in India, document prerequisites, search basics, examination processes, and post-registration maintenance.</p>
              <a class="text-link" href="/resources/trademark-registration-guide/">Read the Guide <span>→</span></a>
            </div>
          </article>

          <article class="service-card">
            <img src="/assets/resources-card-classes.webp" alt="Trademark Class Guide" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Trademark Class Guide</h3>
              <p>Understand the Nice Classification system (Classes 1 to 45). Learn the difference between goods and services, how to select your core class, and how to avoid costly misclassification.</p>
              <a class="text-link" href="/resources/trademark-class-guide/">Read the Guide <span>→</span></a>
            </div>
          </article>

          <article class="service-card">
            <img src="/assets/resources-card-search.webp" alt="Brand Name Search Guide" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Brand Name Search Guide</h3>
              <p>Why a preliminary search matters before you invest in branding. Understand phonetic similarity, visual conflicts, well-known mark conflicts, and the limits of public portal queries.</p>
              <a class="text-link" href="/resources/brand-name-search-guide/">Read the Guide <span>→</span></a>
            </div>
          </article>

          <article class="service-card">
            <img src="/assets/resources-card-process.webp" alt="Trademark Application Process" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Trademark Application Process</h3>
              <p>Step-by-step breakdown of the official journey: Form TM-A drafting, Vienna codification, formalities checks, examination reports, journal publication, and certificate issuance.</p>
              <a class="text-link" href="/resources/trademark-application-process/">Read the Guide <span>→</span></a>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Kerala Regional Location Guides Directory -->
    <section class="section" id="kerala-guides">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">District Knowledge Base</p>
          <h2>Kerala Regional Location Guides &amp; Advisory.</h2>
          <div class="gold-rule"></div>
          <p>Practical, location-specific guidance on trademark registration, FSSAI licensing, GST, and MSME compliance for founders across Kerala's 14 commercial districts.</p>
        </div>

        <!-- Search & District Filter Controls -->
        <div class="search-filter-wrap">
          <div class="search-input-box">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="guide-search-input"
              class="guide-search-input"
              placeholder="Search articles by title, district, or keyword..."
              aria-label="Search articles by title, district, or keyword"
            />
            <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Clear search query" style="display: none;">&times;</button>
          </div>
        </div>

        <!-- District Filter Bar -->
        <div class="district-filter-wrap">
          <div class="district-filter-bar" role="tablist" aria-label="Filter guides by district">
            {districts.map((dist, idx) => (
              <button
                type="button"
                class={`filter-chip ${idx === 0 ? 'active' : ''}`}
                data-district={dist}
              >
                {dist === 'All' ? `All Articles (${articles.length})` : dist}
              </button>
            ))}
          </div>
        </div>

        <div class="kerala-directory-grid" id="kerala-directory-grid">
          {articles.map((art, idx) => {
            const articleUrl = getArticleUrl(art);
            const category = getArticleCategory(art);
            const coverImage = getArticleImage(art);
            const readTimeMin = Math.ceil((art.wordCount || 1000) / 200);

            return (
              <article
                class={`kerala-guide-card editorial-article-card ${idx >= 12 ? 'is-hidden' : ''}`}
                data-district={art.district}
                data-title={art.title.toLowerCase()}
                data-desc={art.metaDescription.toLowerCase()}
                style={idx >= 12 ? "display: none;" : ""}
              >
                <!-- Landscape Image Thumbnail with Category Badge & Overlay -->
                <a href={articleUrl} class="card-thumb-link" aria-label={art.title} tabindex="-1">
                  <div class="card-thumb-wrap">
                    <img
                      src={coverImage}
                      alt={art.imageConcept?.altText || `${art.title} - BRNDNUR Advisory Guide`}
                      width="640"
                      height="360"
                      loading={idx < 6 ? "eager" : "lazy"}
                      decoding="async"
                      class="card-thumb-image"
                    />
                    <div class="card-thumb-gradient" aria-hidden="true"></div>
                    <span class="card-category-badge">
                      <span class="badge-accent-dot" aria-hidden="true"></span>
                      <span>{category}</span>
                    </span>
                  </div>
                </a>

                <!-- Card Body Content -->
                <div class="card-body-content">
                  <div class="card-district-row">
                    <span class="district-badge">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      <span>{art.district}</span>
                    </span>
                    <span class="statutory-id">ID: {art.id}</span>
                  </div>

                  <h3 class="card-editorial-heading">
                    <a href={articleUrl} class="title-link">
                      {art.title}
                    </a>
                  </h3>

                  <p class="card-editorial-excerpt">
                    {art.metaDescription}
                  </p>

                  <div class="card-metadata-footer">
                    <div class="meta-author-row">
                      <div class="author-identity">
                        <div class="author-monogram-avatar" aria-hidden="true">
                          <span>B</span>
                        </div>
                        <div class="author-info">
                          <span class="author-name">BRNDNUR Advisory Desk</span>
                          <span class="author-subtext">Statutory Advisory</span>
                        </div>
                      </div>
                      <div class="reading-time-badge" title={`Estimated reading duration: ${readTimeMin} minutes`}>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                        <span>{readTimeMin} min read</span>
                      </div>
                    </div>

                    <div class="meta-action-row">
                      <span class="statutory-pill">Kerala Statutory Guide</span>
                      <a href={articleUrl} class="card-read-action" aria-label={`Read advisory on ${art.title}`}>
                        <span>Read Advisory</span>
                        <span class="action-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}


          <!-- Empty search results placeholder -->
          <div class="no-guides-found" id="no-guides-found" style="display: none;">
            <div class="no-guides-icon" aria-hidden="true">🔍</div>
            <h3>No articles match your search</h3>
            <p>Try searching with another keyword or select a different commercial district.</p>
            <button type="button" class="btn btn-secondary" id="reset-filters-btn">
              <span>Reset All Filters</span>
            </button>
          </div>
        </div>

        <!-- Load More In Batches of 12 Control -->
        <div class="load-more-wrap" id="load-more-wrap" aria-live="polite">
          <button
            type="button"
            class="view-more-btn"
            id="load-more-btn"
            aria-label={`View More Articles (${Math.max(0, articles.length - 12)} remaining)`}
            style={articles.length <= 12 ? "display: none;" : "display: inline-flex;"}
          >
            <span id="view-more-text">View More Articles ({Math.max(0, articles.length - 12)} remaining) ↓</span>
          </button>
          <p class="load-more-status" id="load-more-status">
            Showing <span class="status-pill" id="visible-count">{Math.min(12, articles.length)}</span> of <span class="status-pill" id="total-count">{articles.length}</span> Articles
          </p>
        </div>
      </div>
    </section>

    <script is:inline>
      (function() {
        const BATCH_SIZE = 12;
        let visibleBatch = BATCH_SIZE;
        let currentDistrict = 'All';
        let searchQuery = '';

        const chips = document.querySelectorAll('.filter-chip');
        const cards = Array.from(document.querySelectorAll('.kerala-guide-card'));
        const searchInput = document.getElementById('guide-search-input');
        const searchClearBtn = document.getElementById('search-clear-btn');
        const viewMoreBtn = document.getElementById('load-more-btn');
        const viewMoreText = document.getElementById('view-more-text');
        const visibleCountEl = document.getElementById('visible-count');
        const totalCountEl = document.getElementById('total-count');
        const noResultsEl = document.getElementById('no-guides-found');
        const resetFiltersBtn = document.getElementById('reset-filters-btn');

        function getMatchingCards() {
          return cards.filter(card => {
            // 1. District Match
            const cardDist = card.getAttribute('data-district') || '';
            const matchesDistrict = (currentDistrict === 'All') || (cardDist === currentDistrict);
            if (!matchesDistrict) return false;

            // 2. Search Query Match
            if (searchQuery) {
              const title = card.getAttribute('data-title') || '';
              const desc = card.getAttribute('data-desc') || '';
              const dist = cardDist.toLowerCase();
              if (!title.includes(searchQuery) && !desc.includes(searchQuery) && !dist.includes(searchQuery)) {
                return false;
              }
            }

            return true;
          });
        }

        function render() {
          const matching = getMatchingCards();
          const totalMatching = matching.length;
          const countToShow = Math.min(visibleBatch, totalMatching);
          const remaining = Math.max(0, totalMatching - countToShow);

          const matchingSet = new Set(matching);

          // Hide cards not matching
          cards.forEach(card => {
            if (!matchingSet.has(card)) {
              card.style.display = 'none';
              card.classList.add('is-hidden');
            }
          });

          // Show visible matching cards
          matching.forEach((card, idx) => {
            if (idx < countToShow) {
              card.style.display = 'flex';
              card.classList.remove('is-hidden');
            } else {
              card.style.display = 'none';
              card.classList.add('is-hidden');
            }
          });

          // Update count badges
          if (visibleCountEl) visibleCountEl.textContent = countToShow;
          if (totalCountEl) totalCountEl.textContent = totalMatching;

          // Toggle empty state
          if (noResultsEl) {
            noResultsEl.style.display = totalMatching === 0 ? 'block' : 'none';
          }

          // Toggle and update View More Articles button
          if (viewMoreBtn) {
            if (remaining > 0) {
              viewMoreBtn.style.setProperty('display', 'inline-flex');
              viewMoreBtn.classList.remove('is-hidden');
              const textContent = `View More Articles (${remaining} remaining) ↓`;
              if (viewMoreText) {
                viewMoreText.textContent = textContent;
              } else {
                viewMoreBtn.textContent = textContent;
              }
              viewMoreBtn.setAttribute('aria-label', `View More Articles, ${remaining} remaining`);
            } else {
              viewMoreBtn.style.setProperty('display', 'none');
              viewMoreBtn.classList.add('is-hidden');
            }
          }

          const statusEl = document.getElementById('load-more-status');
          if (statusEl) {
            statusEl.style.display = totalMatching === 0 ? 'none' : 'flex';
          }
        }

        // 1. District Chip Filtering
        chips.forEach(chip => {
          chip.addEventListener('click', () => {
            chips.forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            currentDistrict = chip.getAttribute('data-district') || 'All';
            visibleBatch = BATCH_SIZE; // Reset to 12
            render();
          });
        });

        // 2. Search Input Filtering (Debounced)
        if (searchInput) {
          let debounceTimer;
          searchInput.addEventListener('input', (e) => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
              searchQuery = e.target.value.trim().toLowerCase();
              if (searchClearBtn) {
                searchClearBtn.style.display = searchQuery ? 'block' : 'none';
              }
              visibleBatch = BATCH_SIZE; // Reset to 12
              render();
            }, 80);
          });
        }

        // Clear search input button
        if (searchClearBtn) {
          searchClearBtn.addEventListener('click', () => {
            if (searchInput) {
              searchInput.value = '';
              searchQuery = '';
              searchClearBtn.style.display = 'none';
              visibleBatch = BATCH_SIZE; // Reset to 12
              render();
              searchInput.focus();
            }
          });
        }

        // Reset filters button in empty results card
        if (resetFiltersBtn) {
          resetFiltersBtn.addEventListener('click', () => {
            if (searchInput) {
              searchInput.value = '';
              searchQuery = '';
              if (searchClearBtn) searchClearBtn.style.display = 'none';
            }
            chips.forEach(c => c.classList.remove('active'));
            const allChip = document.querySelector('.filter-chip[data-district="All"]');
            if (allChip) allChip.classList.add('active');
            currentDistrict = 'All';
            visibleBatch = BATCH_SIZE; // Reset to 12
            render();
          });
        }

        // 3. View More Articles Button Click
        if (viewMoreBtn) {
          viewMoreBtn.addEventListener('click', () => {
            visibleBatch += BATCH_SIZE;
            render();
          });
        }

        // Initialize state
        render();
      })();
    </script>

<style>
  /* Search Filter Controls */
  .search-filter-wrap {
    max-width: 540px;
    margin: 24px auto 8px;
    padding: 0 16px;
  }
  .search-input-box {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid #DDCFB8;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(19, 35, 58, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-input-box:focus-within {
    border-color: #A8781A;
    box-shadow: 0 4px 14px rgba(168, 120, 26, 0.12);
  }
  .search-icon {
    position: absolute;
    left: 14px;
    color: #7A8699;
    pointer-events: none;
  }
  .guide-search-input {
    width: 100%;
    padding: 12px 42px 12px 42px;
    border: none;
    background: transparent;
    font-family: var(--sans, 'DM Sans', sans-serif);
    font-size: 14.5px;
    color: #13233A;
    outline: none;
  }
  .guide-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .guide-search-input::placeholder {
    color: #8C96A5;
  }
  .search-clear-btn {
    position: absolute;
    right: 12px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(19, 35, 58, 0.08);
    border: none;
    border-radius: 50%;
    font-size: 16px;
    color: #566174;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .search-clear-btn:hover {
    background: #13233A;
    color: #ffffff;
  }

  .district-filter-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 20px 0 32px;
    padding-bottom: 6px;
  }
  .district-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .district-filter-bar {
      flex-wrap: nowrap;
      justify-content: flex-start;
      width: max-content;
      padding: 0 4px;
    }
  }
  .filter-chip {
    background: rgba(19, 35, 58, 0.04);
    border: 1px solid #DDCFB8;
    color: #13233A;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 100px;
    cursor: pointer;
    white-space: nowrap;
    transition: all .18s ease;
  }
  .filter-chip:hover {
    background: #F0E2C8;
    border-color: #A8781A;
    color: #13233A;
  }
  .filter-chip.active {
    background: #13233A;
    color: #ffffff;
    border-color: #13233A;
    box-shadow: 0 2px 8px rgba(19, 35, 58, 0.15);
  }
  .kerala-directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
    align-items: stretch;
