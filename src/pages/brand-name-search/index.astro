---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import FaqItem from '../../components/FaqItem.astro';

const title = "Brand Name Search in India | Trademark Check | BRNDNUR";
const description = "Conduct a preliminary brand name search on the Indian trademark database before filing. Identify phonetic, visual, and conceptual similarities with BRNDNUR.";
const canonical = "https://brndnur.com/brand-name-search/";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  pageName: "Brand Name Search",
  sectionName: "Hero Section",
  enquiryType: "Preliminary Trademark Search",
  message: "Hi BRNDNUR, I would like to check whether my proposed business name may conflict with existing trademarks. Please guide me on the name-search process, the information you need, and the available options before I proceed with registration."
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  pageName: "Brand Name Search",
  sectionName: "Closing CTA Band",
  enquiryType: "Brand Name Clearance Check",
  message: "Hi BRNDNUR, I would like to request a complimentary preliminary trademark clearance check for my brand. Could you please verify name availability across relevant classes on IP India and guide me on the next steps?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/brand-name-search/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Pre-Filing Trademark Clearance"
      title="Check Your Brand Name<br>Before You <span>Move Forward.</span>"
      hasGoldRule={true}
      description="A preliminary trademark search is the most critical first step before launching a brand or investing in packaging, signage, and marketing. We inspect the official Indian IP database to identify potentially conflicting marks."
      primaryCta={{
        text: "Request a Preliminary Search",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Understand Classes",
        href: "/trademark-classes/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Official IP India", subtitle: "Database Check" },
        { icon: "▱", title: "Section 9 & 11", subtitle: "Risk Screening" },
        { icon: "⌖", title: "Phonetic & Class", subtitle: "Analysis" }
      ]}
      image="/assets/search-hero-preclearance.webp"
      imageAlt="Laptop, notebook, and stationery arranged for preliminary brand name research"
    />

    <!-- Split Section: Why Clearance Matters (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/assets/search-why-clearance.webp" alt="BRNDNUR trademark search and database clearance in Kerala" width="1200" height="900" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Strategic Due Diligence</p>
          <h2>Why Pre-Filing Clearance Protects Your Capital.</h2>
          <p class="clearance-lead">Investing in branding, packaging, and domains without clearance risks costly objections or infringement notices. A preliminary check verifies name availability across your class before committing non-refundable government fees.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Section 9 Absolute Grounds</strong>
                <p>Ensuring your mark is sufficiently distinctive and not purely descriptive of your products or services.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Section 11 Relative Grounds</strong>
                <p>Verifying there are no identical or deceptively similar marks already on register in the same or allied classes.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Objective Viability Appraisal</strong>
                <p>Honest risk classification so you know if your mark is low, medium, or high risk before filing Form TM-A.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Search Dimensions (Editorial Cards) -->
    <section class="section section-search-dimensions">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Search Depth</p>
          <h2>What a Comprehensive Search Examines.</h2>
          <div class="gold-rule"></div>
          <p>A basic word search is rarely sufficient. Trade mark examiners evaluate marks across multiple dimensions under Section 11 of the Trade Marks Act, 1999.</p>
        </div>

        <div class="search-dimensions-grid">
          <article class="service-card search-dimension-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Phonetic Similarity</h3>
            </div>
          </article>

          <article class="service-card search-dimension-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>Visual &amp; Graphic Resemblance</h3>
            </div>
          </article>

          <article class="service-card search-dimension-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>Conceptual Similarity</h3>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Search FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Search FAQs</p>
          <h2>Questions About Name Clearance.</h2>
          <div class="gold-rule"></div>
          <p>Important legal realities regarding registry searches and brand clearance in India.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Does a clear search result guarantee that my trademark will be accepted?"
            answer="No ethical advisory firm can guarantee registration. A preliminary search checks for existing identical or similar marks on the public registry. However, the Registrar of Trade Marks conducts an independent examination and may raise queries regarding distinctiveness (Section 9) or newly filed applications."
          />
          <FaqItem
            num="02"
            question="Why is a simple Google search not sufficient for trademark clearance?"
            answer="A Google search only shows active commercial websites, not registered or pending trademarks on the official Indian Trade Marks Registry. Many businesses own registered marks that have not yet launched websites, or hold defensive registrations in specific classes that will block your application."
          />
          <FaqItem
            num="03"
            question="What is phonetic similarity under Section 11?"
            answer="Section 11 of the Trade Marks Act prohibits marks that sound identical or confusingly similar when spoken aloud, even if spelled differently (e.g., &quot;Kool&quot; vs &quot;Cool&quot;, or &quot;Phast&quot; vs &quot;Fast&quot;). Our search examines phonetic match algorithms to detect these potential conflicts."
          />
          <FaqItem
            num="04"
            question="How quickly can BRNDNUR complete a preliminary search?"
            answer="Preliminary search reviews are typically completed within 24 to 48 hours once we have your exact brand name and product/service description. We deliver an objective written summary and discuss practical next steps."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Start Early</p>
          <h2>Have a Brand Name<br>in Mind?</h2>
          <p>Share your proposed mark and product category. We will conduct an initial check on the IP India registry and provide an objective appraisal.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Check Your Name on WhatsApp <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Quick Turnaround</strong>
              <p>Preliminary search results delivered promptly.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Confidential Inquiries</strong>
              <p>Your proposed brand names remain strictly private.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Practical Guidance</strong>
              <p>Clear guidance on registration viability and next steps.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

<style>
  .clearance-lead {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--body);
    margin: 14px 0 20px;
    max-width: 580px;
  }

  /* Search Dimensions Navy Blue Section */
  .section-search-dimensions {
    background-color: #13233A !important;
    color: #F4EFE4 !important;
    padding: clamp(60px, 6vw, 84px) 0 !important;
    border-block: 1px solid rgba(255, 255, 255, 0.08);
  }
  .section-search-dimensions .section-heading .eyebrow {
    color: #D4A647 !important;
  }
  .section-search-dimensions .section-heading h2 {
    color: #F4EFE4 !important;
  }
  .section-search-dimensions .section-heading .gold-rule {
    background: #D4A647 !important;
  }
  .section-search-dimensions .section-heading p {
    color: #D9DFE8 !important;
  }

  .search-dimensions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .search-dimension-card {
    background: #1C2D46 !important;
    border: 1px solid #3A4B61 !important;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25) !important;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .search-dimension-card:hover {
    transform: translateY(-3px) !important;
    border-color: #A8781A !important;
    box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.45) !important;
  }
  .search-dimension-card .service-body {
    padding: clamp(1.4rem, 2vw, 1.75rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .search-dimension-card .step-num {
    margin-bottom: 14px;
    background: rgba(168, 120, 26, 0.22) !important;
    color: #D4A647 !important;
    border: 1.5px solid rgba(212, 166, 71, 0.45) !important;
  }
  .search-dimension-card h3 {
    margin: 0;
    font-family: var(--sans);
    font-size: clamp(1.15rem, 1.4vw, 1.3rem);
    font-weight: 600;
    line-height: 1.35;
    color: #F4EFE4 !important;
  }
  @media (max-width: 860px) {
    .search-dimensions-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>

</BaseLayout>
