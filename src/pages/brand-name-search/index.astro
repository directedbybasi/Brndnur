---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import FaqItem from '../../components/FaqItem.astro';

const title = "Brand Name Search in India | Trademark Check | BRNDNUR";
const description = "Conduct a preliminary brand name search on the Indian trademark database before filing. Identify phonetic, visual, and conceptual similarities with BRNDNUR.";
const canonical = "https://brndnur.com/brand-name-search/";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Brand Name Search",
  "sectionName": "Hero Section",
  "enquiryType": "Preliminary Trademark Search",
  "topic": "I would like assistance with a preliminary trademark search for my proposed brand name.",
  "details": "Proposed brand name: [Please enter your brand name]",
  "callToAction": "Could you please guide me on the availability assessment and next steps?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Brand Name Search",
  "sectionName": "Closing CTA Band",
  "enquiryType": "Brand Name Clearance Check",
  "topic": "I have a proposed brand name in mind and would like to request an initial clearance check on the IP India registry.",
  "details": "Proposed mark: [Please enter mark]\\nProduct / service category: [Please describe category]",
  "callToAction": "Could you please conduct a preliminary check and advise on registration prospects?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/brand-name-search/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Pre-Filing Trademark Clearance"
      title="Check Your Brand Name<br>Before You <span>Move Forward.</span>"
      hasGoldRule={true}
      description="A preliminary trademark search is the most critical first step before launching a brand or investing in packaging, signage, and marketing. We inspect the official Indian IP database to identify potentially conflicting marks."
      primaryCta={{
        text: "Request a Preliminary Search",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Understand Classes",
        href: "/trademark-classes/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Official IP India", subtitle: "Database Check" },
        { icon: "▱", title: "Section 9 & 11", subtitle: "Risk Screening" },
        { icon: "⌖", title: "Phonetic & Class", subtitle: "Analysis" }
      ]}
      image="/assets/search-hero-preclearance.webp"
      imageAlt="Laptop, notebook, and stationery arranged for preliminary brand name research"
    />

    <!-- Split Section: Why Clearance Matters (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/assets/search-why-clearance.webp" alt="BRNDNUR trademark search and database clearance in Kerala" width="1200" height="900" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Strategic Due Diligence</p>
          <h2>Why Pre-Filing Clearance Protects Your Capital.</h2>
          <div class="gold-rule"></div>
          <p>Every year, hundreds of Indian business owners invest heavily in branding, product packaging, domain registrations, and signage—only to receive an objection or an infringement cease-and-desist letter within months.</p>
          <p>Under the Trade Marks Act, 1999, prior adoption and registration grant senior rights. A preliminary clearance check verifies whether similar names exist in your intended classification before you commit non-refundable statutory government fees.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Section 9 Absolute Grounds</strong>
                <p>Ensuring your mark is sufficiently distinctive and not purely descriptive of your products or services.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Section 11 Relative Grounds</strong>
                <p>Verifying there are no identical or deceptively similar marks already on register in the same or allied classes.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Objective Viability Appraisal</strong>
                <p>Honest risk classification so you know if your mark is low, medium, or high risk before filing Form TM-A.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Search Dimensions (Editorial Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Search Depth</p>
          <h2>What a Comprehensive Search Examines.</h2>
          <div class="gold-rule"></div>
          <p>A basic word search is rarely sufficient. Trade mark examiners evaluate marks across multiple dimensions under Section 11 of the Trade Marks Act, 1999.</p>
        </div>

        <CardCarousel id="search-depth-carousel" ariaLabel="Search depth dimensions">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Phonetic Similarity</h3>
              <p>Marks that sound identical or confusingly similar when spoken aloud (e.g., 'Kool' vs 'Cool') face immediate objections even if spelling differs substantially.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>Visual &amp; Graphic Resemblance</h3>
              <p>Evaluating visual styling, typography, logo layout, and device mark elements to prevent conflicts with prior graphical trademark filings.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>Conceptual Similarity</h3>
              <p>Marks conveying synonymous meaning or identical commercial impressions, even in different languages or dialects within Indian commerce.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">04</div>
              <h3>Cross-Class Relevance</h3>
              <p>Checking allied and complementary goods and services classes (such as Class 29 and Class 30 for foods, or Class 25 and Class 35 for apparel and retail).</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Clearance Tiers Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Clearance Methodology</p>
          <h2>Our Multi-Tier Verification Process.</h2>
          <div class="gold-rule"></div>
          <p>We review official registry records to provide actionable recommendations before application drafting.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Verification Level</th>
                <th>Search Scope</th>
                <th>Key Criteria Checked</th>
                <th>Strategic Outcome</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Tier 1: Direct Identity Search</strong></td>
                <td>Exact text in target class</td>
                <td>Exact spelling matches and active registrations</td>
                <td>Identifies direct roadblocks immediately</td>
              </tr>
              <tr>
                <td><strong>Tier 2: Phonetic &amp; Prefix Check</strong></td>
                <td>Sounds-alike &amp; variant spellings</td>
                <td>Phonetic algorithms, truncated stems, and compound words</td>
                <td>Uncovers hidden phonetic conflicts</td>
              </tr>
              <tr>
                <td><strong>Tier 3: Cross-Class &amp; Well-Known Marks</strong></td>
                <td>Allied goods &amp; services classes</td>
                <td>Co-related classes (e.g. Class 29 &amp; 30, Class 35 &amp; 25) + list of Well-Known marks</td>
                <td>Prevents infringement disputes from established conglomerates</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Search Outcomes & Risk Appraisal -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Risk Classification</p>
          <h2>How We Interpret Search Results.</h2>
          <div class="gold-rule"></div>
          <p>Every brand clearance review produces one of three distinct statutory appraisals.</p>
        </div>

        <CardCarousel id="risk-classification-carousel" ariaLabel="Risk classification appraisals">
          <article class="service-card" style="padding: 1.75rem;">
            <div class="step-num" style="margin-bottom: 12px; font-size: 1.15rem; color: #2e7d32;">✓</div>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: .6rem;">Low Risk / Prima Facie Clear</h3>
            <p style="font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); line-height: 1.6; color: var(--body); margin-bottom: 1rem;">No identical or phonetically conflicting marks found in your active or allied classes. The mark appears distinctive under Section 9 and eligible for straightforward TM-A filing.</p>
            <a class="text-link" href="/trademark-registration/">Proceed to Filing <span>→</span></a>
          </article>

          <article class="service-card" style="padding: 1.75rem;">
            <div class="step-num" style="margin-bottom: 12px; font-size: 1.15rem; color: var(--gold);">⚠</div>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: .6rem;">Moderate Risk / Phonetic Similarity</h3>
            <p style="font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); line-height: 1.6; color: var(--body); margin-bottom: 1rem;">Similar marks exist but differences in commercial goods, prior use affidavits, or distinct visual device styling may overcome Section 11 objections. Strategic filing required.</p>
            <a class="text-link" href="/wordmark-registration/">Explore Strategy <span>→</span></a>
          </article>

          <article class="service-card" style="padding: 1.75rem;">
            <div class="step-num" style="margin-bottom: 12px; font-size: 1.15rem; color: #c62828;">✕</div>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: .6rem;">High Risk / Direct Conflict</h3>
            <p style="font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); line-height: 1.6; color: var(--body); margin-bottom: 1rem;">Identical or deceptively similar marks are actively registered for identical goods. We advise modifying the name or coining a distinctive prefix before capital is spent on branding.</p>
            <a class="text-link" href="/resources/brand-name-search-guide/">Read Search Guide <span>→</span></a>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Search FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Search FAQs</p>
          <h2>Questions About Name Clearance.</h2>
          <div class="gold-rule"></div>
          <p>Important legal realities regarding registry searches and brand clearance in India.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Does a clear search result guarantee that my trademark will be accepted?"
            answer="No ethical advisory firm can guarantee registration. A preliminary search checks for existing identical or similar marks on the public registry. However, the Registrar of Trade Marks conducts an independent examination and may raise queries regarding distinctiveness (Section 9) or newly filed applications."
          />
          <FaqItem
            num="02"
            question="Why is a simple Google search not sufficient for trademark clearance?"
            answer="A Google search only shows active commercial websites, not registered or pending trademarks on the official Indian Trade Marks Registry. Many businesses own registered marks that have not yet launched websites, or hold defensive registrations in specific classes that will block your application."
          />
          <FaqItem
            num="03"
            question="What is phonetic similarity under Section 11?"
            answer="Section 11 of the Trade Marks Act prohibits marks that sound identical or confusingly similar when spoken aloud, even if spelled differently (e.g., &quot;Kool&quot; vs &quot;Cool&quot;, or &quot;Phast&quot; vs &quot;Fast&quot;). Our search examines phonetic match algorithms to detect these potential conflicts."
          />
          <FaqItem
            num="04"
            question="How quickly can BRNDNUR complete a preliminary search?"
            answer="Preliminary search reviews are typically completed within 24 to 48 hours once we have your exact brand name and product/service description. We deliver an objective written summary and discuss practical next steps."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Start Early</p>
          <h2>Have a Brand Name<br>in Mind?</h2>
          <p>Share your proposed mark and product category. We will conduct an initial check on the IP India registry and provide an objective appraisal.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Check Your Name on WhatsApp <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Quick Turnaround</strong>
              <p>Preliminary search results delivered promptly.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Confidential Inquiries</strong>
              <p>Your proposed brand names remain strictly private.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Practical Guidance</strong>
              <p>Clear guidance on registration viability and next steps.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
