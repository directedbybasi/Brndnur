---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import FaqItem from '../../components/FaqItem.astro';

const title = "GST Registration Assistance in India | BRNDNUR Advisory LLP";
const description = "Professional GST registration guidance for proprietors, LLPs, and companies in Kerala and throughout India. Understand thresholds and documentation with BRNDNUR.";
const canonical = "https://brndnur.com/gst-registration/";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "GST Registration",
  "sectionName": "Hero Section",
  "enquiryType": "GST Registration Assistance",
  "topic": "I would like assistance with GST registration for my business.",
  "details": "Type of business: [e.g. Proprietorship, Partnership, LLP, Pvt Ltd]\\nNature of activity: [e.g. Retail, E-commerce, Services, Manufacturing]",
  "callToAction": "Could you please explain the applicable requirements, documents, service charges, and next steps?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "GST Registration",
  "sectionName": "Closing CTA Band",
  "enquiryType": "GST Document Checklist & Quotation",
  "topic": "I would like to receive the complete GST registration document checklist and fee structure for my enterprise.",
  "details": "State / District: [e.g. Kerala / Malappuram]\\nBusiness turnover estimate: [Please specify if applicable]",
  "callToAction": "Could you please guide me on registration timelines and portal onboarding?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/gst-registration/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Tax Compliance Support"
      title="GST Registration<br>Guidance for <span>Your Business.</span>"
      hasGoldRule={true}
      description="Goods and Services Tax (GST) is the foundational indirect tax registration in India. We assist startups, trading firms, and service enterprises in understanding statutory thresholds, assembling required paperwork, and securing GSTIN registration smoothly."
      primaryCta={{
        text: "Apply for GST Assistance",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "MSME Registration",
        href: "/udyam-msme-registration/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "GSTIN Issuance", subtitle: "Assistance" },
        { icon: "▱", title: "Input Tax Credit", subtitle: "(ITC) Advisory" },
        { icon: "⌖", title: "Kerala & Pan-India", subtitle: "Coverage" }
      ]}
      image="/assets/gst-hero-compliance.webp"
      imageAlt="Ivory business binders with refined gold business and compliance icons"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/assets/gst-tax-credibility.webp" alt="BRNDNUR GST registration and commercial tax advisory in Kerala" width="1200" height="900" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Fiscal Credibility</p>
          <h2>Unlocking Business Credibility and Tax Input Offsets.</h2>
          <div class="gold-rule"></div>
          <p>Obtaining a Goods and Services Tax Identification Number (GSTIN) is not merely a statutory obligation once sales cross turnover limits; it is a vital commercial asset. Having an active GSTIN allows you to issue legal tax invoices, open corporate current accounts, and partner with established institutional buyers.</p>
          <p>Moreover, GST registration enables your enterprise to claim Input Tax Credit (ITC) on commercial purchases, raw materials, capital equipment, and operational overheads, directly lowering your effective cost of doing business.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Statutory Documentation Review</strong>
                <p>Meticulous verification of electricity bills, rent agreements, and ownership deeds to prevent portal queries.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Aadhaar Authentication Support</strong>
                <p>Guided biometric or OTP authentication to avoid unnecessary physical premises inspections.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Return Schedule Clarity</strong>
                <p>Clear instruction on monthly or quarterly GSTR-1 and GSTR-3B compliance obligations from day one.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GST Requirements (Editorial Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">When Is GST Required?</p>
          <h2>Turnover Thresholds &amp; Mandatory Categories.</h2>
          <div class="gold-rule"></div>
          <p>Under GST legislation, businesses require registration under specific operational conditions.</p>
        </div>

        <CardCarousel id="gst-requirements-carousel" ariaLabel="GST requirements and mandatory categories">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Threshold Limits</h3>
              <p>Mandatory when annual aggregate turnover exceeds ₹40 lakhs for businesses exclusively supplying goods (₹20 lakhs in special category states) or ₹20 lakhs for service providers.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>Inter-State Commerce</h3>
              <p>Mandatory under Section 24 of the CGST Act for any enterprise selling goods across state boundaries, irrespective of total annual turnover.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>E-Commerce Marketplaces</h3>
              <p>Selling through digital platforms like Amazon, Flipkart, or Meesho requires compulsory GST registration for merchant listing and TCS compliance.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">04</div>
              <h3>Voluntary Registration</h3>
              <p>Early-stage enterprises voluntarily register to establish corporate credibility, issue tax invoices, and pass on Input Tax Credit to B2B clients.</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Threshold Comparison Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Statutory Thresholds</p>
          <h2>GST Applicability Matrix.</h2>
          <div class="gold-rule"></div>
          <p>Standard regulatory thresholds governing registration obligations across India.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Business Category</th>
                <th>Threshold Limit</th>
                <th>Applicability</th>
                <th>Key Benefit / Consideration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Goods Suppliers (Regular States)</strong></td>
                <td>₹40 Lakhs Aggregate Turnover</td>
                <td>Applicable in Kerala and most standard states</td>
                <td>Exempt below threshold unless selling inter-state</td>
              </tr>
              <tr>
                <td><strong>Service Providers (All States)</strong></td>
                <td>₹20 Lakhs Aggregate Turnover</td>
                <td>Consulting, IT, hospitality, freelancers</td>
                <td>Lower limit reflecting higher value-add margins</td>
              </tr>
              <tr>
                <td><strong>Inter-State Suppliers</strong></td>
                <td>Mandatory (₹0 Threshold)</td>
                <td>Any supply crossing state lines</td>
                <td>Compulsory registration required prior to dispatch</td>
              </tr>
              <tr>
                <td><strong>E-Commerce Marketplace Sellers</strong></td>
                <td>Mandatory (₹0 Threshold)</td>
                <td>Selling on Amazon, Flipkart, JioMart</td>
                <td>Marketplace deduction under TCS provisions</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 3-Step GST Registration Process -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Structured Support</p>
          <h2>The 3-Step GST Registration Journey.</h2>
          <div class="gold-rule"></div>
          <p>Navigating the Goods and Services Tax Network (GSTN) portal with diligence and compliance.</p>
        </div>

        <CardCarousel id="gst-steps-carousel" ariaLabel="The 3-step GST registration journey">
          <article class="step">
            <div class="step-top">
              <span class="step-num">01</span>
              <span class="step-line"></span>
            </div>
            <h3>Document &amp; Address Verification</h3>
            <p>We review your PAN, Aadhaar, electricity bills, rent agreements, and NOCs to ensure they comply with local jurisdictional GST officer scrutiny.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">02</span>
              <span class="step-line"></span>
            </div>
            <h3>Form GST REG-01 E-Filing</h3>
            <p>We draft the application, map your HSN/SAC commercial codes, and complete biometric Aadhaar authentication for expedited portal clearance.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">03</span>
              <span class="step-line"></span>
            </div>
            <h3>ARN Tracking &amp; Certificate Issuance</h3>
            <p>We track the Application Reference Number (ARN), respond to any clarification notices (REG-03), and deliver your official GSTIN Certificate.</p>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- GST FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">GST FAQs</p>
          <h2>Frequently Asked Questions About GST.</h2>
          <div class="gold-rule"></div>
          <p>Practical facts on government portal fees, composition schemes, and interstate rules.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Is there an official government fee for GST registration?"
            answer="No. The Government of India does not levy a statutory fee for issuing a new GST registration on the GSTN portal. BRNDNUR Advisory charges solely for professional document verification, HSN/SAC mapping, application drafting, and officer query resolution."
          />
          <FaqItem
            num="02"
            question="What address proof is required if operating from rented premises?"
            answer="You must provide a registered rent/lease agreement in the name of the applicant/firm, a recent electricity bill or municipal tax receipt for the property, and a signed No Objection Certificate (NOC) from the property owner."
          />
          <FaqItem
            num="03"
            question="What is the Composition Scheme under GST?"
            answer="Small businesses with an annual turnover up to ₹1.5 Crore (₹75 Lakhs for special category states) can opt for the Composition Scheme, paying a fixed lower turnover tax (1% for manufacturers/traders, 5% for restaurants) with quarterly return filings. However, composition dealers cannot claim input tax credit or make inter-state sales."
          />
          <FaqItem
            num="04"
            question="How long does GST approval take in Kerala?"
            answer="With successful Aadhaar authentication and clear address proof, GSTIN certificates are typically approved by the jurisdictional tax officer within 3 to 7 working days. If a clarification query (REG-03) is issued, we respond within the statutory 7-day window."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Get Registered</p>
          <h2>Streamline Your GST<br>Compliance Today.</h2>
          <p>We review your business structure, verify address documentation, and guide you through the official GST portal application process.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Inquire on WhatsApp <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Structured Verification</strong>
              <p>Pre-filing documentation audit to ensure prompt approval.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Clear Timelines</strong>
              <p>Transparent updates through ARN generation and GSTIN certificate issuance.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Post-Approval Clarity</strong>
              <p>Complete guidance on invoicing formats and filing calendars.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
