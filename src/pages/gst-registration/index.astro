---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "GST Registration Assistance in India | BRNDNUR Advisory LLP";
const description = "Professional GST registration guidance for proprietors, LLPs, and companies in Kerala and throughout India. Understand thresholds and documentation with BRNDNUR.";
const canonical = "https://brndnur.com/gst-registration/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/gst-registration/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/services/">Services</a>
          <span class="sep">/</span>
          <span class="current">GST Registration</span>
        </nav>
        <p class="eyebrow">Tax Compliance Support</p>
        <h1>GST Registration Guidance for Your Business.</h1>
        <p class="lead">Goods and Services Tax (GST) is the foundational indirect tax registration in India. We assist startups, trading firms, and service enterprises in understanding statutory thresholds, assembling required paperwork, and securing GSTIN registration smoothly.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>GSTIN Issuance Assistance</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="18" x2="12" y2="6"/></svg>
            <span>Input Tax Credit (ITC) Advisory</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Kerala State & Pan-India Coverage</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20need%20help%20with%20GST%20registration." target="_blank" rel="noopener noreferrer">Apply for GST Assistance &rarr;</a>
          <a class="btn btn-outline" href="/udyam-msme-registration/">MSME Registration</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/assets/service-business.webp" alt="BRNDNUR GST registration and commercial tax advisory in Kerala" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Fiscal Credibility</p>
            <h2>Unlocking Business Credibility and Tax Input Offsets</h2>
            <p>Obtaining a Goods and Services Tax Identification Number (GSTIN) is not merely a statutory obligation once sales cross turnover limits; it is a vital commercial asset. Having an active GSTIN allows you to issue legal tax invoices, open corporate current accounts, and partner with established institutional buyers.</p>
            <p>Moreover, GST registration enables your enterprise to claim Input Tax Credit (ITC) on commercial purchases, raw materials, capital equipment, and operational overheads, directly lowering your effective cost of doing business.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>Mandatory Return Filing</h4>
                <p>Once registered under GST, timely monthly or quarterly compliance (GSTR-1 and GSTR-3B) becomes mandatory even during months with zero commercial turnover. Our team explains return schedules before filing.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 GST Scenarios with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">When Is GST Required?</p>
          <h2>Turnover Thresholds & Mandatory Categories</h2>
          <p>Under GST legislation, businesses require registration under specific operational conditions:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <h3>Threshold Limits</h3>
            <p>Mandatory when annual aggregate turnover exceeds ₹40 lakhs for businesses exclusively supplying goods (₹20 lakhs in special category states) or ₹20 lakhs for service providers.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <h3>Inter-State Commerce</h3>
            <p>Mandatory for any person or entity supplying goods or taxable services across state boundaries, regardless of overall annual turnover volume.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </div>
            <h3>E-Commerce & Online Sellers</h3>
            <p>Required for selling goods or digital services through e-commerce marketplaces like Amazon, Flipkart, or your own online storefront.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3>Voluntary Registration</h3>
            <p>Early-stage businesses often register voluntarily to claim Input Tax Credit (ITC), build commercial credibility, and establish vendor relationships with corporate buyers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- GST Threshold Matrix -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Threshold Reference</p>
          <h2>Statutory GST Registration Thresholds</h2>
          <p>National thresholds under the Central Goods and Services Tax Act, 2017.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Business Category</th>
                <th>Threshold Limit</th>
                <th>Applicability</th>
                <th>Key Benefit / Consideration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Goods Suppliers (Regular States)</strong></td>
                <td>₹40 Lakhs Aggregate Turnover</td>
                <td>Applicable in Kerala and most standard states</td>
                <td>Exempt below threshold unless selling inter-state</td>
              </tr>
              <tr>
                <td><strong>Service Providers (All States)</strong></td>
                <td>₹20 Lakhs Aggregate Turnover</td>
                <td>Consulting, IT, hospitality, freelancers</td>
                <td>Lower limit reflecting higher value-add margins</td>
              </tr>
              <tr>
                <td><strong>Inter-State Suppliers</strong></td>
                <td>Mandatory (₹0 Threshold)</td>
                <td>Any supply crossing state lines</td>
                <td>Compulsory registration required prior to dispatch</td>
              </tr>
              <tr>
                <td><strong>E-Commerce Marketplace Sellers</strong></td>
                <td>Mandatory (₹0 Threshold)</td>
                <td>Selling on Amazon, Flipkart, JioMart</td>
                <td>Marketplace deduction under TCS provisions</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Get Registered</p>
          <h2>Streamline Your GST Compliance.</h2>
          <p>We review your business structure, verify address documentation, and guide you through the official GST portal application process.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20share%20GST%20registration%20checklist%20and%20fees." target="_blank" rel="noopener noreferrer">Inquire on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/business-setup/">Business Setup Advisory</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
