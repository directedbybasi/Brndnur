---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page Not Found (404) | BRNDNUR Advisory LLP";
const description = "The page you are looking for cannot be found. Explore our services, packages, and guides or return to the BRNDNUR homepage.";
const canonical = "https://brndnur.com/404.html";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/404.html"
  robots="noindex, follow"
>
  <main id="main-content">
    <section class="section" style="min-height: 70vh; display: flex; align-items: center;">
      <div class="container text-center" style="max-width: 680px; margin: 0 auto; text-align: center;">
        <p class="eyebrow">Error 404</p>
        <h1>We couldn’t find <span>that page.</span></h1>
        <div class="gold-rule"></div>
        <p class="lead" style="margin: 0 auto 32px;">The page you requested may have moved, been renamed, or is temporarily unavailable. Let us help you find the right information.</p>
        
        <div class="hero-actions" style="justify-content: center; margin-bottom: 40px;">
          <a class="btn btn-primary" href="/">Return to Homepage <span class="arrow">→</span></a>
          <a class="btn btn-outline" href="/services/">Explore Services <span class="arrow">→</span></a>
          <a class="btn btn-outline" href="/contact/">Contact Us <span class="arrow">→</span></a>
        </div>

        <div class="service-card" style="text-align: left;">
          <div class="service-body">
            <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 8px;">Looking for something specific?</h2>
            <p style="margin-bottom: 12px;">Browse our most popular services and educational guides:</p>
            <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: var(--muted); line-height: 1.8;">
              <li><a href="/trademark-registration/" class="text-link">Trademark Registration in India <span>→</span></a></li>
              <li><a href="/trademark-classes/" class="text-link">Trademark Class Directory (1–45) <span>→</span></a></li>
              <li><a href="/brand-name-search/" class="text-link">Brand Name Clearance Searches <span>→</span></a></li>
              <li><a href="/packages/" class="text-link">Packages &amp; Transparent Pricing <span>→</span></a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
