---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Trademark Renewal in India | 10-Year Maintenance Support";
const description = "Renew your Indian registered trademark before expiry. Understand statutory renewal windows, restoration grace periods, and fees with BRNDNUR.";
const canonical = "https://brndnur.com/trademark-renewal/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/trademark-renewal/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/services/">Services</a>
          <span class="sep">/</span>
          <span class="current">Trademark Renewal</span>
        </nav>
        <p class="eyebrow">Continuous Brand Protection</p>
        <h1>Trademark Renewal & Maintenance Support.</h1>
        <p class="lead">Under Section 25 of the Trade Marks Act, a registered trademark remains valid for 10 years from the original application date. Renewing on time prevents lapse, removal from the register, or vulnerability to competitor registration.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
            <span>Section 25 Statutory Renewal</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>10-Year Indefinite Protection</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Restoration Defense Protocol</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20need%20to%20renew%20my%20trademark." target="_blank" rel="noopener noreferrer">Renew Your Trademark &rarr;</a>
          <a class="btn btn-outline" href="/trademark-monitoring/">Explore Brand Monitoring</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/packages/assets/pricing-breakdown.webp" alt="BRNDNUR Trademark renewal filings and statutory maintenance in Kerala" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Perpetual Equity</p>
            <h2>Maintaining Perpetual Trademark Ownership</h2>
            <p>Unlike patents or copyright which eventually enter the public domain, a registered trademark can be renewed indefinitely every 10 years. As long as renewal forms and prescribed statutory fees are remitted on schedule, your commercial monopoly continues perpetually.</p>
            <p>Allowing a mark to lapse through administrative oversight is catastrophic: third-party competitors can immediately file for the abandoned mark, while reviving a removed trademark requires complex restoration proceedings with heavy government penalty surcharges.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>Calculation of the 10-Year Term</h4>
                <p>The 10-year validity period is calculated from the original date of application filing (Form TM-A), not the date the certificate was issued. Verify your filing date to ensure timely submission.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Critical Renewal Timelines with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Statutory Windows</p>
          <h2>Renewal Periods Under the Trade Marks Rules</h2>
          <p>Be aware of statutory deadlines to avoid severe late surcharge penalties or mark abandonment:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3>Standard Renewal Window</h3>
            <p>Renewal applications can be filed up to 6 months prior to the 10-year expiry date on Form TM-R with standard statutory government fees.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3>Late Renewal (6-Month Grace)</h3>
            <p>If you miss the expiry date, a 6-month statutory grace period permits renewal accompanied by additional prescribed government surcharge fees.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
            </div>
            <h3>Restoration (Within 1 Year)</h3>
            <p>If removed from the register, a mark may be restored between 6 months and 1 year post-expiry by filing for restoration and renewal with statutory penalties.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Renewal Windows & Statutory Procedure Table -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Filing Schedule</p>
          <h2>Statutory Renewal & Restoration Schedule</h2>
          <p>Official procedural timeline under Section 25 of the Trade Marks Act, 1999.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Period</th>
                <th>Prescribed Form</th>
                <th>Government Statutory Surcharge</th>
                <th>Registry Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>6 Months Prior to Expiry</strong></td>
                <td>Form TM-R</td>
                <td>Standard Statutory Fee Only</td>
                <td>Registered & Active</td>
              </tr>
              <tr>
                <td><strong>Up to 6 Months After Expiry</strong></td>
                <td>Form TM-R</td>
                <td>Standard Statutory Fee + Prescribed Late Surcharge</td>
                <td>Grace Period (Valid)</td>
              </tr>
              <tr>
                <td><strong>6 Months to 1 Year Post-Expiry</strong></td>
                <td>Form TM-R (Restoration)</td>
                <td>Standard Statutory Fee + Restoration Surcharge Penalty</td>
                <td>Removed from Register (Restorable)</td>
              </tr>
              <tr>
                <td><strong>Beyond 1 Year Post-Expiry</strong></td>
                <td>Fresh Form TM-A</td>
                <td>New Application Statutory Fees</td>
                <td>Lapsed & Abandoned; Open to Public Adoption</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Check Status</p>
          <h2>Is Your Registered Trademark Approaching Its 10-Year Mark?</h2>
          <p>Share your trademark registration number. We will verify its status on the official registry and advise on the next steps.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20check%20my%20trademark%20renewal%20date." target="_blank" rel="noopener noreferrer">Check Expiry on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/contact/">Contact Our Office</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
