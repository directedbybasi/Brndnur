---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Trademark Renewal in India | 10-Year Maintenance Support";
const description = "Renew your Indian registered trademark before expiry. Understand statutory renewal windows, restoration grace periods, and fees with BRNDNUR.";
const canonical = "https://brndnur.in/trademark-renewal/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/trademark-renewal/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Continuous Brand Protection</p>
        <h1>Trademark Renewal & Maintenance Support.</h1>
        <p class="lead">Under Section 25 of the Trade Marks Act, a registered trademark remains valid for 10 years from the original application date. Renewing on time prevents lapse, removal from the register, or vulnerability to competitor registration.</p>
        <div class="actions">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20need%20to%20renew%20my%20trademark." target="_blank" rel="noopener noreferrer">Renew Your Trademark &rarr;</a>
          <a class="btn btn-outline" href="/trademark-monitoring/">Explore Brand Monitoring</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Critical Windows</p>
          <h2>Renewal Timelines Under the Trade Marks Rules</h2>
          <p>Be aware of statutory deadlines to avoid severe late surcharge penalties or mark abandonment:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">📅</div>
            <h3>Standard Renewal Window</h3>
            <p>Renewal applications can be filed up to 6 months prior to the 10-year expiry date on Form TM-R with standard statutory government fees.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">⏳</div>
            <h3>Late Renewal (Within 6 Months After)</h3>
            <p>If you miss the expiry date, a 6-month grace period permits renewal accompanied by additional statutory surcharge fees.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">🔄</div>
            <h3>Restoration (Within 1 Year)</h3>
            <p>If removed from the register, a mark may be restored between 6 months and 1 year after expiration by filing for restoration and renewal with prescribed penalties.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Check Status</p>
          <h2>Is Your Registered Trademark Approaching Its 10-Year Mark?</h2>
          <p>Share your trademark registration number. We will verify its status on the official registry and advise on the next steps.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20check%20my%20trademark%20renewal%20date." target="_blank" rel="noopener noreferrer">Check Expiry on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/contact/">Contact Our Office</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
