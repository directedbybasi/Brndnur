---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Trademark Registration Support | BRNDNUR Advisory LLP";
const description = "End-to-end trademark registration guidance in India: preliminary search, class selection, documentation, filing assistance, and objection tracking with BRNDNUR.";
const canonical = "https://brndnur.in/trademark-registration/";
const ogImage = "/trademark-registration/assets/trademark-hero-generated.jpg";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/trademark-registration/"
>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://brndnur.in/trademark-registration/#webpage",
      "url": "https://brndnur.in/trademark-registration/",
      "name": "Trademark Registration Support | BRNDNUR Advisory LLP",
      "description": "End-to-end trademark registration guidance in India: preliminary search, class selection, documentation, filing assistance, and objection tracking with BRNDNUR.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://brndnur.in/#website",
        "url": "https://brndnur.in/",
        "name": "BRNDNUR Advisory LLP"
      }
    },
    {
      "@type": "Service",
      "@id": "https://brndnur.in/trademark-registration/#service",
      "name": "Trademark Registration Support",
      "serviceType": "Trademark Registration Guidance and Application Support",
      "provider": {
        "@type": "Organization",
        "@id": "https://brndnur.in/#organization",
        "name": "BRNDNUR Advisory LLP",
        "url": "https://brndnur.in/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "India"
      },
      "description": "Guidance for trademark searches, class selection, documentation, filing assistance, and objection tracking in India."
    },
    {
      "@type": "FAQPage",
      "@id": "https://brndnur.in/trademark-registration/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the cost of trademark registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs depend on the applicant category, number of classes and the professional support required. We can explain the applicable government fees and proposed service charges before you proceed."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the registration process take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Timelines vary depending on examination, publication, objections and other steps. Registration cannot be guaranteed by a fixed date."
          }
        },
        {
          "@type": "Question",
          "name": "What is a trademark class?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trademark classes group goods and services into categories. Choosing suitable classes depends on what your business offers now and may offer in the future."
          }
        },
        {
          "@type": "Question",
          "name": "Should I register a wordmark or a logo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A wordmark protects the wording as filed, while a logo application covers the submitted visual mark. The right approach depends on your brand assets and goals."
          }
        },
        {
          "@type": "Question",
          "name": "How can I check the status of my application?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Application status can be checked using the official trademark registry portal and application details. We can help you understand status updates."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if there is an objection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An objection may require a response and supporting documents within the stated deadline. The right response depends on the grounds raised and the facts of the application."
          }
        },
        {
          "@type": "Question",
          "name": "How long is a trademark valid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In India, a registered trademark is generally valid for 10 years from the filing date and may be renewed for further 10-year periods."
          }
        }
      ]
    }
  ]
}
</script>
  </Fragment>

  <main id="top">
    
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Trademark Registration</p><h1>Protect Your Brand.<br>Build With <span>Confidence.</span></h1><div class="accent-line"></div><p class="lead">A trademark gives your business a unique identity and legal protection. We help you understand the process, choose the right class and complete the application with clarity.</p><div class="hero-actions"><a class="btn btn-primary" href="#contact">Request a Trademark Search <span class="arrow">→</span></a><a class="btn btn-outline" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20trademark%20registration.">Talk to an Expert <span>◉</span></a></div></div><div class="hero-image-wrap"><div class="hero-image"><img src="/trademark-registration/assets/trademark-hero-generated.jpg" alt="Cream trademark portfolio with gold registered mark, intellectual property law books and pen" width="1358" height="1086" fetchpriority="high"></div></div></div></section>
<section class="section benefits" id="why"><div class="container benefits-grid"><div class="rounded-photo benefit-photo"><img src="/trademark-registration/assets/trademark-benefits-generated.jpg" alt="Trademark registration certificate with gold scales of justice and legal books" width="1303" height="1086" loading="lazy" decoding="async"></div><div class="benefit-content"><p class="eyebrow">Why Trademark Registration Matters</p><h2 class="section-title">Give Your Brand a<br>Stronger Foundation.</h2><p class="lead">A trademark is more than a name or logo. It represents your reputation, helps build trust and protects your business identity in the market.</p><div class="feature-grid"><article class="feature"><div class="feature-icon" aria-hidden="true">◎</div><h3>Unique Identity</h3><p>Helps distinguish your brand from others in the market.</p></article><article class="feature"><div class="feature-icon" aria-hidden="true">♢</div><h3>Legal Protection</h3><p>Provides legal rights against unauthorised use, where applicable.</p></article><article class="feature"><div class="feature-icon" aria-hidden="true">↗</div><h3>Business Credibility</h3><p>Builds trust and value for your business over time.</p></article></div></div></div></section>
<section class="section" id="support"><div class="container support-grid"><div class="support-copy"><p class="eyebrow">What We Help You With</p><h2 class="section-title">Trademark Support,<br>Step by Step.</h2><p class="lead">We provide end-to-end guidance for trademark registration in India, helping you understand each stage of the process.</p><ul class="check-list"><li><span class="check">✓</span><span>Wordmark and logo application guidance</span></li><li><span class="check">✓</span><span>Preliminary trademark search</span></li><li><span class="check">✓</span><span>Class identification guidance</span></li><li><span class="check">✓</span><span>Application documentation support</span></li><li><span class="check">✓</span><span>Examination and objection guidance, where applicable</span></li><li><span class="check">✓</span><span>Renewal and ongoing support</span></li></ul></div><div class="rounded-photo support-photo"><img src="/trademark-registration/assets/trademark-support-generated.jpg" alt="Trademark registration folio, legal books, gold seal and pen on a sunlit desk" width="1448" height="965" loading="lazy" decoding="async"></div></div></section>
<section class="section process" id="process"><div class="container process-grid"><div class="process-photo"><img src="/trademark-registration/assets/trademark-process-generated.jpg" alt="Trademark registration document with legal books, gavel and scales of justice" width="905" height="1086" loading="lazy" decoding="async"></div><div class="process-copy"><p class="eyebrow">The Registration Process</p><h2 class="section-title">A Clearer Path to<br>Trademark Registration.</h2><p class="lead">We help you understand the key steps and what may be required before moving forward.</p><div class="steps"><article class="step"><div class="step-number">01</div><div><h3>Share Your Brand Details</h3><p>Provide your brand name, logo and basic business information.</p></div></article><article class="step"><div class="step-number">02</div><div><h3>Review Search Findings</h3><p>We conduct a preliminary search and explain the results.</p></div></article><article class="step"><div class="step-number">03</div><div><h3>Discuss Classes &amp; Requirements</h3><p>We help you identify relevant classes and documentation.</p></div></article><article class="step"><div class="step-number">04</div><div><h3>File the Application</h3><p>The application is prepared and submitted through the appropriate process.</p></div></article><article class="step"><div class="step-number">05</div><div><h3>Track and Respond</h3><p>We keep you informed and guide you through examination updates, objections or other requirements, where applicable.</p></div></article></div></div></div></section>
<section class="section" id="documents">
  <div class="container documents-grid documents-centered">
    <div class="documents-content">
      <p class="eyebrow">Documents and Information</p>
      <h2 class="section-title">What You May Need to Get Started.</h2>
      <p class="lead">The exact documents may vary based on the applicant category and type of application. Here are common details required.</p>
      <div class="document-grid">
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">♙</div><h3>Applicant Details</h3><p>Name, address and contact information.</p></article>
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">▤</div><h3>Brand Name or Logo</h3><p>Clear representation of the mark you wish to register.</p></article>
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">♜</div><h3>Business Information</h3><p>Type of business and relevant details.</p></article>
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">▧</div><h3>Supporting Documents</h3><p>Depending on applicant category and application requirements.</p></article>
      </div>
    </div>
  </div>
</section>
<section class="section" id="faqs"><div class="container faq-grid"><div class="rounded-photo faq-photo"><img src="/trademark-registration/assets/trademark-faq-generated.jpg" alt="Navy legal portfolio with a gold registered trademark symbol and intellectual property law books" width="814" height="1086" loading="lazy" decoding="async"></div><div><p class="eyebrow">Pricing and FAQs</p><h2 class="section-title">Common Questions.</h2><p class="lead">A few helpful answers before you decide on your next step.</p><div class="faq-list"><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>What is the cost of trademark registration?</span><span>+</span></button><div class="faq-answer">Costs depend on the applicant category, number of classes and the professional support required. We can explain the applicable government fees and proposed service charges before you proceed.</div></div><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>How long does the registration process take?</span><span>+</span></button><div class="faq-answer">Timelines vary depending on examination, publication, objections and other steps. Registration cannot be guaranteed by a fixed date.</div></div><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>What is a trademark class?</span><span>+</span></button><div class="faq-answer">Trademark classes group goods and services into categories. Choosing suitable classes depends on what your business offers now and may offer in the future.</div></div><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>Should I register a wordmark or a logo?</span><span>+</span></button><div class="faq-answer">A wordmark protects the wording as filed, while a logo application covers the submitted visual mark. The right approach depends on your brand assets and goals.</div></div><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>How can I check the status of my application?</span><span>+</span></button><div class="faq-answer">Application status can be checked using the official trademark registry portal and application details. We can help you understand status updates.</div></div><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>What happens if there is an objection?</span><span>+</span></button><div class="faq-answer">An objection may require a response and supporting documents within the stated deadline. The right response depends on the grounds raised and the facts of the application.</div></div><div class="faq-item"><button class="faq-question" aria-expanded="false"><span>How long is a trademark valid?</span><span>+</span></button><div class="faq-answer">In India, a registered trademark is generally valid for 10 years from the filing date and may be renewed for further 10-year periods.</div></div></div></div></div></section>
<section class="cta-section" id="contact"><div class="container"><div class="cta-panel"><div class="cta-copy"><p class="eyebrow">Ready to Protect Your Brand?</p><h2 class="section-title">Take the First Step Today.</h2><p>Request a trademark search or speak with our team to understand the best way forward for your business.</p><div class="cta-actions"><a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20request%20a%20trademark%20search.">Request a Trademark Search <span>→</span></a></div></div></div></div></section>

  </main>
</BaseLayout>


<script>
  document.querySelectorAll('.faq-question').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.faq-item');
      if (item) {
        const open = item.classList.toggle('open');
        button.setAttribute('aria-expanded', String(open));
      }
    });
  });
</script>


<style is:global>

:root {--ivory:#F4EFE4;--paper:#fbf7ef;--navy:#13233a;--gold:#A8781A;--gold-dark:#966116;--ink:#182a42;--muted:#526075;--line:#e4d6bd;--white:#fffdf8;--serif:"Playfair Display",Georgia,'Times New Roman',serif;--sans:"DM Sans",Arial,Helvetica,sans-serif;--max:1200px}
* {box-sizing:border-box}
html {scroll-behavior:smooth}
body {margin:0;background:var(--ivory);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased}
img {display:block;width:100%;height:100%;object-fit:cover}
a {color:inherit;text-decoration:none}
button {font:inherit}
.container {width:min(var(--max),calc(100% - 48px));margin-inline:auto}
.eyebrow {margin:0 0 12px;color:var(--gold-dark);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.section-title {font-family:var(--serif);font-weight:400;letter-spacing:-.035em;font-size:clamp(30px,3.1vw,44px);line-height:1.13;margin:0 0 16px;color:var(--navy)}
.lead {color:var(--muted);font-size:15px;max-width:620px;margin:0}
.accent-line {width:38px;height:2px;background:var(--gold);margin:20px 0 22px}
.btn {display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:0 19px;border:1px solid transparent;border-radius:5px;font-size:13px;font-weight:700;transition:transform .2s,background .2s,border-color .2s;cursor:pointer}
.btn:hover {transform:translateY(-2px)}
.btn-primary {background:var(--navy);color:white}
.btn-primary:hover {background:#203956}
.btn-outline {border-color:#a8a18f;color:var(--navy);background:rgba(255,255,255,.28)}
.btn-gold {background:var(--gold);color:#fff}
.arrow {color:#d99a31;font-size:18px;line-height:1}
.hero {padding:28px 0 44px}
.hero-grid {display:grid;grid-template-columns:.88fr 1.12fr;gap:34px;align-items:center}
.hero-copy {padding:20px 0 20px 2px}
.hero h1 {font-family:var(--serif);font-weight:400;letter-spacing:-.045em;font-size:clamp(38px,4.5vw,62px);line-height:1.02;margin:0;color:var(--navy);max-width:520px}
.hero h1 span {color:var(--gold)}
.hero .lead {font-size:15px;max-width:470px;margin-top:18px}
.hero-actions {display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.hero-image {height:clamp(290px,37vw,450px);border-radius:12px;overflow:hidden;box-shadow:0 15px 35px rgba(62,43,16,.08);background:#e9ddc9}
.hero-image img {object-position:center 55%}
.hero-image-wrap {position:relative}
.hero-image-wrap:before {content:"";position:absolute;z-index:1;pointer-events:none;inset:0 auto 0 0;width:11%;background:linear-gradient(90deg,var(--ivory),rgba(244,238,226,0));border-radius:12px 0 0 12px}
.section {padding:62px 0}
.benefits {border-top:1px solid rgba(19,35,58,.04);border-bottom:1px solid rgba(19,35,58,.04)}
.benefits-grid {display:grid;grid-template-columns:.8fr 1.2fr;gap:48px;align-items:center}
.rounded-photo {overflow:hidden;border-radius:12px;background:#e5d4b8;box-shadow:0 10px 24px rgba(44,32,14,.07)}
.benefit-photo {height:360px}
.benefit-content .section-title {max-width:570px}
.feature-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.feature-icon {width:48px;height:48px;border-radius:10px;background:#efe2cb;display:grid;place-items:center;color:var(--gold-dark);font-size:23px;margin-bottom:12px}
.feature h3 {font-size:14px;line-height:1.3;margin:0 0 6px;color:var(--navy)}
.feature p {font-size:12px;line-height:1.55;color:var(--muted);margin:0}
.support-grid {display:grid;grid-template-columns:1fr 1.04fr;gap:64px;align-items:center}
.support-copy .lead {max-width:500px}
.check-list {padding:0;margin:24px 0 0;list-style:none;display:grid;gap:10px}
.check-list li {display:flex;align-items:flex-start;gap:12px;font-size:13px;color:#314157}
.check {width:18px;height:18px;flex:0 0 18px;border-radius:50%;display:grid;place-items:center;background:var(--gold);color:white;font-size:11px;margin-top:1px}
.support-photo {height:390px}
.process {background:#eee4d3}
.process-grid {display:grid;grid-template-columns:.85fr 1.15fr;gap:54px;align-items:stretch}
.process-photo {min-height:490px;border-radius:12px;overflow:hidden}
.process-copy {padding:24px 0;align-self:center}
.steps {display:grid;gap:17px;margin-top:24px}
.step {display:grid;grid-template-columns:42px 1fr;gap:15px;align-items:start}
.step-number {width:40px;height:40px;border-radius:50%;background:var(--gold);color:white;display:grid;place-items:center;font-family:var(--serif);font-size:17px}
.step h3 {font-family:var(--serif);font-size:18px;font-weight:400;margin:0 0 2px;color:var(--navy)}
.step p {font-size:12px;color:var(--muted);margin:0;line-height:1.55}
.documents-grid {display:grid;grid-template-columns:1.4fr .6fr;gap:40px;align-items:center}
.document-photo {height:270px}
.document-grid {display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:28px}
.doc-item {padding-top:0;border-right:1px solid var(--line);padding-right:12px}
.doc-item:last-child {border-right:0}
.doc-icon {width:43px;height:43px;border-radius:9px;background:#efe2cb;display:grid;place-items:center;color:var(--gold-dark);font-size:21px;margin-bottom:10px}
.doc-item h3 {font-size:12px;line-height:1.35;margin:0 0 5px;color:var(--navy)}
.doc-item p {font-size:11px;line-height:1.5;color:var(--muted);margin:0}
.faq-grid {display:grid;grid-template-columns:.85fr 1.15fr;gap:42px;align-items:center}
.faq-photo {height:auto;aspect-ratio:3/4}
.faq-list {border-top:1px solid var(--line);margin-top:18px}
.faq-item {border-bottom:1px solid var(--line)}
.faq-question {width:100%;display:flex;align-items:center;justify-content:space-between;gap:15px;text-align:left;padding:13px 2px;border:0;background:transparent;color:var(--navy);font-size:13px;cursor:pointer}
.faq-question span:last-child {font-size:20px;color:var(--gold);transition:transform .2s}
.faq-answer {display:none;padding:0 24px 14px 2px;color:var(--muted);font-size:12px;line-height:1.65}
.faq-item.open .faq-answer {display:block}
.faq-item.open .faq-question span:last-child {transform:rotate(45deg)}
.cta-section {padding:12px 0 50px}
.cta-panel {position:relative;overflow:hidden;background:var(--navy);color:#fff;border-radius:12px;padding:36px 42px;display:flex;align-items:center;justify-content:space-between;gap:30px;min-height:205px}
.cta-panel:after {content:"®";position:absolute;right:7%;top:-40px;font-family:var(--serif);font-size:240px;line-height:1;color:transparent;-webkit-text-stroke:1px rgba(183,126,36,.32);transform:rotate(-9deg);pointer-events:none}
.cta-copy {position:relative;z-index:1;max-width:560px}
.cta-copy .eyebrow {color:#dba64c}
.cta-copy .section-title {color:#fff;font-size:clamp(28px,3vw,40px);margin-bottom:10px}
.cta-copy p {font-size:13px;color:#e1e6ed;max-width:440px;margin:0}
.cta-actions {display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.cta-panel .btn-outline {border-color:#88642f;color:white;background:transparent}
.copyright {font-size:10px;color:#778091}
@media(max-width:900px) {
.hero-grid {grid-template-columns:.92fr 1.08fr;gap:22px}
.benefits-grid, .support-grid, .process-grid, .documents-grid, .faq-grid {gap:30px}
.feature-grid {gap:12px}
.support-photo {height:340px}
.process-photo {min-height:430px}
.document-grid {gap:12px}
}
@media(max-width:680px) {
.container {width:min(100% - 32px,var(--max))}
.hero {padding:24px 0 32px}
.hero-grid, .benefits-grid, .support-grid, .process-grid, .documents-grid, .faq-grid {grid-template-columns:1fr;gap:24px}
.hero-copy {padding:0}
.hero h1 {font-size:clamp(38px,10vw,52px)}
.hero-image {height:290px;grid-row:1}
.hero-image-wrap:before {width:8%}
.hero-actions .btn {flex:1 1 auto}
.section {padding:42px 0}
.benefit-photo {height:270px;order:2}
.feature-grid {grid-template-columns:1fr;gap:18px;margin-top:22px}
.feature {display:grid;grid-template-columns:48px 1fr;column-gap:13px;align-items:start}
.feature-icon {grid-row:span 2;margin:0}
.feature h3 {margin-top:2px}
.support-photo {height:280px;order:-1}
.process {padding:0}
.process-photo {min-height:270px;height:270px}
.process-copy {padding:20px 0 40px}
.steps {gap:15px}
.document-photo {height:240px;order:-1}
.document-grid {grid-template-columns:repeat(2,1fr);gap:20px 16px}
.doc-item:nth-child(2) {border-right:0}
.faq-photo {height:auto;aspect-ratio:3/4;max-height:none}
.faq-grid {gap:22px}
.cta-section {padding:0 0 34px}
.cta-panel {padding:28px 22px;min-height:0}
.cta-panel:after {right:-25px;top:10px;font-size:150px}
.copyright {margin-top:0}
}
@media(prefers-reduced-motion:reduce) {
html {scroll-behavior:auto}
*, *:before, *:after {transition:none!important}
}



:root {
  --max: 1200px;
  --serif: Georgia, "Times New Roman", serif;
  --sans: "Inter", "Segoe UI", Arial, Helvetica, sans-serif;
  --section-space: 88px;
  --section-space-compact: 60px;
  --gutter: 48px;
  --grid-gap: 24px;
  --body-size: 16px;
  --body-line: 1.65;
}
html { scroll-padding-top: 84px; }
body {
  font-family: var(--sans);
  font-size: var(--body-size);
  line-height: var(--body-line);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.container { width: min(var(--max), calc(100% - (var(--gutter) * 2))); }
.eyebrow {
  margin-bottom: 14px;
  font-size: 11px;
  line-height: 1.5;
  letter-spacing: .15em;
}
.section-title {
  font-size: clamp(34px, 3.25vw, 42px);
  line-height: 1.16;
  letter-spacing: -.025em;
  margin-bottom: 18px;
  text-wrap: balance;
}
.lead {
  font-size: 16px;
  line-height: 1.68;
  max-width: 650px;
}
.accent-line { margin: 22px 0 24px; width: 40px; height: 2px; }
.btn {
  min-height: 48px;
