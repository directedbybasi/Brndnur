---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import FaqItem from '../../components/FaqItem.astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const title = "Trademark Registration Support | BRNDNUR Advisory LLP";
const description = "End-to-end trademark registration guidance in India: preliminary search, class selection, documentation, filing assistance, and objection tracking with BRNDNUR.";
const canonical = "https://brndnur.com/trademark-registration/";
const ogImage = "/trademark-registration/assets/tm-hero-protection.webp";

const tmHeroWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Trademark Registration',
  sectionName: 'Hero Section',
  enquiryType: 'Trademark Registration Advisory',
  message: 'Hi BRNDNUR, I am interested in trademark registration for my brand. Could you please guide me through the name availability search, required application documents, applicable government fees, and the next steps for filing with IP India?'
});

const wordmarkWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Trademark Registration',
  sectionName: 'Wordmark Section',
  enquiryType: 'Wordmark Registration',
  message: 'Hi BRNDNUR, I am interested in wordmark registration for my brand. Could you please guide me through the name availability check, required documents, applicable government fees, professional service charges, and the next steps for applying?'
});

const logoWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Trademark Registration',
  sectionName: 'Logo & Device Mark Section',
  enquiryType: 'Logo & Device Mark Protection',
  message: 'Hi BRNDNUR, I would like to understand the registration process for my brand logo. Could you please explain the required artwork, relevant trademark class, application documents, applicable fees, and the next steps for protecting my visual brand identity?'
});

const tmClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Trademark Registration',
  sectionName: 'Closing CTA Section',
  enquiryType: 'Trademark Search Request',
  message: 'Hi BRNDNUR, I would like to request a preliminary trademark clearance search for my proposed brand name before filing Form TM-A. Could you please guide me on the database search, information required, and next steps?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/trademark-registration/"
  hasCustomSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://brndnur.com/trademark-registration/#webpage",
      "url": "https://brndnur.com/trademark-registration/",
      "name": "Trademark Registration Support | BRNDNUR Advisory LLP",
      "description": "End-to-end trademark registration guidance in India: preliminary search, class selection, documentation, filing assistance, and objection tracking with BRNDNUR.",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://brndnur.com/#website",
        "url": "https://brndnur.com/",
        "name": "BRNDNUR Advisory LLP"
      }
    },
    {
      "@type": "Service",
      "@id": "https://brndnur.com/trademark-registration/#service",
      "name": "Trademark Registration Support",
      "serviceType": "Trademark Registration Guidance and Application Support",
      "provider": {
        "@type": "Organization",
        "@id": "https://brndnur.com/#organization",
        "name": "BRNDNUR Advisory LLP",
        "url": "https://brndnur.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "India"
      },
      "description": "Guidance for trademark searches, class selection, documentation, filing assistance, and objection tracking in India."
    },
    {
      "@type": "FAQPage",
      "@id": "https://brndnur.com/trademark-registration/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the cost of trademark registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Costs depend on the applicant category, number of classes and the professional support required. We can explain the applicable government fees and proposed service charges before you proceed."
          }
        },
        {
          "@type": "Question",
          "name": "How long does the registration process take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Timelines vary depending on examination, publication, objections and other steps. Registration cannot be guaranteed by a fixed date."
          }
        },
        {
          "@type": "Question",
          "name": "What is a trademark class?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trademark classes group goods and services into categories. Choosing suitable classes depends on what your business offers now and may offer in the future."
          }
        },
        {
          "@type": "Question",
          "name": "Should I register a wordmark or a logo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A wordmark protects the wording as filed, while a logo application covers the submitted visual mark. The right approach depends on your brand assets and goals."
          }
        },
        {
          "@type": "Question",
          "name": "How can I check the status of my application?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Application status can be checked using the official trademark registry portal and application details. We can help you understand status updates."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if there is an objection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An objection may require a response and supporting documents within the stated deadline. The right response depends on the grounds raised and the facts of the application."
          }
        },
        {
          "@type": "Question",
          "name": "How long is a trademark valid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In India, a registered trademark is generally valid for 10 years from the filing date and may be renewed for further 10-year periods."
          }
        }
      ]
    }
  ]
}
</script>
  </Fragment>

  <main id="main-content">
    
<PageHero
  eyebrow="Trademark Registration"
  title="Protect Your Brand.<br>Build With <span>Confidence.</span>"
  hasGoldRule={true}
  description="A trademark gives your business a unique identity and legal protection. We help you understand the process, choose the right class and complete the application with clarity."
  primaryCta={{
    text: "Request a Trademark Search",
    href: "#contact",
    icon: "→"
  }}
  secondaryCta={{
    text: "Talk to an Expert",
    href: tmHeroWhatsAppUrl,
    icon: "→",
    target: "_blank",
    rel: "noopener noreferrer"
  }}
  trustBadges={[
    { icon: "♢", title: "Trade Marks Act", subtitle: "1999 Guidance" },
    { icon: "▱", title: "Class Selection", subtitle: "NICE System" },
    { icon: "⌖", title: "Based in", subtitle: "Skatt Business Park, Manjeri" }
  ]}
  image="/trademark-registration/assets/tm-hero-protection.webp"
  imageAlt="Cream trademark portfolio with gold registered mark, intellectual property law books and pen"
  variant="service"
/>
<section class="section benefits" id="why"><div class="container benefits-grid"><div class="rounded-photo benefit-photo"><img src="/trademark-registration/assets/tm-benefits-foundation.webp" alt="Trademark registration certificate with gold scales of justice and legal books" width="1303" height="1086" loading="lazy" decoding="async"></div><div class="benefit-content"><p class="eyebrow">Why Trademark Registration Matters</p><h2 class="section-title">Give Your Brand a<br>Stronger Foundation.</h2><p class="lead">A trademark is more than a name or logo. It represents your reputation, helps build trust and protects your business identity in the market.</p><div class="feature-grid"><article class="feature"><div class="feature-icon" aria-hidden="true">◎</div><h3>Unique Identity</h3><p>Helps distinguish your brand from others in the market.</p></article><article class="feature"><div class="feature-icon" aria-hidden="true">♢</div><h3>Legal Protection</h3><p>Provides legal rights against unauthorised use, where applicable.</p></article><article class="feature"><div class="feature-icon" aria-hidden="true">↗</div><h3>Business Credibility</h3><p>Builds trust and value for your business over time.</p></article></div></div></div></section>
<section class="section" id="support"><div class="container support-grid"><div class="support-copy"><p class="eyebrow">What We Help You With</p><h2 class="section-title">Trademark Support,<br>Step by Step.</h2><p class="lead">We provide end-to-end guidance for trademark registration in India, helping you understand each stage of the process.</p><ul class="check-list"><li><span class="check">✓</span><span><a href="/wordmark-registration/" style="color:inherit;text-decoration:none;"><strong>Wordmark and logo application guidance &rarr;</strong></a></span></li><li><span class="check">✓</span><span><a href="/brand-name-search/" style="color:inherit;text-decoration:none;"><strong>Preliminary trademark search &rarr;</strong></a></span></li><li><span class="check">✓</span><span><a href="/trademark-classes/" style="color:inherit;text-decoration:none;"><strong>Class identification guidance &rarr;</strong></a></span></li><li><span class="check">✓</span><span>Application documentation support</span></li><li><span class="check">✓</span><span>Examination and objection guidance, where applicable</span></li><li><span class="check">✓</span><span><a href="/trademark-renewal/" style="color:inherit;text-decoration:none;"><strong>Renewal and ongoing support &rarr;</strong></a></span></li></ul></div><div class="rounded-photo support-photo"><img src="/trademark-registration/assets/tm-support-steps.webp" alt="Trademark registration folio, legal books, gold seal and pen on a sunlit desk" width="1448" height="965" loading="lazy" decoding="async"></div></div></section>
<section class="section process" id="process"><div id="filing" style="position: relative; top: -100px;"></div><div class="container process-grid"><div class="process-photo"><img src="/trademark-registration/assets/tm-process-path.webp" alt="Trademark registration document with legal books, gavel and scales of justice" width="905" height="1086" loading="lazy" decoding="async"></div><div class="process-copy"><p class="eyebrow">The Registration Process</p><h2 class="section-title">A Clearer Path to<br>Trademark Registration.</h2><p class="lead">We help you understand the key steps and what may be required before moving forward.</p><div class="steps"><article class="step"><div class="step-number">01</div><div><h3>Share Your Brand Details</h3><p>Provide your brand name, logo and basic business information.</p></div></article><article class="step"><div class="step-number">02</div><div><h3>Review Search Findings</h3><p>We conduct a preliminary search and explain the results.</p></div></article><article class="step"><div class="step-number">03</div><div><h3>Discuss Classes &amp; Requirements</h3><p>We help you identify relevant classes and documentation.</p></div></article><article class="step"><div class="step-number">04</div><div><h3>File the Application</h3><p>The application is prepared and submitted through the appropriate process.</p></div></article><article class="step"><div class="step-number">05</div><div><h3>Track and Respond</h3><p>We keep you informed and guide you through examination updates, objections or other requirements, where applicable.</p></div></article></div></div></div></section>

<!-- Wordmark & Logo Mark Distinction Section -->
<section class="section marks-distinction-section" id="marks-distinction">
  <div class="container marks-distinction-container">
    <div class="marks-distinction-grid">
      <!-- Left Column: Brand Trademark Specimen Image -->
      <div class="marks-photo-col">
        <div class="marks-photo-frame">
          <img
            src="/assets/wordmark-hero-typography.webp"
            alt="BRNDNUR wordmark and device mark trademark registration specimen sheets with typography grid"
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Right Column: Information & Comparison -->
      <div class="marks-content-col">
        <div class="marks-header">
          <p class="eyebrow marks-eyebrow">Types of Trademark Applications</p>
          <h2 class="marks-heading">Wordmark vs. Device Mark <span class="gold-text">Registration.</span></h2>
          <div class="gold-rule marks-rule"></div>
          <p class="marks-intro">Most businesses in India need both to protect their brand name and their visual identity.</p>
        </div>

        <div class="marks-options-grid">
          <!-- Option A: Wordmark Registration -->
          <div class="mark-option" id="wordmark">
            <span class="option-eyebrow">Text-Only Protection</span>
            <h3 class="option-title">Wordmark Registration</h3>
            <p class="option-desc">
              A wordmark protects the actual words, letters, and spelling of your brand name itself. Once registered, your name is legally protected regardless of font, style, color, capitalization, or layout.
            </p>
            <ul class="option-benefits">
              <li><strong>Broadest Defense:</strong> Prevents competitors from using confusingly similar names in any typography.</li>
              <li><strong>Flexible Rebranding:</strong> If you redesign your logo in the future, your wordmark protection remains 100% intact.</li>
              <li><strong>Phonetic Exclusivity:</strong> Stops copycats using names that sound identical in speech.</li>
            </ul>
            <div class="option-cta">
              <a href={wordmarkWhatsAppUrl} class="btn-mark btn-gold-outline" target="_blank" rel="noopener noreferrer">
                <span>Register Wordmark</span>
                <span class="arrow">→</span>
              </a>
            </div>
          </div>

          <!-- Option B: Logo & Device Mark -->
          <div class="mark-option" id="logo-mark">
            <span class="option-eyebrow">Visual Identity &amp; Artwork</span>
            <h3 class="option-title">Logo &amp; Device Mark</h3>
            <p class="option-desc">
              A device mark protects the specific graphic composition, artistic symbol, emblem, custom stylized lettering, or packaging artwork submitted on your application.
            </p>
            <ul class="option-benefits">
              <li><strong>Emblem &amp; Icon Exclusivity:</strong> Stops visual lookalikes from imitating your brand badge or app icon.</li>
              <li><strong>Vienna Codification:</strong> Indexed under international graphic codes for comprehensive visual clearance.</li>
              <li><strong>Packaging Standards:</strong> Crucial for consumer goods, food packaging, and retail storefronts.</li>
            </ul>
            <div class="option-cta">
              <a href={logoWhatsAppUrl} class="btn-mark btn-gold-primary" target="_blank" rel="noopener noreferrer">
                <span>Protect Logo Mark</span>
                <span class="arrow">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trademark Classes (NICE Classification) Section -->
<section class="section section-alt" id="classes">
  <div class="container split-section">
    <div class="split-photo">
      <img src="/assets/resources-card-classes-169.webp" alt="NICE trademark classification system 45 classes" width="1200" height="675" loading="lazy" style="border-radius: 8px; border: 1px solid #DDCFB8; aspect-ratio: 16/9; object-fit: cover;" />
    </div>
    <div class="split-copy">
      <p class="eyebrow">NICE Classification</p>
      <h2 class="section-title">Trademark Classes (1 to 45).</h2>
      <div class="accent-line"></div>
      <p class="lead" style="margin-bottom: 20px;">The class you file defines exactly what business activities your trademark protects. Filing in the wrong class leaves your actual commercial operations completely exposed to competitors.</p>
      
      <div class="feature-grid classes-feature-grid">
        <article class="feature class-mini-card">
          <h4>Classes 1 to 34</h4>
          <p>Manufactured physical products, apparel, electronics, cosmetics, packaged food &amp; beverages.</p>
        </article>
        <article class="feature class-mini-card">
          <h4>Classes 35 to 45</h4>
          <p>Commercial services, retail stores, IT/software, restaurants, healthcare, education &amp; consulting.</p>
        </article>
      </div>

      <a href="/brand-name-search/" class="btn btn-navy">
        <span>Check Your Trademark Class</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
<section class="section" id="documents">
  <div class="container documents-grid documents-centered">
    <div class="documents-content">
      <p class="eyebrow">Documents and Information</p>
      <h2 class="section-title">What You May Need to Get Started.</h2>
      <p class="lead">The exact documents may vary based on the applicant category and type of application. Here are common details required.</p>
      <CardCarousel id="tm-documents-carousel" class="dark-carousel" ariaLabel="Documents and Information">
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">♙</div><h3>Applicant Details</h3><p>Name, address and contact information.</p></article>
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">▤</div><h3>Brand Name or Logo</h3><p>Clear representation of the mark you wish to register.</p></article>
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">♜</div><h3>Business Information</h3><p>Type of business and relevant details.</p></article>
        <article class="doc-item"><div class="doc-icon" aria-hidden="true">▧</div><h3>Supporting Documents</h3><p>Depending on applicant category and application requirements.</p></article>
      </CardCarousel>
    </div>
  </div>
</section>
<section class="section" id="faqs">
  <div class="container faq-grid">
    <div class="rounded-photo faq-photo">
      <img src="/trademark-registration/assets/tm-faq-advisory.webp" alt="Navy legal portfolio with a gold registered trademark symbol and intellectual property law books" width="814" height="1086" loading="lazy" decoding="async">
    </div>
    <div>
      <p class="eyebrow">Pricing and FAQs</p>
      <h2 class="section-title">Common Questions.</h2>
      <p class="lead">A few helpful answers before you decide on your next step.</p>
      <div class="faq-editorial-list faq-list">
        <FaqItem
          num="01"
          question="What is the cost of trademark registration?"
          answer="Costs depend on the applicant category, number of classes and the professional support required. We can explain the applicable government fees and proposed service charges before you proceed."
        />
        <FaqItem
          num="02"
          question="How long does the registration process take?"
          answer="Timelines vary depending on examination, publication, objections and other steps. Registration cannot be guaranteed by a fixed date."
        />
        <FaqItem
          num="03"
          question="What is a trademark class?"
          answer="Trademark classes group goods and services into categories. Choosing suitable classes depends on what your business offers now and may offer in the future."
        />
        <FaqItem
          num="04"
          question="Should I register a wordmark or a logo?"
          answer="A wordmark protects the wording as filed, while a logo application covers the submitted visual mark. The right approach depends on your brand assets and goals."
        />
        <FaqItem
          num="05"
          question="How can I check the status of my application?"
          answer="Application status can be checked using the official trademark registry portal and application details. We can help you understand status updates."
        />
        <FaqItem
          num="06"
          question="What happens if there is an objection?"
          answer="An objection may require a response and supporting documents within the stated deadline. The right response depends on the grounds raised and the facts of the application."
        />
        <FaqItem
          num="07"
          question="How long is a trademark valid?"
          answer="In India, a registered trademark is generally valid for 10 years from the filing date and may be renewed for further 10-year periods."
        />
      </div>
    </div>
  </div>
</section>
<section class="cta-section" id="contact"><div class="container"><div class="cta-panel"><div class="cta-copy"><p class="eyebrow">Ready to Protect Your Brand?</p><h2 class="section-title">Take the First Step Today.</h2><p>Request a trademark search or speak with our team to understand the best way forward for your business.</p><div class="cta-actions"><a class="btn btn-gold" href={tmClosingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Request a Trademark Search <span>→</span></a></div></div></div></div></section>

  </main>
</BaseLayout>


<style is:global>

:root {--ivory:#F4EFE4;--paper:#fbf7ef;--navy:#13233a;--gold:#A8781A;--gold-dark:#966116;--ink:#182a42;--muted:#526075;--line:#e4d6bd;--white:#fffdf8;--serif:"DM Sans",Arial,Helvetica,sans-serif;--sans:"DM Sans",Arial,Helvetica,sans-serif;--max:1200px}
* {box-sizing:border-box}
html {scroll-behavior:smooth}
body {margin:0;background:var(--ivory);color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased}
img {display:block;width:100%;height:100%;object-fit:cover}
a {color:inherit;text-decoration:none}
button {font:inherit}
.container {width:min(var(--max),calc(100% - 48px));margin-inline:auto}
.eyebrow {margin:0 0 12px;color:var(--gold);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.section-title {font-family:var(--sans);font-weight:600;letter-spacing:-.02em;font-size:clamp(30px,3.1vw,44px);line-height:1.15;margin:0 0 16px;color:var(--navy)}
.lead {color:var(--muted);font-size:15px;max-width:620px;margin:0}
.accent-line {width:38px;height:2px;background:var(--gold);margin:20px 0 22px}
.btn {display:inline-flex !important;align-items:center !important;justify-content:center !important;gap:8px !important;min-height:48px !important;padding:12px 22px !important;border:1.5px solid var(--navy) !important;border-radius:6px !important;font-size:14px !important;font-weight:600 !important;line-height:1.25 !important;box-shadow: 0 2px 6px rgba(19, 35, 58, 0.16) !important;transition:all .18s ease !important;cursor:pointer !important;white-space:nowrap !important;box-sizing:border-box !important}
.btn:hover {transform:translateY(-1px) !important}
.btn-primary {background:var(--navy) !important;color:var(--ivory, #F4EFE4) !important;border-color:var(--navy) !important;box-shadow: 0 2px 6px rgba(19, 35, 58, 0.16) !important;}
.btn-primary:hover {background:#1B2F4A !important;border-color:#1B2F4A !important;color:#FFFFFF !important;box-shadow: 0 6px 16px rgba(19, 35, 58, 0.24) !important;}
.btn-outline {border-color:var(--navy) !important;color:var(--navy) !important;background:transparent !important;box-shadow:none !important;}
.btn-outline:hover {background:var(--gold-pale, #F0E2C8) !important;border-color:var(--gold, #A8781A) !important;color:var(--navy) !important}
.btn-gold {background:var(--gold) !important;color:#fff !important;border-color:var(--gold) !important}
.btn-gold:hover {background:#936414 !important;border-color:#936414 !important}
.arrow {color:var(--gold, #A8781A) !important;font-size:15px !important;font-weight:600 !important;line-height:1 !important;display:inline-block !important;transition:transform .2s ease, color .2s ease !important;}
.btn:hover .arrow {transform:translateX(3px) !important;color:#C28A25 !important;}

.section {padding:62px 0}
.benefits {
  background: var(--navy, #13233A) !important;
  color: #FFFFFF;
  border-top: 1px solid rgba(168, 120, 26, 0.25);
  border-bottom: 1px solid rgba(168, 120, 26, 0.25);
}
.benefits .eyebrow {
  color: #D4A647 !important;
}
.benefits .section-title {
  color: #FFFFFF !important;
}
.benefits .lead {
  color: rgba(244, 239, 228, 0.88) !important;
}
.benefits-grid {display:grid;grid-template-columns:clamp(340px,38%,440px) minmax(0, 1fr);gap:48px;align-items:center}
.rounded-photo {overflow:hidden;border-radius:12px;background:#e5d4b8;box-shadow:0 10px 24px rgba(44,32,14,.07);width:100%;max-width:460px;aspect-ratio:4 / 3;margin-inline:auto}
.rounded-photo img {width:100%;height:100%;aspect-ratio:4 / 3;object-fit:cover;object-position:center;display:block}
.benefit-photo {aspect-ratio:4 / 3;height:auto}
.benefits .benefit-photo {
  border: 1px solid rgba(168, 120, 26, 0.35);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
}
.benefit-content .section-title {max-width:570px}
.feature-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.feature-icon {width:48px;height:48px;border-radius:10px;background:#efe2cb;display:grid;place-items:center;color:var(--gold-dark);font-size:23px;margin-bottom:12px}
.benefits .feature-icon {
  background: rgba(168, 120, 26, 0.18) !important;
  border: 1px solid rgba(168, 120, 26, 0.4) !important;
  color: #E8C982 !important;
}
.feature h3 {font-size:clamp(17px, 1.2vw, 19px);line-height:1.35;margin:0 0 6px;color:var(--navy)}
.benefits .feature h3 {
  color: #FFFFFF !important;
}
.feature p {font-size:15px;line-height:1.6;color:var(--muted);margin:0}
.benefits .feature p {
  color: rgba(244, 239, 228, 0.78) !important;
}
.support-grid {display:grid;grid-template-columns:minmax(0, 1fr) clamp(340px,38%,440px);gap:64px;align-items:center}
.support-copy .lead {max-width:500px}
.check-list {padding:0;margin:24px 0 0;list-style:none;display:grid;gap:10px}
.check-list li {display:flex;align-items:flex-start;gap:12px;font-size:15px;color:#314157}
.check {width:18px;height:18px;flex:0 0 18px;border-radius:50%;display:grid;place-items:center;background:var(--gold);color:white;font-size:11px;margin-top:1px}
.support-photo {aspect-ratio:4 / 3;height:auto}
