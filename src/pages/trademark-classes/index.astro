---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import FaqItem from '../../components/FaqItem.astro';

const title = "Trademark Classes in India | NICE Guide | BRNDNUR";
const description = "Understand Indian trademark classes under the NICE classification system. Identify the right goods and services classes for your brand with BRNDNUR.";
const canonical = "https://brndnur.com/trademark-classes/";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Trademark Classes",
  "sectionName": "Hero Section",
  "enquiryType": "Trademark Class Selection",
  "topic": "I need assistance identifying the appropriate trademark class or classes for my business.",
  "details": "Business or brand name: [Please enter]\\nProducts or services: [Please describe]",
  "callToAction": "Could you please guide me on the suitable classes and registration process?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Trademark Classes",
  "sectionName": "Closing CTA Band",
  "enquiryType": "Classification Advisory",
  "topic": "I have reviewed your Nice Classification guide and would like help determining the exact classes for my products and services.",
  "details": "My products / activities: [Please describe briefly]",
  "callToAction": "Could you please provide guidance on cross-class coverage and filing strategy?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/trademark-classes/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Classification Guidance"
      title="Find the Right Trademark<br>Class for <span>Your Brand.</span>"
      hasGoldRule={true}
      description="Under the Trade Marks Act, 1999, trademarks in India are classified into 45 distinct categories based on the international NICE classification system. Choosing the correct class ensures your statutory protection aligns with what you actually sell."
      primaryCta={{
        text: "Request Class Consultation",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Check Brand Name",
        href: "/brand-name-search/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "45 NICE Classes", subtitle: "Categories" },
        { icon: "▱", title: "Classes 1–34", subtitle: "Physical Goods" },
        { icon: "⌖", title: "Classes 35–45", subtitle: "Services" }
      ]}
      image="/assets/classes-hero-catalog.webp"
      imageAlt="Organized intellectual property classification folders, gold tabs, index ledger, and magnifying glass"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo split-photo--portrait" data-ratio="portrait">
          <img src="/assets/classes-avoid-overfiling.webp" alt="BRNDNUR trademark classification consultation and guidance" width="800" height="600" loading="lazy" decoding="async" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Strategic Precision</p>
          <h2>Avoiding Over-Filing and Under-Protection.</h2>
          <div class="gold-rule"></div>
          <p>Selecting the wrong trademark class can leave your primary commercial revenue stream completely unprotected. Conversely, blindly applying across unrelated classes drives up unnecessary statutory fees without practical legal benefit.</p>
          <p>Our advisory team conducts a rigorous commercial mapping: we review your current catalog, upcoming product extensions, and distribution channels to recommend the exact primary and complementary classes required under Indian law.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Statutory Fee Alignment</strong>
                <p>Government fees are charged per mark per class (₹4,500 MSME / ₹9,000 Standard). We prevent wasteful filings.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Expansion-Ready Scope</strong>
                <p>Drafting precise specifications that protect planned product launches without inviting third-party objections.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Co-Related Class Screening</strong>
                <p>Ensuring cross-class protection across interrelated categories such as foods (29/30) and apparel retail (25/35).</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Most Common Commercial Classes -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Popular Sectors</p>
          <h2>Most Actively Filed Classes in India.</h2>
          <div class="gold-rule"></div>
          <p>Key categories covering primary manufacturing, retail, and service businesses.</p>
        </div>

        <CardCarousel id="classes-sectors-carousel" ariaLabel="Popular trademark classes in India">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">29</div>
              <h3>Class 29 &amp; 30 — Food &amp; Spices</h3>
              <p>Class 29 covers edible oils, dairy, meat, and processed foods. Class 30 covers spices, tea, coffee, bakery products, confectionery, and packaged snacks.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">25</div>
              <h3>Class 25 — Clothing &amp; Footwear</h3>
              <p>The definitive category for fashion labels, garments, readymade apparel, headgear, footwear, and textile merchandise.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">35</div>
              <h3>Class 35 — Retail &amp; E-Commerce</h3>
              <p>Essential for retail stores, wholesale distribution, supermarkets, online marketplaces, advertising agencies, and commercial management.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">43</div>
              <h3>Class 43 — Restaurants &amp; Hospitality</h3>
              <p>Covers cafes, dining establishments, cloud kitchens, catering operations, hotels, and temporary accommodation services.</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Classification Overview Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Comprehensive Breakdown</p>
          <h2>NICE Classification Overview.</h2>
          <div class="gold-rule"></div>
          <p>International standard recognized by the Indian Trade Marks Registry.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Classification Group</th>
                <th>Class Range</th>
                <th>Representative Industries &amp; Items</th>
                <th>Statutory Type</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Industrial &amp; Raw Materials</strong></td>
                <td>Classes 1 &ndash; 7</td>
                <td>Chemicals, paints, lubricants, pharmaceuticals, metals, machinery</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Electronics &amp; Appliances</strong></td>
                <td>Classes 8 &ndash; 15</td>
                <td>Hand tools, electronics/software, medical devices, lighting, vehicles</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Consumer Goods &amp; Apparel</strong></td>
                <td>Classes 16 &ndash; 28</td>
                <td>Paper/print, leather, textiles, clothing (Cl 25), toys</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Food, Agricultural &amp; Beverages</strong></td>
                <td>Classes 29 &ndash; 34</td>
                <td>Dairy/meat (Cl 29), spices/grain (Cl 30), fresh produce, beverages</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Business &amp; Commercial Services</strong></td>
                <td>Classes 35 &amp; 36</td>
                <td>Retail/e-commerce (Cl 35), finance, real estate, insurance</td>
                <td>Services (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Hospitality, Tech &amp; Legal Services</strong></td>
                <td>Classes 37 &ndash; 45</td>
                <td>Construction, telecom, tech/SaaS (Cl 42), restaurants (Cl 43)</td>
                <td>Services (Form TM-A)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- How Class Selection Fits Into Your Application (Process Steps) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Strategic Methodology</p>
          <h2>How We Map Your Trademark Classes.</h2>
          <div class="gold-rule"></div>
          <p>A rigorous 3-step advisory sequence to ensure complete coverage without unnecessary government expense.</p>
        </div>

        <CardCarousel id="classes-methodology-carousel" ariaLabel="How we map trademark classes">
          <article class="step">
            <div class="step-top">
              <span class="step-num">01</span>
              <span class="step-line"></span>
            </div>
            <h3>Catalog Inventory Review</h3>
            <p>We analyze your active product catalog, packaging SKUs, and service menus to identify immediate core classification categories.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">02</span>
              <span class="step-line"></span>
            </div>
            <h3>Cross-Class Conflict Check</h3>
            <p>We screen closely related classes (e.g. food manufacture in 29/30 vs. restaurant service in 43) to prevent competitor encroachment.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">03</span>
              <span class="step-line"></span>
            </div>
            <h3>Precise Specification Drafting</h3>
            <p>We draft narrow, accurate descriptions of goods or services matching official NICE classification terms to minimize registry office actions.</p>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Preparation Checklist & FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Class Selection FAQs</p>
          <h2>Common Classification Questions.</h2>
          <div class="gold-rule"></div>
          <p>Practical guidance regarding multi-class applications, statutory fees, and future catalog extensions.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Can I apply for a trademark in multiple classes simultaneously?"
            answer="Yes. You can file a multi-class application using Form TM-A covering several classes at once. However, statutory government fees are payable per class (e.g., ₹4,500 per class for MSME/individuals). Filing separate single-class applications is often strategically preferred so that an objection in one class does not delay registration in other clear classes."
          />
          <FaqItem
            num="02"
            question="What is the difference between goods classes and services classes?"
            answer="Classes 1 through 34 cover physical manufactured goods (such as apparel, packaged food, pharmaceuticals, and cosmetics). Classes 35 through 45 cover services (such as retail store operation, advertising, software development, healthcare, and restaurant dining)."
          />
          <FaqItem
            num="03"
            question="Can I add additional classes to my registered trademark later?"
            answer="No. Once an application is filed, you cannot add new classes or substantially expand the scope of goods/services. If your business expands into new product categories later, you must file a new trademark application for those additional classes."
          />
          <FaqItem
            num="04"
            question="What information should I prepare before our class consultation?"
            answer="Prepare a comprehensive list of all goods currently manufactured or sold, your commercial sales channels (online marketplace, retail shop, export), and any planned products you intend to launch within the next 12 to 24 months."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Unsure About Your Class?</p>
          <h2>Let Our Team Map<br>Your Catalog.</h2>
          <p>Share a list of your products or commercial services. We will identify the precise classes required under the Trade Marks Act, 1999.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Consult on WhatsApp <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Accurate Mapping</strong>
              <p>Classification matched to your exact business activities.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Cost Optimization</strong>
              <p>Eliminate unnecessary classes while protecting real assets.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Complete Protection</strong>
              <p>Covers both goods and sales distribution channels.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
