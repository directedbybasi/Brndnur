---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Trademark Classes in India | NICE Classification Guide";
const description = "Understand Indian trademark classes under the NICE classification system. Identify the right goods and services classes for your brand with BRNDNUR.";
const canonical = "https://brndnur.com/trademark-classes/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/trademark-classes/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/services/">Services</a>
          <span class="sep">/</span>
          <span class="current">Trademark Classes</span>
        </nav>
        <p class="eyebrow">Classification Guidance</p>
        <h1>Find the Right Trademark Class for Your Brand.</h1>
        <p class="lead">Under the Trade Marks Act, 1999, trademarks in India are classified into 45 distinct categories based on the international NICE classification system. Choosing the correct class ensures your statutory protection aligns with what you actually sell.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span>45 NICE Classification Categories</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span>Classes 1–34: Physical Goods</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Classes 35–45: Commercial Services</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20need%20help%20identifying%20my%20trademark%20class." target="_blank" rel="noopener noreferrer">Request Class Consultation &rarr;</a>
          <a class="btn btn-outline" href="/brand-name-search/">Check Brand Name</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/services/assets/why-brndnur.webp" alt="BRNDNUR trademark classification consultation and guidance" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Strategic Precision</p>
            <h2>Avoiding Over-Filing and Under-Protection</h2>
            <p>Selecting the wrong trademark class can leave your primary commercial revenue stream completely unprotected. Conversely, blindly applying across unrelated classes drives up unnecessary statutory fees without practical legal benefit.</p>
            <p>Our advisory team conducts a rigorous commercial mapping: we review your current catalog, upcoming product extensions, and distribution channels to recommend the exact primary and complementary classes required under Indian law.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>Statutory Fee Multiplier</h4>
                <p>Government statutory filing fees are charged per mark per class (₹4,500 for MSMEs/individuals, ₹9,000 for standard companies). A multi-class application for two classes incurs 2x statutory fees.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Most Common Commercial Classes with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Popular Sectors</p>
          <h2>Most Actively Filed Classes in India</h2>
          <p>Key categories covering primary manufacturing, retail, and service businesses.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
            </div>
            <h3>Class 29 & 30 — Food & Spices</h3>
            <p>Class 29 covers edible oils, dairy, meat, and processed fruits. Class 30 covers spices, tea, coffee, bakery products, confectionery, and packaged snacks.</p>
            <a class="card-link" href="/packages/food-brand/">View Food Package &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
            </div>
            <h3>Class 25 — Clothing & Footwear</h3>
            <p>Covers all ready-made garments, headgear, footwear, sports apparel, and fashion accessories. The single most contested class in Indian trade.</p>
            <a class="card-link" href="/trademark-registration/">Register in Class 25 &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </div>
            <h3>Class 35 — Retail, E-Commerce & Ads</h3>
            <p>Essential for retail stores, supermarkets, e-commerce platforms, brand distribution networks, marketing agencies, and corporate management.</p>
            <a class="card-link" href="/services/">Explore Service Filings &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <h3>Class 42 — Technology & SaaS</h3>
            <p>Covers software development, cloud hosting, SaaS platforms, IT architecture, website design, and mobile application engineering.</p>
            <a class="card-link" href="/contact/">Consult on Tech Brands &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
            </div>
            <h3>Class 43 — Restaurants & Hospitality</h3>
            <p>Covers restaurants, cafes, cloud kitchens, catering, food delivery outlets, hotels, resorts, and temporary accommodation providers.</p>
            <a class="card-link" href="/packages/food-brand/">Explore Hospitality Filings &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m14 2-3 3 7 7 3-3a3 3 0 0 0 0-4.24l-2.76-2.76A3 3 0 0 0 14 2z"/><path d="m10 6-7 7 3 3 7-7"/><line x1="3" y1="21" x2="5" y2="19"/></svg>
            </div>
            <h3>Class 03 — Cosmetics & Personal Care</h3>
            <p>Covers skincare formulations, beauty soaps, organic cosmetics, perfumes, hair oils, essential oils, and herbal personal care products.</p>
            <a class="card-link" href="/trademark-registration/">Protect Cosmetic Brands &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive NICE Overview Matrix -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Classification Reference</p>
          <h2>NICE Goods vs Services Summary</h2>
          <p>Structural overview of all 45 international trademark classes.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Category</th>
                <th>Class Range</th>
                <th>Representative Industry Examples</th>
                <th>Statutory Filing Unit</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Chemicals & Raw Materials</strong></td>
                <td>Classes 1 &ndash; 4</td>
                <td>Industrial chemicals, paints, lubricants, industrial oils</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Health & Personal Care</strong></td>
                <td>Classes 3 & 5</td>
                <td>Cosmetics, soaps, pharmaceuticals, dietary supplements</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Electronics & Hardware</strong></td>
                <td>Classes 6 &ndash; 14</td>
                <td>Metals, machinery, electronics, computers, jewelry</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Consumer Goods & Apparel</strong></td>
                <td>Classes 16 &ndash; 28</td>
                <td>Paper/print, leather, textiles, clothing (Cl 25), toys</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Food, Agricultural & Beverages</strong></td>
                <td>Classes 29 &ndash; 34</td>
                <td>Dairy/meat (Cl 29), spices/grain (Cl 30), fresh produce, beverages</td>
                <td>Goods (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Business & Commercial Services</strong></td>
                <td>Classes 35 & 36</td>
                <td>Retail/e-commerce (Cl 35), finance, real estate, insurance</td>
                <td>Services (Form TM-A)</td>
              </tr>
              <tr>
                <td><strong>Hospitality, Tech & Legal Services</strong></td>
                <td>Classes 37 &ndash; 45</td>
                <td>Construction, telecom, tech/SaaS (Cl 42), restaurants (Cl 43)</td>
                <td>Services (Form TM-A)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Unsure About Your Class?</p>
          <h2>Let Our Advisory Team Map Your Catalog.</h2>
          <p>Share a list of your products or commercial services. We will identify the precise classes required under the Trade Marks Act.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20help%20me%20identify%20my%20trademark%20class." target="_blank" rel="noopener noreferrer">Consult on WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/packages/">View Packages & Pricing</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
