---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const title = "Contact Us | BRNDNUR Advisory LLP";
const description = "Connect with BRNDNUR Advisory LLP in Manjeri, Malappuram, Kerala. Contact us via WhatsApp, phone, or email for trademark and business advisory support.";
const canonical = "https://brndnur.com/contact/";

const contactHeroWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Contact Page',
  sectionName: 'Hero Section',
  enquiryType: 'General Enquiry',
  message: 'Hi BRNDNUR, I visited your contact page and would like to discuss my brand protection or business registration requirement directly with an advisor. Could you please guide me on how to proceed?'
});

const contactChannelWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Contact Page',
  sectionName: 'Direct WhatsApp Channel Card',
  enquiryType: 'Direct WhatsApp Consultation',
  message: 'Hi BRNDNUR, I am reaching out through your direct WhatsApp channel to enquire about trademark registration and business advisory services. Could you please explain how we can get started?'
});

const contactClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Contact Page',
  sectionName: 'Closing Consultation Section',
  enquiryType: 'Immediate Advisory Consultation',
  message: 'Hi BRNDNUR, I would like an immediate WhatsApp consultation regarding brand protection or business registration. Could you please review my requirement and guide me towards the suitable service, fees, and next steps?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/contact/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Get In Touch"
      title="Let’s Talk About<br><span>Your Brand.</span>"
      hasGoldRule={true}
      description="Reach out to discuss your brand name, explore trademark protection, or request tailored guidance for your business registrations. Our team in Manjeri, Kerala is here to assist you."
      primaryCta={{
        text: "Chat on WhatsApp",
        href: contactHeroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Call +91 90481 88899",
        href: "tel:+919048188899",
        icon: "→"
      }}
      trustBadges={[
        { icon: "☏", title: "Direct Advisory", subtitle: "+91 90481 88899" },
        { icon: "▱", title: "Based in", subtitle: "Skatt Business Park, Manjeri" },
        { icon: "⌖", title: "Mon – Sat", subtitle: "9:30 AM – 6:00 PM" }
      ]}
      image="/assets/contact-hero-consultation.webp"
      imageAlt="BRNDNUR Advisory executive consultation desk in Kerala"
    />

    <!-- Channels Grid (Harmonized with Reference Component Style) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Direct Channels</p>
          <h2>How You Can Reach Us.</h2>
          <div class="gold-rule"></div>
          <p>Choose the communication channel that suits you best. We respond promptly during normal business hours.</p>
        </div>

        <div class="service-grid">
          <article class="service-card contact-card">
            <div class="contact-card-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12.01 2.001c-5.502 0-9.98 4.478-9.98 9.98 0 1.76.46 3.475 1.332 4.992L2.001 22l5.16-1.353a9.948 9.948 0 0 0 4.849 1.258h.004c5.501 0 9.98-4.479 9.98-9.98 0-2.667-1.038-5.174-2.924-7.06A9.918 9.918 0 0 0 12.01 2zM12.01 20.25a8.27 8.27 0 0 1-4.223-1.152l-.303-.18-3.139.823.838-3.061-.197-.314a8.276 8.276 0 0 1-1.268-4.436c0-4.57 3.719-8.289 8.29-8.289 2.215 0 4.297.863 5.863 2.43 1.566 1.566 2.428 3.649 2.428 5.864 0 4.572-3.719 8.29-8.29 8.29zm4.542-6.196c-.249-.125-1.472-.726-1.7-.809-.228-.083-.394-.125-.56.125-.166.249-.643.809-.788.975-.145.166-.29.187-.539.062-.249-.125-1.052-.388-2.004-1.237-.741-.661-1.241-1.478-1.386-1.727-.145-.249-.015-.383.109-.507.112-.112.249-.29.373-.435.125-.145.166-.249.249-.415.083-.166.042-.311-.021-.436-.062-.124-.56-1.349-.768-1.848-.202-.486-.407-.42-.56-.427l-.478-.008c-.166 0-.435.062-.663.311-.228.249-.871.851-.871 2.075 0 1.224.892 2.407 1.016 2.573.124.166 1.755 2.68 4.252 3.757.594.256 1.058.41 1.419.525.597.19 1.141.163 1.571.099.479-.072 1.472-.602 1.68-1.183.207-.581.207-1.079.145-1.183-.062-.104-.228-.166-.477-.291z"/></svg>
            </div>
            <h3>WhatsApp Consultation</h3>
            <p>Our fastest and most convenient communication channel for preliminary inquiries, document sharing, and status updates.</p>
            <div class="contact-highlight">+91 90481 88899</div>
            <a class="btn btn-primary btn-block" href={contactChannelWhatsAppUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span class="arrow">→</span></a>
          </article>

          <article class="service-card contact-card">
            <div class="contact-card-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <h3>Telephone Inquiry</h3>
            <p>Speak directly with our advisory coordinators during normal business hours (Monday to Saturday, 9:30 AM to 6:00 PM IST).</p>
            <div class="contact-highlight">+91 90481 88899</div>
            <a class="btn btn-primary btn-block" href="tel:+919048188899">Call Directly <span class="arrow">→</span></a>
          </article>

          <article class="service-card contact-card">
            <div class="contact-card-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <h3>Email Correspondence</h3>
            <p>Send formal documentation, search inquiries, or multi-class service proposals directly to our inbox.</p>
            <div class="contact-highlight contact-email">brndnuradvisoryllp@gmail.com</div>
            <a class="btn btn-outline btn-block" href="mailto:brndnuradvisoryllp@gmail.com">Send an Email <span class="arrow">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <!-- Two Column: Consultation Form + Office Location -->
    <section class="section">
      <div class="container">
        <div class="contact-split-grid">
          <!-- Left: Direct Interactive Inquiry Builder (Zero Fake Success) -->
          <div class="inquiry-card">
            <p class="eyebrow">Quick Inquiry</p>
            <h2>Start an Advisory Discussion</h2>
            <div class="gold-rule"></div>
            <p class="inquiry-subtitle">
              Fill in your preliminary details to initiate a direct conversation with our advisory desk.
            </p>

            <form id="contact-inquiry-form" class="inquiry-form">
              <div>
                <label for="client-name">Your Name / Enterprise Name *</label>
                <input type="text" id="client-name" name="client-name" aria-label="Your Name or Enterprise Name" required placeholder="e.g. Rahul Sharma / Malabar Spices" class="form-input" />
              </div>

              <div>
                <label for="client-phone">Phone / WhatsApp Number *</label>
                <input type="tel" id="client-phone" name="client-phone" aria-label="Phone or WhatsApp Number" required placeholder="+91 98765 43210" class="form-input" />
              </div>

              <div>
                <label for="client-service">Service Required *</label>
                <select id="client-service" name="client-service" aria-label="Service Required" class="form-select">
                  <option value="Trademark Registration">Trademark Registration (Form TM-A)</option>
                  <option value="Brand Name Search">Preliminary Brand Name Search & Clearance</option>
                  <option value="GST & Udyam MSME Setup">GST & Udyam MSME Setup</option>
                  <option value="FSSAI Food License">FSSAI Food Licensing Package</option>
                  <option value="Gulf Return Business Advisory">Gulf-Return Business Setup</option>
                  <option value="General Consultation">General Commercial Advisory</option>
                </select>
              </div>

              <div>
                <label for="client-details">Brand Name or Requirements (Optional)</label>
                <textarea id="client-details" name="client-details" aria-label="Brand Name or Requirements" rows="3" placeholder="Tell us your proposed brand name or specific questions..." class="form-textarea"></textarea>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="width: 100%;">Chat on WhatsApp <span class="arrow">→</span></button>
              </div>
            </form>
          </div>

          <!-- Right: Registered Office & Details -->
          <div class="office-card">
            <!-- Digital Business Card Visual (Matching Approved Reference) -->
            <div class="bn-business-card" aria-label="BRNDNUR Advisory LLP Official Business Card">
              <div class="bn-card-header">
                <img src="/assets/brndnur-logo-transparent.png" alt="BRNDNUR Advisory LLP" class="bn-card-logo" width="190" height="63" loading="eager" />
                <span class="bn-card-tagline">LIGHT UP YOUR BRAND</span>
              </div>
              <div class="bn-card-divider" aria-hidden="true"></div>
              <div class="bn-card-body">
                <div class="bn-card-row">
                  <svg class="bn-card-pin" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 22s7-7.4 7-13a7 7 0 1 0-14 0c0 5.6 7 13 7 13Z"/>
                    <circle cx="12" cy="9" r="2.4"/>
                  </svg>
                  <span class="bn-card-address">Skatt Business Park, Manjeri</span>
                </div>
                <div class="bn-card-row">
                  <svg class="bn-card-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                  <span>brndnur.com</span>
                </div>
                <div class="bn-card-row">
                  <svg class="bn-card-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L7.7 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 2.2 2.5Z"/>
                  </svg>
                  <span>+91 9048 188 899</span>
                </div>
                <div class="bn-card-row">
                  <svg class="bn-card-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2Z"/>
                    <path d="m22 6-10 7L2 6"/>
                  </svg>
                  <span>brndnuradvisoryllp@gmail.com</span>
                </div>
              </div>
            </div>

            <p class="eyebrow" style="margin-top: 1.75rem;">Registered Office</p>
            <h2>BRNDNUR Advisory LLP</h2>
            <div class="gold-rule"></div>

            <div class="office-details">
              <div>
                <strong>Office Location:</strong>
                Skatt Business Park, Manjeri
              </div>

              <div>
                <strong>Advisory Hours:</strong>
                Monday to Saturday: 9:30 AM &ndash; 6:00 PM IST<br>
                Sunday: Closed (Digital inquiries queued)
              </div>

              <div>
                <strong>Statutory Jurisdictions Served:</strong>
                &bull; Trade Marks Registry, Chennai (Kerala jurisdiction)<br>
                &bull; Ministry of Corporate Affairs (MCA)<br>
                &bull; Ministry of MSME (Udyam)<br>
                &bull; FSSAI National Food Authority
              </div>

              <div class="office-callout">
                <strong>Remote &amp; Pan-India Collaboration</strong>
                <p>
                  Our trademark and business filing processes are 100% digitally executed across all Indian states and for NRI founders globally.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Direct Contact</p>
          <h2>Prefer an Immediate WhatsApp Consultation?</h2>
          <p>Send your brand name and questions directly to our advisory coordinators. We review preliminary availability and provide clear scope guidance.</p>
          <a class="btn btn-gold" href={contactClosingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp Directly <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Quick Response</strong>
              <p>Direct communication without intermediaries.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Confidential Discussions</strong>
              <p>Your brand name is kept strictly private.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Expert Clarifications</strong>
              <p>Understand classes, costs, and timeline expectations.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    document.getElementById('contact-inquiry-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const name = document.getElementById('client-name').value;
      const phone = document.getElementById('client-phone').value;
      const service = document.getElementById('client-service').value;
      const details = document.getElementById('client-details').value;

      const notesLine = details ? ` Requirement notes: ${details}.` : '';
      const message = encodeURIComponent(
        `Hi BRNDNUR, my name is ${name}. I am contacting you regarding ${service} for my business.${notesLine} Could you please review my enquiry, explain the applicable documents and fees, and advise on the next steps?`
      );

      window.open(`https://wa.me/919048188899?text=${message}`, '_blank');
    });
  </script>
</BaseLayout>

<style>
  .contact-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .contact-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 4px;
    background: var(--gold-pale);
    display: grid;
    place-items: center;
    color: var(--gold-dark);
    font-size: 20px;
    margin-bottom: 1rem;
  }
  .contact-card h3 {
    font-size: 1.25rem;
    margin-bottom: .5rem;
  }
  .contact-card p {
    font-size: var(--font-card-body, clamp(0.9375rem, 0.91rem + 0.15vw, 1rem));
    line-height: 1.65;
    margin-bottom: 1rem;
    flex: 1;
  }
  .contact-highlight {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .contact-email {
    font-size: 0.9375rem;
    word-break: break-all;
  }
  .btn-block {
    width: 100%;
    margin-top: auto;
  }
  .contact-split-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .inquiry-card, .office-card {
    background: rgba(255, 252, 246, 0.85);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: clamp(24px, 3vw, 36px);
    box-shadow: 0 4px 16px rgba(19, 35, 58, 0.04);
  }
  .inquiry-card h2, .office-card h2 {
    font-size: clamp(1.5rem, 2.5vw, 1.85rem);
    margin-bottom: .5rem;
  }
  .inquiry-subtitle {
    font-size: var(--font-body, 1rem);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .inquiry-form {
    display: grid;
    gap: 1rem;
  }
  .form-input, .form-select, .form-textarea {
    width: 100%;
  }
  .form-actions {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: .5rem;
  }
  .office-details {
    display: grid;
    gap: 1.25rem;
    font-size: var(--font-body, 1rem);
    color: var(--body);
    line-height: 1.65;
  }
  .office-details strong {
    color: var(--navy);
    display: block;
    margin-bottom: .25rem;
  }
  .office-callout {
    margin-top: .5rem;
    padding: 1rem;
    background: var(--ivory-soft);
    border-left: 3px solid var(--gold);
    border-radius: 0 4px 4px 0;
  }
  .office-callout p {
    margin: 0;
    font-size: var(--font-card-body, clamp(0.9375rem, 0.91rem + 0.15vw, 1rem));
    line-height: 1.65;
    color: var(--body);
  }
  @media (max-width: 900px) {
    .contact-split-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Digital Business Card Visual Styles */
  .bn-business-card {
    background: #FAF7F0;
    color: #13233A;
    border: 1px solid rgba(168, 120, 26, 0.4);
    border-radius: 8px;
    padding: clamp(20px, 2.5vw, 26px);
    box-shadow: 0 6px 20px rgba(19, 35, 58, 0.08);
    position: relative;
    overflow: hidden;
  }
  .bn-card-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 12px;
  }
  .bn-card-logo {
    max-height: 48px;
    width: auto;
    object-fit: contain;
  }
  .bn-card-tagline {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #A8781A;
    text-transform: uppercase;
  }
  .bn-card-divider {
    height: 1.5px;
    background: linear-gradient(90deg, rgba(168, 120, 26, 0.8) 0%, rgba(168, 120, 26, 0.15) 100%);
    margin: 10px 0 14px 0;
  }
  .bn-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.9125rem;
  }
  .bn-card-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #13233A;
  }
  .bn-card-pin {
    color: #A8781A;
    flex-shrink: 0;
  }
  .bn-card-icon {
    color: #A8781A;
    flex-shrink: 0;
  }
  .bn-card-address {
    font-weight: 700;
    color: #13233A;
  }
</style>
