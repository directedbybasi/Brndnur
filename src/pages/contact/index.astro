---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Contact Us | BRNDNUR Advisory LLP";
const description = "Connect with BRNDNUR Advisory LLP in Manjeri, Malappuram, Kerala. Contact us via WhatsApp, phone, or email for trademark and business advisory support.";
const canonical = "https://brndnur.com/contact/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/contact/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">Contact</span>
        </nav>
        <p class="eyebrow">Get In Touch</p>
        <h1>Let’s Talk About Your Brand.</h1>
        <p class="lead">Reach out to discuss your brand name, explore trademark protection, or request tailored guidance for your business registrations.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Manjeri, Malappuram, Kerala</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Direct WhatsApp Advisory: +91 90481 88899</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Mon &ndash; Sat, 9:30 AM &ndash; 6:00 PM IST</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Channels Grid with SVGs -->
    <section class="section">
      <div class="container">
        <div class="card-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <h3>WhatsApp Consultation</h3>
            <p>Our fastest and most convenient communication channel for preliminary inquiries, document sharing, and status updates.</p>
            <p style="font-size: 16px; margin: 12px 0;"><strong>+91 90481 88899</strong></p>
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%20Advisory%2C%20I%20would%20like%20to%20discuss%20my%20requirements." target="_blank" rel="noopener noreferrer">Chat on WhatsApp &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <h3>Telephone Inquiry</h3>
            <p>Speak directly with our advisory coordinators during normal business hours (Monday to Saturday, 9:30 AM to 6:00 PM IST).</p>
            <p style="font-size: 16px; margin: 12px 0;"><strong>+91 90481 88899</strong></p>
            <a class="btn btn-primary" href="tel:+919048188899">Call Directly &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <h3>Email Correspondence</h3>
            <p>Send formal documentation, search inquiries, or multi-class service proposals directly to our inbox.</p>
            <p style="font-size: 16px; margin: 12px 0;"><strong>brndnuradvisoryllp@gmail.com</strong></p>
            <a class="btn btn-outline" href="mailto:brndnuradvisoryllp@gmail.com">Send an Email &rarr;</a>
          </div>
        </div>

        <!-- Two Column: Consultation Form + Office Location -->
        <div style="margin-top: 56px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(32px, 4vw, 56px); align-items: start;">
          <!-- Left: Direct Interactive Inquiry Builder (Zero Fake Success) -->
          <div style="background: #FFFCF6; border: 1px solid #DCCEB6; border-radius: 10px; padding: clamp(24px, 3vw, 36px); box-shadow: 0 4px 16px rgba(19, 35, 58, 0.04);">
            <p class="eyebrow">Quick Inquiry</p>
            <h2 style="font-family: var(--bn-serif); font-size: 24px; margin: 0 0 10px; color: #13233A;">Start an Advisory Discussion</h2>
            <p style="color: #566174; font-size: 14.5px; line-height: 1.6; margin: 0 0 20px;">
              Fill in your preliminary details to initiate a direct conversation with our advisory desk.
            </p>

            <form id="contact-inquiry-form" onsubmit="event.preventDefault(); submitInquiry();" style="display: grid; gap: 16px;">
              <div>
                <label for="client-name" style="display: block; font-size: 13px; font-weight: 600; color: #13233A; margin-bottom: 6px;">Your Name / Enterprise Name *</label>
                <input type="text" id="client-name" required placeholder="e.g. Rahul Sharma / Malabar Spices" style="width: 100%; padding: 10px 14px; border: 1px solid #DCCEB6; border-radius: 6px; font-family: inherit; font-size: 14px; background: #FFF;" />
              </div>

              <div>
                <label for="client-phone" style="display: block; font-size: 13px; font-weight: 600; color: #13233A; margin-bottom: 6px;">Phone / WhatsApp Number *</label>
                <input type="tel" id="client-phone" required placeholder="+91 98765 43210" style="width: 100%; padding: 10px 14px; border: 1px solid #DCCEB6; border-radius: 6px; font-family: inherit; font-size: 14px; background: #FFF;" />
              </div>

              <div>
                <label for="client-service" style="display: block; font-size: 13px; font-weight: 600; color: #13233A; margin-bottom: 6px;">Service Required *</label>
                <select id="client-service" style="width: 100%; padding: 10px 14px; border: 1px solid #DCCEB6; border-radius: 6px; font-family: inherit; font-size: 14px; background: #FFF;">
                  <option value="Trademark Registration">Trademark Registration (Form TM-A)</option>
                  <option value="Brand Name Search">Preliminary Brand Name Search & Clearance</option>
                  <option value="GST & Udyam MSME Setup">GST & Udyam MSME Setup</option>
                  <option value="FSSAI Food License">FSSAI Food Licensing Package</option>
                  <option value="Gulf Return Business Advisory">Gulf-Return Business Setup</option>
                  <option value="General Advisory">General Advisory Inquiry</option>
                </select>
              </div>

              <div>
                <label for="client-note" style="display: block; font-size: 13px; font-weight: 600; color: #13233A; margin-bottom: 6px;">Brand Name or Requirements (Optional)</label>
                <textarea id="client-note" rows="3" placeholder="Tell us your proposed brand name or specific questions..." style="width: 100%; padding: 10px 14px; border: 1px solid #DCCEB6; border-radius: 6px; font-family: inherit; font-size: 14px; background: #FFF;"></textarea>
              </div>

              <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px;">
                <button type="submit" class="btn btn-gold" style="cursor: pointer; border: none;">
                  Chat on WhatsApp &rarr;
                </button>
                <button type="button" onclick="submitEmail()" class="btn btn-outline" style="cursor: pointer;">
                  Send via Email
                </button>
              </div>
            </form>
          </div>

          <!-- Right: Registered Office & Details -->
          <div style="background: #F4EFE4; border: 1px solid #DCCEB6; border-radius: 10px; padding: clamp(24px, 3vw, 36px);">
            <p class="eyebrow">Registered Office</p>
            <h2 style="font-family: var(--bn-serif); font-size: 24px; margin: 0 0 14px; color: #13233A;">BRNDNUR Advisory LLP</h2>
            
            <p style="color: #46536A; font-size: 14.5px; line-height: 1.65; margin: 0 0 16px;">
              <strong>Office Location:</strong><br />
              Manjeri, Malappuram District,<br />
              Kerala, India &ndash; PIN 676121
            </p>

            <p style="color: #46536A; font-size: 14.5px; line-height: 1.65; margin: 0 0 16px;">
              <strong>Advisory Hours:</strong><br />
              Monday to Saturday: 9:30 AM &ndash; 6:00 PM IST<br />
              Sunday: Closed (Digital inquiries queued)
            </p>

            <p style="color: #46536A; font-size: 14.5px; line-height: 1.65; margin: 0 0 20px;">
              <strong>Statutory Jurisdictions Served:</strong><br />
              &bull; Trade Marks Registry, Chennai (Kerala jurisdiction)<br />
              &bull; Ministry of Corporate Affairs (MCA)<br />
              &bull; Ministry of MSME (Udyam)<br />
              &bull; FSSAI National Food Authority
            </p>

            <div class="advisory-notice" style="margin: 0; padding: 14px 18px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4 style="font-size: 15px;">Remote & Pan-India Collaboration</h4>
                <p style="font-size: 13px;">Our trademark and business filing processes are 100% digitally executed across all Indian states and for NRI founders globally.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  function submitInquiry() {
    var name = document.getElementById('client-name').value;
    var phone = document.getElementById('client-phone').value;
    var service = document.getElementById('client-service').value;
    var note = document.getElementById('client-note').value;
    
    var text = "Hello BRNDNUR Advisory, I would like to consult regarding " + service + ".\n" +
               "Name: " + name + "\n" +
               "Phone: " + phone + 
               (note ? ("\nDetails: " + note) : "");
               
    var url = "https://wa.me/919048188899?text=" + encodeURIComponent(text);
    window.open(url, '_blank');
  }

  function submitEmail() {
    var name = document.getElementById('client-name').value;
    var phone = document.getElementById('client-phone').value;
    var service = document.getElementById('client-service').value;
    var note = document.getElementById('client-note').value;
    
    var subject = "Advisory Inquiry: " + service + " - " + name;
    var body = "Hello BRNDNUR Advisory Team,\n\n" +
               "I would like to inquire about: " + service + "\n" +
               "Name: " + name + "\n" +
               "Phone: " + phone + "\n\n" +
               "Notes / Brand Details:\n" + note;
               
    var mailto = "mailto:brndnuradvisoryllp@gmail.com?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
    window.location.href = mailto;
  }
</script>
