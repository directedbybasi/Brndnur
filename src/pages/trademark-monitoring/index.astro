---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Trademark Monitoring & Brand Watch in India | BRNDNUR";
const description = "Monitor the official Trade Marks Journal for conflicting marks. Protect your registered trademark with proactive Brand Watch services from BRNDNUR.";
const canonical = "https://brndnur.com/trademark-monitoring/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/trademark-monitoring/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/services/">Services</a>
          <span class="sep">/</span>
          <span class="current">Trademark Monitoring</span>
        </nav>
        <p class="eyebrow">Proactive Brand Defense</p>
        <h1>Trademark Monitoring & Brand Watch Services.</h1>
        <p class="lead">Registering a trademark is only the first line of defense. The Trade Marks Registry regularly advertises newly accepted marks in the weekly Trade Marks Journal. Proactive monitoring detects conflicting filings before they attain registration.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span>Weekly Trade Marks Journal Tracking</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>4-Month Opposition Window Alert</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Form TM-O Legal Recourse</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20am%20interested%20in%20Brand%20Watch%20monitoring." target="_blank" rel="noopener noreferrer">Inquire About Brand Watch &rarr;</a>
          <a class="btn btn-outline" href="/trademark-renewal/">Renewal Services</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/packages/assets/brand-watch-support.webp" alt="BRNDNUR Trademark monitoring and Brand Watch surveillance service" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Brand Watch Defense</p>
            <h2>Why Post-Registration Surveillance Matters</h2>
            <p>The Trade Marks Registry does not proactively alert trademark owners when a competitor files a confusingly similar mark. It publishes newly accepted marks in the weekly Trade Marks Journal, placing the legal responsibility on brand owners to enforce their exclusivity.</p>
            <p>Under Section 21 of the Trade Marks Act, you have a strict four-month statutory window from the date of publication to file a formal opposition (Form TM-O). If this window expires unmonitored, the infringing mark achieves full registration status, making future cancellation far more expensive.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>Strict Statutory Deadline</h4>
                <p>The 4-month opposition window cannot be extended under ordinary circumstances. Missing the deadline means rectification must proceed before the High Court, costing months of delay and substantial legal expenditure.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 Core Pillars with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Our Surveillance Process</p>
          <h2>How BRNDNUR Brand Watch Protects Your Exclusivity</h2>
          <p>Continuous monitoring across all official publications to prevent brand dilution.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <h3>Weekly Journal Tracking</h3>
            <p>Systematic screening of every weekly edition of the official Trade Marks Journal for identical, phonetic, or deceptively similar applications.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <h3>Early Conflict Alerts</h3>
            <p>Prompt notifications whenever a potentially infringing mark is detected within your registered classes or closely allied commercial sectors.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Timely Legal Recourse</h3>
            <p>Enables your enterprise to seek legal counsel and file a timely Notice of Opposition (Form TM-O) before statutory deadlines expire.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4-Month Opposition Window Matrix -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Procedural Framework</p>
          <h2>The 4-Month Opposition Window Procedure</h2>
          <p>Statutory steps required when an unauthorized mark is advertised in the Journal.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Timeline</th>
                <th>Registry Event</th>
                <th>Advisory Action</th>
                <th>Strategic Consequence</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Day 0</strong></td>
                <td>Mark advertised in Trade Marks Journal</td>
                <td>Brand Watch detects identical/phonetic match</td>
                <td>Opposition window opens</td>
              </tr>
              <tr>
                <td><strong>Month 1 &ndash; 2</strong></td>
                <td>Public review period</td>
                <td>Detailed conflict appraisal & legal evaluation</td>
                <td>Determine whether to issue cease & desist or prepare opposition</td>
              </tr>
              <tr>
                <td><strong>Month 3 &ndash; 4</strong></td>
                <td>Final 60-day statutory window</td>
                <td>Draft and file formal Notice of Opposition (Form TM-O)</td>
                <td>Halts registration process; case referred to opposition proceedings</td>
              </tr>
              <tr>
                <td><strong>Post Month 4</strong></td>
                <td>Journal advertisement expires</td>
                <td>If unmonitored: Mark matures into full registration</td>
                <td>Exclusivity compromised; remedy requires costly High Court cancellation</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Safeguard Your Exclusivity</p>
          <h2>Protect Your Brand Equity from Imitators.</h2>
          <p>Our Brand Watch monitoring packages provide year-round surveillance across relevant classes at competitive annual rates.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20share%20Brand%20Watch%20details%20and%20pricing." target="_blank" rel="noopener noreferrer">Get Brand Watch Quote &rarr;</a>
            <a class="btn btn-outline" href="/packages/">View All Packages</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
