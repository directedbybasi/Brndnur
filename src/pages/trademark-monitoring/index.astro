---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import FaqItem from '../../components/FaqItem.astro';

const title = "Trademark Monitoring & Brand Watch in India | BRNDNUR";
const description = "Monitor the official Trade Marks Journal for conflicting marks. Protect your registered trademark with proactive Brand Watch services from BRNDNUR.";
const canonical = "https://brndnur.com/trademark-monitoring/";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Trademark Monitoring",
  "sectionName": "Hero Section",
  "enquiryType": "Brand Watch Surveillance",
  "topic": "I am interested in Brand Watch trademark monitoring to detect conflicting applications in the Trade Marks Journal.",
  "details": "Registered brand name(s): [Please enter]\\nRegistered class(es): [Please enter if known]",
  "callToAction": "Could you please share monitoring scope, opposition window tracking, and service plans?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Trademark Monitoring",
  "sectionName": "Closing CTA Band",
  "enquiryType": "Brand Watch Quotation",
  "topic": "I would like a quotation for ongoing trademark journal monitoring and conflict surveillance for my brand.",
  "details": "Number of trademarks to monitor: [Please specify]",
  "callToAction": "Could you please explain how weekly journal alerts and Form TM-O opposition tracking work?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/trademark-monitoring/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Proactive Brand Defense"
      title='Trademark Monitoring<br class="hero-br">&amp;&nbsp;Brand Watch <span>Services.</span>'
      hasGoldRule={true}
      description="Registering a trademark is only the first line of defense. The Trade Marks Registry regularly advertises newly accepted marks in the weekly Trade Marks Journal. Proactive monitoring detects conflicting filings before they attain registration."
      primaryCta={{
        text: "Inquire About Brand Watch",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Renewal Services",
        href: "/trademark-renewal/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Weekly Journal", subtitle: "Surveillance" },
        { icon: "▱", title: "4-Month Opposition", subtitle: "Window Tracking" },
        { icon: "⌖", title: "Form TM-O Legal", subtitle: "Recourse" }
      ]}
      image="/assets/monitoring-hero-watch.webp"
      imageAlt="Brand protection and trademark surveillance workstation with research dossier and magnifying glass"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/assets/monitoring-surveillance-defense.webp" alt="BRNDNUR Trademark monitoring and Brand Watch surveillance service" width="800" height="600" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Brand Watch Defense</p>
          <h2>Why Post-Registration Surveillance Matters.</h2>
          <div class="gold-rule"></div>
          <p>The Trade Marks Registry does not proactively alert trademark owners when a competitor files a confusingly similar mark. It publishes newly accepted marks in the weekly Trade Marks Journal, placing the legal responsibility on brand owners to enforce their exclusivity.</p>
          <p>Under Section 21 of the Trade Marks Act, you have a strict four-month statutory window from the date of publication to file a formal opposition (Form TM-O). If this window expires unmonitored, the infringing mark achieves full registration status, making future cancellation far more expensive.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Section 21 Timetable Enforcement</strong>
                <p>The 4-month opposition window cannot be extended under ordinary circumstances; timely alerts are non-negotiable.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Preventing Commercial Dilution</strong>
                <p>Stop competitors before they gain certificate-backed rights to launch confusingly similar goods in the market.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Cost-Effective Opposition</strong>
                <p>Opposing an application during the journal window costs a fraction of protracted High Court rectification suits.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Surveillance Process (Editorial Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Our Surveillance Process</p>
          <h2>How BRNDNUR Brand Watch Protects Your Exclusivity.</h2>
          <div class="gold-rule"></div>
          <p>Continuous monitoring across all official publications to prevent brand dilution.</p>
        </div>

        <CardCarousel id="monitoring-process-carousel" ariaLabel="Our surveillance process">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Weekly Journal Tracking</h3>
              <p>Systematic screening of every weekly edition of the official Trade Marks Journal for identical, phonetic, or deceptively similar applications.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>Early Conflict Appraisal</h3>
              <p>When a potentially conflicting mark is spotted, we evaluate the commercial overlap, classes, and strength of grounds for opposition.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>Actionable TM-O Drafting</h3>
              <p>Timely notice preparation, drafting legal grounds of opposition, and coordinating formal proceedings before the Registrar.</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Opposition Timeline Schedule Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Statutory Window</p>
          <h2>The 4-Month Opposition Window Breakdown.</h2>
          <div class="gold-rule"></div>
          <p>Critical milestones from journal publication to final opposition cutoff.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Surveillance Stage</th>
                <th>Official Event</th>
                <th>BRNDNUR Brand Watch Action</th>
                <th>Strategic Outcome</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Day 0</strong></td>
                <td>Mark advertised in Trade Marks Journal</td>
                <td>Brand Watch detects identical/phonetic match</td>
                <td>Opposition window opens</td>
              </tr>
              <tr>
                <td><strong>Month 1 &ndash; 2</strong></td>
                <td>Public review period</td>
                <td>Detailed conflict appraisal &amp; legal evaluation</td>
                <td>Determine whether to issue cease &amp; desist or prepare opposition</td>
              </tr>
              <tr>
                <td><strong>Month 3 &ndash; 4</strong></td>
                <td>Final 60-day statutory window</td>
                <td>Draft and file formal Notice of Opposition (Form TM-O)</td>
                <td>Halts registration process; case referred to opposition proceedings</td>
              </tr>
              <tr>
                <td><strong>Post Month 4</strong></td>
                <td>Journal advertisement expires</td>
                <td>If unmonitored: Mark matures into full registration</td>
                <td>Exclusivity compromised; remedy requires costly High Court cancellation</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Scope: Inclusions and Exclusions -->
    <section class="section section-alt">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Service Scope</p>
          <h2>What Brand Watch Includes &amp; Excludes.</h2>
          <div class="gold-rule"></div>
          <p>Absolute transparency on our annual monitoring parameters so you know exactly what protection is delivered.</p>
        </div>

        <div class="card-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2rem;">
          <div style="background: rgba(255, 252, 246, 0.9); border: 1px solid var(--line); border-radius: 4px; padding: 2rem;">
            <p class="eyebrow" style="margin-bottom: .5rem;">Included Services</p>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: 1rem;">Brand Watch Annual Scope</h3>
            <ul class="check-list">
              <li><span class="check">✓</span><span>Weekly automated and manual screening of published Trade Marks Journals.</span></li>
              <li><span class="check">✓</span><span>Monitoring across all your active classes and specified allied categories.</span></li>
              <li><span class="check">✓</span><span>Instant conflict advisory report whenever potentially infringing marks appear.</span></li>
              <li><span class="check">✓</span><span>Strategic assessment of opposition viability before the 4-month window lapses.</span></li>
            </ul>
          </div>

          <div style="background: rgba(255, 252, 246, 0.9); border: 1px solid var(--line); border-radius: 4px; padding: 2rem;">
            <p class="eyebrow" style="margin-bottom: .5rem;">Separate Legal Actions</p>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: 1rem;">Outside Annual Surveillance</h3>
            <ul class="check-list">
              <li><span class="check" style="color: var(--navy);">✕</span><span>Formal drafting and filing of Notices of Opposition (Form TM-O).</span></li>
              <li><span class="check" style="color: var(--navy);">✕</span><span>Drafting and dispatching formal advocate Cease &amp; Desist legal notices.</span></li>
              <li><span class="check" style="color: var(--navy);">✕</span><span>Litigation, court appearances, or High Court trademark rectification suits.</span></li>
              <li><span class="check" style="color: var(--navy);">✕</span><span>Statutory registry opposition fees (billed separately upon client instruction).</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Monitoring FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Monitoring FAQs</p>
          <h2>Questions About Brand Watch.</h2>
          <div class="gold-rule"></div>
          <p>Understanding why proactive registry surveillance is critical for brand equity.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Why do I need monitoring if I already have a registered trademark?"
            answer="The Trade Marks Registry receives hundreds of thousands of new applications annually. While examiners cite earlier marks, phonetically similar marks or stylized logos occasionally slip through and get advertised in the Trade Marks Journal. If the original trademark owner does not oppose within the strict 4-month window, the competing mark will be registered, diluting your market monopoly."
          />
          <FaqItem
            num="02"
            question="What is the 4-month opposition window under Indian law?"
            answer="Under Section 21 of the Trade Marks Act, 1999, once a mark is advertised in the official Trade Marks Journal, the public has exactly 4 months to oppose its registration by filing Form TM-O. This statutory 4-month deadline cannot be extended under any circumstances."
          />
          <FaqItem
            num="03"
            question="How often does BRNDNUR scan the Trade Marks Journal?"
            answer="The Trade Marks Registry publishes new journal editions every Monday. Our Brand Watch monitoring system screens each edition immediately upon publication to identify potential phonetic, visual, and conceptual conflicts across your designated NICE classes."
          />
          <FaqItem
            num="04"
            question="What happens if an infringing mark is detected?"
            answer="You receive an immediate Alert Report detailing the conflicting application number, applicant name, goods/services claimed, and our advisory appraisal. We provide recommendations on whether to issue a pre-opposition caution letter or prepare formal opposition proceedings before the statutory deadline."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Safeguard Your Exclusivity</p>
          <h2>Protect Your Brand Equity<br>from Imitators.</h2>
          <p>Our Brand Watch monitoring packages provide year-round surveillance across relevant classes at competitive annual rates.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Get Brand Watch Quote <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Surveillance Alerts</strong>
              <p>Weekly notification whenever potential conflicts emerge in the journal.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Objective Analysis</strong>
              <p>Expert legal assessment of phonetic and goods similarity.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Active Protection</strong>
              <p>Safeguarding your market position and registered intellectual property.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
