---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import FaqItem from '../../components/FaqItem.astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const title = "Services & Business Advisory | BRNDNUR Advisory LLP";
const description = "Explore trademark registration, brand name searches, wordmark & logo filing, renewal guidance, GST, Udyam/MSME, and business setup advisory from BRNDNUR.";
const canonical = "https://brndnur.com/services/";
const ogImage = "/services/assets/services-hero-trademark.webp";

const servicesHeroWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Hero Section',
  enquiryType: 'General Services Consultation',
  topic: 'I am reviewing your advisory services and would like guidance on the most suitable solution for my business.',
  details: 'My business requirement: [Please describe briefly]',
  callToAction: 'Could you please guide me on how to proceed with an initial consultation?'
});

const servicesClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Closing CTA Section',
  enquiryType: 'Service Scope Discussion',
  topic: 'I would like to discuss my brand protection and business registration requirements with the BRNDNUR team.',
  details: 'Services required: [e.g. Trademark Registration, Search, GST, FSSAI]',
  callToAction: 'Could you please explain the scope of work, fees, and next steps?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/services/"
  hasCustomSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://brndnur.com/services/#webpage",
        "url": "https://brndnur.com/services/",
        "name": "Services & Business Advisory | BRNDNUR Advisory LLP",
        "description": "Explore trademark registration, brand name searches, wordmark & logo filing, renewal guidance, GST, Udyam/MSME, and business setup advisory from BRNDNUR.",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://brndnur.com/#website",
          "url": "https://brndnur.com/",
          "name": "BRNDNUR Advisory LLP"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://brndnur.com/services/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Which service should I start with?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tell us about your brand name and business type. We can help you understand which service or next step may be relevant to your situation."
            }
          },
          {
            "@type": "Question",
            "name": "What information should I prepare?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "It is helpful to have your brand name, a short description of your goods or services, and basic applicant or business details. The exact requirements depend on the service."
            }
          },
          {
            "@type": "Question",
            "name": "How does a preliminary trademark search work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A preliminary search checks for potentially relevant existing marks. It is an initial review, not a guarantee that an application will be accepted or registered."
            }
          },
          {
            "@type": "Question",
            "name": "How are service fees determined?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fees depend on the service, applicant category, applicable government charges, and work involved. We will discuss the scope and relevant charges before proceeding."
            }
          },
          {
            "@type": "Question",
            "name": "Can BRNDNUR help with business registrations?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We provide guidance on GST, Udyam/MSME, FSSAI, and relevant business setup requirements, depending on your circumstances."
            }
          }
        ]
      }
    ]
  }
  </script>
  </Fragment>

  <main id="main-content">
    
    <PageHero
      eyebrow="Our Services"
      title="Build. Protect.<br><span>Grow Your Brand.</span>"
      hasGoldRule={true}
      description="From trademark searches and registration guidance to essential business registrations, we help you understand your options and take informed next steps for your brand and business."
      primaryCta={{
        text: "Explore Our Services",
        href: "#trademark-services",
        icon: "→"
      }}
      secondaryCta={{
        text: "Talk to Our Team",
        href: servicesHeroWhatsAppUrl,
        icon: "◎",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      trustBadges={[
        {
          icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3 19 6v5c0 4.5-3 7.8-7 10-4-2.2-7-5.5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
          title: "Brand",
          subtitle: "Protection"
        },
        {
          icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 21V8l8-5 8 5v13H4Z"/><path d="M9 21v-7h6v7M8 9h1m6 0h1"/></svg>',
          title: "Business",
          subtitle: "Registrations"
        },
        {
          icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.3"/><path d="M3 20c0-3.2 2.4-5.5 6-5.5s6 2.3 6 5.5M15 15c3.5 0 5.5 1.7 6 4.5"/></svg>',
          title: "Expert",
          subtitle: "Guidance"
        }
      ]}
      image="/services/assets/hero-trademark.webp"
      imageAlt="BRNDNUR Services - Build. Protect. Grow Your Brand"
      variant="service"
    />

    <section class="section" id="trademark-services" aria-labelledby="trademark-heading">
      <div class="wrap split">
        <div class="section-image trademark-photo"><img src="/services/assets/services-trademark-filing.webp" alt="Trademark application folder, legal books, and gold scales on a sunlit desk" width="1448" height="1086" loading="lazy" decoding="async"></div>
        <div class="section-copy">
          <span class="eyebrow">Trademark and Brand Protection</span>
          <h2 id="trademark-heading">Trademark Services.</h2>
          <div class="gold-rule"></div>
          <p>Your brand is a valuable business asset. We help you understand trademark searches, application options, documentation, and relevant requirements before you proceed.</p>
          <div class="service-grid">
            <a class="service-mini" href="/brand-name-search/">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></span>
              <span><h3>Brand Name Search</h3><p>Review potentially relevant existing marks before deciding how to proceed.</p></span>
            </a>
            <a class="service-mini" href="/trademark-registration/">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/></svg></span>
              <span><h3>Trademark Registration</h3><p>Understand filing steps, documentation, classes, and relevant requirements.</p></span>
            </a>
            <a class="service-mini" href="/wordmark-registration/">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="m8 15 2-5 2 5m-3.4-1h2.8M14 10h2M14 14h2"/></svg></span>
              <span><h3>Wordmark and Logo Applications</h3><p>Understand options for a brand name in text form or a distinctive logo.</p></span>
            </a>
            <a class="service-mini" href="/trademark-renewal/">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16M4 10h16M4 15h16M4 20h16"/><path d="M7 3v4M17 8v4M9 13v4M15 18v3"/></svg></span>
              <span><h3>Trademark Renewal and Brand Watch</h3><p>Learn about renewal requirements and available monitoring support.</p></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section business-section" id="business-support" aria-labelledby="business-heading">
      <div class="wrap split">
        <div class="section-copy business-copy">
          <span class="eyebrow">Business Registration Support</span>
          <h2 id="business-heading">Business Registration Support.</h2>
          <div class="gold-rule"></div>
          <p>We help you understand common business registration requirements and the information you may need, based on your business type and circumstances.</p>
          <ul class="check-list">
            <li><span class="check">✓</span><span><a href="/gst-registration/" style="color:inherit; text-decoration:none;"><strong>GST Registration Assistance &rarr;</strong></a></span></li>
            <li><span class="check">✓</span><span><a href="/udyam-msme-registration/" style="color:inherit; text-decoration:none;"><strong>Udyam / MSME Assistance &rarr;</strong></a></span></li>
            <li><span class="check">✓</span><span><a href="/fssai-registration/" style="color:inherit; text-decoration:none;"><strong>FSSAI Assistance &rarr;</strong></a></span></li>
            <li><span class="check">✓</span><span><a href="/business-setup/" style="color:inherit; text-decoration:none;"><strong>Business Setup Advisory &rarr;</strong></a></span></li>
          </ul>
        </div>
        <div class="section-image business-photo"><img src="/services/assets/services-business-registration.webp" alt="Business registration paperwork and labelled folders on a warm, sunlit office desk" width="1448" height="1086" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="section process-section" id="how-it-works" aria-labelledby="process-heading">
      <div class="wrap split">
        <div class="section-image process-photo"><img src="/services/assets/services-process-search.webp" alt="Laptop prepared for a brand-name search beside business documents and a pen" width="1448" height="1086" loading="lazy" decoding="async"></div>
        <div class="section-copy process-copy">
          <span class="eyebrow">How It Works</span>
          <h2 id="process-heading">A Simple Process.</h2>
          <div class="gold-rule"></div>
          <p>We begin by understanding your needs, explain the relevant options, and agree on the scope and next steps before work proceeds.</p>
          <div class="steps">
            <div class="step"><span class="step-num">01</span><div><h3>Tell Us About Your Needs</h3><p>Share your brand name, business type, or the service you are considering.</p></div></div>
            <div class="step"><span class="step-num">02</span><div><h3>Discuss Your Options</h3><p>Understand the relevant process, requirements, and scope of support.</p></div></div>
            <div class="step"><span class="step-num">03</span><div><h3>Confirm the Next Steps</h3><p>Review the proposed scope, applicable charges, and information required.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section why-section" id="why-brndnur" aria-labelledby="why-heading">
      <div class="wrap split">
        <div class="section-copy why-copy">
          <span class="eyebrow">Why BRNDNUR</span>
          <h2 id="why-heading">More Than a Service.<br>A Partner in Your Journey.</h2>
          <div class="gold-rule"></div>
          <p>We focus on clear communication, practical guidance, and helping you understand the proposed scope before you decide how to proceed.</p>
          <div class="benefits">
            <div class="benefit">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m12 3 2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8L12 3Z"/></svg></span>
              <h3>Client-Focused Approach</h3><p>We take time to understand your needs and business.</p>
            </div>
            <div class="benefit">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h7"/></svg></span>
              <h3>Transparent Discussions</h3><p>Understand the scope and charges before proceeding.</p>
            </div>
            <div class="benefit">
              <span class="mini-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 20V12h4v8M10 20V7h4v13M16 20V3h4v17"/></svg></span>
              <h3>Practical Support</h3><p>Clear direction on relevant next steps for your business.</p>
            </div>
          </div>
        </div>
        <div class="section-image why-photo"><img src="/services/assets/services-why-brndnur.webp" alt="Premium brand-protection folio and fountain pen in a warm advisory workspace" width="1086" height="1448" loading="lazy" decoding="async"></div>
      </div>
    </section>

    <section class="section faq-section" id="faqs" aria-labelledby="faq-heading">
      <div class="wrap faq-split">
        <div class="section-image faq-photo"><img src="/services/assets/services-faq-portfolio.webp" alt="Navy portfolio with a gold registered-trademark emblem and legal documents" width="1086" height="1448" loading="lazy" decoding="async"></div>
        <div class="faq-copy">
          <span class="eyebrow">Frequent Questions</span>
          <h2 id="faq-heading">Questions Before You Get Started?</h2>
          <p>A few helpful answers before you decide on your next step.</p>
          <div class="faq-editorial-list faq-list">
            <FaqItem
              num="01"
              question="Which service should I start with?"
              answer="Tell us about your brand name and business type. We can help you understand which service or next step may be relevant to your situation."
            />
            <FaqItem
              num="02"
              question="What information should I prepare?"
              answer="It is helpful to have your brand name, a short description of your goods or services, and basic applicant or business details. The exact requirements depend on the service."
            />
            <FaqItem
              num="03"
              question="How does a preliminary trademark search work?"
              answer="A preliminary search checks for potentially relevant existing marks. It is an initial review, not a guarantee that an application will be accepted or registered."
            />
            <FaqItem
              num="04"
              question="How are service fees determined?"
              answer="Fees depend on the service, applicant category, applicable government charges, and work involved. We will discuss the scope and relevant charges before proceeding."
            />
            <FaqItem
              num="05"
              question="Can BRNDNUR help with business registrations?"
              answer="We provide guidance on GST, Udyam/MSME, FSSAI, and relevant business setup requirements, depending on your circumstances."
            />
          </div>
          <a class="text-link" href="/faqs/">View All FAQs <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="cta-wrap" aria-labelledby="cta-heading">
      <div class="cta-panel">
        <span class="eyebrow">Ready to Take the Next Step?</span>
        <h2 id="cta-heading">Let’s Talk About Your Brand.</h2>
        <p>Tell us what you need help with. We’ll discuss the relevant options and the next steps for your situation.</p>
        <a class="btn" href={servicesClosingWhatsAppUrl} target="_blank" rel="noopener noreferrer">◎&nbsp; Discuss Your Requirements on WhatsApp <span>→</span></a>
      </div>
    </section>
  
  </main>
</BaseLayout>


<style is:global>

:root {
  --ivory: #F4EFE4;
  --ivory-soft: #F8F4EB;
  --ivory-deep: #EDE3D1;
  --navy: #13233A;
  --navy-deep: #0C1C2C;
  --gold: #A8781A;
  --gold-bright: #C28A25;
  --gold-pale: #F0E2C8;
  --ink: #14243A;
  --muted: #536176;
  --line: #DCCEB6;
  --white: #FFFCF6;
  --serif: "DM Sans", Arial, Helvetica, sans-serif;
  --sans: "DM Sans", Arial, sans-serif;
  --content: 1200px;
  --shadow: 0 12px 28px rgba(35, 30, 20, .07);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 84px; }
body {
  margin: 0; background: var(--ivory); color: var(--ink); font-family: var(--sans);
  font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }
.wrap { width: min(var(--content), calc(100% - 96px)); margin-inline: auto; }
.eyebrow {
  display: block; color: var(--gold); font-size: 11.5px; line-height: 1.45; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase; margin: 0 0 14px;
}
h1, h2, h3, p { margin-top: 0; }
h1, h2, .serif { font-family: var(--sans); font-weight: 600; letter-spacing: -.02em; }
h1 { font-size: clamp(2.6rem, 4vw, 3.65rem); line-height: 1.02; margin-bottom: 18px; }
h2 { font-size: clamp(2.15rem, 3.1vw, 2.7rem); line-height: 1.12; margin-bottom: 14px; }
h3 { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.35rem); line-height: 1.35; margin-bottom: 7px; font-weight: 600; }
p { color: var(--muted); margin-bottom: 16px; }
.gold { color: var(--gold); }
.gold-rule { width: 36px; height: 2px; background: var(--gold); margin: 15px 0 17px; }
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px;
  padding: 12px 20px; border: 1px solid var(--gold); border-radius: 6px; background: var(--gold);
  color: #fffaf0; font-size: 15px; font-weight: 600; line-height: 1.3;
  transition: transform .2s ease, background .2s ease, border-color .2s ease; cursor: pointer; white-space: nowrap;
}
.btn:hover { transform: translateY(-2px); background: #8F6214; border-color: #8F6214; }
.btn-navy { background: var(--navy); border-color: var(--navy); }
.btn-navy:hover { background: #203853; border-color: #203853; }
.btn-outline { background: transparent; border: 1.5px solid var(--navy); color: var(--navy); }
.btn-outline:hover { color: var(--navy); background: var(--gold-pale); border-color: var(--gold); }
.arrow { color: var(--gold-bright); font-size: 16px; line-height: 1; }
:focus-visible { outline: 3px solid rgba(168,120,26,.55); outline-offset: 3px; }
.hero { min-height: 440px; position: relative; isolation: isolate; overflow: hidden; background: var(--ivory); display: flex; align-items: center; }
.hero-media { position: absolute; z-index: 1; right: 0; top: 0; bottom: 0; width: 56%; overflow: hidden; }
.hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: 54% 50%; display: block; }
.hero-media::before { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(90deg, var(--ivory) 0%, rgba(244,239,228,.94) 8%, rgba(244,239,228,.64) 22%, rgba(244,239,228,.10) 45%, transparent 66%); }
.hero-content { width: min(var(--content, 1200px), calc(100% - 64px)); margin-inline: auto; display: flex; align-items: center; padding: 46px 0 42px; position: relative; z-index: 3; }
.hero-copy { width: 56%; max-width: 660px; padding-right: 24px; }
.hero h1 span { display: block; }
.hero h1 span:first-child { color: var(--navy); }
.hero h1 span.gold { color: var(--gold); }
.hero-copy p { max-width: 485px; font-size: 16px; line-height: 1.65; margin-bottom: 22px; }
.hero-actions { display: flex; flex-direction: row; align-items: center; gap: 12px; margin-bottom: 26px; }
.hero-actions .btn { min-height: 48px; padding: 12px 20px; font-size: 14.5px; border-radius: 6px; }
.section { padding-block: 80px; }
.split { display: grid; grid-template-columns: clamp(340px, 38%, 440px) minmax(0, 1fr); align-items: center; gap: clamp(36px, 4.2vw, 56px); }
.section-image { position: relative; overflow: hidden; border-radius: 8px; box-shadow: var(--shadow); min-width: 0; width: 100%; max-width: 460px; aspect-ratio: 4 / 3; background: var(--ivory-deep); margin-inline: auto; }
.section-image img { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0; aspect-ratio: 4 / 3; object-fit: cover; }
.why-photo { max-width: 380px !important; aspect-ratio: 3 / 4 !important; }
.why-photo img { aspect-ratio: 3 / 4 !important; }
.trademark-photo img { object-position: 52% 50%; }
.section-copy { min-width: 0; }
.section-copy > p { font-size: 16px; line-height: 1.68; max-width: 620px; }
.section-copy h2 { max-width: 590px; }
.section-copy .service-grid,
.service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; margin-top: 26px; }
.service-mini { display: grid !important; grid-template-columns: 40px minmax(0, 1fr) !important; gap: 12px !important; padding: 16px 16px 16px 0 !important; min-width: 0 !important; border-top: 1px solid var(--line) !important; border-right: 0 !important; border-bottom: 0 !important; border-left: 0 !important; align-items: start !important; }
.service-mini:nth-child(odd) { border-right: 1px solid var(--line) !important; }
.service-mini:nth-child(even) { padding-left: 17px !important; padding-right: 0 !important; border-right: 0 !important; }
.service-mini:nth-child(-n+2) { border-top: 0 !important; padding-top: 0 !important; }
.mini-icon { width: 38px !important; height: 38px !important; border-radius: 7px !important; display: grid !important; place-items: center !important; background: var(--gold-pale) !important; color: var(--gold) !important; flex: 0 0 38px !important; }
.mini-icon svg { width: 20px !important; height: 20px !important; }
.service-mini h3 { font-family: var(--sans) !important; font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem) !important; font-weight: 600 !important; line-height: 1.35 !important; margin: 1px 0 5px 0 !important; color: var(--navy) !important; letter-spacing: normal !important; }
.service-mini p { font-family: var(--sans) !important; font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem) !important; line-height: 1.6 !important; margin: 0 !important; color: var(--muted) !important; }
.service-mini:hover h3 { color: var(--gold) !important; }
.business-section { background: #F8F3E9; border-block: 1px solid rgba(220,206,182,.42); }
.business-section .split { grid-template-columns: minmax(0, 1fr) clamp(340px, 38%, 440px); }
.business-copy { padding: 0; }
.business-photo img { object-position: 57% 50%; }
.check-list { display: grid; gap: 10px; margin: 21px 0 0; padding: 0; list-style: none; }
.check-list li { display: flex; gap: 11px; align-items: flex-start; color: #26364C; font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); font-weight: 500; line-height: 1.5; }
.check-list strong { font-weight: 600; }
.check { margin-top: 3px; display: grid; place-items: center; background: var(--gold); color: #fff; width: 18px; height: 18px; border-radius: 50%; font-size: 11px; flex: 0 0 18px; }
.process-section { background: #EFE5D4; }
.process-section .split { grid-template-columns: clamp(340px, 38%, 440px) minmax(0, 1fr); }
.process-photo img { object-position: 54% 50%; }
.process-section .steps,
.process-copy .steps,
.steps { margin-top: 25px; display: flex !important; flex-direction: column !important; gap: 20px !important; width: 100% !important; }
.process-section .step,
.process-copy .step,
.step { display: grid !important; grid-template-columns: 44px minmax(0, 1fr) !important; align-items: start !important; gap: 16px !important; width: 100% !important; }
.step-num { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--gold); color: white; font-family: var(--sans); font-weight: 700; font-size: 16px; flex-shrink: 0; }
.step h3 { font-family: var(--sans); font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem); font-weight: 600; margin: 0 0 4px; color: var(--navy); line-height: 1.35; }
