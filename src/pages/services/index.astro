---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import FaqItem from '../../components/FaqItem.astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const title = "Services & Business Advisory | BRNDNUR Advisory LLP";
const description = "Explore trademark registration, brand name searches, wordmark & logo filing, renewal guidance, GST, Udyam/MSME, and business setup advisory from BRNDNUR.";
const canonical = "https://brndnur.com/services/";
const ogImage = "/services/assets/services-hero-trademark.webp";

const servicesHeroWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Hero Section',
  enquiryType: 'General Services Consultation',
  message: 'Hi BRNDNUR, I am reviewing your advisory services and would like guidance on brand protection and business registration. Could you please advise me on the suitable service for my requirement, professional fees, and next steps?'
});

const servicesClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Closing CTA Section',
  enquiryType: 'Service Scope Discussion',
  message: 'Hi BRNDNUR, I would like to discuss my brand protection and business registration requirements with an advisor. Could you please explain the scope of work, professional charges, applicable statutory fees, and the next steps?'
});

const infringementWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Infringement Action',
  enquiryType: 'Trademark Infringement Advisory',
  message: 'Hi BRNDNUR, I suspect another business is using a name or logo confusingly similar to my trademark. Could you please advise me on available legal options, evidence required, cease-and-desist notices, and appropriate next steps?'
});

const classExtensionWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Class Extension',
  enquiryType: 'Trademark Class Audit',
  message: 'Hi BRNDNUR, my business is expanding into new product lines or services, and I need to extend my trademark protection to additional classes. Could you please guide me on the classification audit, fees, and filing process?'
});

const oppositionWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Services Hub',
  sectionName: 'Opposition & Disputes',
  enquiryType: 'Trademark Opposition Consultation',
  message: 'Hi BRNDNUR, I need guidance regarding a trademark opposition or registry objection. Could you please explain the procedure for filing a notice of opposition or responding to official examination queries within statutory deadlines?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/services/"
  hasCustomSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://brndnur.com/services/#webpage",
        "url": "https://brndnur.com/services/",
        "name": "Services & Business Advisory | BRNDNUR Advisory LLP",
        "description": "Explore trademark registration, brand name searches, wordmark & logo filing, renewal guidance, GST, Udyam/MSME, and business setup advisory from BRNDNUR.",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://brndnur.com/#website",
          "url": "https://brndnur.com/",
          "name": "BRNDNUR Advisory LLP"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://brndnur.com/services/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Which service should I start with?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Tell us about your brand name and business type. We can help you understand which service or next step may be relevant to your situation."
            }
          },
          {
            "@type": "Question",
            "name": "What information should I prepare?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "It is helpful to have your brand name, a short description of your goods or services, and basic applicant or business details. The exact requirements depend on the service."
            }
          },
          {
            "@type": "Question",
            "name": "How does a preliminary trademark search work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A preliminary search checks for potentially relevant existing marks across all 45 classes on the IP India database before committing filing fees."
            }
          },
          {
            "@type": "Question",
            "name": "How are service fees determined?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Statutory government fees are ₹4,500 per class for individuals and MSMEs. Professional advisory fees are quoted transparently based on scope."
            }
          },
          {
            "@type": "Question",
            "name": "Can BRNDNUR help with business registrations?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "We provide comprehensive guidance on GST, Udyam/MSME, FSSAI, and commercial business setup requirements."
            }
          }
        ]
      }
    ]
  }
  </script>
  </Fragment>

  <main id="main-content">
    
    <!-- Hero Section -->
    <PageHero
      eyebrow="TRADEMARK SERVICES &middot; KERALA &amp; INDIA-WIDE"
      title="Every Service Built Around One Goal:<br><span>Your Brand Is Legally Yours.</span>"
      hasGoldRule={true}
      description="From initial clearance search to 10-year renewal — comprehensive trademark and brand protection advisory for growing businesses."
      primaryCta={{
        text: "Check My Brand Name",
        href: servicesHeroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Explore Services",
        href: "#trademark-services",
        icon: "↓"
      }}
      trustBadges={[
        {
          icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3 19 6v5c0 4.5-3 7.8-7 10-4-2.2-7-5.5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>',
          title: "45 Nice Classes",
          subtitle: "Comprehensive Coverage"
        },
        {
          icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 21V8l8-5 8 5v13H4Z"/><path d="M9 21v-7h6v7M8 9h1m6 0h1"/></svg>',
          title: "100% IP India",
          subtitle: "Statutory Compliance"
        },
        {
          icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.3"/><path d="M3 20c0-3.2 2.4-5.5 6-5.5s6 2.3 6 5.5M15 15c3.5 0 5.5 1.7 6 4.5"/></svg>',
          title: "Legal Advisory",
          subtitle: "Not a Form Agent"
        }
      ]}
      image="/services/assets/hero-trademark.webp"
      imageAlt="BRNDNUR Services - Build. Protect. Grow Your Brand"
      variant="service"
    />

    <!-- 2-COLUMN SERVICE CARD SYSTEM (6 CATEGORIES, 3 BALANCED ROWS ON DESKTOP) -->
    <section class="section services-grid-section" id="trademark-services" aria-labelledby="services-hub-heading">
      <div class="wrap">
        <div class="section-header text-center">
          <span class="eyebrow">Comprehensive Brand Protection</span>
          <h2 id="services-hub-heading">Six Core Services.<br>One Complete Protection Lifecycle.</h2>
          <div class="gold-rule center-rule"></div>
          <p class="section-intro">
            From preliminary clearance search to 10-year renewal maintenance, we provide structured, end-to-end statutory IP advisory for Indian enterprises.
          </p>
        </div>

        <div class="services-grid">
          
          <!-- Card 1: Trademark Search -->
          <article class="service-card" id="trademark-search" aria-labelledby="heading-search">
            <div class="service-card__media">
              <img src="/assets/home-card-search.webp" alt="Magnifying glass and trademark clearance research notebook" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__category">TRADEMARK SEARCH</span>
              <h3 class="service-card__title" id="heading-search">Is Your Brand Name Already Taken?</h3>
              <p class="service-card__desc">
                Preliminary search across IP India's database to verify phonetic and visual availability across all 45 classes before you commit capital or print packaging.
              </p>

              <div class="service-card__deliverables">
                <span class="deliverables-kicker">KEY DELIVERABLES</span>
                <ul class="deliverables-bullets">
                  <li>Full IP India database search across Classes 1–45 with phonetic & visual similarity checks</li>
                  <li>Written conflict report with clear recommendation (clear to file, risky, or blocked)</li>
                  <li>Accurate Nice classification mapping tailored to your business activities</li>
                </ul>
              </div>

              <div class="service-card__pricing">
                <span class="pricing-kicker-text">STARTING FROM</span>
                <div class="pricing-main-row">
                  <span class="pricing-amount-text">Contact Us</span>
                </div>
                <p class="pricing-sub-note">Written report delivered within 24 hours of receiving brand details</p>
              </div>

              <div class="service-card__cta">
                <a class="btn btn-navy" href="/brand-name-search/">Check My Brand Name <span class="arrow">&rarr;</span></a>
              </div>
            </div>
          </article>

          <!-- Card 2: Filing & Registration -->
          <article class="service-card" id="filing-registration" aria-labelledby="heading-filing">
            <div class="service-card__media">
              <img src="/services/assets/services-trademark-filing.webp" alt="Form TM-A filing documents and trademark registry folders" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__category">FILING &amp; REGISTRATION</span>
              <h3 class="service-card__title" id="heading-filing">Protect Your Brand in the Right Classes</h3>
              <p class="service-card__desc">
                We identify your exact Nice classification, draft Form TM-A, and submit directly with IP India to secure your nationwide priority filing date immediately.
              </p>

              <div class="service-card__deliverables">
                <span class="deliverables-kicker">KEY DELIVERABLES</span>
                <ul class="deliverables-bullets">
                  <li>Class identification guidance for wordmarks and device/logo marks</li>
                  <li>Form TM-A drafting and direct online filing on IP India e-portal</li>
                  <li>Official same-day filing receipt, status tracking, and examination query support</li>
                </ul>
              </div>

              <div class="service-card__pricing">
                <span class="pricing-kicker-text">GOVERNMENT STATUTORY FEE</span>
                <div class="pricing-main-row">
                  <span class="pricing-amount-text">&#8377;4,500</span>
                  <span class="pricing-unit-text">/ class (Individual / MSME)</span>
                </div>
                <p class="pricing-sub-note">Professional fee quoted separately &middot; Most businesses file in 1–2 classes</p>
              </div>

              <div class="service-card__cta">
                <a class="btn btn-navy" href="/trademark-registration/">Start My Application <span class="arrow">&rarr;</span></a>
              </div>
            </div>
          </article>

          <!-- Card 3: Infringement Action -->
          <article class="service-card" id="infringement" aria-labelledby="heading-infringement">
            <div class="service-card__media">
              <img src="/assets/home-card-trademark.webp" alt="Bronze trademark emblem and legal notice files" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__category">INFRINGEMENT ACTION</span>
              <h3 class="service-card__title" id="heading-infringement">Defend Your Brand Against Copycats</h3>
              <p class="service-card__desc">
                A registered mark gives you legal standing to halt imitation, issue cease-and-desist notices, file police complaints, or claim damages in District Court.
              </p>

              <div class="service-card__deliverables">
                <span class="deliverables-kicker">KEY DELIVERABLES</span>
                <ul class="deliverables-bullets">
                  <li>Infringement assessment, evidence documentation, and cease-and-desist notices</li>
                  <li>Police complaint support (Sections 103–104) and civil court litigation assistance</li>
                  <li>Passing-off remedies and dispute advisory where registration is absent</li>
                </ul>
              </div>

              <div class="service-card__pricing">
                <span class="pricing-kicker-text">ENGAGEMENT</span>
                <div class="pricing-main-row">
                  <span class="pricing-amount-text">Quoted per matter</span>
                </div>
                <p class="pricing-sub-note">First consultation free &middot; Covers Kerala courts and IP India proceedings</p>
              </div>

              <div class="service-card__cta">
                <a class="btn btn-navy" href={infringementWhatsAppUrl} target="_blank" rel="noopener noreferrer">Discuss My Case <span class="arrow">&rarr;</span></a>
              </div>
            </div>
          </article>

          <!-- Card 4: Class Extension -->
          <article class="service-card" id="class-extension" aria-labelledby="heading-extension">
            <div class="service-card__media">
              <img src="/assets/classes-hero-catalog.webp" alt="Trademark class expansion folders and commercial catalog" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__category">CLASS EXTENSION</span>
              <h3 class="service-card__title" id="heading-extension">Expand Coverage as Your Business Grows</h3>
              <p class="service-card__desc">
                New product lines or commercial expansions create unprotected gaps. We audit existing registrations and file additional classes to keep pace with your growth.
              </p>

              <div class="service-card__deliverables">
                <span class="deliverables-kicker">KEY DELIVERABLES</span>
                <ul class="deliverables-bullets">
                  <li>Full portfolio audit comparing existing registrations against current activities</li>
                  <li>Gap analysis report with priority classification recommendations</li>
                  <li>Additional class filing (Form TM-A) with pre-filing clearance checks</li>
                </ul>
              </div>

              <div class="service-card__pricing">
                <span class="pricing-kicker-text">GOVERNMENT FEE PER ADDITIONAL CLASS</span>
                <div class="pricing-main-row">
                  <span class="pricing-amount-text">&#8377;4,500</span>
                  <span class="pricing-unit-text">/ class (Individual / MSME)</span>
                </div>
                <p class="pricing-sub-note">Coverage audit fee quoted separately based on portfolio size</p>
              </div>

              <div class="service-card__cta">
                <a class="btn btn-navy" href={classExtensionWhatsAppUrl} target="_blank" rel="noopener noreferrer">Audit My Coverage <span class="arrow">&rarr;</span></a>
              </div>
            </div>
          </article>

          <!-- Card 5: Opposition & Disputes -->
          <article class="service-card" id="opposition" aria-labelledby="heading-opposition">
            <div class="service-card__media">
              <img src="/assets/about-card-corporate.webp" alt="Trade Marks Journal publication dispute representation" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__category">OPPOSITION &amp; DISPUTES</span>
              <h3 class="service-card__title" id="heading-opposition">Defend Your Rights in the Trade Marks Journal</h3>
              <p class="service-card__desc">
                Every application is published with a strict 4-month opposition window. We prepare evidence, file notices, and represent you before IP India tribunals.
              </p>

              <div class="service-card__deliverables">
                <span class="deliverables-kicker">KEY DELIVERABLES</span>
                <ul class="deliverables-bullets">
                  <li>Notice of Opposition drafted and filed within the statutory 4-month window</li>
                  <li>Counter-statement preparation, evidence affidavits, and hearing representation</li>
                  <li>Cancellation and rectification petition advisory before High Court benches</li>
                </ul>
              </div>

              <div class="service-card__pricing">
                <span class="pricing-kicker-text">ENGAGEMENT</span>
                <div class="pricing-main-row">
                  <span class="pricing-amount-text">Quoted per matter</span>
                </div>
                <p class="pricing-sub-note">Time-sensitive statutory deadlines &middot; Direct advisory representation</p>
              </div>

              <div class="service-card__cta">
                <a class="btn btn-navy" href={oppositionWhatsAppUrl} target="_blank" rel="noopener noreferrer">Discuss an Opposition <span class="arrow">&rarr;</span></a>
              </div>
            </div>
          </article>

          <!-- Card 6: Renewal -->
          <article class="service-card" id="renewal" aria-labelledby="heading-renewal">
            <div class="service-card__media">
              <img src="/assets/renewal-ownership-maintenance.webp" alt="Trademark 10-year renewal calendar and registry certificate" width="900" height="600" loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__category">RENEWAL</span>
              <h3 class="service-card__title" id="heading-renewal">Maintain Continuous 10-Year Protection</h3>
              <p class="service-card__desc">
                Trademarks must be renewed every 10 years via Form TM-R. We maintain a docket calendar and file timely renewals to preserve your continuous legal priority.
              </p>

              <div class="service-card__deliverables">
                <span class="deliverables-kicker">KEY DELIVERABLES</span>
                <ul class="deliverables-bullets">
                  <li>Renewal docket calendar tracking all managed marks against statutory deadlines</li>
                  <li>12-month advance renewal reminder and timely Form TM-R submission</li>
                  <li>Official renewal certificate confirmation and lapsed mark restoration petitions</li>
                </ul>
              </div>

              <div class="service-card__pricing">
                <span class="pricing-kicker-text">GOVERNMENT STATUTORY FEE</span>
                <div class="pricing-main-row">
                  <span class="pricing-amount-text">&#8377;9,000</span>
                  <span class="pricing-unit-text">/ class (Individual / MSME)</span>
                </div>
                <p class="pricing-sub-note">Grace period (+6 mos): &#8377;4,500 surcharge &middot; Professional fee separate</p>
              </div>

              <div class="service-card__cta">
                <a class="btn btn-navy" href="/trademark-renewal-monitoring/">Renew My Trademark <span class="arrow">&rarr;</span></a>
              </div>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- BUSINESS REGISTRATIONS CONSOLIDATED SECTION -->
    <section class="section business-section" id="business-support" aria-labelledby="business-heading">
      <div class="wrap split">
        <div class="section-copy business-copy">
          <span class="eyebrow">BUSINESS SERVICES</span>
          <h2 id="business-heading">Business Registration &amp; Setup.</h2>
          <div class="gold-rule"></div>
          <p>
            Establishing legal and regulatory compliance goes hand in hand with trademark protection. We provide structured guidance on essential statutory registrations for Kerala and Indian commercial ventures.
          </p>
          <ul class="check-list">
            <li><span class="check">&check;</span><span><strong>GST Registration:</strong> Indirect tax compliance and ITC alignment for traders, manufacturers, and services.</span></li>
            <li><span class="check">&check;</span><span><strong>Udyam / MSME Registration:</strong> Digital certification unlocking statutory 50% government fee concessions on trademark filings.</span></li>
            <li><span class="check">&check;</span><span><strong>FSSAI Registration:</strong> Mandatory food safety licensing on FoSCoS for cafes, restaurants, bakeries, and packaged brands.</span></li>
            <li><span class="check">&check;</span><span><strong>Business Setup:</strong> Strategic constitution guidance for Sole Proprietorships, Partnerships, LLPs, and Private Limited Companies.</span></li>
          </ul>
          <div style="margin-top: 24px;">
            <a class="btn btn-navy" href="/business-registration/">Explore Business Registrations <span class="arrow">&rarr;</span></a>
          </div>
        </div>
        <div class="section-image business-photo">
          <img src="/services/assets/services-business-registration.webp" alt="Business registration paperwork and labelled folders on a warm, sunlit office desk" width="1448" height="1086" loading="lazy" decoding="async">
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="section faq-section" id="faqs" aria-labelledby="faq-heading">
      <div class="wrap faq-split">
        <div class="section-image faq-photo">
          <img src="/services/assets/services-faq-portfolio.webp" alt="Navy portfolio with a gold registered-trademark emblem and legal documents" width="1086" height="1448" loading="lazy" decoding="async">
        </div>
        <div class="faq-copy">
          <span class="eyebrow">FREQUENT QUESTIONS</span>
          <h2 id="faq-heading">Questions Before You Get Started?</h2>
          <p>Clear, practical answers to help you determine the right next step for your brand.</p>
          <div class="faq-editorial-list faq-list">
            <FaqItem
              num="01"
              question="Which service should I start with?"
              answer="Tell us about your brand name and business type. We will conduct an initial review to advise whether a clearance search, direct filing, or business registration is your most urgent priority."
            />
            <FaqItem
              num="02"
              question="What information should I prepare?"
              answer="Having your proposed brand name, logo artwork, a brief summary of goods or services, and applicant details (proprietorship, LLP, or company) ensures an efficient assessment."
            />
            <FaqItem
              num="03"
              question="How does a preliminary trademark search work?"
              answer="We search the IP India database across all 45 Nice classes, checking for identical names, phonetic equivalents, and visually similar logos before you commit government filing fees."
            />
            <FaqItem
              num="04"
              question="How are service fees determined?"
              answer="Official statutory fees are fixed by IP India (₹4,500/class for individuals and MSMEs; ₹9,000 for companies). Professional fees are quoted transparently upfront based on scope."
            />
            <FaqItem
              num="05"
              question="Can BRNDNUR help with business registrations?"
              answer="Yes. We assist with GST, Udyam MSME certification, FSSAI food business licensing, and entity setup advisory tailored to your operating model."
            />
          </div>
          <a class="text-link" href="/faqs/">View All Frequently Asked Questions <span>&rarr;</span></a>
        </div>
      </div>
    </section>

    <!-- CLOSING WHATSAPP CTA -->
    <section class="cta-wrap" aria-labelledby="cta-heading">
      <div class="cta-panel">
        <span class="eyebrow">NOT SURE WHICH SERVICE YOU NEED?</span>
        <h2 id="cta-heading">Send Us Your Brand Name.<br>We'll Tell You Exactly Where You Stand.</h2>
        <p>Get a confidential preliminary availability assessment on WhatsApp within the same business day &mdash; free, with no obligation.</p>
        <a class="btn btn-gold" href={servicesClosingWhatsAppUrl} target="_blank" rel="noopener noreferrer">
          WhatsApp Free Name Check <span class="arrow">&rarr;</span>
        </a>
      </div>
    </section>
  
  </main>
</BaseLayout>

<style is:global>
:root {
  --ivory: #F4EFE4;
  --ivory-soft: #F8F4EB;
  --ivory-deep: #EDE3D1;
  --navy: #13233A;
  --navy-deep: #0C1C2C;
  --gold: #A8781A;
  --gold-bright: #C28A25;
  --gold-pale: #F0E2C8;
  --ink: #14243A;
  --muted: #536176;
  --line: #DCCEB6;
  --white: #FFFCF6;
  --serif: "Playfair Display", Georgia, serif;
  --sans: "DM Sans", Arial, sans-serif;
  --content: 1200px;
  --shadow: 0 12px 28px rgba(35, 30, 20, .07);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 84px; }
body {
  margin: 0; background: var(--ivory); color: var(--ink); font-family: var(--sans);
  font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
}
img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }
.wrap { width: min(var(--content), calc(100% - 96px)); margin-inline: auto; }
.eyebrow {
  display: block; color: var(--gold); font-size: 11.5px; line-height: 1.45; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase; margin: 0 0 10px;
}
h1, h2, h3, p { margin-top: 0; }
h1, h2 { font-family: var(--sans); font-weight: 600; letter-spacing: -.02em; }
h1 { font-size: clamp(2.6rem, 4vw, 3.65rem); line-height: 1.02; margin-bottom: 18px; }
h2 { font-size: clamp(1.85rem, 2.6vw, 2.45rem); line-height: 1.18; margin-bottom: 14px; color: var(--navy); }
h3 { font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.35rem); line-height: 1.35; margin-bottom: 7px; font-weight: 600; }
p { color: var(--muted); margin-bottom: 16px; }
.gold-rule { width: 36px; height: 2px; background: var(--gold); margin: 15px 0 17px; }
.center-rule { margin-inline: auto; }

/* General Section Spacing */
.section { padding-block: 72px; }

/* 2-Column Services Grid Section */
.services-grid-section {
  padding-block: 56px 80px;
  background: var(--ivory);
}
.section-header.text-center {
  text-align: center;
  max-width: 740px;
  margin: 0 auto 48px;
}
.section-intro {
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0 auto;
}

/* 2-Column Grid on Desktop (3 balanced rows of 2 cards) */
