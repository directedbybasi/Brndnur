---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const title = "About BRNDNUR | Brand & Business Advisory LLP";
const description = "Learn about BRNDNUR Advisory LLP: our client-focused approach to trademark registration guidance and practical business advisory in Kerala, India.";
const canonical = "https://brndnur.com/about/";

const aboutClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'About BRNDNUR',
  sectionName: 'Closing CTA Band',
  enquiryType: 'General Advisory Consultation',
  topic: 'I have reviewed your firm background and would like to discuss brand protection and advisory support for my business.',
  details: 'My venture / requirement: [Please describe briefly]',
  callToAction: 'Could you please explain how we can initiate an advisory consultation?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/about/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="About BRNDNUR Advisory LLP"
      title="Guidance for Your Brand’s<br><span>Next Chapter.</span>"
      hasGoldRule={true}
      description="BRNDNUR Advisory LLP is an independent business and brand advisory firm based in Manjeri, Malappuram, Kerala. We provide structured guidance to entrepreneurs, growing enterprises, and NRI founders seeking clear trademark protection and regulatory compliance."
      primaryCta={{
        text: "Get in Touch",
        href: "/contact/",
        icon: "→"
      }}
      secondaryCta={{
        text: "Explore Our Services",
        href: "/services/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Trade Marks Act", subtitle: "1999 Guidance" },
        { icon: "▱", title: "Based in", subtitle: "Manjeri, Kerala" },
        { icon: "⌖", title: "Transparent", subtitle: "Statutory Scope" }
      ]}
      image="/assets/about-hero-guidance.webp"
      imageAlt="BRNDNUR Advisory executive workspace in Manjeri, Kerala"
    />

    <!-- Story Split Section (Harmonized with Homepage Why BRNDNUR) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo split-photo--portrait" data-ratio="portrait">
          <img src="/assets/about-values-integrity.webp" alt="BRNDNUR Advisory consultation scene and client portfolio" width="1000" height="1500" loading="lazy" decoding="async" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Our Heritage &amp; Mission</p>
          <h2>Clarity, Integrity, and Protection from Day One.</h2>
          <div class="gold-rule"></div>
          <p>Starting or expanding an enterprise brings a storm of questions: Is your brand name legally clear? What classes of the NICE classification protect your specific products? How do statutory concessions apply to your startup or MSME?</p>
          <p>At BRNDNUR Advisory LLP, we bridge the gap between complex regulatory statutes and day-to-day business reality. Founded in Malabar, we advise local Kerala businesses, consumer brands, food ventures, and Gulf-return entrepreneurs with objective, transparent guidance before significant capital is committed.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Objective Risk Assessment</strong>
                <p>Rigorous research, honest risk appraisal, and transparent filing preparation without false guarantees.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Transparent Statutory Delineation</strong>
                <p>Direct government receipts and an upfront separation of official statutory fees from professional advisory.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Client-Focused Partnership</strong>
                <p>Clear, responsive advisory built for long-term brand protection and commercial growth.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Advisory Areas (Harmonized with Homepage Service Grid) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">What We Do</p>
          <h2>Comprehensive Brand &amp; Regulatory Advisory.</h2>
          <div class="gold-rule"></div>
          <p>We focus on critical foundational legal steps that protect your identity and establish compliance across India.</p>
        </div>

        <CardCarousel id="about-services-carousel" ariaLabel="Core advisory services">
          <article class="service-card">
            <img src="/assets/about-card-trademark.webp" alt="Trademark registration services" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Trademark Guidance</h3>
              <p>Comprehensive availability searches, classification across 45 NICE classes, application drafting, and monitoring under the Trade Marks Act, 1999.</p>
              <a class="text-link" href="/trademark-registration/">Learn More <span>→</span></a>
            </div>
          </article>

          <article class="service-card">
            <img src="/assets/about-card-corporate.webp" alt="Business registration support" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Business Registration</h3>
              <p>Structured onboarding for GST registrations, Udyam MSME certificates for 50% government fee benefits, and FSSAI licensing for food enterprises.</p>
              <a class="text-link" href="/services/">Learn More <span>→</span></a>
            </div>
          </article>

          <article class="service-card">
            <img src="/assets/about-card-search.webp" alt="Transparent pricing packages" width="1000" height="750" loading="lazy" />
            <div class="service-body">
              <h3>Transparent Pricing</h3>
              <p>Every proposal clearly itemizes statutory Government fees versus BRNDNUR professional charges so you never encounter unexpected surprise billing.</p>
              <a class="text-link" href="/packages/">Learn More <span>→</span></a>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Who We Help Section (Per BRAIN/03_PAGE_SPECS/01_MAIN_PAGES.md) -->
    <section class="section section-dark-advise" id="who-we-advise">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Tailored Engagement</p>
          <h2>Who We Advise &amp; Support.</h2>
          <div class="gold-rule"></div>
          <p>We tailor our advisory scope to the exact commercial stage and legal requirements of each client.</p>
        </div>

        <CardCarousel id="about-advise-carousel" class="dark-carousel" ariaLabel="Who we advise and support">
          <article class="service-card advise-card">
            <div class="advise-icon-circle" aria-hidden="true">♙</div>
            <h3>Early-Stage Founders</h3>
            <p>Preliminary brand clearance, conflict-free name validation, and cost-effective individual/startup filing under the Trade Marks Act, 1999.</p>
            <a class="text-link" href="/packages/individual-msme/">Individual / MSME Package <span>→</span></a>
          </article>

          <article class="service-card advise-card">
            <div class="advise-icon-circle" aria-hidden="true">▥</div>
            <h3>Food &amp; Consumer Brands</h3>
            <p>Multi-class protection across NICE Classes 29, 30, and 43 combined with mandatory FSSAI food licensing and packaging compliance.</p>
            <a class="text-link" href="/packages/food-brand/">Food Brand Package <span>→</span></a>
          </article>

          <article class="service-card advise-card">
            <div class="advise-icon-circle" aria-hidden="true">▤</div>
            <h3>Growing Enterprises &amp; LLPs</h3>
            <p>Corporate trademark holdings, brand portfolio restructuring, multi-class filings, and ongoing registry brand watch surveillance.</p>
            <a class="text-link" href="/packages/company-llp/">Company &amp; LLP Package <span>→</span></a>
          </article>

          <article class="service-card advise-card">
            <div class="advise-icon-circle" aria-hidden="true">⌖</div>
            <h3>Gulf-Return Entrepreneurs</h3>
            <p>Local advisory in Malabar for NRI founders launching manufacturing, hospitality, or retail ventures in Kerala with end-to-end setup.</p>
            <a class="text-link" href="/packages/gulf-return-business/">Gulf-Return Package <span>→</span></a>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Working Principles (Harmonized with Homepage Process Steps) -->
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Our Working Principles</p>
          <h2>How We Build Enduring Partnerships.</h2>
          <div class="gold-rule"></div>
          <p>Our advisory philosophy is governed by three non-negotiable standards of professional practice.</p>
        </div>

        <CardCarousel id="about-principles-carousel" ariaLabel="Our working principles">
          <article class="step">
            <div class="step-top">
              <span class="step-num">01</span>
              <span class="step-line"></span>
            </div>
            <h3>Commercial Understanding</h3>
            <p>We evaluate your long-term business roadmap, distribution channels, and export goals before recommending classes or corporate structures.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">02</span>
              <span class="step-line"></span>
            </div>
            <h3>Complete Transparency</h3>
            <p>Government fees and professional fees are distinctly separated. You receive official e-filing receipts directly from government portals.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">03</span>
              <span class="step-line"></span>
            </div>
            <h3>Diligence &amp; Accuracy</h3>
            <p>We meticulously verify entity constitutions, user date affidavits, and power of attorney documents to avoid avoidable registry objections.</p>
          </article>
        </CardCarousel>

        <div style="text-align: center; margin-top: 2.5rem;">
          <a class="btn btn-navy" href="/how-it-works/">See How Our Process Works <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Partner With Us</p>
          <h2>Ready to Take the Next Step<br>for Your Brand?</h2>
          <p>Whether you need a preliminary brand search or comprehensive business setup advisory, our team in Kerala is ready to assist you.</p>
          <a class="btn btn-gold" href={aboutClosingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Discuss Your Requirements on WhatsApp <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Direct Advisory</strong>
              <p>Speak directly with our team in Manjeri.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Confidential Discussions</strong>
              <p>Your business assets are handled with strict care.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Comprehensive Support</strong>
              <p>Guidance from preliminary search to final certificate.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .split-photo {
    aspect-ratio: 3 / 4;
    max-width: 380px;
  }
  .split-photo img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 35%;
  }
  @media (max-width: 767px) {
    .split-photo,
    .split-photo img {
      aspect-ratio: 3 / 4 !important;
      max-width: 340px !important;
      object-position: center 35% !important;
    }
  }
</style>
