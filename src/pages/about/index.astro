---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "About BRNDNUR | Brand & Business Advisory LLP";
const description = "Learn about BRNDNUR Advisory LLP: our client-focused approach to trademark registration guidance and practical business advisory in Kerala, India.";
const canonical = "https://brndnur.com/about/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/about/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">About BRNDNUR</p>
        <h1>Guidance for Your Brand’s Next Chapter.</h1>
        <p class="lead">BRNDNUR Advisory LLP is an independent business and brand advisory firm based in Manjeri, Malappuram, Kerala. We provide structured guidance to entrepreneurs, growing enterprises, and established businesses seeking clear trademark and registration support.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contact/">Get in Touch</a>
          <a class="btn btn-outline" href="/services/">Explore Our Services</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Our Mission</p>
          <h2>Clarity and Protection from Day One.</h2>
          <p>Choosing a brand name, protecting intellectual property, and establishing regulatory compliance can feel daunting. We demystify the journey through objective consultation, transparent scopes, and hands-on assistance.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">♢</div>
            <h3>Brand Protection Guidance</h3>
            <p>End-to-end support for trademark searches, class identification, application preparation, and monitoring across India.</p>
            <a class="card-link" href="/trademark-registration/">Learn about trademarks &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon">▱</div>
            <h3>Business Registration Support</h3>
            <p>Assistance navigating GST, Udyam/MSME, FSSAI for food ventures, and foundational business setup requirements.</p>
            <a class="card-link" href="/services/">View business services &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon">⌖</div>
            <h3>Practical, Transparent Advice</h3>
            <p>We outline verified government charges and professional fees upfront before any work commences, avoiding false promises.</p>
            <a class="card-link" href="/packages/">Explore packages &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Our Working Principles</p>
          <h2>How We Build Enduring Partnerships.</h2>
          <p>Our advisory philosophy is rooted in three non-negotiable standards of service.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">♙</div>
            <h3>Client-Focused Listening</h3>
            <p>We evaluate your specific industry, commercial goals, and brand expansion plans before recommending trademark classes or business structures.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">▤</div>
            <h3>Complete Fee Transparency</h3>
            <p>We clearly delineate statutory government charges from our professional fees, so you always know exactly what you are paying for.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">▥</div>
            <h3>Realistic Risk Disclosure</h3>
            <p>Trademark approval ultimately rests with the Registrar. We provide honest preliminary risk assessments without misleading guarantees.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Partner With Us</p>
          <h2>Ready to Take the Next Step for Your Brand?</h2>
          <p>Whether you need a preliminary brand search or comprehensive business setup advisory, our team in Kerala is ready to assist you.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20my%20brand%20requirements." target="_blank" rel="noopener noreferrer">Chat with Us on WhatsApp</a>
            <a class="btn btn-outline" href="/contact/">View Contact Options</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
