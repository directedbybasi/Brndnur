---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "About BRNDNUR | Brand & Business Advisory LLP";
const description = "Learn about BRNDNUR Advisory LLP: our client-focused approach to trademark registration guidance and practical business advisory in Kerala, India.";
const canonical = "https://brndnur.com/about/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/about/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <span class="current">About</span>
        </nav>
        <p class="eyebrow">About BRNDNUR Advisory LLP</p>
        <h1>Guidance for Your Brand’s Next Chapter.</h1>
        <p class="lead">BRNDNUR Advisory LLP is an independent business and brand advisory firm based in Manjeri, Malappuram, Kerala. We provide structured guidance to entrepreneurs, growing enterprises, and NRI founders seeking clear trademark protection and regulatory compliance.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Trade Marks Act, 1999 Guidance</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Manjeri, Malappuram, Kerala</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Transparent Statutory Delineation</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="/contact/">Get in Touch</a>
          <a class="btn btn-outline" href="/services/">Explore Our Services</a>
        </div>
      </div>
    </section>

    <!-- Story Split Section with Authentic Media -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/assets/about-workspace-rounded.webp" alt="BRNDNUR Advisory advisory desk workspace in Kerala" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Our Heritage & Mission</p>
            <h2>Clarity, Integrity, and Protection from Day One.</h2>
            <p>Starting or expanding an enterprise brings a storm of questions: Is your brand name legally clear? What classes of the NICE classification protect your specific products? How do statutory concessions apply to your startup or MSME?</p>
            <p>At BRNDNUR Advisory LLP, we bridge the gap between complex regulatory statutes and day-to-day business reality. Founded in Malabar, we advise local Kerala businesses, consumer brands, food ventures, and Gulf-return entrepreneurs with objective, transparent guidance before significant capital is committed.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>Objective Risk Assessment</h4>
                <p>We do not make false guarantees of automatic trademark registration. Trademark rights are granted exclusively by the Registrar of Trade Marks under statutory examination. Our commitment is rigorous research, honest risk appraisal, and flawless filing preparation.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Advisory Areas with Bespoke SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">What We Do</p>
          <h2>Comprehensive Brand & Regulatory Advisory</h2>
          <p>We focus on critical foundational legal steps that protect your identity and establish compliance across India.</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>Trademark Guidance</h3>
            <p>Comprehensive availability searches, classification across 45 NICE classes, application drafting, and monitoring under the Trade Marks Act, 1999.</p>
            <a class="card-link" href="/trademark-registration/">Learn about trademarks &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h3>Business Registration</h3>
            <p>Structured onboarding for GST registrations, Udyam MSME certificates for 50% government fee benefits, and FSSAI licensing for food enterprises.</p>
            <a class="card-link" href="/services/">View business services &rarr;</a>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="18" x2="12" y2="6"/></svg>
            </div>
            <h3>Transparent Pricing</h3>
            <p>Every proposal clearly itemizes statutory Government fees versus BRNDNUR professional charges so you never encounter unexpected surprise billing.</p>
            <a class="card-link" href="/packages/">Explore packages &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Working Principles -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Our Working Principles</p>
          <h2>How We Build Enduring Partnerships</h2>
          <p>Our advisory philosophy is governed by three non-negotiable standards of professional practice.</p>
        </div>

        <div class="journey-grid">
          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">1</div>
              <span class="journey-step-tag">Listening</span>
            </div>
            <h3>Commercial Understanding</h3>
            <p>We evaluate your long-term business roadmap, distribution channels, and export goals before recommending classes or corporate structures.</p>
          </div>

          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">2</div>
              <span class="journey-step-tag">Ethics</span>
            </div>
            <h3>Complete Transparency</h3>
            <p>Government fees and professional fees are distinctly separated. You receive official e-filing receipts directly from government portals.</p>
          </div>

          <div class="journey-card">
            <div class="journey-header">
              <div class="journey-number">3</div>
              <span class="journey-step-tag">Precision</span>
            </div>
            <h3>Diligence & Accuracy</h3>
            <p>We meticulously verify entity constitutions, user date affidavits, and power of attorney documents to avoid avoidable registry objections.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Partner With Us</p>
          <h2>Ready to Take the Next Step for Your Brand?</h2>
          <p>Whether you need a preliminary brand search or comprehensive business setup advisory, our team in Kerala is ready to assist you.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20my%20brand%20requirements." target="_blank" rel="noopener noreferrer">Chat with Us on WhatsApp</a>
            <a class="btn btn-outline" href="/contact/">View Contact Options</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
