---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const title = "About BRNDNUR | Brand & Business Advisory LLP";
const description = "Learn about BRNDNUR Advisory LLP: our advisory-first approach to trademark registration, IP clearance, and business protection in Malappuram, Kerala.";
const canonical = "https://brndnur.com/about/";
const ogImage = "/assets/about-hero-guidance.webp";

const aboutWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'About BRNDNUR',
  sectionName: 'Hero Section',
  enquiryType: 'Free Name Check Consultation',
  message: 'Hi BRNDNUR, I would like to request a free preliminary brand name check to verify trademark availability. Could you please guide me through the search process, required details, and next steps?'
});

const aboutClosingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'About BRNDNUR',
  sectionName: 'Closing Free Name Check Band',
  enquiryType: 'Free Name Check Request',
  message: 'Hi BRNDNUR, I would like to send my proposed brand name for an availability check and initial consultation. Could you please explain the clearance process, applicable fees, and the next steps?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/about/"
  heroImage="/assets/about-hero-guidance.webp"
  hasCustomSchema={true}
>
  <main id="main-content">
    <!-- Hero Section -->
    <PageHero
      eyebrow="ABOUT BRNDNUR ADVISORY LLP"
      title="Your Brand Name.<br><span>Legally Yours.</span>"
      hasGoldRule={true}
      description="We are a specialist trademark and IP advisory firm based in Malappuram. Our job is to make sure your brand is legally yours &mdash; before someone else makes it theirs."
      primaryCta={{
        text: "WhatsApp Free Name Check",
        href: aboutWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Explore Our Services",
        href: "/services/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Trade Marks Act", subtitle: "1999 Guidance" },
        { icon: "▱", title: "Based in", subtitle: "Skatt Business Park, Manjeri, Malappuram - 676121" },
        { icon: "⌖", title: "Advisory-First", subtitle: "Not a Filing Agent" }
      ]}
      image="/assets/about-hero-guidance.webp"
      imageAlt="BRNDNUR Advisory executive workspace in Manjeri, Malappuram"
      imagePosition="left 35%"
      imagePositionMobile="50% 50%"
      imageTransform="scale(1.25) translateX(14%) translateY(-2%)"
    />

    <!-- Who We Are (Condensed Single-Paragraph Advisory Section) -->
    <section class="section about-story-section">
      <div class="container split-section">
        <div class="split-photo split-photo--portrait" data-ratio="portrait">
          <img src="/assets/about-values-integrity.webp" alt="BRNDNUR Advisory consultation scene and client portfolio" width="1000" height="1500" loading="lazy" decoding="async" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">WHO WE ARE</p>
          <h2>A Trademark Firm That Thinks About Consequences</h2>
          <div class="gold-rule"></div>
          
          <blockquote class="about-quote">
            <p>&ldquo;A trademark is not a formality. It is the only legal instrument that gives you the right to stop someone else from profiting from your brand.&rdquo;</p>
          </blockquote>

          <p class="story-lead">
            BRNDNUR Advisory LLP was built around one observation: most businesses in Kerala seek trademark protection only after something goes wrong &mdash; a copycat surfaces, a bank flags a name conflict, or a franchise deal falls through because the brand isn't registered. By then, the options are expensive and the outcomes uncertain.
          </p>
          <p class="story-lead">
            We work the other way. We help you understand your exposure before you have a problem, file in the right classes before a competitor does, and keep your registration current so you never lose rights you built. We are not a filing agent. We are an advisory firm. That means every engagement starts with a legal assessment of your situation &mdash; your business, your market, your risk &mdash; not a form submission.
          </p>
        </div>
      </div>
    </section>


    <!-- Why BRNDNUR (3 Differentiators in 1 sentence each) -->
    <section class="section why-section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">WHY BRNDNUR</p>
          <h2>What Sets Us Apart from a Filing Agent</h2>
          <div class="gold-rule" style="margin-inline: auto;"></div>
        </div>

        <div class="differentiators-grid">
          <article class="diff-card">
            <span class="diff-num">01</span>
            <h3>Legal Opinion, Not a Receipt</h3>
            <p>A filing agent enters your data and submits a form. We analyse your business, identify the classes that actually protect you, and give you a written legal assessment &mdash; not a transaction confirmation.</p>
          </article>

          <article class="diff-card">
            <span class="diff-num">02</span>
            <h3>Examination Reports Handled Properly</h3>
            <p>An IP India Examination Report objection has a 30-day window. We draft a full legal reply with evidence &mdash; not an extension request followed by silence.</p>
          </article>

          <article class="diff-card">
            <span class="diff-num">03</span>
            <h3>Class Strategy, Not Class Guessing</h3>
            <p>The wrong class gives you a registration that protects nothing. We map your business to every class a competitor could exploit &mdash; now and as you grow.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Signature Dark Navy CTA Band (Harmonized with Homepage & Brand System) -->
    <section class="cta-band" aria-labelledby="cta-heading">
      <img
        class="cta-leaves"
        src="/assets/cta-leaves.webp"
        alt=""
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
      />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Start with a Free Name Check</p>
          <h2 id="cta-heading">Ready to Secure Your Brand Name?</h2>
          <p>Send us your brand name on WhatsApp. We search IP India across all relevant classes and advise you on risks and availability &mdash; free, with no obligation.</p>
          <a class="btn btn-gold" href={aboutClosingWhatsAppUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp Free Name Check <span class="arrow">&rarr;</span>
          </a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon" aria-hidden="true">&#9742;</span>
            <div>
              <strong>Quick Response</strong>
              <p>WhatsApp response within the same business day.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon" aria-hidden="true">&#9671;</span>
            <div>
              <strong>24-Hour Clearance</strong>
              <p>Preliminary conflict search delivered within 24 hours.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon" aria-hidden="true">&#9827;</span>
            <div>
              <strong>Strict Confidentiality</strong>
              <p>Your proposed marks and trade secrets handled securely.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
/* Story Split */
.split-section {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.2fr);
  gap: clamp(32px, 4vw, 56px);
  align-items: center;
}
.split-photo {
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 12px 30px rgba(19, 35, 58, 0.08);
  aspect-ratio: 3 / 4;
  max-width: 420px;
}
.split-photo img { width: 100%; height: 100%; object-fit: cover; }

.about-quote {
  border-left: 3px solid var(--gold);
  margin: 0 0 20px 0;
  padding: 8px 0 8px 18px;
  background: rgba(168, 120, 26, 0.05);
  border-radius: 0 6px 6px 0;
}
.about-quote p {
  font-family: var(--serif);
  font-style: italic;
  font-size: 1.15rem;
  line-height: 1.5;
  color: var(--navy);
  margin: 0;
}
.story-lead {
  font-size: 1.05rem;
  line-height: 1.68;
  color: #2D3A4B;
  margin-bottom: 16px;
}

/* Differentiators Grid */
.why-section {
  background: var(--ivory);
}
.differentiators-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 36px;
}
.diff-card {
  background: #FFFCF6;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 28px 24px;
  box-shadow: 0 4px 12px rgba(19, 35, 58, 0.03);
}
.diff-num {
  font-family: var(--serif);
  font-size: 2rem;
  font-weight: 700;
  color: var(--gold);
  line-height: 1;
  display: block;
  margin-bottom: 12px;
}
.diff-card h3 {
  font-size: 1.2rem;
  line-height: 1.35;
  margin: 0 0 10px;
  color: var(--navy);
}
.diff-card p {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #4A5568;
  margin: 0;
}

@media (max-width: 900px) {
  .split-section {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .split-photo {
    max-width: 100%;
    aspect-ratio: 4 / 3;
  }
  .differentiators-grid {
    grid-template-columns: 1fr;
  }
}
</style>
