---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/hero/PageHero.astro";
import CardCarousel from "../../components/CardCarousel.astro";
import FaqItem from "../../components/FaqItem.astro";

const title = "Packages & Pricing | BRNDNUR Advisory LLP";
const description =
  "Compare trademark and business support package options from BRNDNUR Advisory LLP. Understand indicative inclusions and request a personalised quotation.";
const canonical = "https://brndnur.com/packages/";
const ogImage = "/packages/assets/hero-packages.webp";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroQuoteUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Hero Section',
  enquiryType: 'Personalised Package Quotation',
  message: 'Hi BRNDNUR, I am exploring your fixed-fee service packages and would like to request a tailored quotation for my business. Could you please guide me on package inclusions, government fees, and the onboarding process?'
});

const starterPackUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Brand Starter Pack Card',
  enquiryType: 'Brand Starter Package Enquiry',
  message: 'Hi BRNDNUR, I am interested in the Brand Starter Package for my business. Could you please share the package deliverables, name clearance details, statutory filing fees, and the steps to get started?'
});

const tmPackageUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Standard Trademark Package Card',
  enquiryType: 'Trademark Registration Package Enquiry',
  message: 'Hi BRNDNUR, I am interested in the Standard Trademark Registration Package. Could you please explain the end-to-end filing scope, MSME fee concession benefits, documentation required, and next steps?'
});

const foodBrandUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Food Brand Package Card',
  enquiryType: 'Food Brand Package Enquiry',
  message: 'Hi BRNDNUR, I am interested in the Food Brand Package combining trademark registration and FSSAI food licensing. Could you please share the full package scope, applicable statutory fees, and registration timelines?'
});

const gulfPackageUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Gulf Return Business Package Card',
  enquiryType: 'Gulf Return Business Package Enquiry',
  message: 'Hi BRNDNUR, I am an NRI returning from the Gulf and planning to launch a business in Kerala. Could you please guide me through your Gulf Return Business Package, entity setup, and brand clearance roadmaps?'
});

const brandWatchAddonUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Brand Watch Add-on',
  enquiryType: 'Brand Watch Monitoring Add-on',
  message: 'Hi BRNDNUR, I would like to add Brand Watch journal monitoring to my trademark protection. Could you please explain the weekly surveillance scope, opposition alerts, and subscription terms?'
});

const tmRenewalAddonUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Renewal Support Add-on',
  enquiryType: 'Trademark Renewal Add-on',
  message: 'Hi BRNDNUR, I would like to enquire about your trademark renewal support service. Could you please explain the renewal audit, statutory filing window on Form TM-R, and applicable fees?'
});

const bizRegAddonUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Business Registrations Add-on',
  enquiryType: 'Business Registration Add-on',
  message: 'Hi BRNDNUR, I would like to enquire about adding business registrations like GST, Udyam MSME, or FSSAI to my trademark filing. Could you please share the combined scope, documents needed, and fees?'
});

const closingPackageQuoteUrl = buildWhatsAppUrl({
  pageName: 'Packages Hub',
  sectionName: 'Closing CTA Band',
  enquiryType: 'Custom Package Quotation',
  message: 'Hi BRNDNUR, I would like to request a customized service package combining trademark protection and statutory business setup for my enterprise. Could you please share a detailed scope, fee breakdown, and onboarding timeline?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/packages/"
  hasCustomSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebPage",
            "@id": "https://brndnur.com/packages/#webpage",
            "url": "https://brndnur.com/packages/",
            "name": "Packages & Pricing | BRNDNUR Advisory LLP",
            "description": "Compare trademark and business support package options from BRNDNUR Advisory LLP. Understand indicative inclusions and request a personalised quotation.",
            "isPartOf": {
              "@type": "WebSite",
              "@id": "https://brndnur.com/#website",
              "url": "https://brndnur.com/",
              "name": "BRNDNUR Advisory LLP"
            }
          },
          {
            "@type": "FAQPage",
            "@id": "https://brndnur.com/packages/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Are government fees included in the package price?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Not necessarily. Ask for a quotation that clearly separates government charges from BRNDNUR's professional fees and any additional services."
                }
              },
              {
                "@type": "Question",
                "name": "Does trademark pricing depend on the number of classes?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, the number of classes and your applicant category can affect the overall cost. Confirm the exact scope before proceeding."
                }
              },
              {
                "@type": "Question",
                "name": "What is included in the Food Brand Package?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "The library describes trademark, Udyam/MSME and FSSAI-related support. Confirm current inclusions and which registrations apply to your business."
                }
              },
              {
                "@type": "Question",
                "name": "Can I get a package customised for my business?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Contact BRNDNUR to discuss your requirements and request a scope-specific quotation."
                }
              },
              {
                "@type": "Question",
                "name": "Are renewal and Brand Watch services included?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "These may be separate services unless your written quotation states they are included."
                }
              },
              {
                "@type": "Question",
                "name": "How do I get a quotation before proceeding?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Share your brand name, business type and service needs over WhatsApp. Review the scope and charges before confirming."
                }
              }
            ]
          }
        ]
      }
    </script>
  </Fragment>

  <main id="main-content">
    <PageHero
      eyebrow="Packages & Pricing"
      title="Clear Options.<br />Practical Support.<br /><span>One Stronger Brand.</span>"
      description="Compare our trademark and business support packages, understand what's included, and choose the right starting point for your business."
      primaryCta={{
        text: "Explore Packages",
        href: "#packages",
        icon: "→"
      }}
      secondaryCta={{
        text: "Get a Personalised Quote",
        href: heroQuoteUrl,
        icon: "◎",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      trustBadges={[
        { icon: "◇", title: "Clear Scope", subtitle: "Inclusions" },
        { icon: "▱", title: "Transparent", subtitle: "Pricing" },
        { icon: "⌖", title: "Personal", subtitle: "Guidance" }
      ]}
      image="/packages/assets/hero-packages.webp"
      imageAlt="Warm ivory trademark portfolio, gold emblem and pen on a marble office desk"
      variant="package"
    />

    <section class="finder section-compact" aria-labelledby="finder-heading">
      <div class="container">
        <div class="section-heading centered">
          <p class="eyebrow eyebrow-rule">Find your starting point</p>
          <h2 id="finder-heading">What Do You Need Help With?</h2>
        </div>
        <div class="finder-grid">
          <a class="finder-item" href="#packages">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M12 3 19 6v5c0 5-3.3 8.2-7 10-3.7-1.8-7-5-7-10V6l7-3Z"
                ></path><path d="m9 12 2 2 4-5"></path></svg
              ></span
            >
            <span class="finder-title">Protect My Brand</span>
            <span class="finder-desc"
              >Search, registration and ongoing support.</span
            >
            <span class="text-link">View Options <b>→</b></span>
          </a>
          <a class="finder-item" href="#food-package">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M4 3v7M7 3v7M4 6h3M5.5 10v11M14 3c-2 3-2 7 1 9v9M15 3v18"
                ></path></svg
              ></span
            >
            <span class="finder-title">Start a Food Business</span>
            <span class="finder-desc"
              >Explore food-business and brand support.</span
            >
            <span class="text-link">View Package <b>→</b></span>
          </a>
          <a class="finder-item" href="#gulf-package">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><rect x="3" y="7" width="18" height="13" rx="2"></rect><path
                  d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"
                ></path></svg
              ></span
            >
            <span class="finder-title">Launch a Business</span>
            <span class="finder-desc"
              >Business registration and compliance guidance.</span
            >
            <span class="text-link">View Package <b>→</b></span>
          </a>
          <a class="finder-item" href="#ongoing-support">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M5 3h10l4 4v14H5z"></path><path
                  d="M15 3v5h4M8 12h8M8 16h8"></path></svg
              ></span
            >
            <span class="finder-title">Manage an Existing Trademark</span>
            <span class="finder-desc"
              >Renewal, watch and monitoring support.</span
            >
            <span class="text-link">View Options <b>→</b></span>
          </a>
        </div>
      </div>
    </section>

    <section
      class="packages section"
      id="packages"
      aria-labelledby="packages-heading"
    >
      <div id="pricing" style="scroll-margin-top: 100px;"></div>
      <div class="container">
        <div class="section-heading centered package-heading">
          <p class="eyebrow eyebrow-rule">Our packages</p>
          <h2 id="packages-heading">
            Choose the Support That Fits Your Business.
          </h2>
          <p>
            Clear starting points for different needs, with scope and applicable
            charges confirmed before you proceed.
          </p>
        </div>
        <CardCarousel id="packages-cards-carousel" ariaLabel="Choose the Support That Fits Your Business">
          <article class="package-card" id="individual-msme" style="scroll-margin-top: 100px;">
            <div class="package-photo">
              <img
                src="/packages/assets/packages-card-starter.webp"
                alt="Navy portfolio and gold-trimmed pen on a marble desk"
                width="1400"
                height="1050"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="package-content">
              <span class="package-kicker">For early-stage brands &amp; MSMEs</span>
              <h3>Individual &amp; MSME Brand Pack</h3>
              <p class="package-desc">
                Ideal for individual founders, sole proprietors, and small enterprises eligible for 50% statutory fee concessions.
              </p>
              <div class="price-line">
                <strong>₹4,999</strong><span class="price-note"
                  >Indicative + ₹4,500 gov fee</span>
              </div>
              <p class="eyebrow included-label">Core inclusions</p>
              <ul class="check-list">
                <li>Comprehensive IP India brand name search</li>
                <li>NICE class selection and strategy</li>
                <li>Form TM-A drafting and filing</li>
                <li>Filing receipt and priority date lock</li>
              </ul>
              <div style="display:flex; flex-direction:column; gap:8px;">
                <a
                  class="button button-small button-outline-navy"
                  href={starterPackUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  >Discuss This Package <span>→</span></a
                >
              </div>
            </div>
          </article>

          <article class="package-card package-featured" id="company-llp" style="scroll-margin-top: 100px;">
            <div class="package-photo">
              <img
                src="/packages/assets/packages-card-trademark.webp"
                alt="Ivory trademark portfolio with a gold registered symbol and legal books"
                width="1400"
                height="1050"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="package-content">
              <span class="package-kicker">Corporate &amp; Enterprise</span>
              <h3>Company &amp; LLP Trademark Package</h3>
              <p class="package-desc">
                End-to-end statutory brand protection for incorporated entities, companies, LLPs, and multi-director firms.
              </p>
              <div class="price-line">
                <strong>Get a Quote</strong><span class="price-note"
                  >Statutory fee: ₹9,000 / class</span>
              </div>
              <p class="eyebrow included-label">Support includes</p>
              <ul class="check-list">
                <li>Phonetic and visual conflict search across classes</li>
                <li>Corporate authorization &amp; board resolution verification</li>
                <li>Form TM-A corporate application filing</li>
                <li>Examination response advisory &amp; status tracking</li>
              </ul>
              <div style="display:flex; flex-direction:column; gap:8px;">
                <a
                  class="button button-small button-gold"
                  href={tmPackageUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  >Discuss This Package <span>→</span></a
                >
              </div>
              <span class="featured-badge">Core service</span>
            </div>
          </article>

          <article class="package-card" id="food-brand" style="scroll-margin-top: 100px;">
            <div id="food-package" style="position: relative; top: -100px;"></div>
            <div class="package-photo">
              <img
                src="/packages/assets/packages-card-food.webp"
                alt="Artisanal food jars, bakery items and blank product packaging in a sunlit kitchen"
                width="1400"
                height="1050"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="package-content">
              <span class="package-kicker">Food businesses &amp; Cloud Kitchens</span>
              <h3>Food Brand &amp; FSSAI Package</h3>
              <p class="package-desc">
                Coordinated trademark filing in Class 29/30/43, Udyam MSME certification, and mandatory FSSAI food licensing.
              </p>
              <div class="price-line">
                <strong>₹12,000</strong><span class="price-note"
                  >Indicative; confirm final quote</span>
              </div>
              <p class="eyebrow included-label">Listed support areas</p>
              <ul class="check-list">
                <li>Food trademark clearance search and TM-A filing</li>
                <li>Udyam MSME certification (50% fee discount)</li>
                <li>FSSAI food registration / licensing guidance</li>
                <li>Packaging mandatory labeling compliance</li>
              </ul>
              <div style="display:flex; flex-direction:column; gap:8px;">
                <a
                  class="button button-small button-outline-navy"
                  href={foodBrandUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  >Discuss This Package <span>→</span></a
                >
              </div>
            </div>
          </article>

          <article class="package-card" id="gulf-return-business" style="scroll-margin-top: 100px;">
            <div id="gulf-package" style="position: relative; top: -100px;"></div>
            <div class="package-photo">
              <img
                src="/packages/assets/packages-card-gulf.webp"
                alt="Navy business folio and documents overlooking a sunlit international business skyline"
                width="1400"
                height="1050"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="package-content">
              <span class="package-kicker"
                >Entrepreneurs launching a business</span
              >
              <h3>Gulf Return Business Package</h3>
              <p class="package-desc">
                Business-starting guidance combining brand and relevant
                registration support.
              </p>
              <div class="price-line">
                <strong>Starting at ₹18,000</strong><span class="price-note"
                  >Indicative; confirm final quote</span>
              </div>
              <p class="eyebrow included-label">Listed support areas</p>
              <ul class="check-list">
                <li>Brand name search</li>
                <li>Trademark filing support</li>
                <li>Udyam/MSME and GST assistance</li>
                <li>FSSAI guidance, where relevant</li>
              </ul>
              <div style="display:flex; flex-direction:column; gap:8px;">
                <a
                  class="button button-small button-outline-navy"
                  href={gulfPackageUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  >Discuss This Package <span>→</span></a
                >
              </div>
            </div>
          </article>
        </CardCarousel>
        <p class="package-disclaimer">
          Package prices and inclusions are indicative planning information, not
          a final offer. Please confirm current pricing, eligibility, government
          charges and the exact scope with BRNDNUR before payment.
        </p>
      </div>
    </section>

    <section
      class="price-breakdown section-compact"
      aria-labelledby="price-heading"
    >
      <div class="container split-section pricing-split">
        <div class="section-photo price-photo">
          <img
            src="/packages/assets/packages-pricing-breakdown.webp"
            alt="Calculator, trademark documents and pen on a refined legal office desk"
            width="1400"
            height="1050"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="price-copy">
          <p class="eyebrow">Trademark price breakdown</p>
          <h2 id="price-heading">Understand What You Pay For.</h2>
          <p class="section-intro">
            Trademark costs can depend on applicant category, number of classes
            and the services required. The examples below are from BRNDNUR's
            internal template library and must be verified before publication.
          </p>
          <div class="table-wrap">
            <table class="fee-table">
              <thead
                ><tr
                  ><th>Applicant type</th><th
                    >Government fee<br /><span>(per class)</span></th
                  ><th>Professional fee</th><th>Total estimate</th></tr
                ></thead
              >
              <tbody>
                <tr
                  ><td>Individual / eligible small business</td><td>₹4,500</td
                  ><td>₹1,500</td><td><strong>₹6,000</strong></td
                  ></tr
                >
                <tr
                  ><td>Company / LLP</td><td>₹9,000</td><td>₹2,000</td><td
                    ><strong>₹11,000</strong></td
                  ></tr
                >
              </tbody>
            </table>
          </div>
          <p class="table-note">
            Indicative examples only. Fees, eligibility, taxes and service scope
            may change; the final quotation should be confirmed before
            proceeding.
          </p>
        </div>
      </div>
    </section>

    <section
      class="included-section section-compact"
      aria-labelledby="included-heading"
    >
      <div class="container">
        <div class="section-heading centered compact-heading">
          <p class="eyebrow eyebrow-rule">What's included</p>
          <h2 id="included-heading">Know What's Included Before You Begin.</h2>
        </div>
        <CardCarousel id="packages-included-carousel" class="dark-carousel" ariaLabel="Know What's Included Before You Begin">
          <article class="included-item">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"></path></svg
              ></span
            >
            <h3>Services Included</h3>
            <p>A clear list of the work covered in each package.</p>
          </article>
          <article class="included-item">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7"></path></svg
              ></span
            >
            <h3>Documents Required</h3>
            <p>Understand the information you need to provide.</p>
          </article>
          <article class="included-item">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><circle cx="12" cy="12" r="9"></circle><path
                  d="M12 7v10M9 9h4a2 2 0 0 1 0 4H9"></path></svg
              ></span
            >
            <h3>Charges</h3>
            <p>
              See government fees, professional fees and possible additional
              costs.
            </p>
          </article>
          <article class="included-item">
            <span class="icon-tile"
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M4 12h15M13 6l6 6-6 6"></path></svg
              ></span
            >
            <h3>Next Steps</h3>
            <p>Know what happens after you confirm the package.</p>
          </article>
        </CardCarousel>
      </div>
    </section>

    <section
      class="ongoing-section section-compact"
      id="ongoing-support"
      aria-labelledby="ongoing-heading"
    >
      <div class="container split-section ongoing-split">
        <div class="section-photo ongoing-photo">
          <img
            src="/packages/assets/packages-watch-support.webp"
            alt="Navy document folio, magnifying glass and organised papers on a marble desk"
            width="1400"
            height="1050"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="ongoing-copy">
          <p class="eyebrow">What's next?</p>
          <h2 id="ongoing-heading">Support Beyond the Initial Application.</h2>
          <p class="section-intro">
            Some services may be needed later or separately, depending on your
            business and trademark.
          </p>
          <div class="addon-grid">
            <article class="addon-item">
              <span class="addon-icon"
                ><svg viewBox="0 0 24 24" aria-hidden="true"
                  ><circle cx="10.5" cy="10.5" r="6.5"></circle><path
                    d="m15.5 15.5 5 5M8 10.5h5M10.5 8v5"></path></svg
                ></span
              >
              <h3>Brand Watch</h3>
              <p>Monitoring options for potentially conflicting marks.</p>
              <a
                class="text-link"
                href={brandWatchAddonUrl}
                target="_blank"
                rel="noopener noreferrer">Learn More <b>→</b></a
              >
            </article>
            <article class="addon-item">
              <span class="addon-icon"
                ><svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path d="M20 7v5h-5M4 17v-5h5"></path><path
                    d="M6 9a7 7 0 0 1 12-2l2 5M4 12l2 5a7 7 0 0 0 12-2"
                  ></path></svg
                ></span
              >
              <h3>Trademark Renewal</h3>
              <p>Understand renewal requirements and timing.</p>
              <a
                class="text-link"
                href={tmRenewalAddonUrl}
                target="_blank"
                rel="noopener noreferrer">Learn More <b>→</b></a
              >
            </article>
            <article class="addon-item">
              <span class="addon-icon"
                ><svg viewBox="0 0 24 24" aria-hidden="true"
                  ><path
                    d="M4 20V8l8-4 8 4v12M2 20h20M9 20v-6h6v6M8 10h.01M16 10h.01"
                  ></path></svg
                ></span
              >
              <h3>Business Registration Assistance</h3>
              <p>GST, Udyam/MSME, FSSAI and other relevant registrations.</p>
              <a
                class="text-link"
                href={bizRegAddonUrl}
                target="_blank"
                rel="noopener noreferrer">Learn More <b>→</b></a
              >
            </article>
          </div>
        </div>
      </div>
    </section>

    <section
      class="steps-section section-compact"
      aria-labelledby="steps-heading"
    >
      <div class="container">
        <div class="section-heading centered compact-heading">
          <p class="eyebrow eyebrow-rule">How to get started</p>
          <h2 id="steps-heading">Three Simple Steps to Get a Quote.</h2>
        </div>
        <CardCarousel id="packages-steps-carousel" class="dark-carousel" ariaLabel="Three Simple Steps to Get a Quote">
          <article class="step-item">
            <span class="step-number" aria-hidden="true">01</span>
            <div class="step-copy">
              <h3>Tell Us About Your Business</h3><p>
                Share your brand, business type and what you need.
              </p>
            </div>
          </article>
          <article class="step-item">
            <span class="step-number" aria-hidden="true">02</span>
            <div class="step-copy">
              <h3>Review Your Options</h3><p>
                Discuss the best package, scope and applicable fees.
              </p>
            </div>
          </article>
          <article class="step-item">
            <span class="step-number" aria-hidden="true">03</span>
            <div class="step-copy">
              <h3>Confirm Before Proceeding</h3><p>
                Review the documents, charges and next steps.
              </p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <section class="faq-section section-compact" aria-labelledby="faq-heading">
      <div class="container split-section faq-split">
        <div class="section-photo faq-photo">
          <img
            src="/packages/assets/packages-faq-legal.webp"
            alt="Navy legal books, cream portfolio and brass scales of justice in warm light"
            width="1400"
            height="788"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="faq-copy">
          <p class="eyebrow">Frequently asked questions</p>
          <h2 id="faq-heading">Questions About Packages &amp; Pricing?</h2>
          <p class="section-intro">
            A few helpful answers before you choose your next step.
          </p>
          <div class="faq-editorial-list faq-list">
            <FaqItem
              num="01"
              question="Are government fees included in the package price?"
              answer="Not necessarily. Ask for a quotation that clearly separates government charges from BRNDNUR's professional fees and any additional services."
            />
            <FaqItem
              num="02"
              question="Does trademark pricing depend on the number of classes?"
              answer="Yes, the number of classes and your applicant category can affect the overall cost. Confirm the exact scope before proceeding."
            />
            <FaqItem
              num="03"
              question="What is included in the Food Brand Package?"
              answer="The library describes trademark, Udyam/MSME and FSSAI-related support. Confirm current inclusions and which registrations apply to your business."
            />
            <FaqItem
              num="04"
              question="Can I get a package customised for my business?"
              answer="Contact BRNDNUR to discuss your requirements and request a scope-specific quotation."
            />
            <FaqItem
              num="05"
              question="Are renewal and Brand Watch services included?"
              answer="These may be separate services unless your written quotation states they are included."
            />
            <FaqItem
              num="06"
              question="How do I get a quotation before proceeding?"
              answer="Share your brand name, business type and service needs over WhatsApp. Review the scope and charges before confirming."
            />
          </div>
          <a class="text-link faq-link" href="/faqs/"
            >View All FAQs <b>→</b></a
          >
        </div>
      </div>
    </section>

    <section class="final-cta section-compact">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Ready to get started?</p>
          <h2>Not Sure Which Package to Choose?</h2>
          <p>
            Tell us about your brand or business. We'll discuss suitable
            options, what's included, and the applicable charges.
          </p>
          <a
            class="button button-gold"
            href={closingPackageQuoteUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.9Z"
              ></path><path
                d="M8.4 8.3c.3-.6.6-.6.9-.6h.4c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4 0 .6.6 1 1.4 1.8 2.4 2.3.2.1.4.1.6-.1l.8-.9c.2-.2.4-.3.6-.2l1.7.8c.3.1.4.3.4.5 0 .4-.2 1.1-.7 1.5-.5.4-1.2.7-2 .5-1-.2-2.3-.7-3.8-2-1.2-1.1-2-2.5-2.2-3.4-.2-.8.1-1.6.4-2Z"
              ></path></svg
            >
            Get a Personalised Quote on WhatsApp <span aria-hidden="true"
              >→</span
            >
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll(".faq-q").forEach((button) => {
    button.addEventListener("click", () => {
      const item = button.closest(".faq-item");
      if (item) {
        const open = item.classList.toggle("active");
        button.setAttribute("aria-expanded", String(open));
      }
    });
  });
</script>

