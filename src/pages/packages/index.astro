---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Packages & Pricing | BRNDNUR Advisory LLP";
const description = "Compare trademark and business support package options from BRNDNUR Advisory LLP. Understand indicative inclusions and request a personalised quotation.";
const canonical = "https://brndnur.in/packages/";
const ogImage = "/packages/assets/hero-packages.webp";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/packages/"
>
  <Fragment slot="head">
    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://brndnur.in/packages/#webpage",
        "url": "https://brndnur.in/packages/",
        "name": "Packages & Pricing | BRNDNUR Advisory LLP",
        "description": "Compare trademark and business support package options from BRNDNUR Advisory LLP. Understand indicative inclusions and request a personalised quotation.",
        "isPartOf": {
          "@type": "WebSite",
          "@id": "https://brndnur.in/#website",
          "url": "https://brndnur.in/",
          "name": "BRNDNUR Advisory LLP"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://brndnur.in/packages/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Are government fees included in the package price?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not necessarily. Ask for a quotation that clearly separates government charges from BRNDNUR's professional fees and any additional services."
            }
          },
          {
            "@type": "Question",
            "name": "Does trademark pricing depend on the number of classes?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, the number of classes and your applicant category can affect the overall cost. Confirm the exact scope before proceeding."
            }
          },
          {
            "@type": "Question",
            "name": "What is included in the Food Brand Package?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The library describes trademark, Udyam/MSME and FSSAI-related support. Confirm current inclusions and which registrations apply to your business."
            }
          },
          {
            "@type": "Question",
            "name": "Can I get a package customised for my business?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Contact BRNDNUR to discuss your requirements and request a scope-specific quotation."
            }
          },
          {
            "@type": "Question",
            "name": "Are renewal and Brand Watch services included?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "These may be separate services unless your written quotation states they are included."
            }
          },
          {
            "@type": "Question",
            "name": "How do I get a quotation before proceeding?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Share your brand name, business type and service needs over WhatsApp. Review the scope and charges before confirming."
            }
          }
        ]
      }
    ]
  }
  </script>
  </Fragment>

  <main id="main">
    
    <section class="hero">
      <div class="hero-image" role="img" aria-label="Warm ivory trademark portfolio, gold emblem and pen on a marble office desk"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Packages &amp; Pricing</p>
          <h1>Clear Options.<br>Practical Support.<br><span>One Stronger Brand.</span></h1>
          <p class="hero-text">Compare our trademark and business support packages, understand what's included, and choose the right starting point for your business.</p>
          <div class="button-row">
            <a class="button button-navy" href="#packages">Explore Packages <span aria-hidden="true">→</span></a>
            <a class="button button-outline" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%27d%20like%20a%20personalised%20package%20quote." target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.9Z"/><path d="M8.4 8.3c.3-.6.6-.6.9-.6h.4c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4 0 .6.6 1 1.4 1.8 2.4 2.3.2.1.4.1.6-.1l.8-.9c.2-.2.4-.3.6-.2l1.7.8c.3.1.4.3.4.5 0 .4-.2 1.1-.7 1.5-.5.4-1.2.7-2 .5-1-.2-2.3-.7-3.8-2-1.2-1.1-2-2.5-2.2-3.4-.2-.8.1-1.6.4-2Z"/></svg>
              Get a Personalised Quote
            </a>
          </div>
          <div class="hero-assurances">
            <span><i class="mini-icon">◇</i> Clear scope</span>
            <span><i class="mini-icon">▱</i> Transparent pricing</span>
            <span><i class="mini-icon">⌖</i> Personal guidance</span>
          </div>
        </div>
      </div>
    </section>

    <section class="finder section-compact" aria-labelledby="finder-heading">
      <div class="container">
        <div class="section-heading centered">
          <p class="eyebrow eyebrow-rule">Find your starting point</p>
          <h2 id="finder-heading">What Do You Need Help With?</h2>
        </div>
        <div class="finder-grid">
          <a class="finder-item" href="#packages">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 5-3.3 8.2-7 10-3.7-1.8-7-5-7-10V6l7-3Z"/><path d="m9 12 2 2 4-5"/></svg></span>
            <span class="finder-title">Protect My Brand</span>
            <span class="finder-desc">Search, registration and ongoing support.</span>
            <span class="text-link">View Options <b>→</b></span>
          </a>
          <a class="finder-item" href="#food-package">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3v7M7 3v7M4 6h3M5.5 10v11M14 3c-2 3-2 7 1 9v9M15 3v18"/></svg></span>
            <span class="finder-title">Start a Food Business</span>
            <span class="finder-desc">Explore food-business and brand support.</span>
            <span class="text-link">View Package <b>→</b></span>
          </a>
          <a class="finder-item" href="#gulf-package">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"/></svg></span>
            <span class="finder-title">Launch a Business</span>
            <span class="finder-desc">Business registration and compliance guidance.</span>
            <span class="text-link">View Package <b>→</b></span>
          </a>
          <a class="finder-item" href="#ongoing-support">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5z"/><path d="M15 3v5h4M8 12h8M8 16h8"/></svg></span>
            <span class="finder-title">Manage an Existing Trademark</span>
            <span class="finder-desc">Renewal, watch and monitoring support.</span>
            <span class="text-link">View Options <b>→</b></span>
          </a>
        </div>
      </div>
    </section>

    <section class="packages section" id="packages" aria-labelledby="packages-heading">
      <div class="container">
        <div class="section-heading centered package-heading">
          <p class="eyebrow eyebrow-rule">Our packages</p>
          <h2 id="packages-heading">Choose the Support That Fits Your Business.</h2>
          <p>Clear starting points for different needs, with scope and applicable charges confirmed before you proceed.</p>
        </div>
        <div class="package-grid">
          <article class="package-card">
            <div class="package-photo"><img src="/packages/assets/brand-starter-pack.webp" alt="Navy portfolio and gold-trimmed pen on a marble desk" width="1400" height="1050" loading="lazy" decoding="async"></div>
            <div class="package-content">
              <span class="package-kicker">For early-stage brands</span>
              <h3>Brand Starter Pack</h3>
              <p class="package-desc">A starting point for brand-name exploration and trademark guidance.</p>
              <div class="price-line"><strong>₹4,999</strong><span class="price-note">Indicative; confirm current quote</span></div>
              <p class="included-label">Possible inclusions</p>
              <ul class="check-list">
                <li>Brand name search</li>
                <li>Trademark guidance</li>
                <li>Basic documentation support</li>
                <li>Guidance on next steps</li>
              </ul>
              <a class="button button-small button-outline-navy" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20share%20the%20current%20Brand%20Starter%20Pack%20scope%20and%20price." target="_blank" rel="noopener noreferrer">Discuss This Package <span>→</span></a>
            </div>
          </article>

          <article class="package-card package-featured">
            <div class="package-photo"><img src="/packages/assets/trademark-registration.webp" alt="Ivory trademark portfolio with a gold registered symbol and legal books" width="1400" height="1050" loading="lazy" decoding="async"></div>
            <div class="package-content">
              <span class="package-kicker">Brand protection</span>
              <h3>Trademark Registration</h3>
              <p class="package-desc">Guidance on searches, classification, documentation and the application process.</p>
              <div class="price-line"><strong>Get a Quote</strong><span class="price-note">Based on applicant and filing scope</span></div>
              <p class="included-label">Support may include</p>
              <ul class="check-list">
                <li>Trademark search and analysis</li>
                <li>Class selection guidance</li>
                <li>Document preparation support</li>
                <li>Application filing guidance</li>
              </ul>
              <a class="button button-small button-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%27d%20like%20a%20trademark%20registration%20quote." target="_blank" rel="noopener noreferrer">Discuss This Package <span>→</span></a>
              <span class="featured-badge">Core service</span>
            </div>
          </article>

          <article class="package-card" id="food-package">
            <div class="package-photo"><img src="/packages/assets/food-brand-package.webp" alt="Artisanal food jars, bakery items and blank product packaging in a sunlit kitchen" width="1400" height="1050" loading="lazy" decoding="async"></div>
            <div class="package-content">
              <span class="package-kicker">Food businesses</span>
              <h3>Food Brand Package</h3>
              <p class="package-desc">Trademark, Udyam/MSME and FSSAI-related support for food businesses, as applicable.</p>
              <div class="price-line"><strong>₹12,000</strong><span class="price-note">Indicative; confirm final quote</span></div>
              <p class="included-label">Listed support areas</p>
              <ul class="check-list">
                <li>Trademark support</li>
                <li>Udyam/MSME assistance</li>
                <li>FSSAI registration guidance</li>
                <li>Business advisory support</li>
              </ul>
              <a class="button button-small button-outline-navy" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20confirm%20the%20Food%20Brand%20Package%20scope%20and%20current%20price." target="_blank" rel="noopener noreferrer">Discuss This Package <span>→</span></a>
            </div>
          </article>

          <article class="package-card" id="gulf-package">
            <div class="package-photo"><img src="/packages/assets/gulf-business-package.webp" alt="Navy business folio and documents overlooking a sunlit international business skyline" width="1400" height="1050" loading="lazy" decoding="async"></div>
            <div class="package-content">
              <span class="package-kicker">Entrepreneurs launching a business</span>
              <h3>Gulf Return Business Package</h3>
              <p class="package-desc">Business-starting guidance combining brand and relevant registration support.</p>
              <div class="price-line"><strong>Starting at ₹18,000</strong><span class="price-note">Indicative; confirm final quote</span></div>
              <p class="included-label">Listed support areas</p>
              <ul class="check-list">
                <li>Brand name search</li>
                <li>Trademark filing support</li>
                <li>Udyam/MSME and GST assistance</li>
                <li>FSSAI guidance, where relevant</li>
              </ul>
              <a class="button button-small button-outline-navy" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20confirm%20the%20Gulf%20Return%20Business%20Package%20scope%20and%20price." target="_blank" rel="noopener noreferrer">Discuss This Package <span>→</span></a>
            </div>
          </article>
        </div>
        <p class="package-disclaimer">Package prices and inclusions are indicative planning information, not a final offer. Please confirm current pricing, eligibility, government charges and the exact scope with BRNDNUR before payment.</p>
      </div>
    </section>

    <section class="price-breakdown section-compact" aria-labelledby="price-heading">
      <div class="container split-section pricing-split">
        <div class="section-photo price-photo"><img src="/packages/assets/pricing-breakdown.webp" alt="Calculator, trademark documents and pen on a refined legal office desk" width="1400" height="1050" loading="lazy" decoding="async"></div>
        <div class="price-copy">
          <p class="eyebrow">Trademark price breakdown</p>
          <h2 id="price-heading">Understand What You Pay For.</h2>
          <p class="section-intro">Trademark costs can depend on applicant category, number of classes and the services required. The examples below are from BRNDNUR's internal template library and must be verified before publication.</p>
          <div class="table-wrap">
            <table class="fee-table">
              <thead><tr><th>Applicant type</th><th>Government fee<br><span>(per class)</span></th><th>Professional fee</th><th>Total estimate</th></tr></thead>
              <tbody>
                <tr><td>Individual / eligible small business</td><td>₹4,500</td><td>From ₹3,000</td><td><strong>₹7,500–9,500</strong></td></tr>
                <tr><td>Company / LLP</td><td>₹9,000</td><td>From ₹4,000</td><td><strong>₹13,000–15,000</strong></td></tr>
              </tbody>
            </table>
          </div>
          <p class="table-note">Indicative examples only. Fees, eligibility, taxes and service scope may change; the final quotation should be confirmed before proceeding.</p>
        </div>
      </div>
    </section>

    <section class="included-section section-compact" aria-labelledby="included-heading">
      <div class="container">
        <div class="section-heading centered compact-heading">
          <p class="eyebrow eyebrow-rule">What's included</p>
          <h2 id="included-heading">Know What's Included Before You Begin.</h2>
        </div>
        <div class="included-grid">
          <article class="included-item">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg></span>
            <h3>Services Included</h3>
            <p>A clear list of the work covered in each package.</p>
          </article>
          <article class="included-item">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7"/></svg></span>
            <h3>Documents Required</h3>
            <p>Understand the information you need to provide.</p>
          </article>
          <article class="included-item">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9h4a2 2 0 0 1 0 4H9"/></svg></span>
            <h3>Charges</h3>
            <p>See government fees, professional fees and possible additional costs.</p>
          </article>
          <article class="included-item">
            <span class="icon-tile"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
            <h3>Next Steps</h3>
            <p>Know what happens after you confirm the package.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ongoing-section section-compact" id="ongoing-support" aria-labelledby="ongoing-heading">
      <div class="container split-section ongoing-split">
        <div class="section-photo ongoing-photo"><img src="/packages/assets/brand-watch-support.webp" alt="Navy document folio, magnifying glass and organised papers on a marble desk" width="1400" height="1050" loading="lazy" decoding="async"></div>
        <div class="ongoing-copy">
          <p class="eyebrow">What's next?</p>
          <h2 id="ongoing-heading">Support Beyond the Initial Application.</h2>
          <p class="section-intro">Some services may be needed later or separately, depending on your business and trademark.</p>
          <div class="addon-grid">
            <article class="addon-item">
              <span class="addon-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5M8 10.5h5M10.5 8v5"/></svg></span>
              <h3>Brand Watch</h3>
              <p>Monitoring options for potentially conflicting marks.</p>
              <span class="addon-price">Confirm current quote</span>
              <a class="text-link" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20share%20Brand%20Watch%20service%20details." target="_blank" rel="noopener noreferrer">Learn More <b>→</b></a>
            </article>
            <article class="addon-item">
              <span class="addon-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 9a7 7 0 0 1 12-2l2 5M4 12l2 5a7 7 0 0 0 12-2"/></svg></span>
              <h3>Trademark Renewal</h3>
              <p>Understand renewal requirements and timing.</p>
              <span class="addon-price">Custom quotation</span>
              <a class="text-link" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20share%20trademark%20renewal%20support%20details." target="_blank" rel="noopener noreferrer">Learn More <b>→</b></a>
            </article>
            <article class="addon-item">
              <span class="addon-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8l8-4 8 4v12M2 20h20M9 20v-6h6v6M8 10h.01M16 10h.01"/></svg></span>
              <h3>Business Registration Assistance</h3>
              <p>GST, Udyam/MSME, FSSAI and other relevant registrations.</p>
              <span class="addon-price">Custom quotation</span>
              <a class="text-link" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20share%20business%20registration%20assistance%20details." target="_blank" rel="noopener noreferrer">Learn More <b>→</b></a>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="steps-section section-compact" aria-labelledby="steps-heading">
      <div class="container">
        <div class="section-heading centered compact-heading">
          <p class="eyebrow eyebrow-rule">How to get started</p>
          <h2 id="steps-heading">Three Simple Steps to Get a Quote.</h2>
        </div>
        <div class="steps-grid">
          <article class="step-item">
            <span class="step-number" aria-hidden="true">01</span>
            <div class="step-copy"><h3>Tell Us About Your Business</h3><p>Share your brand, business type and what you need.</p></div>
          </article>
          <article class="step-item">
            <span class="step-number" aria-hidden="true">02</span>
            <div class="step-copy"><h3>Review Your Options</h3><p>Discuss the best package, scope and applicable fees.</p></div>
          </article>
          <article class="step-item">
            <span class="step-number" aria-hidden="true">03</span>
            <div class="step-copy"><h3>Confirm Before Proceeding</h3><p>Review the documents, charges and next steps.</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="faq-section section-compact" aria-labelledby="faq-heading">
      <div class="container split-section faq-split">
        <div class="section-photo faq-photo"><img src="/packages/assets/faq-legal-books.webp" alt="Navy legal books, cream portfolio and brass scales of justice in warm light" width="1400" height="788" loading="lazy" decoding="async"></div>
        <div class="faq-copy">
          <p class="eyebrow">Frequently asked questions</p>
          <h2 id="faq-heading">Questions About Packages &amp; Pricing?</h2>
          <p class="section-intro">A few helpful answers before you choose your next step.</p>
          <div class="faq-list">
            <details><summary>Are government fees included in the package price?</summary><p>Not necessarily. Ask for a quotation that clearly separates government charges from BRNDNUR's professional fees and any additional services.</p></details>
            <details><summary>Does trademark pricing depend on the number of classes?</summary><p>Yes, the number of classes and your applicant category can affect the overall cost. Confirm the exact scope before proceeding.</p></details>
            <details><summary>What is included in the Food Brand Package?</summary><p>The library describes trademark, Udyam/MSME and FSSAI-related support. Confirm current inclusions and which registrations apply to your business.</p></details>
            <details><summary>Can I get a package customised for my business?</summary><p>Contact BRNDNUR to discuss your requirements and request a scope-specific quotation.</p></details>
            <details><summary>Are renewal and Brand Watch services included?</summary><p>These may be separate services unless your written quotation states they are included.</p></details>
            <details><summary>How do I get a quotation before proceeding?</summary><p>Share your brand name, business type and service needs over WhatsApp. Review the scope and charges before confirming.</p></details>
          </div>
          <a class="text-link faq-link" href="../services/index.html#faqs">View All FAQs <b>→</b></a>
        </div>
      </div>
    </section>

    <section class="final-cta section-compact">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Ready to get started?</p>
          <h2>Not Sure Which Package to Choose?</h2>
          <p>Tell us about your brand or business. We'll discuss suitable options, what's included, and the applicable charges.</p>
          <a class="button button-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%27d%20like%20a%20personalised%20package%20quotation." target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.9Z"/><path d="M8.4 8.3c.3-.6.6-.6.9-.6h.4c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4 0 .6.6 1 1.4 1.8 2.4 2.3.2.1.4.1.6-.1l.8-.9c.2-.2.4-.3.6-.2l1.7.8c.3.1.4.3.4.5 0 .4-.2 1.1-.7 1.5-.5.4-1.2.7-2 .5-1-.2-2.3-.7-3.8-2-1.2-1.1-2-2.5-2.2-3.4-.2-.8.1-1.6.4-2Z"/></svg>
            Get a Personalised Quote on WhatsApp <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  
  </main>
</BaseLayout>


<script>
  document.querySelectorAll('.faq-q').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.faq-item');
      if (item) {
        const open = item.classList.toggle('active');
        button.setAttribute('aria-expanded', String(open));
      }
    });
  });
</script>


<style is:global>
:root {
  --ivory:#F4EFE4;--ivory-deep:#EDE3D2;--paper:#FBF8F1;--navy:#13233A;--navy-deep:#0D1D31;
  --gold:#A8781A;--gold-bright:#C28A28;--ink:#172943;--muted:#586478;--line:#E2D5BD;
  --serif:"Playfair Display",Georgia,"Times New Roman",serif;--sans:"DM Sans",Arial,sans-serif;
  --container:1200px;--gutter:48px;--section-y:80px;--section-compact:54px;
  --shadow:0 12px 34px rgba(42,34,20,.06);--radius:9px
}
* {box-sizing:border-box}
html {scroll-behavior:smooth;scroll-padding-top:88px}
body {margin:0;background:var(--ivory);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased}
img {display:block;max-width:100%;width:100%}
a {color:inherit;text-decoration:none}
