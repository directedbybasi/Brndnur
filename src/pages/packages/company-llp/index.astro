---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/hero/PageHero.astro';
import CardCarousel from '../../../components/CardCarousel.astro';
import FaqItem from '../../../components/FaqItem.astro';

const title = "Company & LLP Trademark Package | BRNDNUR Advisory LLP";
const description = "Corporate trademark registration package for Private Limited companies, LLPs, and corporations in India. Corporate governance, fee transparency, and guidance with BRNDNUR.";
const canonical = "https://brndnur.com/packages/company-llp/";
import { buildWhatsAppUrl } from '../../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Packages — Company & LLP",
  "sectionName": "Hero Section",
  "enquiryType": "Company & LLP Package Enquiry",
  "topic": "I am interested in the Company & LLP Corporate Trademark Package.",
  "details": "Entity name: [Company / LLP Name]\\nProposed brand name: [Please enter]",
  "callToAction": "Could you please share the corporate scope, government fee breakdown (₹9,000 per class), and documentation checklist?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Packages — Company & LLP",
  "sectionName": "Closing CTA Band",
  "enquiryType": "Corporate Service Proposal",
  "topic": "I would like to request a corporate service proposal and quotation for our Company/LLP trademark portfolio.",
  "details": "Number of classes / marks: [Please specify]",
  "callToAction": "Could you please provide a written corporate proposal and billing details?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/packages/company-llp/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Corporate IP Advisory"
      title='Company &amp;&nbsp;LLP<br class="hero-br">Trademark <span>Package.</span>'
      hasGoldRule={true}
      description="Structured for Private Limited companies, Public Limited entities, Limited Liability Partnerships (LLPs), and established corporations requiring corporate governance compliance and brand asset security."
      primaryCta={{
        text: "Inquire About Corporate Package",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Back to All Packages",
        href: "/packages/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Standard Govt Fee:", subtitle: "₹9,000 / Class" },
        { icon: "▱", title: "Board Resolution &", subtitle: "TM-48 Compliant" },
        { icon: "⌖", title: "Multi-Class Asset", subtitle: "Governance" }
      ]}
      image="/packages/assets/pkg-corp-hero.webp"
      imageAlt="Corporate trademark filing documentation and Board resolution governance folio"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/packages/assets/pkg-corp-security.webp" alt="BRNDNUR Corporate trademark filing and intellectual property governance" width="1200" height="900" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Corporate Governance</p>
          <h2>Corporate Intellectual Property Security.</h2>
          <div class="gold-rule"></div>
          <p>For corporate entities, registering trademarks in the company's legal name—rather than under an individual promoter's personal name—is vital for balance sheet valuation, investor due diligence, merger and acquisition integrity, and institutional borrowing.</p>
          <p>Our Company &amp; LLP Package ensures rigorous corporate compliance: we draft official Board Resolutions authorizing the application, prepare Form TM-48 (Agent Authorization), verify Certificate of Incorporation (COI) details, and coordinate multi-class filings that protect your enterprise's complete market presence.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>DPIIT Startup Fee Optimization</strong>
                <p>If recognized under Startup India or holding Udyam, we verify your 50% concession eligibility (₹4,500/class).</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Board Resolution &amp; Power of Attorney</strong>
                <p>Secretarial-standard documentation formatted to withstand legal scrutiny during corporate audits.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Entity-Held Asset Rights</strong>
                <p>Prevent dispute risks by establishing that all mark rights vest directly with the corporate balance sheet.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Corporate Deliverables (Editorial Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Corporate Inclusions</p>
          <h2>End-to-End Corporate IP Management.</h2>
          <div class="gold-rule"></div>
          <p>Structured procedures specifically aligned with corporate secretarial standards.</p>
        </div>

        <CardCarousel id="pkg-corp-inclusions-carousel" ariaLabel="Corporate Inclusions">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Cross-Class Corporate Search</h3>
              <p>Deep screening across your primary product categories and related service sectors to identify phonetic, visual, and well-known mark conflicts.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>Secretarial Drafting Support</h3>
              <p>Drafting of formal Board of Directors Resolutions or Partner Resolutions authorizing filing in accordance with Companies Act, 2013 standards.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>Corporate Form TM-A Filing</h3>
              <p>Preparation of applicant declarations under corporate seal/digital signature and submission on the official IP India portal.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">04</div>
              <h3>Corporate Portfolio Tracking</h3>
              <p>Milestone reports and alert logging to ensure in-house legal and leadership teams stay informed throughout examination.</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Corporate Fee & Documentation Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Compliance Standards</p>
          <h2>Corporate Entity Requirements &amp; Fees.</h2>
          <div class="gold-rule"></div>
          <p>Statutory standards under the Trade Marks Rules, 2017.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Category</th>
                <th>Statutory Government Fee</th>
                <th>Required Corporate Documents</th>
                <th>Advisory Deliverables</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Private Limited / Public Ltd</strong></td>
                <td>₹9,000 per class (CGPDTM)</td>
                <td>COI, PAN, Board Resolution, Form TM-48</td>
                <td>Full clearance search, drafting, e-filing &amp; receipt</td>
              </tr>
              <tr>
                <td><strong>Limited Liability Partnership (LLP)</strong></td>
                <td>₹9,000 per class (Standard)</td>
                <td>LLP Agreement, PAN, Partner Resolution, TM-48</td>
                <td>Full clearance search, drafting, e-filing &amp; receipt</td>
              </tr>
              <tr>
                <td><strong>DPIIT / MSME Eligible Corporate</strong></td>
                <td>₹4,500 per class (Concessional)</td>
                <td>DPIIT Certificate / Udyam Certificate, PAN, COI</td>
                <td>Fee optimization review, drafting &amp; receipt</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 3-Step Corporate Onboarding -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Enterprise Onboarding</p>
          <h2>The 3-Step Corporate Filing Process.</h2>
          <div class="gold-rule"></div>
          <p>A rigorous, governance-compliant methodology designed for Companies, LLPs, and growing enterprises.</p>
        </div>

        <CardCarousel id="pkg-corp-steps-carousel" ariaLabel="Enterprise Onboarding">
          <article class="step">
            <div class="step-top">
              <span class="step-num">01</span>
              <span class="step-line"></span>
            </div>
            <h3>Corporate Due Diligence &amp; Clearance</h3>
            <p>Comprehensive availability search across primary and allied NICE classes, cross-referencing MCA company name registers and the IP India database.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">02</span>
              <span class="step-line"></span>
            </div>
            <h3>Board Authorization &amp; MSME Check</h3>
            <p>Drafting of corporate Board / Partner resolutions, Form TM-48 Power of Attorney, and auditing Udyam/DPIIT certificates for fee minimization.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">03</span>
              <span class="step-line"></span>
            </div>
            <h3>Direct E-Filing &amp; Lifecycle Alerts</h3>
            <p>Official submission via the CGPDTM gateway with immediate electronic receipts and scheduled milestone updates throughout examination.</p>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Corporate FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Corporate FAQs</p>
          <h2>Enterprise Trademark Queries.</h2>
          <div class="gold-rule"></div>
          <p>Key legal principles for holding intellectual property under a corporate entity.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Why should a trademark be owned by the company rather than the founders personally?"
            answer="Registering the trademark in the name of the Company or LLP establishes the brand as a valuable intangible balance-sheet asset, which is essential for equity financing, bank valuations, and investor due diligence. If filed personally, formal licensing or assignment deeds are required later."
          />
          <FaqItem
            num="02"
            question="Can a Private Limited Company claim the ₹4,500 MSME fee discount?"
            answer="Yes. If the Private Limited company or LLP holds a valid Udyam Registration Certificate (or DPIIT startup recognition), the statutory government fee is reduced by 50% from ₹9,000 to ₹4,500 per class."
          />
          <FaqItem
            num="03"
            question="What authorization documents are required for corporate filing?"
            answer="A certified true copy of a Board Resolution (for Private Limited/Limited companies) or a Partners' Resolution (for LLPs) authorizing a specific Director/Partner, alongside an executed Form TM-48 appointing BRNDNUR Advisory LLP as the authorized agent."
          />
          <FaqItem
            num="04"
            question="How are multi-class applications handled for corporate brands?"
            answer="Corporations often file across multiple product and service classes (e.g., manufacturing in Class 9, software in Class 42, retail in Class 35). We advise whether to file unified multi-class TM-A applications or separate single-class filings to insulate clear classes from potential objections."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Safeguard Corporate Assets</p>
          <h2>Secure Your Enterprise's<br>Intellectual Property.</h2>
          <p>Connect with our senior advisory team to audit your brand names and initiate corporate filings.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Request Corporate Quotation <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Corporate Confidentiality</strong>
              <p>Strict non-disclosure standards for enterprise trademarks.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Governance Verification</strong>
              <p>Resolutions aligned with ROC and Secretarial audit standards.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Multi-Class Coordination</strong>
              <p>Unified filings covering products, manufacturing, and distribution.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
