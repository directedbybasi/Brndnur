---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Company & LLP Trademark Package | Corporate Brand Protection";
const description = "Comprehensive trademark filing package for Private Limited Companies, Public Limited Entities, and LLPs in India. Corporate authorization and class filing with BRNDNUR.";
const canonical = "https://brndnur.com/packages/company-llp/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/packages/company-llp/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Corporate Brand Protection</p>
        <h1>Company & LLP Trademark Package.</h1>
        <p class="lead">Structured for corporate entities, incorporated LLPs, partnership firms, and growing enterprises requiring multi-class brand security, board resolution documentation, and institutional trademark asset management.</p>
        <div class="actions">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20discuss%20the%20Company%20LLP%20Trademark%20Package." target="_blank" rel="noopener noreferrer">Request Corporate Consultation &rarr;</a>
          <a class="btn btn-outline" href="/packages/">All Packages</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Corporate Inclusions</p>
          <h2>Tailored for Structured Legal Entities</h2>
          <p>Addresses corporate governance, multiple director authorizations, and multi-class commercial portfolios:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">🏛️</div>
            <h3>Corporate Documentation Support</h3>
            <p>Guidance drafting board resolutions, powers of attorney, and official applicant representations complying with corporate filing rules.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">📑</div>
            <h3>Multi-Class Strategy</h3>
            <p>Evaluation of primary and secondary commercial offerings to protect goods, core services, and ancillary digital platforms across classes.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">📊</div>
            <h3>Institutional Asset Oversight</h3>
            <p>Full tracking through formal examination reports, hearing notifications, and Trade Marks Journal publication monitoring.</p>
          </div>
        </div>

        <div class="section-alt" style="margin-top: 48px; padding: 32px; border-radius: 10px;">
          <h3 style="font-family: var(--bn-serif); font-size: 22px; margin: 0 0 12px; color: #13233A;">Corporate Fee Schedule</h3>
          <p style="color: #566174; line-height: 1.65; margin: 0 0 16px;">
            Statutory government fees for standard corporate entities (without MSME certification) are ₹9,000 per class. If your company holds an active Udyam Certificate, statutory fees are reduced to ₹4,500 per class. Contact us for an itemized quotation.
          </p>
          <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20provide%20a%20quotation%20for%20our%20Company%20trademark." target="_blank" rel="noopener noreferrer">Request Corporate Quotation &rarr;</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
