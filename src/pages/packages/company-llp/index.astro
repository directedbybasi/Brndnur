---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Company & LLP Trademark Package | BRNDNUR Advisory LLP";
const description = "Corporate trademark registration package for Private Limited companies, LLPs, and corporations in India. Corporate governance, fee transparency, and guidance with BRNDNUR.";
const canonical = "https://brndnur.com/packages/company-llp/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/packages/company-llp/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/packages/">Packages</a>
          <span class="sep">/</span>
          <span class="current">Company & LLP Package</span>
        </nav>
        <p class="eyebrow">Corporate IP Advisory</p>
        <h1>Company & LLP Trademark Package.</h1>
        <p class="lead">Structured for Private Limited companies, Public Limited entities, Limited Liability Partnerships (LLPs), and established corporations requiring corporate governance compliance and brand asset security.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>Standard Corporate Government Fee: ₹9,000/Class</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Board Resolution & Form TM-48 Compliant</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Multi-Class Asset Governance</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20am%20interested%20in%20the%20Company%20LLP%20Package." target="_blank" rel="noopener noreferrer">Inquire About Corporate Package &rarr;</a>
          <a class="btn btn-outline" href="/packages/">Back to All Packages</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/packages/assets/trademark-registration.webp" alt="BRNDNUR Corporate trademark filing and intellectual property governance" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Corporate Governance</p>
            <h2>Corporate Intellectual Property Security</h2>
            <p>For corporate entities, registering trademarks in the company's legal name—rather than under an individual promoter's personal name—is vital for balance sheet valuation, investor due diligence, merger and acquisition integrity, and institutional borrowing.</p>
            <p>Our Company & LLP Package ensures rigorous corporate compliance: we draft official Board Resolutions authorizing the application, prepare Form TM-48 (Agent Authorization), verify Certificate of Incorporation (COI) details, and coordinate multi-class filings that protect your enterprise's complete market presence.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>DPIIT Startup Fee Concession Strategy</h4>
                <p>If your Private Limited company or LLP is recognized under the Startup India (DPIIT) initiative or holds an active Udyam certificate, you may legally claim the 50% statutory fee concession (₹4,500/class instead of ₹9,000/class). Our team audits your eligibility prior to submission.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Corporate Deliverables with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Corporate Inclusions</p>
          <h2>End-to-End Corporate IP Management</h2>
          <p>Structured procedures specifically aligned with corporate secretarial standards:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h3>Cross-Class Corporate Search</h3>
            <p>Deep screening across your primary product categories and related service sectors to identify phonetic, visual, and well-known mark conflicts.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3>Board Resolution & TM-48 Drafting</h3>
            <p>Preparing formal corporate authorization documentation in compliance with the Companies Act, 2013 and Trade Marks Rules, 2017.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h3>Company-Owned IP Assets</h3>
            <p>Ensuring the application is filed strictly in the corporate entity's name, cementing company ownership for balance sheet valuation.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <h3>Registry Tracking & Updates</h3>
            <p>Formal tracking of registry status milestones, prompt examination alerts, and consultation regarding any registry queries.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Corporate Fee Structure Matrix -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Corporate Pricing</p>
          <h2>Corporate Fee Schedule & Requirements</h2>
          <p>Official statutory government fees and advisory documentation for companies.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Category</th>
                <th>Statutory Government Fee</th>
                <th>Required Corporate Documents</th>
                <th>Advisory Deliverables</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Private Limited / Public Ltd</strong></td>
                <td>₹9,000 per class (CGPDTM)</td>
                <td>COI, PAN, Board Resolution, Form TM-48</td>
                <td>Full clearance search, drafting, e-filing & receipt</td>
              </tr>
              <tr>
                <td><strong>Limited Liability Partnership (LLP)</strong></td>
                <td>₹9,000 per class (Standard)</td>
                <td>LLP Agreement, PAN, Partner Resolution, TM-48</td>
                <td>Full clearance search, drafting, e-filing & receipt</td>
              </tr>
              <tr>
                <td><strong>DPIIT / MSME Eligible Corporate</strong></td>
                <td>₹4,500 per class (Concessional)</td>
                <td>DPIIT Certificate / Udyam Certificate, PAN, COI</td>
                <td>Fee optimization review, drafting & receipt</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Safeguard Corporate Assets</p>
          <h2>Secure Your Enterprise's Intellectual Property.</h2>
          <p>Connect with our senior advisory team to audit your brand names and initiate corporate filings.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20send%20a%20written%20quotation%20for%20the%20Company%20LLP%20Package." target="_blank" rel="noopener noreferrer">Request Corporate Quotation &rarr;</a>
            <a class="btn btn-outline" href="/packages/individual-msme/">View MSME Package</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
