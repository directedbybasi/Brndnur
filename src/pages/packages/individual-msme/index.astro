---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Individual & MSME Trademark Package | BRNDNUR Advisory LLP";
const description = "Complete trademark registration package for individuals, sole proprietors, and small businesses in India. Inclusions, fee transparency, and guidance with BRNDNUR.";
const canonical = "https://brndnur.com/packages/individual-msme/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/packages/individual-msme/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/packages/">Packages</a>
          <span class="sep">/</span>
          <span class="current">Individual & MSME Package</span>
        </nav>
        <p class="eyebrow">Service Package</p>
        <h1>Individual & MSME Trademark Package.</h1>
        <p class="lead">Tailored specifically for individual founders, sole proprietors, startups, and registered MSME enterprises eligible for the Government of India's 50% statutory fee concession.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>₹4,500 Statutory Govt Fee (50% Concession)</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>End-to-End TM-A Filing & Support</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Immediate &trade; Right Upon Filing</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20am%20interested%20in%20the%20Individual%20MSME%20Package." target="_blank" rel="noopener noreferrer">Inquire About This Package &rarr;</a>
          <a class="btn btn-outline" href="/packages/">Back to All Packages</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/packages/assets/brand-starter-pack.webp" alt="BRNDNUR Individual and MSME Trademark Starter Package" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Accessible Protection</p>
            <h2>Tailored for Sole Proprietors, Startups & MSMEs</h2>
            <p>Under the Trade Marks Rules, 2017, the Government of India provides a 50% concession on official e-filing fees for individuals, sole proprietors, recognized startups, and enterprises registered under Udyam (MSME).</p>
            <p>Our Individual & MSME Package provides complete, end-to-end guidance from preliminary search clearance through official filing receipt generation, ensuring small business owners secure maximum legal protection without excessive legal overhead.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>MSME Documentation</h4>
                <p>To claim the ₹4,500 statutory fee tier, a valid Udyam Registration Certificate matching the applicant name is required. If you do not yet have an Udyam certificate, we can facilitate registration prior to filing.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Package Deliverables with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Inclusions</p>
          <h2>What This Package Delivers</h2>
          <p>Everything required to take your brand from concept to official registered application receipt:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h3>Preliminary Trademark Search</h3>
            <p>Comprehensive search across the official Trade Marks Registry database to evaluate phonetic, visual, and semantic conflicts prior to filing.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </div>
            <h3>NICE Classification Guidance</h3>
            <p>Identification of the precise goods or services class (Classes 1–45) and drafting of an accurate commercial specification of goods/services.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3>Application Assembly & Filing</h3>
            <p>Drafting Form TM-A, submitting through official digital portals, and generating your formal government acknowledgment receipt.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <h3>TM Symbol Guidance & Tracking</h3>
            <p>Guidance on authorized lawful use of the &trade; symbol upon filing, along with automated monitoring of initial examination milestones.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Transparent Fee Structure Table -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Transparent Pricing</p>
          <h2>Itemized Fee Structure & Delineation</h2>
          <p>Absolute transparency: government statutory fees and professional charges are clearly distinguished.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Cost Component</th>
                <th>Standard Company Rate</th>
                <th>Individual / MSME Concession Rate</th>
                <th>Payment Destination</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Statutory Government Fee (Per Class)</strong></td>
                <td>₹9,000 per class</td>
                <td><strong>₹4,500 per class</strong> (50% Concession)</td>
                <td>Directly to Trade Marks Registry (CGPDTM)</td>
              </tr>
              <tr>
                <td><strong>Preliminary Clearance Search</strong></td>
                <td>Included in scope</td>
                <td><strong>Included in scope</strong></td>
                <td>BRNDNUR Advisory LLP</td>
              </tr>
              <tr>
                <td><strong>Form TM-A Filing Preparation & TM-48</strong></td>
                <td>Included in scope</td>
                <td><strong>Included in scope</strong></td>
                <td>BRNDNUR Advisory LLP</td>
              </tr>
              <tr>
                <td><strong>Official Filing Receipt & TM Tracking</strong></td>
                <td>Included in scope</td>
                <td><strong>Included in scope</strong></td>
                <td>BRNDNUR Advisory LLP</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Ready to Protect Your Brand?</p>
          <h2>Request a Written Quotation for Your Application.</h2>
          <p>Contact our advisory desk in Manjeri, Kerala to confirm class count and receive an itemized proposal.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20send%20a%20written%20quotation%20for%20the%20Individual%20MSME%20Package." target="_blank" rel="noopener noreferrer">Request Written Quotation &rarr;</a>
            <a class="btn btn-outline" href="/packages/company-llp/">View Company Package</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
