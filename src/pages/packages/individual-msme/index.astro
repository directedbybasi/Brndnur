---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/hero/PageHero.astro';
import CardCarousel from '../../../components/CardCarousel.astro';
import FaqItem from '../../../components/FaqItem.astro';

const title = "Individual & MSME Trademark Package | BRNDNUR Advisory LLP";
const description = "Complete trademark registration package for individuals, sole proprietors, and small businesses in India. Inclusions, fee transparency, and guidance with BRNDNUR.";
const canonical = "https://brndnur.com/packages/individual-msme/";
import { buildWhatsAppUrl } from '../../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Packages — Individual & MSME",
  "sectionName": "Hero Section",
  "enquiryType": "Individual & MSME Package Quotation",
  "topic": "I am interested in the Individual & MSME Trademark Package (Form TM-A).",
  "details": "Applicant status: [Individual / Sole Proprietor / Udyam MSME]\\nProposed brand name: [Please enter]",
  "callToAction": "Could you please confirm the 50% government fee concession eligibility, professional charges, and required documents?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Packages — Individual & MSME",
  "sectionName": "Closing CTA Band",
  "enquiryType": "Formal Written Quotation",
  "topic": "I would like to request a formal written quotation for the Individual & MSME Trademark Package.",
  "details": "Brand name / business activity: [Please enter]",
  "callToAction": "Could you please send the complete service agreement scope and payment milestones?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/packages/individual-msme/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Service Package"
      title='Individual &amp;&nbsp;MSME<br class="hero-br">Trademark <span>Package.</span>'
      hasGoldRule={true}
      description="Tailored specifically for individual founders, sole proprietors, startups, and registered MSME enterprises eligible for the Government of India's 50% statutory fee concession."
      primaryCta={{
        text: "Inquire About This Package",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Back to All Packages",
        href: "/packages/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "₹4,500 Statutory Fee", subtitle: "(50% Concession)" },
        { icon: "▱", title: "End-to-End TM-A", subtitle: "Filing Support" },
        { icon: "⌖", title: "Immediate ™ Rights", subtitle: "Upon Filing" }
      ]}
      image="/packages/assets/pkg-indiv-hero.webp"
      imageAlt="BRNDNUR Individual and MSME Trademark Starter Package"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/packages/assets/pkg-indiv-breakdown.webp" alt="BRNDNUR transparent package inclusions and statutory schedule" width="1200" height="900" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Accessible Protection</p>
          <h2>Tailored for Sole Proprietors, Startups &amp; MSMEs.</h2>
          <div class="gold-rule"></div>
          <p>Under the Trade Marks Rules, 2017, the Government of India provides a 50% concession on official e-filing fees for individuals, sole proprietors, recognized startups, and enterprises registered under Udyam (MSME).</p>
          <p>Our Individual &amp; MSME Package provides complete, end-to-end guidance from preliminary search clearance through official filing receipt generation, ensuring small business owners secure maximum legal protection without excessive legal overhead.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>MSME Concession Validation</strong>
                <p>We review your Udyam registration to ensure you qualify for the ₹4,500 government statutory fee per class.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Complete Clearance Search</strong>
                <p>Multi-dimensional clearance check across the official IP India registry before Form TM-A drafting.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Official Government Receipt</strong>
                <p>Direct electronic receipt from the CGPDTM portal delivered to you upon application submission.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Package Deliverables (Editorial Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Inclusions</p>
          <h2>What This Package Delivers.</h2>
          <div class="gold-rule"></div>
          <p>Everything required to take your brand from concept to official registered application receipt.</p>
        </div>

        <CardCarousel id="pkg-msme-inclusions-carousel" ariaLabel="What This Package Delivers">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Preliminary Trademark Search</h3>
              <p>Comprehensive search across the official Trade Marks Registry database to evaluate phonetic, visual, and semantic conflicts prior to filing.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>Class Mapping &amp; Specification</h3>
              <p>Accurate classification across 45 NICE classes, drafting tailored goods and services descriptions that prevent avoidable office actions.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>TM-A Drafting &amp; E-Filing</h3>
              <p>Assembly of Form TM-A, Form TM-48 (Power of Attorney), and user affidavit preparation with prompt submission to the registry portal.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">04</div>
              <h3>Milestone Status Tracking</h3>
              <p>Monitoring application examination milestones through formal examination, journal publication, and final certificate issuance.</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Fee Structure Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Cost Transparency</p>
          <h2>Fee Structure &amp; Concessions Breakdown.</h2>
          <div class="gold-rule"></div>
          <p>Statutory fees are separated cleanly from professional advisory charges.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Cost Component</th>
                <th>Standard Company Rate</th>
                <th>Individual / MSME Concession Rate</th>
                <th>Payment Destination</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Statutory Government Fee (Per Class)</strong></td>
                <td>₹9,000 per class</td>
                <td><strong>₹4,500 per class</strong> (50% Concession)</td>
                <td>Directly to Trade Marks Registry (CGPDTM)</td>
              </tr>
              <tr>
                <td><strong>Preliminary Clearance Search</strong></td>
                <td>Included in scope</td>
                <td><strong>Included in scope</strong></td>
                <td>BRNDNUR Advisory LLP</td>
              </tr>
              <tr>
                <td><strong>Form TM-A Filing Preparation &amp; TM-48</strong></td>
                <td>Included in scope</td>
                <td><strong>Included in scope</strong></td>
                <td>BRNDNUR Advisory LLP</td>
              </tr>
              <tr>
                <td><strong>Official Filing Receipt &amp; TM Tracking</strong></td>
                <td>Included in scope</td>
                <td><strong>Included in scope</strong></td>
                <td>BRNDNUR Advisory LLP</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 3-Step Process -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Onboarding Journey</p>
          <h2>Three Steps from Consultation to Filing.</h2>
          <div class="gold-rule"></div>
          <p>A streamlined sequence designed for individual proprietors, small business owners, and new startups.</p>
        </div>

        <CardCarousel id="pkg-msme-steps-carousel" ariaLabel="Three Steps from Consultation to Filing">
          <article class="step">
            <div class="step-top">
              <span class="step-num">01</span>
              <span class="step-line"></span>
            </div>
            <h3>Intake &amp; Preliminary Search</h3>
            <p>You share your brand name, commercial offerings, and applicant PAN/Aadhaar. We conduct a preliminary clearance search on the IP India database.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">02</span>
              <span class="step-line"></span>
            </div>
            <h3>MSME Status &amp; Draft Review</h3>
            <p>We verify your Udyam registration to lock in the 50% government fee concession and send you Form TM-A draft and Form TM-48 authorization for sign-off.</p>
          </article>

          <article class="step">
            <div class="step-top">
              <span class="step-num">03</span>
              <span class="step-line"></span>
            </div>
            <h3>E-Filing &amp; Official Receipt</h3>
            <p>We e-file your application, remit the statutory ₹4,500 government fee per class, and immediately deliver your official government acknowledgment receipt.</p>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Package FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Package FAQs</p>
          <h2>Frequently Asked Questions.</h2>
          <div class="gold-rule"></div>
          <p>Clear facts on eligibility, fee structures, and post-filing support.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Who qualifies for the Individual / MSME package?"
            answer="Sole proprietors filing under their personal name, recognized DPIIT startups, and micro, small, or medium enterprises holding a valid Udyam Registration Certificate qualify for the reduced statutory government fee of ₹4,500 per class (compared to ₹9,000 for standard companies)."
          />
          <FaqItem
            num="02"
            question="What if I do not have an Udyam certificate yet?"
            answer="If you operate a business entity in India, BRNDNUR Advisory can assist you in obtaining your Udyam MSME certificate prior to filing your trademark application, ensuring you unlock the 50% government fee discount immediately."
          />
          <FaqItem
            num="03"
            question="What happens if the Trade Marks Registry issues an examination query?"
            answer="If an Examination Report raises queries under Section 9 (distinctiveness) or Section 11 (similarity), we review the official report and discuss the appropriate written legal response strategy with you. Substantive objection drafting is handled as a structured add-on service."
          />
          <FaqItem
            num="04"
            question="How are statutory fees paid?"
            answer="Statutory government fees (₹4,500 per class) are remitted directly to the Trade Marks Registry (CGPDTM) e-filing gateway. You receive the official electronic government receipt with date, timestamp, and unique TM Application Number."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Ready to Protect Your Brand?</p>
          <h2>Request a Written Quotation<br>for Your Application.</h2>
          <p>Contact our advisory desk in Manjeri, Kerala to confirm class count and receive an itemized proposal.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Request Written Quotation <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Instant Assessment</strong>
              <p>Quick evaluation of your brand name and eligible MSME tier.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Direct E-Receipt</strong>
              <p>Official government receipt provided immediately upon portal filing.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Reliable Support</strong>
              <p>Ongoing tracking throughout the 12 to 18 month examination cycle.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
