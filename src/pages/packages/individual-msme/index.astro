---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Individual & MSME Trademark Package | BRNDNUR Advisory LLP";
const description = "Complete trademark registration package for individuals, sole proprietors, and small businesses in India. Inclusions, fee transparency, and guidance with BRNDNUR.";
const canonical = "https://brndnur.in/packages/individual-msme/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/packages/individual-msme/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Package Details</p>
        <h1>Individual & MSME Trademark Package.</h1>
        <p class="lead">Tailored specifically for individual founders, sole proprietors, startups, and registered MSME enterprises eligible for the Government of India's 50% statutory fee concession.</p>
        <div class="actions">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20am%20interested%20in%20the%20Individual%20MSME%20Package." target="_blank" rel="noopener noreferrer">Inquire About This Package &rarr;</a>
          <a class="btn btn-outline" href="/packages/">Back to All Packages</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Inclusions</p>
          <h2>What This Package Provides</h2>
          <p>Everything required to take your brand from concept to official registered application receipt:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">✓</div>
            <h3>Preliminary Trademark Search</h3>
            <p>Comprehensive search across the official database to evaluate phonetic, visual, and semantic conflicts prior to filing.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">✓</div>
            <h3>NICE Classification Guidance</h3>
            <p>Identification of the precise goods or services class (Classes 1–45) and drafting of an accurate commercial specification.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">✓</div>
            <h3>Application Assembly & Filing</h3>
            <p>Drafting Form TM-A, submitting through official digital portals, and generating your formal government acknowledgment receipt.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">✓</div>
            <h3>TM Symbol Guidance & Status Updates</h3>
            <p>Guidance on authorized use of the &trade; symbol upon filing, along with automated monitoring of initial examination milestones.</p>
          </div>
        </div>

        <div class="section-alt" style="margin-top: 48px; padding: 32px; border-radius: 10px;">
          <h3 style="font-family: var(--bn-serif); font-size: 22px; margin: 0 0 12px; color: #13233A;">Fee Structure & Transparency</h3>
          <p style="color: #566174; line-height: 1.65; margin: 0 0 16px;">
            Statutory government fees are ₹4,500 per class for individual applicants or MSME certificate holders. Professional advisory fees cover end-to-end clearance, documentation, and filing. Request a personalized quotation to confirm the current combined pricing for your required class count.
          </p>
          <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20please%20send%20a%20written%20quotation%20for%20the%20Individual%20MSME%20Package." target="_blank" rel="noopener noreferrer">Request Written Quotation &rarr;</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
