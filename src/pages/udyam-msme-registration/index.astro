---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Udyam / MSME Registration Guidance | BRNDNUR Advisory LLP";
const description = "Obtain your Udyam Registration Certificate for micro, small, and medium enterprises. Qualify for 50% trademark fee concessions and government benefits with BRNDNUR.";
const canonical = "https://brndnur.com/udyam-msme-registration/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/udyam-msme-registration/"
>
  <main id="main-content">
    <!-- Breadcrumb & Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="bn-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/services/">Services</a>
          <span class="sep">/</span>
          <span class="current">Udyam MSME Registration</span>
        </nav>
        <p class="eyebrow">Enterprise Recognition</p>
        <h1>Udyam / MSME Registration Assistance.</h1>
        <p class="lead">Udyam Registration is the official recognition provided by the Ministry of Micro, Small and Medium Enterprises. It unlocks critical government benefits, priority lending access, and an immediate 50% statutory fee concession on all Indian trademark applications.</p>
        
        <div class="hero-badges">
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            <span>Official Ministry of MSME Certificate</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>50% Trademark Government Fee Discount</span>
          </div>
          <div class="hero-badge-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"/></svg>
            <span>Priority Banking & Collateral-Free Loans</span>
          </div>
        </div>

        <div class="actions" style="margin-top: 28px;">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20need%20assistance%20with%20Udyam%20MSME%20registration." target="_blank" rel="noopener noreferrer">Get Udyam Assistance &rarr;</a>
          <a class="btn btn-outline" href="/packages/individual-msme/">MSME Trademark Package</a>
        </div>
      </div>
    </section>

    <!-- Split Visual Section -->
    <section class="section">
      <div class="container">
        <div class="split-row">
          <div class="split-photo">
            <img src="/services/assets/business-support.webp" alt="BRNDNUR Udyam MSME certificate guidance and filing in Kerala" width="800" height="600" loading="lazy" />
          </div>
          <div class="split-copy">
            <p class="eyebrow">Enterprise Empowerment</p>
            <h2>Catalyst for Small Business Growth and Intellectual Property Savings</h2>
            <p>For entrepreneurs, food producers, and local manufacturers in Kerala, obtaining an Udyam Registration Certificate is the most cost-effective legal step you can take. It formally verifies your entity constitution as an eligible micro, small, or medium enterprise.</p>
            <p>Most importantly for brand owners, holding an active Udyam certificate reduces the Government of India's statutory trademark filing fee from ₹9,000 per class down to ₹4,500 per class—a direct 50% savings on every trademark filing.</p>
            <div class="advisory-notice" style="margin-top: 16px;">
              <div class="advisory-notice-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="advisory-notice-content">
                <h4>Aadhaar & PAN Linking Requirement</h4>
                <p>Udyam Registration requires an Aadhaar-linked mobile number for OTP verification, along with an active PAN card. For proprietary firms, the owner's personal PAN is used; for LLPs and companies, the entity's PAN is mandatory.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 Core MSME Advantages with Clean SVGs -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Major Advantages</p>
          <h2>Why Every Small Enterprise Should Register</h2>
          <p>Securing an Udyam Certificate delivers substantial commercial, legal, and operational advantages:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            </div>
            <h3>50% Off Trademark Statutory Fees</h3>
            <p>Reduces government trademark filing fees from ₹9,000 per class down to ₹4,500 per class, cutting intellectual property protection costs in half.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v4M12 14v4M16 14v4"/></svg>
            </div>
            <h3>Priority Sector Bank Lending</h3>
            <p>Enables eligibility for collateral-free credit schemes (CGTMSE), lower bank interest rates, and dedicated MSME credit lines.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Delayed Payment Protection</h3>
            <p>Access to the statutory MSME Samadhaan portal to recover outstanding dues from corporate buyers with mandatory compound interest penalties.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon" style="color: #A8781A;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3>Subsidies & Concessions</h3>
            <p>Eligible for patent filing subsidies, ISO certification fee reimbursements, and electricity tariff concessions depending on state industrial policies.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MSME Classification & Fee Comparison Table -->
    <section class="section">
      <div class="container">
        <div class="section-heading text-center">
          <p class="eyebrow">Classification Criteria</p>
          <h2>Official MSME Criteria & Trademark Concessions</h2>
          <p>Revised composite criteria under the MSME Development Act, 2006.</p>
        </div>

        <div class="bn-table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Enterprise Category</th>
                <th>Investment in Plant & Machinery</th>
                <th>Annual Turnover Limit</th>
                <th>Statutory Trademark Fee (Per Class)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Micro Enterprise</strong></td>
                <td>Not exceeding ₹1 Crore</td>
                <td>Not exceeding ₹5 Crores</td>
                <td><strong>₹4,500</strong> (50% Concession)</td>
              </tr>
              <tr>
                <td><strong>Small Enterprise</strong></td>
                <td>Not exceeding ₹10 Crores</td>
                <td>Not exceeding ₹50 Crores</td>
                <td><strong>₹4,500</strong> (50% Concession)</td>
              </tr>
              <tr>
                <td><strong>Medium Enterprise</strong></td>
                <td>Not exceeding ₹50 Crores</td>
                <td>Not exceeding ₹250 Crores</td>
                <td><strong>₹4,500</strong> (50% Concession)</td>
              </tr>
              <tr>
                <td><strong>Standard Corporate (Non-MSME)</strong></td>
                <td>Exceeds MSME thresholds</td>
                <td>Exceeds MSME thresholds</td>
                <td><strong>₹9,000</strong> (Standard Statutory Fee)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Quick Turnaround</p>
          <h2>Obtain Your Udyam Certificate.</h2>
          <p>We verify your Aadhaar, PAN, and investment/turnover figures to file seamlessly on the official Udyam portal.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20would%20like%20to%20apply%20for%20Udyam%20registration." target="_blank" rel="noopener noreferrer">Apply via WhatsApp &rarr;</a>
            <a class="btn btn-outline" href="/gst-registration/">GST Registration</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
