---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardCarousel from '../components/CardCarousel.astro';
import { buildWhatsAppUrl } from '../utils/whatsapp';

const title = "BRNDNUR Advisory LLP | Trademark & Business Advisory";
const description = "Trademark registration, brand-name searches and business advisory in Manjeri, Kerala. Get practical guidance from BRNDNUR Advisory LLP.";
const canonical = "https://brndnur.com/";
const ogImage = "/assets/hero-brand-desk.png";

const heroWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Homepage',
  sectionName: 'Hero Section',
  enquiryType: 'Preliminary Brand Name Search',
  message: 'Hi BRNDNUR, I would like to check whether my proposed brand name is available for trademark registration. Could you please guide me on conducting a preliminary name clearance search and advise on the next steps?'
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Homepage',
  sectionName: 'Closing Consultation Section',
  enquiryType: '24-Hour Brand Name Clearance',
  message: 'Hi BRNDNUR, I would like to request a 24-hour brand name clearance search. Could you please check my proposed business name against IP India trademark records, explain any conflicting marks, and guide me on the next steps?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/"
  hasCustomSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness", "ProfessionalService", "LegalService"],
      "@id": "https://brndnur.com/#organization",
      "name": "BRNDNUR Advisory LLP",
      "legalName": "BRNDNUR Advisory LLP",
      "url": "https://brndnur.com/",
      "sameAs": [
        "https://www.linkedin.com/company/brndnur",
        "https://x.com/brndnur"
      ],
      "logo": {
        "@type": "ImageObject",
        "@id": "https://brndnur.com/#logo",
        "url": "https://brndnur.com/assets/brndnur-logo-transparent.png",
        "caption": "BRNDNUR Advisory LLP"
      },
      "image": "https://brndnur.com/assets/brndnur-og-banner.jpg",
      "telephone": "+91 90481 88899",
      "email": "brndnuradvisoryllp@gmail.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skatt Business Park",
        "addressLocality": "Manjeri",
        "addressRegion": "Kerala",
        "postalCode": "676121",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 11.1219,
        "longitude": 76.1210
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:30",
        "closes": "18:00"
      },
      "areaServed": ["Manjeri", "Malappuram", "Kozhikode", "Wayanad", "Kannur", "Kasaragod", "Palakkad", "Thrissur", "Ernakulam", "Kerala", "India"],
      "knowsAbout": [
        "Trademark Registration in India",
        "Brand Name Search",
        "Nice Classification",
        "Trademark Renewal",
        "Trademark Journal Monitoring",
        "GST Registration",
        "Udyam MSME Registration",
        "FSSAI Registration",
        "Business Setup Advisory"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91 90481 88899",
        "contactType": "customer service",
        "availableLanguage": ["en", "ml"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://brndnur.com/#website",
      "url": "https://brndnur.com/",
      "name": "BRNDNUR Advisory LLP",
      "publisher": {
        "@id": "https://brndnur.com/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://brndnur.com/#webpage",
      "url": "https://brndnur.com/",
      "name": "BRNDNUR Advisory LLP | Trademark Registration & Business Advisory",
      "description": "Trademark registration guidance, preliminary brand-name searches, class selection, and business advisory services with BRNDNUR Advisory LLP in Manjeri, Malappuram, Kerala.",
      "isPartOf": {
        "@id": "https://brndnur.com/#website"
      },
      "about": {
        "@id": "https://brndnur.com/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://brndnur.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a trademark?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A trademark protects your distinctive brand name, logo, slogan, or commercial symbol used in connection with goods or services. Registration under the Trade Marks Act grants statutory nationwide exclusive rights, deters deceptive imitation, and secures brand equity as your business grows."
          }
        },
        {
          "@type": "Question",
          "name": "How do I begin a trademark registration enquiry?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can begin by sharing your proposed brand name, logo concept, and a brief description of your products or services via WhatsApp or our enquiry channels. We conduct a preliminary discussion to assess relevant classes and identify potentially conflicting marks before filing."
          }
        },
        {
          "@type": "Question",
          "name": "How do trademark classes work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "India follows the international Nice Classification system of 45 classes: Classes 1 to 34 cover physical goods (e.g. food, clothing, cosmetics), while Classes 35 to 45 cover services (e.g. retail, consulting, software). Applications must specify the exact classes that correspond to your commercial activities."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a wordmark and a logo trademark?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A wordmark protects the brand name itself in standard text, offering broad protection regardless of typography or styling. A logo (device mark) protects the distinctive visual symbol, stylized lettering, or emblem. Many businesses file both to secure comprehensive coverage."
          }
        },
        {
          "@type": "Question",
          "name": "What information should I prepare?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Having your proposed brand name, logo file (if available), a brief description of products or services, applicant details (individual, proprietorship, LLP, or company), and commercial usage status helps ensure an efficient initial assessment."
          }
        },
        {
          "@type": "Question",
          "name": "Is trademark registration the same as company registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Registering a company, LLP, or GST establishes your legal commercial entity and tax compliance, but does not grant proprietary trademark protection over your brand name. Trademark registration is a separate statutory intellectual property procedure."
          }
        },
        {
          "@type": "Question",
          "name": "What can affect the time required for an application?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trademark timelines depend on Trade Marks Registry examination workloads, whether the examiner issues examination report objections, whether third parties file oppositions during publication, and the promptness of responses to official queries."
          }
        },
        {
          "@type": "Question",
          "name": "How can I enquire about service charges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Statutory official government fees are prescribed by the Trade Marks Registry (with a 50% concession for individuals, startups, and MSMEs). BRNDNUR provides a transparent, itemised breakdown of official fees and our professional advisory charges before any work begins."
          }
        }
      ]
    }
  ]
}
    </script>
    <link rel="preload" as="image" href="/assets/hero-brand-desk-mobile.webp" media="(max-width: 768px)" type="image/webp" fetchpriority="high">
    <link rel="preload" as="image" href="/assets/hero-brand-desk.webp" media="(min-width: 769px)" type="image/webp" fetchpriority="high">
  </Fragment>

  <main id="main-content">
    
    <!-- 1. HERO SECTION -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow hero-stagger-1">Trademark Registration &middot; Kerala &amp; India-Wide</p>
          <h1 id="hero-heading" class="hero-stagger-2">If Your Brand Name Isn't Registered,<br><span>Anyone Can Take It.</span></h1>
          
          <div class="hero-quote hero-stagger-3" aria-label="Brand Philosophy">
            <span class="hero-quote-bar" aria-hidden="true"></span>
            <blockquote class="hero-quote-text">&ldquo;Register first. Regret never.&rdquo;</blockquote>
          </div>

          <p class="hero-stagger-4">IP India registration takes 12–18 months. Every day without it is a day someone else can legally file your name first. BRNDNUR Advisory LLP provides clear guidance across preliminary brand-name searches, trademark registration, and business advisory services.</p>
          
          <div class="actions hero-stagger-5">
            <a class="btn btn-primary" href={heroWhatsAppUrl} target="_blank" rel="noopener noreferrer">
              Check If My Brand Name Is Safe <span class="arrow">&rarr;</span>
            </a>
            <a class="btn btn-secondary" href="#services">
              Explore Our Services <span class="arrow">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
      <picture class="hero-photo-wrap hero-photo-animate">
        <source media="(max-width: 768px)" srcset="/assets/hero-brand-desk-mobile.webp" type="image/webp" />
        <source media="(min-width: 769px)" srcset="/assets/hero-brand-desk.webp" type="image/webp" />
        <img
          class="hero-photo"
          src="/assets/hero-brand-desk.webp"
          alt="BRNDNUR notebook with shield logo, BRNDNUR trademark and LIGHT UP YOUR BRAND trademark embossed on a cream cover beside a black-and-gold pen"
          width="1448"
          height="1086"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
    </section>

    <!-- CREDIBILITY STRIP -->
    <section class="credibility-section" aria-label="Key Credibility Indicators">
      <div class="container">
        <div class="credibility-strip">
          <div class="credibility-item">
            <span class="cred-num">50+</span>
            <span class="cred-label">Applications Filed</span>
          </div>
          <div class="credibility-item">
            <span class="cred-num">45</span>
            <span class="cred-label">Classes Covered</span>
          </div>
          <div class="credibility-item">
            <span class="cred-num">100%</span>
            <span class="cred-label">IP India Compliant</span>
          </div>
          <div class="credibility-item">
            <span class="cred-num">24h</span>
            <span class="cred-label">Initial Name Check</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SECTION: WHAT WE DO (6 TRADEMARK SERVICES) -->
    <section class="section service-directory" id="services" aria-labelledby="directory-heading">
      <div class="container">
        <div class="section-heading text-center reveal-on-scroll">
          <p class="eyebrow">What We Do</p>
          <h2 id="directory-heading">Every Service Built Around One Goal:<br><span>Your Brand Is Legally Yours.</span></h2>
          <div class="rule" aria-hidden="true"></div>
          <p class="section-lead">
            From search to registration to renewal &mdash; we handle the entire trademark process so you don't lose your name to a filing mistake or a missed deadline.
          </p>
        </div>

        <!-- 6-Card Services Track -->
        <div class="services-carousel" id="services-carousel">
          <div class="services-carousel__viewport" id="services-carousel-viewport" tabindex="0" role="region" aria-label="Services carousel track">
            <div class="services-carousel__track services-grid" id="services-grid">
              <!-- Card 1 — Trademark Search -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/home-card-search.webp"
                    alt="Magnifying glass over a notebook beside a laptop displaying a neutral trademark search interface"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Clearance Search</span>
                </div>
                <div class="card-content">
                  <h3>Is Your Brand Name Already Taken?</h3>
                  <p>Comprehensive search across IP India's database &mdash; Classes 1–45, phonetic and visual similarity &mdash; before you invest in a name someone else may own.</p>
                  <a class="service-btn" href="/brand-name-search/">
                    <span>Check My Brand Name</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>

              <!-- Card 2 — Filing & Registration -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/about-card-trademark.webp"
                    alt="Cream document folder with trademark registration heading, gold pen, and premium stationery on a warm office desk"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Statutory Filing</span>
                </div>
                <div class="card-content">
                  <h3>File in the Wrong Class and Your Registration Protects Nothing.</h3>
                  <p>We identify your exact trademark class, prepare Form TM-A, and file with IP India. Wrong-class filings are a common, expensive mistake we prevent.</p>
                  <a class="service-btn" href="/trademark-registration/#classes">
                    <span>Explore Registration</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>

              <!-- Card 3 — Infringement Action -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/home-card-trademark.webp"
                    alt="Close-up of a bronze trademark registration symbol embossed on a cream portfolio beside legal reference documents and gold pen"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Legal Standing</span>
                </div>
                <div class="card-content">
                  <h3>Someone Copies Your Brand. Can You Stop Them?</h3>
                  <p>Only a registered trademark gives you legal standing to send a cease-and-desist, file a police complaint, or pursue damages in court.</p>
                  <a class="service-btn" href="/services/#infringement">
                    <span>Infringement Action</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>

              <!-- Card 4 — Class Extension -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/classes-hero-catalog.webp"
                    alt="Organised cream product-category folders and document dividers arranged on an editorial desk"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Portfolio Audit</span>
                </div>
                <div class="card-content">
                  <h3>Your Business Expanded. Your Old Registration May Not Cover It.</h3>
                  <p>New product line, new state, new service category &mdash; we audit your existing registration and file the classes your growth requires.</p>
                  <a class="service-btn" href="/services/#class-extension">
                    <span>Audit My Coverage</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>

              <!-- Card 5 — Opposition & Disputes -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/services/assets/services-trademark-filing.webp"
                    alt="Trademark application folder, legal books, and gold scales on a sunlit desk"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Dispute Defense</span>
                </div>
                <div class="card-content">
                  <h3>Another Brand Is Using Your Name. What Do You Do?</h3>
                  <p>Trademark opposition notices, cease-and-desist letters, IP India dispute representation &mdash; we handle infringement so you can focus on your business.</p>
                  <a class="service-btn" href="/services/#opposition">
                    <span>Opposition &amp; Disputes</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>

              <!-- Card 6 — Renewal & Monitoring -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/renewal-ownership-maintenance.webp"
                    alt="Document calendar, neatly organised filing records, and a premium desk with subtle gold accents"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">10-Year Maintenance</span>
                </div>
                <div class="card-content">
                  <h3>Your Trademark Expires. Your Protection Disappears.</h3>
                  <p>Trademarks last 10 years. We track your renewal dates and file Form TM-R before the deadline &mdash; because a lapsed registration means starting over.</p>
                  <a class="service-btn" href="/trademark-renewal-monitoring/">
                    <span>Renewal &amp; Monitoring</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </article>
            </div>
          </div>

          <!-- Carousel Navigation Controls -->
          <div class="services-carousel__controls" aria-label="Services carousel navigation">
            <div class="services-carousel__dots" id="services-dots" role="tablist" aria-label="Services pagination"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SECTION: THE PROCESS (THREE STEPS) -->
    <section class="process" id="process" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-heading text-center reveal-on-scroll">
          <p class="eyebrow">The Process</p>
          <h2 id="process-heading">Three Steps. Your Brand Protected.</h2>
          <div class="rule" aria-hidden="true"></div>
          <p class="section-lead">No legal jargon. No surprises. We handle the complexity so you don't have to.</p>
        </div>
        
        <div class="three-steps-grid">
          <article class="step-card">
            <div class="step-badge">1</div>
            <h3>Share Your Brand Name</h3>
            <p>WhatsApp us your brand name and the products or services it covers. Takes two minutes.</p>
          </article>
          
          <article class="step-card">
            <div class="step-badge">2</div>
            <h3>We Clear and File</h3>
            <p>We run a full IP India search, confirm the right class, and submit Form TM-A. You get the filing receipt within 24 hours.</p>
          </article>
          
          <article class="step-card">
            <div class="step-badge">3</div>
            <h3>Your Brand Is Protected</h3>
            <p>You have legal priority from the filing date. We track the 12–18 month process and handle any IP India queries.</p>
          </article>
        </div>

        <div class="process-cta-wrap text-center" style="margin-top: 36px;">
          <a class="btn btn-primary" href={heroWhatsAppUrl} target="_blank" rel="noopener noreferrer">
            Start With a Free Name Check <span class="arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 6. SECTION 6: WHY BRNDNUR (IMAGE AND CONTENT) -->
    <section class="about-section" id="about" aria-labelledby="why-heading">
      <div class="about reveal-on-scroll">
        <img
          class="about-photo"
          src="/assets/home-about-partnership.webp"
          alt="Professional, sunlit office consultation-space photograph with cream stone details, warm wood, green plants, and a notebook"
          width="1000"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <div class="about-copy">
          <p class="eyebrow">Why BRNDNUR</p>
          <h2 id="why-heading">More Than a Service.<br>A Partner in Your Brand Journey.</h2>
          <p>We focus on clear guidance, transparent discussions and practical support, so you can make informed decisions about your brand and business.</p>
          
          <div class="values reveal-group">
            <div class="value reveal-item">
              <span class="value-icon" aria-hidden="true">♙</span>
              <div>
                <strong>Client-Focused Guidance</strong>
                <p>We take the time to understand your business and requirements before recommending any specific service or class.</p>
              </div>
            </div>
            
            <div class="value reveal-item">
              <span class="value-icon" aria-hidden="true">▤</span>
              <div>
                <strong>Transparent Discussions</strong>
                <p>You will know the proposed scope and applicable charges before proceeding, with no hidden costs or surprise fees.</p>
              </div>
            </div>
            
            <div class="value reveal-item">
              <span class="value-icon" aria-hidden="true">▥</span>
              <div>
                <strong>Practical Support</strong>
                <p>Relevant services for entrepreneurs and growing businesses navigating statutory registrations in Kerala and India.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. SECTION 7: WHAT TO PREPARE BEFORE YOUR ENQUIRY -->
    <section class="section checklist-section" id="checklist" aria-labelledby="checklist-heading">
      <div class="container">
        <!-- Top Editorial Banner with Plain Image Backdrop and Live HTML Text Overlay -->
        <div class="prep-banner-wrapper reveal-on-scroll">
          <div class="prep-banner-card">
            <img
              src="/assets/prep-hero-branded.webp"
              alt="What to Prepare Before You Begin - desk with BRNDNUR notebook, fountain pen and legal materials"
              width="1024"
              height="440"
              loading="lazy"
              decoding="async"
              class="prep-banner-img"
            />
            <div class="prep-banner-overlay">
              <div class="prep-banner-copy">
                <p class="prep-banner-eyebrow">What to Prepare Before You Begin</p>
                <h2 id="checklist-heading" class="prep-banner-title">
                  Get Ready for Your<br />
                  <span>Trademark Enquiry.</span>
                </h2>
                <div class="prep-banner-rule" aria-hidden="true"></div>
                <p class="prep-banner-desc">
                  Having a few key details ready can help us understand your requirements and discuss the appropriate next steps.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Compact Inline Enquiry Checklist (3 Core Requirements per Section 4.G) -->
        <div class="prep-checklist-grid" role="list" aria-label="Enquiry preparation checklist">
          <!-- Item 1: Description of Products or Services -->
          <div class="prep-checklist-item" role="listitem">
            <div class="prep-checklist-header">
              <span class="prep-checklist-num" aria-hidden="true">01</span>
              <span class="prep-checklist-badge">Class Scoping</span>
            </div>
            <h3 class="prep-checklist-title">Description of Products or Services</h3>
            <p class="prep-checklist-text">A plain-language summary of what your business sells, manufactures, or delivers so we can accurately classify your trademark under the NICE classification.</p>
          </div>

          <!-- Item 2: Applicant Name & Applicant Type -->
          <div class="prep-checklist-item" role="listitem">
            <div class="prep-checklist-header">
              <span class="prep-checklist-num" aria-hidden="true">02</span>
              <span class="prep-checklist-badge">Entity Classification</span>
            </div>
            <h3 class="prep-checklist-title">Applicant Name &amp; Applicant Type</h3>
            <p class="prep-checklist-text">Whether you are filing as an individual founder, sole proprietorship, partnership, LLP, or private limited company to determine correct statutory government fees.</p>
          </div>

          <!-- Item 3: Relevant Business Information -->
          <div class="prep-checklist-item" role="listitem">
            <div class="prep-checklist-header">
              <span class="prep-checklist-num" aria-hidden="true">03</span>
              <span class="prep-checklist-badge">Fee Concessions</span>
            </div>
            <h3 class="prep-checklist-title">Relevant Business Information</h3>
            <p class="prep-checklist-text">Your GST certificate, MSME/Udyam registration for up to 50% government fee concessions, and your date of first commercial use if already trading.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. SECTION 8: FAQ EDITORIAL PREVIEW (MINIMALIST NUMBERED ACCORDION) -->
    <section class="section faq-section" id="faq-preview" aria-labelledby="faq-heading">
      <div class="container">
        <!-- Section Introduction -->
        <div class="faq-editorial-header reveal-on-scroll">
          <div class="faq-eyebrow-wrap">
            <span class="faq-eyebrow-line" aria-hidden="true"></span>
            <span class="faq-eyebrow-text">FREQUENT QUESTIONS</span>
            <span class="faq-eyebrow-line" aria-hidden="true"></span>
          </div>
          <h2 id="faq-heading" class="faq-editorial-title">
            Common Questions About<br />
            <span class="gold-text">Trademarks.</span>
          </h2>
          <p class="faq-editorial-desc">
            Clear, practical answers to essential questions founders and business owners ask before starting a trademark or registration enquiry.
          </p>
        </div>

        <!-- Numbered Editorial FAQ List -->
        <div class="faq-editorial-list" id="faq-accordion-container">
          <!-- Item 01 -->
          <details class="faq-row-item faq-details">
            <summary class="faq-row-summary faq-summary">
              <div class="faq-row-lead">
                <span class="faq-row-num">01</span>
                <span class="faq-row-vbar" aria-hidden="true"></span>
                <span class="faq-row-question">Can someone else take my brand name before I register it?</span>
              </div>
              <span class="faq-row-toggle" aria-hidden="true">
                <svg class="faq-toggle-svg" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line class="line-h" x1="2" y1="7" x2="12" y2="7"></line>
                  <line class="line-v" x1="7" y1="2" x2="7" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="faq-row-content">
              <p>Yes. Under Indian trademark law, rights are established primarily by filing priority date. If a competitor files an identical or deceptively similar name before you, they gain statutory priority to that name in commerce across India.</p>
            </div>
          </details>

          <!-- Item 02 -->
          <details class="faq-row-item faq-details">
            <summary class="faq-row-summary faq-summary">
              <div class="faq-row-lead">
                <span class="faq-row-num">02</span>
                <span class="faq-row-vbar" aria-hidden="true"></span>
                <span class="faq-row-question">I've been using this name for years. Doesn't that protect me?</span>
              </div>
              <span class="faq-row-toggle" aria-hidden="true">
                <svg class="faq-toggle-svg" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line class="line-h" x1="2" y1="7" x2="12" y2="7"></line>
                  <line class="line-v" x1="7" y1="2" x2="7" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="faq-row-content">
              <p>Prior use provides limited common law rights under &ldquo;passing off&rdquo;, but proving it in court requires extensive historical invoices, turnover evidence, and expensive litigation. A registered trademark gives you immediate nationwide statutory ownership.</p>
            </div>
          </details>

          <!-- Item 03 -->
          <details class="faq-row-item faq-details">
            <summary class="faq-row-summary faq-summary">
              <div class="faq-row-lead">
                <span class="faq-row-num">03</span>
                <span class="faq-row-vbar" aria-hidden="true"></span>
                <span class="faq-row-question">How long does registration take?</span>
              </div>
              <span class="faq-row-toggle" aria-hidden="true">
                <svg class="faq-toggle-svg" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line class="line-h" x1="2" y1="7" x2="12" y2="7"></line>
                  <line class="line-v" x1="7" y1="2" x2="7" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="faq-row-content">
              <p>The standard IP India registration lifecycle typically spans 12 to 18 months through examination, journal publication, and final certificate issuance. However, your legal priority date is locked the exact day Form TM-A is submitted.</p>
            </div>
          </details>

          <!-- Item 04 -->
          <details class="faq-row-item faq-details">
            <summary class="faq-row-summary faq-summary">
              <div class="faq-row-lead">
                <span class="faq-row-num">04</span>
                <span class="faq-row-vbar" aria-hidden="true"></span>
