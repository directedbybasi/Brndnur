    <!-- Interactive 4.5s Auto-Infinity Sliders for Group A, Group B, and Section 7 -->
    <script is:inline>
      function setupInfiniteSlider(config) {
        const slider = document.getElementById(config.sliderId);
        const prevBtn = document.getElementById(config.prevId);
        const nextBtn = document.getElementById(config.nextId);
        if (!slider) return null;

        const container = config.containerSelector 
          ? (slider.closest(config.containerSelector) || document.querySelector(config.containerSelector) || slider.parentElement)
          : (config.containerId ? document.getElementById(config.containerId) : slider.parentElement);
        const dots = config.dotsId ? document.querySelectorAll(`#${config.dotsId} .prep-dot`) : [];
        const intervalTime = config.interval || 5000;
        let timer = null;
        let isPaused = false;

        function getStep() {
          const card = slider.querySelector(config.cardSelector);
          if (!card) return 320;
          const style = window.getComputedStyle(slider);
          const gap = parseFloat(style.gap) || 20;
          return card.getBoundingClientRect().width + gap;
        }

        function getMaxScroll() {
          return Math.max(0, slider.scrollWidth - slider.clientWidth - 4);
        }

        function updateDots() {
          if (!dots || dots.length === 0) return;
          const max = getMaxScroll();
          let activeIndex = 0;
          if (max > 4) {
            const ratio = Math.min(1, Math.max(0, slider.scrollLeft / max));
            activeIndex = Math.min(dots.length - 1, Math.round(ratio * (dots.length - 1)));
          }
          dots.forEach((dot, idx) => {
            const isActive = idx === activeIndex;
            dot.classList.toggle('active', isActive);
            dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
        }

        function nextSlide() {
          const max = getMaxScroll();
          if (slider.scrollLeft >= max - 6) {
            slider.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: getStep(), behavior: 'smooth' });
          }
        }

        function prevSlide() {
          const max = getMaxScroll();
          if (slider.scrollLeft <= 6) {
            slider.scrollTo({ left: max, behavior: 'smooth' });
          } else {
            slider.scrollBy({ left: -getStep(), behavior: 'smooth' });
          }
        }

        function startAuto() {
          stopAuto();
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return;
          }
          if (isPaused) return;
          timer = setInterval(nextSlide, intervalTime);
        }

        function stopAuto() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        function resetAuto() {
          stopAuto();
          startAuto();
        }

        if (nextBtn) {
          nextBtn.onclick = function() {
            nextSlide();
            resetAuto();
          };
        }

        if (prevBtn) {
          prevBtn.onclick = function() {
            prevSlide();
            resetAuto();
          };
        }

        if (dots && dots.length > 0) {
          dots.forEach(dot => {
            dot.onclick = function() {
              const idx = parseInt(this.dataset.index, 10);
              const max = getMaxScroll();
              if (max > 0) {
                const target = (idx / (dots.length - 1)) * max;
                slider.scrollTo({ left: target, behavior: 'smooth' });
              }
              resetAuto();
            };
          });
        }

        slider.addEventListener('scroll', function() {
          requestAnimationFrame(updateDots);
        }, { passive: true });

        let touchResumeTimeout = null;
        if (container) {
          container.addEventListener('mouseenter', function() {
            isPaused = true;
            stopAuto();
          });
          container.addEventListener('mouseleave', function() {
            isPaused = false;
            startAuto();
          });
          container.addEventListener('focusin', function() {
            isPaused = true;
            stopAuto();
          });
          container.addEventListener('focusout', function(e) {
            if (!container.contains(e.relatedTarget)) {
              isPaused = false;
              startAuto();
            }
          });
        }

        slider.addEventListener('touchstart', function() {
          isPaused = true;
          if (touchResumeTimeout) clearTimeout(touchResumeTimeout);
          stopAuto();
        }, { passive: true });
        slider.addEventListener('touchend', function() {
          isPaused = false;
          if (touchResumeTimeout) clearTimeout(touchResumeTimeout);
          touchResumeTimeout = setTimeout(startAuto, intervalTime);
        }, { passive: true });

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            stopAuto();
          } else {
            if (!isPaused) startAuto();
          }
        });

        document.addEventListener('astro:before-swap', function() {
          stopAuto();
          if (touchResumeTimeout) clearTimeout(touchResumeTimeout);
        });

        startAuto();
        updateDots();
      }

      function initAllSliders() {
        // Section 7: Preparation Checklist (3 columns in a row, auto-infinity 5s + dots)
        setupInfiniteSlider({
          sliderId: 'prep-slider',
          prevId: 'prep-prev',
          nextId: 'prep-next',
          containerSelector: '.prep-slider-wrapper',
          dotsId: 'prep-dots',
          cardSelector: '.prep-card',
          interval: 5000
        });
      }

      function initServicesCarousel() {
        const filterBar = document.querySelector('.services-filter-bar');
        const grid = document.getElementById('services-grid');
        const viewport = document.getElementById('services-carousel-viewport');
        const prevBtn = document.getElementById('services-prev');
        const nextBtn = document.getElementById('services-next');
        const dotsContainer = document.getElementById('services-dots');
        const statusEl = document.getElementById('services-filter-status');
        if (!grid || !viewport) return;

        const tabs = filterBar ? filterBar.querySelectorAll('.filter-tab') : [];
        const cards = Array.from(grid.querySelectorAll('.service-card'));
        let currentIndex = 0;

        const AUTOPLAY_INTERVAL = 5000;
        let autoTimer = null;
        let isPaused = false;
        let touchResumeTimer = null;

        function nextSlide() {
          const max = getMaxIndex();
          if (max <= 0) return;
          if (currentIndex >= max) {
            currentIndex = 0;
          } else {
            currentIndex++;
          }
          updateCarousel();
        }

        function startAuto() {
          stopAuto();
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return;
          }
          if (isPaused) return;
          const max = getMaxIndex();
          if (max <= 0) return;
          autoTimer = setInterval(nextSlide, AUTOPLAY_INTERVAL);
        }

        function stopAuto() {
          if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        }

        function resetAuto() {
          stopAuto();
          startAuto();
        }

        function getCardsPerView() {
          const w = window.innerWidth;
          if (w >= 1200) return 4;
          if (w >= 1024) return 3;
          if (w >= 768) return 2;
          return 1;
        }

        function getVisibleCards() {
          return cards.filter(card => !card.classList.contains('is-hidden'));
        }

        function getMaxIndex() {
          const visible = getVisibleCards();
          const perView = getCardsPerView();
          return Math.max(0, visible.length - perView);
        }

        function updateCarousel() {
          const visible = getVisibleCards();
          const perView = getCardsPerView();
          const maxIndex = Math.max(0, visible.length - perView);

          if (currentIndex > maxIndex) currentIndex = maxIndex;
          if (currentIndex < 0) currentIndex = 0;

          // Compute exact offset
          if (visible.length === 0 || maxIndex === 0 || currentIndex === 0) {
            grid.style.transform = 'translateX(0px)';
          } else {
            const targetCard = visible[currentIndex];
            const firstCard = visible[0];
            if (targetCard && firstCard) {
              const offset = targetCard.offsetLeft - firstCard.offsetLeft;
              grid.style.transform = `translateX(-${offset}px)`;
            }
          }

          // Update arrow states
          if (prevBtn) {
            prevBtn.disabled = (currentIndex <= 0);
            prevBtn.setAttribute('aria-disabled', (currentIndex <= 0).toString());
          }
          if (nextBtn) {
            nextBtn.disabled = (currentIndex >= maxIndex);
            nextBtn.setAttribute('aria-disabled', (currentIndex >= maxIndex).toString());
          }

          // Render / update pagination dots
          if (dotsContainer) {
            const totalDots = maxIndex + 1;
            if (dotsContainer.children.length !== totalDots) {
              dotsContainer.innerHTML = '';
              for (let i = 0; i < totalDots; i++) {
                const dot = document.createElement('button');
                dot.type = 'button';
                dot.className = 'services-carousel__dot' + (i === currentIndex ? ' active' : '');
                dot.setAttribute('role', 'tab');
                dot.setAttribute('aria-selected', (i === currentIndex).toString());
                dot.setAttribute('aria-label', `Go to service slide ${i + 1} of ${totalDots}`);
                dot.dataset.index = i.toString();
                dot.addEventListener('click', () => {
                  currentIndex = i;
                  updateCarousel();
                  resetAuto();
                });
                dotsContainer.appendChild(dot);
              }
            } else {
              Array.from(dotsContainer.children).forEach((dot, idx) => {
                const isActive = (idx === currentIndex);
                dot.classList.toggle('active', isActive);
                dot.setAttribute('aria-selected', isActive.toString());
              });
            }
          }
        }

        // Category tab filter handling
        tabs.forEach(tab => {
          tab.addEventListener('click', function() {
            const filter = this.getAttribute('data-filter') || 'all';

            // Update tab states
            tabs.forEach(t => {
              t.classList.remove('active');
              t.setAttribute('aria-selected', 'false');
            });
            this.classList.add('active');
            this.setAttribute('aria-selected', 'true');

            // Filter cards
            let visibleCount = 0;
            cards.forEach(card => {
              const category = card.getAttribute('data-category');
              if (filter === 'all' || category === filter) {
                card.classList.remove('is-hidden');
                visibleCount++;
              } else {
                card.classList.add('is-hidden');
              }
            });

            // Reset carousel to first card position and reset timer
            currentIndex = 0;

            // Recalculate after layout update
            requestAnimationFrame(() => {
              updateCarousel();
              resetAuto();
            });

            // Announce to screen readers
            if (statusEl) {
              const label = this.querySelector('.tab-label')?.textContent?.trim() || filter;
              statusEl.textContent = `Showing ${visibleCount} services for ${label}`;
            }
          });
        });

        // Navigation arrows
        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentIndex > 0) {
              currentIndex--;
              updateCarousel();
              resetAuto();
            }
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const max = getMaxIndex();
            if (currentIndex < max) {
              currentIndex++;
              updateCarousel();
              resetAuto();
            }
          });
        }

        // Keyboard navigation (ArrowLeft / ArrowRight)
        viewport.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') {
            const max = getMaxIndex();
            if (currentIndex < max) {
              e.preventDefault();
              currentIndex++;
              updateCarousel();
              resetAuto();
            }
          } else if (e.key === 'ArrowLeft') {
            if (currentIndex > 0) {
              e.preventDefault();
              currentIndex--;
              updateCarousel();
              resetAuto();
            }
          }
        });

        // Hover pause
        viewport.addEventListener('mouseenter', () => {
          isPaused = true;
          stopAuto();
        });
        viewport.addEventListener('mouseleave', () => {
          isPaused = false;
          startAuto();
        });

        // Focus pause (interactive accessibility: buttons, links inside carousel)
        viewport.addEventListener('focusin', () => {
          isPaused = true;
          stopAuto();
        });
        viewport.addEventListener('focusout', (e) => {
          if (!viewport.contains(e.relatedTarget)) {
            isPaused = false;
            startAuto();
          }
        });

        // Touch swipe handling on mobile & tablet
        let touchStartX = 0;
        let touchStartY = 0;
        viewport.addEventListener('touchstart', (e) => {
          isPaused = true;
          if (touchResumeTimer) clearTimeout(touchResumeTimer);
          stopAuto();
          touchStartX = e.changedTouches[0].screenX;
          touchStartY = e.changedTouches[0].screenY;
        }, { passive: true });

        viewport.addEventListener('touchend', (e) => {
          const touchEndX = e.changedTouches[0].screenX;
          const touchEndY = e.changedTouches[0].screenY;
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;

          if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
            if (diffX < 0) {
              const max = getMaxIndex();
              if (currentIndex < max) {
                currentIndex++;
                updateCarousel();
              }
            } else {
              if (currentIndex > 0) {
                currentIndex--;
                updateCarousel();
              }
            }
          }
          isPaused = false;
          if (touchResumeTimer) clearTimeout(touchResumeTimer);
          touchResumeTimer = setTimeout(startAuto, AUTOPLAY_INTERVAL);
        }, { passive: true });

        // Tab visibility pause
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            stopAuto();
          } else {
            if (!isPaused) startAuto();
          }
        });

        // Astro page transition cleanup
        document.addEventListener('astro:before-swap', () => {
          stopAuto();
          if (touchResumeTimer) clearTimeout(touchResumeTimer);
        });

        // Responsive resize handler
        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            updateCarousel();
            resetAuto();
          }, 80);
        });

        // Initial setup and start autoplay
        updateCarousel();
        startAuto();
      }

      function initPageInteractive() {
        initAllSliders();
        initServicesCarousel();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPageInteractive);
      } else {
        initPageInteractive();
      }
      document.addEventListener('astro:page-load', initPageInteractive);
    </script>

  </main>
</BaseLayout>

