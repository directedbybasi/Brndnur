---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardCarousel from '../components/CardCarousel.astro';
import { buildWhatsAppUrl } from '../utils/whatsapp';

const title = "BRNDNUR Advisory LLP | Trademark & Business Advisory";
const description = "Trademark registration guidance, preliminary brand-name searches, class selection, and business advisory services with BRNDNUR Advisory LLP in Manjeri, Malappuram, Kerala.";
const canonical = "https://brndnur.com/";
const ogImage = "/assets/hero-brand-desk.png";

const heroWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Homepage',
  sectionName: 'Hero Section',
  enquiryType: 'Preliminary Brand Name Search',
  topic: 'I visited your homepage and would like assistance with a preliminary trademark search for my proposed brand name.',
  details: 'Proposed brand name: [Please enter your brand name]',
  callToAction: 'Could you please guide me on the availability assessment and next steps?'
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  pageName: 'Homepage',
  sectionName: 'Closing Consultation Section',
  enquiryType: 'General Advisory Consultation',
  topic: 'I visited your homepage and would like to discuss my brand and business requirements with your advisory team.',
  details: 'My requirement is: [Please describe your brand name or service requirement]',
  callToAction: 'Could you please explain the suitable options and next steps?'
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  currentPath="/"
  hasCustomSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness", "ProfessionalService", "LegalService"],
      "@id": "https://brndnur.com/#organization",
      "name": "BRNDNUR Advisory LLP",
      "legalName": "BRNDNUR Advisory LLP",
      "url": "https://brndnur.com/",
      "sameAs": [
        "https://www.linkedin.com/company/brndnur",
        "https://x.com/brndnur"
      ],
      "logo": {
        "@type": "ImageObject",
        "@id": "https://brndnur.com/#logo",
        "url": "https://brndnur.com/assets/brndnur-logo-transparent.png",
        "caption": "BRNDNUR Advisory LLP"
      },
      "image": "https://brndnur.com/assets/brndnur-og-banner.jpg",
      "telephone": "+91 90481 88899",
      "email": "brndnuradvisoryllp@gmail.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Skatt Business Park",
        "addressLocality": "Manjeri",
        "addressRegion": "Kerala",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 11.1219,
        "longitude": 76.1210
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:30",
        "closes": "18:00"
      },
      "areaServed": ["Manjeri", "Malappuram", "Kozhikode", "Wayanad", "Kannur", "Kasaragod", "Palakkad", "Thrissur", "Ernakulam", "Kerala", "India"],
      "knowsAbout": [
        "Trademark Registration in India",
        "Brand Name Search",
        "Nice Classification",
        "Trademark Renewal",
        "Trademark Journal Monitoring",
        "GST Registration",
        "Udyam MSME Registration",
        "FSSAI Registration",
        "Business Setup Advisory"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91 90481 88899",
        "contactType": "customer service",
        "availableLanguage": ["en", "ml"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://brndnur.com/#website",
      "url": "https://brndnur.com/",
      "name": "BRNDNUR Advisory LLP",
      "publisher": {
        "@id": "https://brndnur.com/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://brndnur.com/#webpage",
      "url": "https://brndnur.com/",
      "name": "BRNDNUR Advisory LLP | Trademark Registration & Business Advisory",
      "description": "Trademark registration guidance, preliminary brand-name searches, class selection, and business advisory services with BRNDNUR Advisory LLP in Manjeri, Malappuram, Kerala.",
      "isPartOf": {
        "@id": "https://brndnur.com/#website"
      },
      "about": {
        "@id": "https://brndnur.com/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://brndnur.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a trademark?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A trademark protects your distinctive brand name, logo, slogan, or commercial symbol used in connection with goods or services. Registration under the Trade Marks Act grants statutory nationwide exclusive rights, deters deceptive imitation, and secures brand equity as your business grows."
          }
        },
        {
          "@type": "Question",
          "name": "How do I begin a trademark registration enquiry?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can begin by sharing your proposed brand name, logo concept, and a brief description of your products or services via WhatsApp or our enquiry channels. We conduct a preliminary discussion to assess relevant classes and identify potentially conflicting marks before filing."
          }
        },
        {
          "@type": "Question",
          "name": "How do trademark classes work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "India follows the international Nice Classification system of 45 classes: Classes 1 to 34 cover physical goods (e.g. food, clothing, cosmetics), while Classes 35 to 45 cover services (e.g. retail, consulting, software). Applications must specify the exact classes that correspond to your commercial activities."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a wordmark and a logo trademark?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A wordmark protects the brand name itself in standard text, offering broad protection regardless of typography or styling. A logo (device mark) protects the distinctive visual symbol, stylized lettering, or emblem. Many businesses file both to secure comprehensive coverage."
          }
        },
        {
          "@type": "Question",
          "name": "What information should I prepare?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Having your proposed brand name, logo file (if available), a brief description of products or services, applicant details (individual, proprietorship, LLP, or company), and commercial usage status helps ensure an efficient initial assessment."
          }
        },
        {
          "@type": "Question",
          "name": "Is trademark registration the same as company registration?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Registering a company, LLP, or GST establishes your legal commercial entity and tax compliance, but does not grant proprietary trademark protection over your brand name. Trademark registration is a separate statutory intellectual property procedure."
          }
        },
        {
          "@type": "Question",
          "name": "What can affect the time required for an application?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trademark timelines depend on Trade Marks Registry examination workloads, whether the examiner issues examination report objections, whether third parties file oppositions during publication, and the promptness of responses to official queries."
          }
        },
        {
          "@type": "Question",
          "name": "How can I enquire about service charges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Statutory official government fees are prescribed by the Trade Marks Registry (with a 50% concession for individuals, startups, and MSMEs). BRNDNUR provides a transparent, itemised breakdown of official fees and our professional advisory charges before any work begins."
          }
        }
      ]
    }
  ]
}
    </script>
  </Fragment>

  <main id="main-content">
    
    <!-- 1. HERO SECTION -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow hero-stagger-1">Trademark Registration &amp; Business Advisory</p>
          <h1 id="hero-heading" class="hero-stagger-2">Your Brand Deserves<br>a <span>Stronger Tomorrow.</span></h1>
          <p class="hero-stagger-3">Your brand reflects your ideas, your hard work and the trust you build with customers. BRNDNUR helps you understand trademark registration and relevant business advisory services, so you can take informed steps towards building your brand.</p>
          
          <div class="actions hero-stagger-4">
            <a class="btn btn-primary" href={heroWhatsAppUrl} target="_blank" rel="noopener noreferrer">
              Request a Preliminary Search <span class="arrow">→</span>
            </a>
            <a class="btn btn-secondary" href="#services">
              Explore Our Services <span class="arrow">→</span>
            </a>
          </div>

          <div class="trust-row hero-stagger-5" aria-label="Key Highlights">
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">♢</span>
              <span class="trust-label">Brand<br>Protection Guidance</span>
            </div>
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">▱</span>
              <span class="trust-label">Business-Focused<br>Support</span>
            </div>
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">⌖</span>
              <span class="trust-label">Based in<br>Manjeri, Kerala</span>
            </div>
          </div>
        </div>
      </div>
      <picture class="hero-photo-wrap hero-photo-animate">
        <source srcset="/assets/hero-brand-desk-mobile.webp 768w, /assets/hero-brand-desk.webp 1448w" sizes="(max-width: 768px) 100vw, 50vw" type="image/webp" />
        <img
          class="hero-photo"
          src="/assets/hero-brand-desk.webp"
          alt="BRNDNUR notebook with shield logo, BRNDNUR trademark and LIGHT UP YOUR BRAND trademark embossed on a cream cover beside a black-and-gold pen"
          width="1448"
          height="1086"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
    </section>

    <!-- 2. SECTION 2: INFORMED DECISIONS (EDITORIAL IMAGE & TEXT SPLIT) -->
    <section class="section informed-section" id="informed" aria-labelledby="informed-heading">
      <div class="container">
        <div class="informed-split">
          <div class="informed-media reveal-on-scroll">
            <img
              src="/assets/home-card-trademark.webp"
              alt="Close-up of a bronze trademark registration symbol embossed on a cream portfolio beside legal reference documents and gold pen"
              width="1000"
              height="1000"
              loading="lazy"
              decoding="async"
              class="informed-photo"
            />
          </div>
          <div class="informed-content reveal-on-scroll">
            <p class="eyebrow">A Stronger Brand Starts With</p>
            <h2 id="informed-heading">Informed Decisions.</h2>
            <div class="rule-left" aria-hidden="true"></div>
            <p class="informed-lead">Choosing a brand name is an important business decision. Understanding trademark protection, relevant classes and the registration process can help you plan the next steps with greater clarity.</p>
            
            <div class="informed-pillars reveal-group">
              <div class="informed-pillar reveal-item">
                <span class="pillar-bullet" aria-hidden="true">♢</span>
                <div>
                  <strong>Brand Protection Clarity</strong>
                  <p>Understand the statutory differences between business name registration and nationwide trademark ownership.</p>
                </div>
              </div>
              <div class="informed-pillar reveal-item">
                <span class="pillar-bullet" aria-hidden="true">▱</span>
                <div>
                  <strong>Precise Class Alignment</strong>
                  <p>Identify the relevant goods and services categories across the 45 Nice Classification classes before filing.</p>
                </div>
              </div>
              <div class="informed-pillar reveal-item">
                <span class="pillar-bullet" aria-hidden="true">⌖</span>
                <div>
                  <strong>Clear Commercial Roadmap</strong>
                  <p>Review preliminary search findings, filing prerequisites, and applicable fees before committing resources.</p>
                </div>
              </div>
            </div>

            <div class="informed-action">
              <a class="btn btn-primary" href="/trademark-registration/">
                Explore Trademark Registration <span class="arrow">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SECTION 3: COMPREHENSIVE SERVICES (INTERACTIVE LUXURY SUITE) -->
    <section class="section service-directory" id="services" aria-labelledby="directory-heading">
      <div class="container">
        <div class="section-heading text-center reveal-on-scroll">
          <p class="eyebrow">Our Advisory Services</p>
          <h2 id="directory-heading">Comprehensive Support for Your Brand and Business.</h2>
          <div class="rule" aria-hidden="true"></div>
          <p class="section-lead">
            From statutory trademark clearance and nationwide registration to corporate structuring and regulatory licensing, explore our core advisory capabilities.
          </p>
        </div>

        <!-- Interactive Category Filter Bar -->
        <div class="services-filter-bar reveal-on-scroll" role="tablist" aria-label="Filter services by category">
          <button
            type="button"
            role="tab"
            class="filter-tab active"
            id="tab-all"
            aria-selected="true"
            aria-controls="services-grid"
            data-filter="all"
          >
            <span class="tab-label">All Services</span>
            <span class="tab-badge">9</span>
          </button>

          <button
            type="button"
            role="tab"
            class="filter-tab"
            id="tab-trademark"
            aria-selected="false"
            aria-controls="services-grid"
            data-filter="trademark"
          >
            <span class="tab-icon" aria-hidden="true">🛡️</span>
            <span class="tab-label">Trademark &amp; Brand Protection</span>
            <span class="tab-badge">5</span>
          </button>

          <button
            type="button"
            role="tab"
            class="filter-tab"
            id="tab-business"
            aria-selected="false"
            aria-controls="services-grid"
            data-filter="business"
          >
            <span class="tab-icon" aria-hidden="true">🏛️</span>
            <span class="tab-label">Business Registration &amp; Setup</span>
            <span class="tab-badge">4</span>
          </button>
        </div>

        <!-- Screen reader status live region -->
        <div id="services-filter-status" class="sr-only" aria-live="polite">
          Showing all 9 advisory services
        </div>

        <!-- Unified 4-Column Luxury Horizontal Service Carousel -->
        <div class="services-carousel" id="services-carousel">
          <div class="services-carousel__viewport" id="services-carousel-viewport" tabindex="0" role="region" aria-label="Services carousel track">
            <div class="services-carousel__track services-grid" id="services-grid">
              <!-- Card 1 — Trademark Registration (Trademark) -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/about-card-trademark.webp"
                    alt="Cream document folder with trademark registration heading, gold pen, and premium stationery on a warm office desk"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Statutory Filing</span>
                </div>
                <div class="card-content">
                  <h3>Trademark Registration</h3>
                  <p>End-to-end guidance for filing wordmarks and logos under the Trade Marks Act, including applicant vetting, documentation, and class selection.</p>
                  <a class="service-btn" href="/trademark-registration/">
                    <span>Explore Registration</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              <!-- Card 2 — Brand Name Search (Trademark) -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/home-card-search.webp"
                    alt="Magnifying glass over a notebook beside a laptop displaying a neutral trademark search interface"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Pre-Filing Clearance</span>
                </div>
                <div class="card-content">
                  <h3>Brand Name Search</h3>
                  <p>Preliminary clearance on the IP India database to evaluate phonetic and visual conflict risks under Sections 9 and 11 before committing capital.</p>
                  <a class="service-btn" href="/brand-name-search/">
                    <span>Request Search</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              <!-- Card 3 — Trademark Classes (Trademark) -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/classes-hero-catalog.webp"
                    alt="Organised cream product-category folders and document dividers arranged on an editorial desk"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Classification</span>
                </div>
                <div class="card-content">
                  <h3>Trademark Classes</h3>
                  <p>Navigate the 45 Nice Classification categories to pinpoint precisely which goods and services your business must protect without overfiling.</p>
                  <a class="service-btn" href="/trademark-classes/">
                    <span>Class Guidance</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              <!-- Card 4 — Wordmark and Logo Protection (Trademark) -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/wordmark-foundation-exclusivity.webp"
                    alt="Two elegant sheets displaying a wordmark design and a separate logo concept side by side"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Mark Types</span>
                </div>
                <div class="card-content">
                  <h3>Wordmark &amp; Logo Protection</h3>
                  <p>Understand the statutory distinctions between name-only text exclusivity and visual logo symbol protection to secure broad commercial coverage.</p>
                  <div class="card-dual-actions">
                    <a class="service-btn service-btn-split" href="/wordmark-registration/">
                      <span>Wordmark</span>
                      <span class="btn-arrow" aria-hidden="true">→</span>
                    </a>
                    <a class="service-btn service-btn-subtle" href="/logo-trademark-registration/">
                      <span>Logo</span>
                      <span class="btn-arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>

              <!-- Card 5 — Trademark Renewal & Monitoring (Trademark) -->
              <article class="service-card services-carousel__card" data-category="trademark">
                <div class="card-media">
                  <img
                    src="/assets/renewal-ownership-maintenance.webp"
                    alt="Document calendar, neatly organised filing records, and a premium desk with subtle gold accents"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Ongoing Maintenance</span>
                </div>
                <div class="card-content">
                  <h3>Trademark Renewal &amp; Monitoring</h3>
                  <p>Protect registered marks through 10-year statutory renewals on Form TM-R and ongoing surveillance of the Trade Marks Journal for conflicting marks.</p>
                  <div class="card-dual-actions">
                    <a class="service-btn service-btn-split" href="/trademark-renewal/">
                      <span>Renewal</span>
                      <span class="btn-arrow" aria-hidden="true">→</span>
                    </a>
                    <a class="service-btn service-btn-subtle" href="/trademark-monitoring/">
                      <span>Monitoring</span>
                      <span class="btn-arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>

              <!-- Card 6 — GST Registration (Business) -->
              <article class="service-card services-carousel__card" data-category="business">
                <div class="card-media">
                  <img
                    src="/assets/gst-tax-credibility.webp"
                    alt="Professional accounting documents, a calculator, and organised business paperwork"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Taxation &amp; Commerce</span>
                </div>
                <div class="card-content">
                  <h3>GST Registration</h3>
                  <p>Assistance with Goods &amp; Services Tax registration, document verification, and compliance alignment for manufacturers, traders, and service providers.</p>
                  <a class="service-btn" href="/gst-registration/">
                    <span>GST Assistance</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              <!-- Card 7 — Udyam / MSME Registration (Business) -->
              <article class="service-card services-carousel__card" data-category="business">
                <div class="card-media">
                  <img
                    src="/assets/udyam-growth-catalyst.webp"
                    alt="Small-business workspace featuring an organised business file and laptop"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">MSME Concessions</span>
                </div>
                <div class="card-content">
                  <h3>Udyam / MSME Registration</h3>
                  <p>Official digital MSME certification to unlock the statutory 50% government fee concession on trademark filings, priority credit, and subsidy schemes.</p>
                  <a class="service-btn" href="/udyam-msme-registration/">
                    <span>MSME Assistance</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              <!-- Card 8 — FSSAI Registration (Business) -->
              <article class="service-card services-carousel__card" data-category="business">
                <div class="card-media">
                  <img
                    src="/assets/fssai-packaging-standards.webp"
                    alt="Clean food-brand workspace featuring packaged food products, ingredient labels, and regulatory paperwork"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Food Licensing</span>
                </div>
                <div class="card-content">
                  <h3>FSSAI Registration</h3>
                  <p>Regulatory food business licensing and basic registration assistance on the FoSCoS portal for restaurants, bakeries, cloud kitchens, and packaged foods.</p>
                  <a class="service-btn" href="/fssai-registration/">
                    <span>FSSAI Assistance</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>

              <!-- Card 9 — Business Setup Advisory (Business) -->
              <article class="service-card services-carousel__card" data-category="business">
                <div class="card-media">
                  <img
                    src="/assets/setup-startup-readiness.webp"
                    alt="Professional business planning documents, a notebook, and architectural details of a modern business workspace"
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="card-tag">Entity Structuring</span>
                </div>
                <div class="card-content">
                  <h3>Business Setup Advisory</h3>
                  <p>Strategic constitution advice for founders choosing between Sole Proprietorships, Partnerships, LLPs, and Private Limited Companies synchronized with trademark clearance.</p>
                  <a class="service-btn" href="/business-setup/">
                    <span>Setup Advisory</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            </div>
          </div>

          <!-- Carousel Navigation Controls (Dot-Only Standard) -->
          <div class="services-carousel__controls" aria-label="Services carousel navigation">
            <div class="services-carousel__dots" id="services-dots" role="tablist" aria-label="Services pagination"></div>
          </div>
        </div>

        <!-- Section Footer Callout -->
        <div class="services-footer-banner">
          <div class="services-footer-content">
            <div class="services-footer-text">
              <h4>Looking for an Integrated Regulatory Solution?</h4>
              <p>Explore our bundled advisory packages designed for first-time founders, food brands, and Gulf-return entrepreneurs.</p>
            </div>
            <a class="btn btn-secondary" href="/packages/">
              <span>Explore All Packages</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SECTION 4: HOW IT WORKS (A CLEARER WAY FORWARD) -->
    <section class="process" id="process" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-heading reveal-on-scroll">
          <p class="eyebrow">How It Works</p>
          <h2 id="process-heading">A Clearer Way Forward.</h2>
          <p>A straightforward process to understand your requirements, discuss relevant options, and agree on the next steps.</p>
        </div>
        
        <CardCarousel id="home-process-carousel" ariaLabel="A Clearer Way Forward">
          <article class="step">
            <div class="step-top">
              <span class="step-num">01</span>
              <span class="step-line"></span>
            </div>
            <h3>Tell Us About Your Brand</h3>
            <p>Share your proposed brand name, business type, products or services, and the assistance you are looking for.</p>
          </article>
          
          <article class="step">
            <div class="step-top">
              <span class="step-num">02</span>
              <span class="step-line"></span>
            </div>
            <h3>Discuss Your Options</h3>
            <p>Understand relevant services, possible trademark classes, requirements, and practical considerations.</p>
          </article>
          
          <article class="step">
            <div class="step-top">
              <span class="step-num">03</span>
              <span class="step-line"></span>
