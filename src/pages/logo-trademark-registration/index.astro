---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Logo Trademark Registration in India | Device Mark Protection";
const description = "Protect your visual identity, emblems, icons, and graphic logos with a device mark registration in India. Guidance on artwork and filing with BRNDNUR.";
const canonical = "https://brndnur.com/logo-trademark-registration/";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/logo-trademark-registration/"
>
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Visual Identity Protection</p>
        <h1>Logo & Device Mark Trademark Registration.</h1>
        <p class="lead">Your logo represents your company’s public face. Registering a device mark protects the specific graphic composition, artistic emblem, custom typography, and visual brand identity submitted to the Trade Marks Registry.</p>
        <div class="actions">
          <a class="btn btn-primary" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20I%20want%20to%20protect%20my%20logo." target="_blank" rel="noopener noreferrer">Protect Your Logo &rarr;</a>
          <a class="btn btn-outline" href="/wordmark-registration/">Explore Wordmarks</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Filing Requirements</p>
          <h2>Preparing Your Logo Artwork for Submission</h2>
          <p>Proper artwork preparation ensures smooth processing and eliminates technical objections from the registry examiner:</p>
        </div>

        <div class="card-grid">
          <div class="bn-card">
            <div class="card-icon">🎨</div>
            <h3>Color vs. Black & White</h3>
            <p>Filing in black and white or grayscale generally grants protection across all color applications, whereas claiming specific colors limits rights to those exact shades.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">📐</div>
            <h3>High-Resolution Format</h3>
            <p>Clear, high-contrast digital representation free from background clutter, watermarks, or photographic compression artifacts.</p>
          </div>

          <div class="bn-card">
            <div class="card-icon">🔏</div>
            <h3>Composite Mark Rights</h3>
            <p>If your logo contains both a unique emblem and text, a device mark protects the combined whole. Filing both a wordmark and a logo offers maximum brand defense.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-panel">
          <p class="eyebrow">Secure Your Emblem</p>
          <h2>Ensure No Competitor Copies Your Visual Identity.</h2>
          <p>Send us your logo files. We will review the artwork against classification guidelines and prepare your application.</p>
          <div class="cta-actions">
            <a class="btn btn-gold" href="https://wa.me/919048188899?text=Hello%20BRNDNUR%2C%20here%20is%20my%20logo%20for%20review." target="_blank" rel="noopener noreferrer">Submit Logo for Review &rarr;</a>
            <a class="btn btn-outline" href="/trademark-registration/">View Overall Process</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
