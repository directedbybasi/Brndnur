---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/hero/PageHero.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import FaqItem from '../../components/FaqItem.astro';

const title = "Logo Trademark Registration in India | Device Marks | BRNDNUR";
const description = "Protect your visual identity, emblems, icons, and graphic logos with a device mark registration in India. Guidance on artwork and filing with BRNDNUR.";
const canonical = "https://brndnur.com/logo-trademark-registration/";
import { buildWhatsAppUrl } from '../../utils/whatsapp';

const heroWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Logo Trademark Registration",
  "sectionName": "Hero Section",
  "enquiryType": "Logo & Device Mark Protection",
  "topic": "I would like guidance on registering and protecting my logo or device mark in India.",
  "details": "Logo concept / brand: [Please describe your logo]\\nColor specifications: [e.g. Color mark or B&W]",
  "callToAction": "Could you please advise on submission formats, diagnostic reviews, and fee structures?"
});

const closingWhatsAppUrl = buildWhatsAppUrl({
  "pageName": "Logo Trademark Registration",
  "sectionName": "Closing CTA Band",
  "enquiryType": "Logo Diagnostic Review",
  "topic": "I have a logo artwork ready and would like to submit it for preliminary diagnostic and conflict screening.",
  "details": "Brand / entity name: [Please enter]",
  "callToAction": "Could you please review my logo for distinctiveness under Section 9 and 11 and advise on next steps?"
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  currentPath="/logo-trademark-registration/"
>
  <main id="main-content">
    <!-- Hero Section (Harmonized with Reference Layout) -->
    <PageHero
      eyebrow="Visual Identity Protection"
      title='Logo &amp;&nbsp;Device Mark<br class="hero-br">Trademark <span>Registration.</span>'
      hasGoldRule={true}
      description="Your logo represents your company’s public face. Registering a device mark protects the specific graphic composition, artistic emblem, custom typography, and visual brand identity submitted to the Trade Marks Registry."
      primaryCta={{
        text: "Protect Your Logo",
        href: heroWhatsAppUrl,
        icon: "→",
        target: "_blank",
        rel: "noopener noreferrer"
      }}
      secondaryCta={{
        text: "Explore Wordmarks",
        href: "/wordmark-registration/",
        icon: "→"
      }}
      trustBadges={[
        { icon: "♢", title: "Device Mark &", subtitle: "Emblem Protection" },
        { icon: "▱", title: "Vienna Codification", subtitle: "Compliant" },
        { icon: "⌖", title: "Packaging &", subtitle: "Lookalike Defense" }
      ]}
      image="/assets/logo-hero-branding.webp"
      imageAlt="Brand identity design studio desk with geometric logo grid sketches, brass drafting tools, and Pantone swatches"
    />

    <!-- Split Visual Section (Harmonized with Reference Layout) -->
    <section class="section">
      <div class="container split-section">
        <div class="split-photo">
          <img src="/assets/logo-packaging-protection.webp" alt="BRNDNUR Logo trademark registration artwork preparation in Kerala" width="800" height="600" loading="lazy" />
        </div>
        <div class="split-copy">
          <p class="eyebrow">Visual Defense</p>
          <h2>Protecting Your Graphic Elements &amp; Packaging.</h2>
          <div class="gold-rule"></div>
          <p>Customers recognize products on supermarket shelves, delivery boxes, and digital mobile apps primarily by visual design—the distinctive emblem, geometric shapes, stylized mascot, and color palette.</p>
          <p>Under the Trade Marks Act, 1999, filing a Device Mark locks in your exclusive rights over the specific graphic presentation. When a competitor attempts to use a visually imitating emblem or deceptive packaging layout, a registered device mark provides definitive legal grounds to halt imitation.</p>
          <div class="values">
            <div class="value">
              <span class="value-icon">♙</span>
              <div>
                <strong>Vienna Agreement Codification</strong>
                <p>Every device mark is classified under the international Vienna Classification for figurative elements to detect graphical conflicts.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▤</span>
              <div>
                <strong>Packaging &amp; Label Exclusivity</strong>
                <p>Stop lookalike products from deceiving customers through copycat color schemes and graphic layouts.</p>
              </div>
            </div>
            <div class="value">
              <span class="value-icon">▥</span>
              <div>
                <strong>Vernacular Script Protection</strong>
                <p>Protect stylized regional scripts (including Malayalam, Arabic, or Hindi) alongside proper English transliterations.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filing Considerations (Editorial Cards) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Filing Requirements</p>
          <h2>Preparing Your Logo Artwork for Submission.</h2>
          <div class="gold-rule"></div>
          <p>Proper artwork preparation ensures smooth processing and eliminates technical objections from the registry examiner.</p>
        </div>

        <CardCarousel id="logo-requirements-carousel" ariaLabel="Logo filing requirements">
          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">01</div>
              <h3>Color vs. Black &amp; White</h3>
              <p>Filing in black and white or grayscale generally grants protection across all color applications, whereas claiming specific colors limits rights to those exact shades.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">02</div>
              <h3>High-Resolution Source Files</h3>
              <p>The Trade Marks Registry requires crisp digital specimens formatted within strict pixel dimensions without pixelation or background noise.</p>
            </div>
          </article>

          <article class="service-card">
            <div class="service-body">
              <div class="step-num" style="margin-bottom: 14px;">03</div>
              <h3>Transliteration Affidavits</h3>
              <p>If your logo incorporates regional language lettering, an accurate translation and phonetic transliteration into English must accompany Form TM-A.</p>
            </div>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Logo Specifications Table -->
    <section class="section">
      <div class="container" style="max-width: 960px;">
        <div class="section-heading">
          <p class="eyebrow">Registry Specifications</p>
          <h2>Device Mark Filing Specifications.</h2>
          <div class="gold-rule"></div>
          <p>Technical and legal benchmarks for compliant application submission.</p>
        </div>

        <div class="table-wrap">
          <table class="bn-table">
            <thead>
              <tr>
                <th>Requirement</th>
                <th>Statutory Standard</th>
                <th>BRNDNUR Best Practice</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Image Format &amp; Size</strong></td>
                <td>JPEG/PNG, 8cm x 8cm bounding box, &lt; 5MB</td>
                <td>Supply vector or high-resolution (300 DPI) source files</td>
              </tr>
              <tr>
                <td><strong>Color Limitation Claim</strong></td>
                <td>Specific color combinations can be claimed</td>
                <td>File in black &amp; white unless color combination is your primary differentiator</td>
              </tr>
              <tr>
                <td><strong>Non-English / Vernacular Text</strong></td>
                <td>Mandatory transliteration and translation into English</td>
                <td>Submit transliteration affidavit if mark includes Malayalam, Arabic, or Hindi script</td>
              </tr>
              <tr>
                <td><strong>Composite Mark Strategy</strong></td>
                <td>Protects logo emblem + wordmark arrangement as a unit</td>
                <td>Pair with a standalone wordmark to prevent competitors from using the name separately</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Logo Preparation Checklist & Methodology -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Artwork Specifications</p>
          <h2>Preparing Your Logo for E-Filing.</h2>
          <div class="gold-rule"></div>
          <p>Proper digital formatting avoids formal registry deficiencies and delayed examination.</p>
        </div>

        <CardCarousel id="logo-specs-carousel" ariaLabel="Artwork specifications for e-filing">
          <article class="service-card" style="padding: 1.75rem;">
            <div class="step-num" style="margin-bottom: 12px; font-size: 1.15rem; color: var(--gold);">01</div>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: .6rem;">High-Resolution Digital Proof</h3>
            <p style="font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); line-height: 1.65; color: var(--body);">Supply your vector or 300+ DPI artwork (PNG or JPEG) on a clean white background, free from drop shadows or 3D mockups.</p>
          </article>

          <article class="service-card" style="padding: 1.75rem;">
            <div class="step-num" style="margin-bottom: 12px; font-size: 1.15rem; color: var(--gold);">02</div>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: .6rem;">Color Claim Evaluation</h3>
            <p style="font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); line-height: 1.65; color: var(--body);">Filing in monochrome (black & white) grants broad protection across all colorways; claim specific hex colors only when color is your core brand identity.</p>
          </article>

          <article class="service-card" style="padding: 1.75rem;">
            <div class="step-num" style="margin-bottom: 12px; font-size: 1.15rem; color: var(--gold);">03</div>
            <h3 style="font-family: var(--sans); font-weight: 600; font-size: 1.35rem; color: var(--navy); margin-bottom: .6rem;">Vernacular Script Translation</h3>
            <p style="font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem); line-height: 1.65; color: var(--body);">If your logo contains Malayalam, Arabic, Hindi, or regional text, statutory transliteration and English translation affidavits must accompany the filing.</p>
          </article>
        </CardCarousel>
      </div>
    </section>

    <!-- Logo FAQs -->
    <section class="section">
      <div class="container" style="max-width: 880px;">
        <div class="section-heading">
          <p class="eyebrow">Device Mark FAQs</p>
          <h2>Questions About Logo Protection.</h2>
          <div class="gold-rule"></div>
          <p>Practical guidance regarding device marks, emblem exclusivity, and Vienna classification.</p>
        </div>

        <div class="faq-editorial-list faq-list">
          <FaqItem
            num="01"
            question="Does registering a logo protect the textual brand name as well?"
            answer="Registering a logo (device mark) protects the overall visual composite—the combination of text, typeface, and graphic symbols as filed. If a competitor uses your textual name in a completely different font or arrangement, enforcing a logo mark can be more challenging. For complete legal protection, filing both a standalone wordmark and your logo mark is recommended."
          />
          <FaqItem
            num="02"
            question="What happens if I redesign or update my logo after registration?"
            answer="Minor typographical tweaks may still fall under the original protection, but any substantial redesign—such as altering the visual emblem, changing mascot illustrations, or modifying key graphic features—requires filing a new device mark application."
          />
          <FaqItem
            num="03"
            question="What is the Vienna Classification for logos?"
            answer="The Vienna Classification is an international indexing system that categorizes the figurative elements of marks (e.g., animals, geometric shapes, plants, heraldic crests). The Indian Registry assigns Vienna codes during initial examination to identify graphically similar conflicting logos."
          />
          <FaqItem
            num="04"
            question="Can I register a logo that has already been used on packaging for years?"
            answer="Yes. You can claim a &quot;prior user date&quot; on Form TM-A by submitting a notarized User Affidavit along with dated commercial invoices, packaging proofs, social media screenshots, or tax records demonstrating commercial use in India."
          />
        </div>
      </div>
    </section>

    <!-- Signature Full-Width Dark Navy CTA Band (Harmonized with Homepage) -->
    <section class="cta-band">
      <img class="cta-leaves" src="/assets/cta-leaves.webp" alt="" width="1672" height="941" loading="lazy" decoding="async" />
      <div class="container cta-inner">
        <div class="cta-copy">
          <p class="eyebrow">Secure Your Emblem</p>
          <h2>Ensure No Competitor Copies<br>Your Visual Identity.</h2>
          <p>Send us your logo files. We will review the artwork against classification guidelines and prepare your application.</p>
          <a class="btn btn-gold" href={closingWhatsAppUrl} target="_blank" rel="noopener noreferrer">Submit Logo for Review <span>→</span></a>
        </div>
        <div class="cta-benefits">
          <div class="cta-benefit">
            <span class="value-icon">☏</span>
            <div>
              <strong>Visual Audit</strong>
              <p>Preliminary check of emblem uniqueness against the Vienna code index.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♢</span>
            <div>
              <strong>Artwork Formatting</strong>
              <p>Conversion to exact registry dimensions and resolution standards.</p>
            </div>
          </div>
          <div class="cta-benefit">
            <span class="value-icon">♧</span>
            <div>
              <strong>Filing Assistance</strong>
              <p>Precise TM-A drafting with appropriate goods and services claims.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
